---
// src/components/About.astro
import CallToAction from '../Home/CallToAction.astro';
import biodegradableWaterImg from '../../images/biodegradable_water.png';
import greyBagsImg from '../../images/biodegradable_greybags.png';

const products = [
  { title: "Biodegradable Water Bottle", url: "/compostable-product/biodegradable-water-bottles", image: biodegradableWaterImg.src },
  { title: "Compostable Bag", url: "/compostable-product/carry-bags/compostable-bag", image: "/compostable-bags/imgi_4_biodegradable-bags-compostable-products-ecofriendly-bags-1-1.webp" },
  { title: "Compostable Nursery Bags", url: "/compostable-product/carry-bags/compostable-nursery-bags", image: "/compostable-bags/imgi_7_Compostable-grow-bags-e1780576071172.webp"},
  { title: "Compostable Grocery Bag", url: "/compostable-product/carry-bags/compostable-grocery-bag", image: "/compostable-bags/imgi_12_biodegradable-bags-compostable-products-eco-products-3.webp" },
  
  { title: "Compostable Medical Waste Bags", url: "/compostable-product/carry-bags/compostable-medical-waste-bags", image: "/compostable-bags/imgi_8_biodegradable-bags-compostable-products-ecofriendly-bags-1-3.webp" },
  { title: "Compostable Mailer Bags", url: "/compostable-product/carry-bags/compostable-mailer-bags", image: "/compostable-bags/imgi_11_courier-bags.webp" },
  { title: "Stand-up Pouches", url: "/compostable-product/compostable-pouches/stand-up-pouch", image: greyBagsImg.src },
  { title: "Compostable Garment Bags", url: "/compostable-product/carry-bags/compostable-garment-bags", image: "/compostable-bags/imgi_9_biodegradable-bags-compostable-products-ecofriendly-bags-2-1.webp" },
  
  { title: "Compostable Dona Bowl", url: "/compostable-product/food-packaging-boxes/compostable-dona-bowl", image: "/tableware/imgi_12_biodegradable-bags-compostable-products-eco-product-1.webp" },
  { title: "Compostable Plates", url: "/compostable-product/food-packaging-boxes/compostable-food-plates", image: "/tableware/imgi_7_biodegradable-bags-compostable-products-eco-product.-1.webp" },
  { title: "Compostable Bowls", url: "/compostable-product/food-packaging-boxes/compostable-bowl", image: "/tableware/imgi_6_biodegradable-bags-compostable-products-eco-product.webp" },
  { title: "Compostable Round Cup", url: "/compostable-product/food-packaging-boxes/compostable-round-cup", image: "/tableware/imgi_5_biodegradable-bags-compostable-products-eco-products.webp" }
];

const whyChoose = [
  {
    title: "We Vet Every Product",
    desc: "Only globally certified compostable products make it into our catalog (EN 13432, ASTM D6400, OK Compost).",
    icon: "/about/imgi_4_biodegradable_carry_bags-biodegradable_bags__compostable-products-ecofriendly-bags.-1.webp"
  },
  {
    title: "Fast Fulfillment",
    desc: "We stock and deliver in bulk perfect for retailers, supermarkets, restaurants, and event suppliers.",
    icon: "/about/imgi_5_biodegradable_carry_bags_biodegradable_bags-compostable-products-ecofriendly-bags.webp"
  },
  {
    title: "Personalized B2B Support",
    desc: "A dedicated account manager ensures smooth ordering, consistent supply, and custom packaging options.",
    icon: "/about/imgi_6_biodegradable_carry_bags-biodegradable_bags_compostable-products-ecofriendly-bags.webp"
  },
  {
    title: "Full Transparency",
    desc: "We provide full material traceability, product certifications, and eco-impact documentation.",
    icon: "/about/imgi_7_biodegradable_carry_bags-biodegradable_bags-compostable-products-ecofriendly_bags.webp"
  },
  {
    title: "Eco-Conscious Partnerships",
    desc: "We work only with manufacturers committed to sustainable agriculture, fair labor, and carbon neutrality.",
    icon: "/about/imgi_8_Biodegradable_carry_bags-biodegradable_bags-compostable-products-ecofriendly-bags.webp"
  },
  {
    title: "Field-Tested Quality",
    desc: "We provide full material traceability, product certifications, and eco-impact documentation.",
    icon: "/about/imgi_9_server-check.png"
  },
  {
    title: "Scalable Supply Chain",
    desc: "From local shops to national distributors, our inventory and logistics are built to grow with you.",
    icon: "/about/imgi_10_supply-chain.png"
  }
];
---

<section class="about-page" id="about-section">
  <div class="ambient-glow" id="ambient-glow"></div>

  <!-- Hero band -->
  <div class="sk-section about-hero-band">
    <div class="sk-wrap">
      <div class="hero-header" data-reveal>
        <span class="badge-tag">
          <span class="pulsing-dot"></span> SAKRT BIOPLASTIC MANUFACTURERS
        </span>
        <h1 class="hero-title">Pioneering Sustainable <br /><span class="italic-highlight">Bioplastic Solutions</span></h1>
      </div>
    </div>
  </div>

  <!-- Narrative band -->
  <div class="sk-section sk-section--band">
    <div class="sk-wrap">
      <div class="split-narrative" data-reveal-group>
        <div class="story-card">
          <h2 class="section-heading">About SAKRT</h2>
        <p class="lead-text">
          SAKRT is a trusted bioplastic manufacturer and distributor. We help retailers, food service providers, and eco-conscious brands replace plastic with sustainable alternatives.
        </p>
        <div class="about-text-more">
          <p>
            SAKRT delivers 100% bioplastic manufacturers, plates, and tableware. We are the trusted partner for modern businesses committed to protecting the environment. More than just a supplier, SAKRT is your trusted partner in sustainability. Together, we can reduce plastic pollution, safeguard our oceans, and create a future where bioplastic manufacturers’ choices are the norm.
          </p>
          <p>
            As one of India’s leading bioplastic manufacturers, SAKRT combines quality, compliance, and innovation to help businesses transition away from single-use plastics with confidence. Our manufacturing process adheres to CPCB certification standards, ensuring every product meets India’s regulatory requirements for compostability and environmental safety.
          </p>
        </div>
        <button id="about-text-toggle" class="products-toggle-link text-toggle-link">View More <span class="arrow">↓</span></button>
        </div>

        <div class="sectors-card">
          <h2 class="section-heading">What We Do?</h2>
        <p class="sub-label">We offer certified compostable packaging for:</p>
        
        <div class="sector-pills">
          <div class="sector-pill stagger-pill">
            <span class="pill-num">01</span>
            <span class="pill-text">Retail Stores</span>
          </div>
          <div class="sector-pill stagger-pill">
            <span class="pill-num">02</span>
            <span class="pill-text">E-commerce Brands</span>
          </div>
          <div class="sector-pill stagger-pill">
            <span class="pill-num">03</span>
            <span class="pill-text">Hospitality & Food Service</span>
          </div>
          <div class="sector-pill stagger-pill">
            <span class="pill-num">04</span>
            <span class="pill-text">Corporates & Institutions</span>
          </div>
          <div class="sector-pill stagger-pill">
            <span class="pill-num">05</span>
            <span class="pill-text">Municipal & Waste Management</span>
          </div>
        </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Pillars band -->
  <div class="sk-section">
    <div class="sk-wrap pillars-wrapper">
      <div class="section-center-head" data-reveal>
        <h2 class="why-title">Why Choose SAKRT?</h2>
        <div class="gold-accent-line"></div>
      </div>

      <div class="pillars-grid" data-reveal-group>
        {whyChoose.map((item) => (
          <div class="pillar-card">
            <div class="pillar-icon-wrap">
              <img src={item.icon} alt={item.title} class="pillar-icon" loading="lazy" />
            </div>
            <div class="pillar-body">
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Products band -->
  <div class="sk-section sk-section--band">
    <div class="sk-wrap products-showcase">
      <div class="section-center-head" data-reveal>
        <h2 class="why-title">Most Enquired Products</h2>
        <p class="products-subtitle">Browse Our Preferred Eco-Friendly Catalog Options</p>
      </div>

      <div class="product-grid" data-reveal-group>
        {products.map((product) => (
          <div class="product-card">
            <a href={product.url} class="card-image-box sk-media">
              <img src={product.image} alt={product.title} loading="lazy" />
              <div class="card-hover-overlay">
                <span class="quick-view-badge">Explore Item →</span>
              </div>
            </a>
            <div class="card-content">
              <h3 class="product-title">{product.title}</h3>
              <a href={product.url} class="view-details-btn">View Details</a>
            </div>
          </div>
        ))}
      </div>

      <button id="about-products-toggle" class="products-toggle-link">View More <span class="arrow">↓</span></button>
    </div>
  </div>
</section>

<!-- CTA Component -->
<CallToAction />

<style>
  /* About page — presentation rebuilt on the SAKRT design system.
     Tokens + .sk-* primitives only. Fonts load once in Layout.astro. */

  .about-page {
    position: relative;
    isolation: isolate;
  }

  /* The old mouse-tracking gold glow is gone; the element (and its id)
     remain in the DOM but render nothing. */
  .ambient-glow { display: none; }

  /* Clear the fixed glass header, matching the hero's generous top space. */
  .about-hero-band {
    padding-block: clamp(120px, 15vh, 176px) var(--section-y);
  }

  /* ---------- HERO ---------- */
  .hero-header {
    text-align: center;
    max-width: 62ch;
    margin-inline: auto;
  }

  .badge-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--s-2);
    max-width: 100%;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-muted);
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: 7px 16px;
    border-radius: var(--r-pill);
    margin-bottom: var(--s-5);
  }

  .pulsing-dot {
    width: 7px;
    height: 7px;
    flex: none;
    background: var(--lime);
    border-radius: var(--r-pill);
  }
  @media (prefers-reduced-motion: no-preference) {
    .pulsing-dot { animation: dotPulse 2.4s var(--ease-out) infinite; }
  }
  @keyframes dotPulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-synthesis-weight: none;
    font-size: var(--fs-h1);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
  }

  /* Ink on a lime marker stroke = 12.7:1 — the page's one lime mark. */
  .italic-highlight {
    font-style: italic;
    color: var(--ink);
    background-image: linear-gradient(to top, var(--lime) 0 30%, transparent 30%);
    background-repeat: no-repeat;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding-inline: 0.06em;
  }

  /* ---------- NARRATIVE ---------- */
  .split-narrative {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);
  }

  .story-card,
  .sectors-card {
    padding: clamp(var(--s-6), 4vw, var(--s-12));
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-1);
  }

  .section-heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-synthesis-weight: none;
    font-size: var(--fs-h3);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0 0 var(--s-4);
  }

  .lead-text {
    font-family: var(--font-sans);
    font-size: var(--fs-lede);
    line-height: 1.7;
    color: var(--ink-soft);
    margin: 0;
  }

  .about-text-more p {
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    line-height: 1.7;
    color: var(--ink-soft);
    margin-top: var(--s-4);
  }

  .sub-label {
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    color: var(--ink-soft);
    margin: 0 0 var(--s-5);
  }

  /* ---------- SECTOR PILLS ---------- */
  .sector-pills {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .sector-pill {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding: 14px 18px;
    background: var(--pulp);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    transition: border-color var(--dur-2) var(--ease-settle),
                transform var(--dur-2) var(--ease-settle);
  }

  .pill-num {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--lime-ink);
  }

  .pill-text {
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--ink);
  }

  @media (hover: hover) {
    .sector-pill:hover {
      transform: translateX(4px);
      border-color: var(--hairline-strong);
    }
  }

  /* ---------- SECTION HEADS (pillars + products) ---------- */
  .section-center-head {
    max-width: var(--maxw-narrow);
    margin: 0 0 var(--s-12);
  }

  .why-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-synthesis-weight: none;
    font-size: var(--fs-h2);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
  }

  /* Recoloured from gold to a lime rule — the pillars section's one mark. */
  .gold-accent-line {
    width: 56px;
    height: 3px;
    margin: var(--s-4) 0 0;
    background: var(--lime);
    border-radius: var(--r-pill);
  }

  /* ---------- WHY-CHOOSE GRID ---------- */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--s-5);
  }

  .pillar-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    height: 100%;
    padding: var(--s-6);
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-1);
    transition: transform var(--dur-2) var(--ease-settle),
                box-shadow var(--dur-2) var(--ease-settle),
                border-color var(--dur-2) var(--ease-settle);
  }

  .pillar-icon-wrap {
    width: 56px;
    height: 56px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
    background: var(--pulp-deep);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
  }

  .pillar-icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .pillar-body h3 {
    font-family: var(--font-sans);
    font-size: var(--fs-h4);
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 var(--s-2);
  }

  .pillar-body p {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
  }

  @media (hover: hover) {
    .pillar-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-2);
      border-color: var(--hairline-strong);
    }
  }

  /* ---------- PRODUCTS: SPECIMEN GRID ---------- */
  .products-subtitle {
    font-family: var(--font-sans);
    font-size: var(--fs-lede);
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 62ch;
    margin: var(--s-4) 0 0;
  }

  /* Mobile-first: one column, widening at each breakpoint below. */
  .product-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-5);
  }

  .product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* The anchor is the fixed-ratio tile. Global .sk-media supplies the
     aspect-ratio, clipping, pulp-deep backing and cover-fit image; here we
     only pin the ratio and add the specimen hairline. */
  .card-image-box {
    display: block;
    --ar: 1 / 1;
    border: 1px solid var(--hairline);
    transition: border-color var(--dur-2) var(--ease-settle);
  }

  /* Bottom scrim holding the "Explore Item" tag — no full-cover wash. */
  .card-hover-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: var(--s-4);
    background: linear-gradient(to top, rgba(16, 40, 28, 0.55), rgba(16, 40, 28, 0) 60%);
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
  }

  .quick-view-badge {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-dark);
    background: rgba(16, 40, 28, 0.72);
    border: 1px solid rgba(242, 243, 237, 0.28);
    padding: 6px 12px;
    border-radius: var(--r-pill);
  }

  .card-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-3);
    padding-top: var(--s-4);
  }

  .product-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-synthesis-weight: none;
    font-size: clamp(1.3rem, 1.6vw, 1.45rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0;
  }

  /* A text link with a hairline underline, not a coloured pill. The rule
     turns lime on hover — lime as a mark, never as the text itself. */
  .view-details-btn {
    align-self: flex-start;
    margin-top: auto;
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--hairline-strong);
    transition: color var(--dur-1) var(--ease-out),
                border-color var(--dur-1) var(--ease-out);
  }

  /* TOGGLE LINK BUTTONS (shown on mobile by the toggle script) */
  .products-toggle-link {
    display: none;
    margin: var(--s-10) auto 0;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    padding: var(--s-2);
    border: none;
    cursor: pointer;
    align-items: center;
    gap: var(--s-2);
    text-transform: uppercase;
  }

  .products-toggle-link.text-toggle-link {
    margin: var(--s-4) 0 0;
    padding-left: 0;
  }

  @media (hover: hover) {
    .product-card:hover .card-image-box { border-color: var(--hairline-strong); }
    .product-card:hover .card-image-box img { transform: scale(1.045); }
    .product-card:hover .card-hover-overlay { opacity: 1; }
    .view-details-btn:hover { border-color: var(--lime); }
  }

  /* ---------- RESPONSIVE (mobile-first) ---------- */
  @media (min-width: 520px) {
    .product-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 768px) {
    .split-narrative {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--s-10);
      align-items: start;
    }
    .product-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (min-width: 1024px) {
    .product-grid { grid-template-columns: repeat(4, 1fr); }
  }

  /* Toggle-collapsed rows only apply on phones. */
  @media (max-width: 768px) {
    .product-card.mobile-hidden,
    .about-text-more.mobile-hidden {
      display: none !important;
    }
  }
</style>

<script>
  /* Presentation logic only: the two mobile "View More" toggles. Scroll
     reveals are handled globally in Layout.astro (data-reveal), so the old
     glow-tracking, 3D-tilt and bespoke IntersectionObserver are gone. */
  function initAboutToggles() {
    const isMobile = window.innerWidth <= 768;

    // Products Toggle Logic
    const toggleProductsBtn = document.getElementById('about-products-toggle');
    const cards = document.querySelectorAll('.product-grid .product-card');
    let isProductsExpanded = false;

    const updateProductsVisibility = () => {
      cards.forEach((card, index) => {
        if (isMobile && !isProductsExpanded && index >= 4) {
          card.classList.add('mobile-hidden');
        } else {
          card.classList.remove('mobile-hidden');
        }
      });
      if (toggleProductsBtn) {
        toggleProductsBtn.style.display = isMobile ? 'inline-flex' : 'none';
        toggleProductsBtn.innerHTML = isProductsExpanded ? 'View Less <span class="arrow">↑</span>' : 'View More <span class="arrow">↓</span>';
      }
    };

    updateProductsVisibility();

    if (toggleProductsBtn) {
      toggleProductsBtn.addEventListener('click', () => {
        isProductsExpanded = !isProductsExpanded;
        updateProductsVisibility();
      });
    }

    // Text Toggle Logic
    const toggleTextBtn = document.getElementById('about-text-toggle');
    const textMoreContent = document.querySelector('.about-text-more');
    let isTextExpanded = false;

    const updateTextVisibility = () => {
      if (isMobile && !isTextExpanded) {
        textMoreContent?.classList.add('mobile-hidden');
      } else {
        textMoreContent?.classList.remove('mobile-hidden');
      }
      if (toggleTextBtn) {
        toggleTextBtn.style.display = isMobile ? 'inline-flex' : 'none';
        toggleTextBtn.innerHTML = isTextExpanded ? 'View Less <span class="arrow">↑</span>' : 'View More <span class="arrow">↓</span>';
      }
    };

    updateTextVisibility();

    if (toggleTextBtn) {
      toggleTextBtn.addEventListener('click', () => {
        isTextExpanded = !isTextExpanded;
        updateTextVisibility();
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initAboutToggles);
  document.addEventListener('astro:page-load', initAboutToggles);
</script>