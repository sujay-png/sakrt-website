<script>
  function initAboutPageInteractions() {
    // 1. Accordion Toggle
    const accordionRows = document.querySelectorAll("#industries-accordion .accordion-row");

    accordionRows.forEach((row) => {
      const trigger = row.querySelector(".accordion-trigger");
      const panel = row.querySelector(".accordion-panel") as HTMLElement;
      const symbol = row.querySelector(".trigger-symbol");

      if (trigger && panel && symbol) {
        trigger.addEventListener("click", () => {
          const isOpen = row.classList.contains("is-open");

          // Close all other rows
          accordionRows.forEach((otherRow) => {
            otherRow.classList.remove("is-open");
            const otherPanel = otherRow.querySelector(".accordion-panel") as HTMLElement;
            const otherSymbol = otherRow.querySelector(".trigger-symbol");
            const otherTrigger = otherRow.querySelector(".accordion-trigger");
            if (otherPanel) otherPanel.style.display = "none";
            if (otherSymbol) otherSymbol.textContent = "+";
            if (otherTrigger) otherTrigger.setAttribute("aria-expanded", "false");
          });

          // Toggle current row
          if (!isOpen) {
            row.classList.add("is-open");
            panel.style.display = "block";
            symbol.textContent = "−";
            trigger.setAttribute("aria-expanded", "true");
          }
        });
      }
    });

    // 2. Subnav Scrollspy Active State
    const subnavLinks = document.querySelectorAll(".about-subnav-bar .subnav-link");
    const sections = document.querySelectorAll("section[id]");

    if (subnavLinks.length > 0 && sections.length > 0) {
      window.addEventListener("scroll", () => {
        let currentId = "";
        const scrollPosition = window.scrollY + 160;

        sections.forEach((section) => {
          const el = section as HTMLElement;
          const top = el.offsetTop;
          const height = el.offsetHeight;
          if (scrollPosition >= top && scrollPosition < top + height) {
            currentId = el.getAttribute("id") || "";
          }
        });

        if (currentId) {
          subnavLinks.forEach((link) => {
            const href = link.getAttribute("href")?.replace("#", "");
            if (href === currentId) {
              link.classList.add("active");
            } else {
              link.classList.remove("active");
            }
          });
        }
      });
    }
  }

  document.addEventListener("DOMContentLoaded", initAboutPageInteractions);
  document.addEventListener("astro:page-load", initAboutPageInteractions);
</script>
