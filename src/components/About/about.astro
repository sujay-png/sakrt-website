---
// src/components/About/about.astro
import CallToAction from "../Home/CallToAction.astro";
import biodegradableWaterImg from "../../images/biodegradable_water.png";
import greyBagsImg from "../../images/biodegradable_greybags.png";

const products = [
  {
    title: "Biodegradable Water Bottle",
    category: "Hospitality & Corporate",
    url: "/compostable-product/biodegradable-water-bottles/",
    image: biodegradableWaterImg.src,
  },
  {
    title: "Compostable Carry Bag",
    category: "Retail & Shopping",
    url: "/compostable-product/carry-bags/compostable-bag/",
    image: "/compostable-bags/new-compostable-bag.webp",
  },
  {
    title: "Compostable Nursery Bags",
    category: "Agriculture & Horticulture",
    url: "/compostable-product/carry-bags/compostable-nursery-bags/",
    image: "/compostable-bags/imgi_7_Compostable-grow-bags-e1780576071172.webp",
  },
  {
    title: "Compostable Grocery Bag",
    category: "Supermarkets & Produce",
    url: "/compostable-product/carry-bags/compostable-grocery-bag/",
    image:
      "/compostable-bags/imgi_12_biodegradable-bags-compostable-products-eco-products-3.webp",
  },
  {
    title: "Compostable Mailer Bags",
    category: "E-Commerce Logistics",
    url: "/compostable-product/carry-bags/compostable-mailer-bags/",
    image: "/compostable-bags/imgi_11_courier-bags.webp",
  },
  {
    title: "Stand-Up Pouches",
    category: "Food & Dry Packaging",
    url: "/compostable-product/compostable-pouches/stand-up-pouch/",
    image: greyBagsImg.src,
  },
  {
    title: "Compostable Garment Bags",
    category: "Apparel & Textiles",
    url: "/compostable-product/carry-bags/compostable-garment-bags/",
    image:
      "/compostable-bags/imgi_9_biodegradable-bags-compostable-products-ecofriendly-bags-2-1.webp",
  },
  {
    title: "Compostable Food Plates",
    category: "Dining & Events",
    url: "/compostable-product/food-packaging-boxes/compostable-food-plates/",
    image:
      "/tableware/imgi_7_biodegradable-bags-compostable-products-eco-product.-1.webp",
  },
];

const industries = [
  {
    num: "01",
    title: "Retail & supermarkets",
    content:
      "Carry and shopping bags for supermarkets, apparel outlets, neighbourhood stores, and local vendors. Practical GSM options and W-cut or D-cut styles for everyday customer loads.",
    open: true,
  },
  {
    num: "02",
    title: "E-commerce brands",
    content:
      "Compostable courier mailer bags and tamper-evident shipping pouches engineered for high tear resistance, waterproof protection, and smooth logistics handling.",
    open: false,
  },
  {
    num: "03",
    title: "Hospitality & food service",
    content:
      "Biodegradable water bottles, food plates, bowls, dona bowls, and food-grade packaging designed for hotels, restaurants, cafes, and catering.",
    open: false,
  },
  {
    num: "04",
    title: "Corporates & institutions",
    content:
      "Eco-friendly giveaway bottles, event hydration kits, and campus packaging helping companies and colleges reduce single-use plastic mandates.",
    open: false,
  },
  {
    num: "05",
    title: "Municipal & waste management",
    content:
      "Certified biodegradable garbage bags and medical waste liners with leak-proof seals for hygienic organic and segregated waste processing.",
    open: false,
  },
];
---

<div class="about-page-redesign">
  <!-- ==============================================
       HERO SECTION
       ============================================== -->
  <section class="about-hero-section">
    <div class="content-container">
      <div class="hero-top-grid">
        <!-- Left: Text & Actions -->
        <div class="hero-left-col">
          <div class="meta-kicker">
            <span class="kicker-dot"></span>
                    <div class="science-panel-divider"></div>
          <span>ABOUT SAKRT · ENVIRLY INNOVATIONS PVT LTD</span>
          </div>

          <h1 class="hero-headline">
            Trusted Corn Starch<br />
            Bags Manufacturers<br />
            <span class="serif-italic">in Karnataka.</span>
          </h1>

          <p class="hero-lead">
            Strong on performance. Lighter on tomorrow. SAKRT helps the businesses to
            replace single-use plastics with corn starch bags and certified
            compostable packaging, manufactured in Mangalore, Karnataka.
          </p>

          <div class="hero-actions">
            <a href="https://www.sakrt.in/contact-us/" class="btn-primary-pill">
              Request a wholesale quote
              <span class="action-icon">↗</span>
            </a>
            <a href="#science" class="link-secondary">
              Explore the science
              <span class="action-icon">↓</span>
            </a>
          </div>

          <p class="hero-subline">
            LOCAL ROOTS · FACTORY-DIRECT · PAN-INDIA SUPPLY
          </p>
        </div>

        <!-- Right: Arch Plant Image & Floating Card -->
        <div class="hero-right-col">
          <div class="hero-visual-arch-wrap">
            <div class="hero-arch-frame">
              <img
                src="/about/hero-arch.webp"
                alt="Plant growing from earth globe representing sustainable compostable packaging"
                class="hero-arch-img"
                loading="eager"
              />
            </div>

            <!-- Floating Badge Card -->
            <div class="hero-floating-card">
              <span class="floating-tag">A BETTER MATERIAL MINDSET</span>
              <p class="floating-title">
                Built for business.<br />
                <span class="serif-italic">Designed for a better future.</span>
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Trust Badges Strip -->
      <div class="hero-badges-strip">
        <div class="badge-item">
          <svg class="badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <path d="M9 12l2 2 4-4"></path>
          </svg>
          <span class="badge-text">CPCB certified</span>
        </div>

        <div class="badge-divider"></div>

        <div class="badge-item">
          <svg class="badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
            <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
          </svg>
          <span class="badge-text">Compostable alternatives</span>
        </div>

        <div class="badge-divider"></div>

        <div class="badge-item">
          <svg class="badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
          <span class="badge-text">Customised B2B solutions</span>
        </div>

        <div class="badge-divider"></div>

        <div class="badge-item">
          <svg class="badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          <span class="badge-text">Made in Mangaluru</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ==============================================
       SUB-NAVIGATION BAR
       ============================================== -->
  <nav class="about-subnav-bar" id="about-subnav">
    <div class="content-container subnav-inner">
      <a href="#story" class="subnav-link active">Our story</a>
      <a href="#mission" class="subnav-link">Mission & vision</a>
      <a href="#science" class="subnav-link">Material science</a>
      <a href="#certifications" class="subnav-link">Certifications</a>
      <a href="#products" class="subnav-link">Products</a>
      <a href="#why-sakrt" class="subnav-link">Why SAKRT</a>
    </div>
  </nav>

  <!-- ==============================================
       SECTION 01: OUR STORY
       ============================================== -->
  <section class="page-section section-story" id="story">
    <div class="content-container">
      <div class="split-section-grid">
        <!-- Left Title -->
        <div class="section-heading-col">
          <span class="section-kicker">01 — OUR STORY</span>
          <h2 class="section-title-large">
            Bio Degradable Plastic Manufacturer, <br />
            <span class="serif-italic">and Suppliers.</span>
          </h2>
        </div>

        <!-- Right Content -->
        <div class="section-body-col">
          <h2 class="section-title-large">
            Leading Manufacturer and Distributor of Sugarcane Bagasse & Corn Starch Bags in Karnataka.
          </h2>

          <div class="two-col-text-grid">
            <p>
              SAKRT - a brand of Envirly Innovations Pvt Ltd - is part of Mangalore's
              bioplastic manufacturing community. From our Kinnigoli facility,
              we manufacture and distribute corn starch bags and compostable
              packaging alternatives designed for strength, reliability, and
              cost-effective commercial use.
            </p>
            <p>
              From neighbourhood stores in Mangalore and Udupi to hospitality
              chains, hospitals, and e-commerce brands in Bengaluru and across
              India, we help organisations make a practical transition.
              Conventional plastics can persist for centuries and shed microplastics
              into soil and waterways. Better packaging should fit your operations—not
              add complexity.
            </p>
          </div>

          <div class="section-link-wrapper">
            <a href="#certifications" class="underlined-action-link">
              Our commitment, certified
              <span class="action-icon">↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==============================================
       SECTION 02: OUR MISSION & VISION
       ============================================== -->
  <section class="page-section section-mission" id="mission">
    <div class="content-container">
      <div class="section-header-block">
        <span class="section-kicker">02 — OUR MISSION & VISION</span>
        <h2 class="section-title-large">
          A practical mission.<br />
          <span class="serif-italic">A circular vision.</span>
        </h2>
      </div>

      <div class="cards-two-col-grid">
        <!-- Mission Card -->
        <div class="sage-card">
          <span class="card-kicker">OUR MISSION</span>
          <h3 class="card-headline">Make Better Packaging Accessible.</h3>
          <p class="card-copy">
            Make sustainable, legally compliant packaging durable, affordable,
            and accessible for Indian businesses. A factory-direct alternative
            to conventional polythene should fit seamlessly into existing supply
            chains.
          </p>
        </div>

        <!-- Vision Card -->
        <div class="sage-card">
          <span class="card-kicker">OUR VISION</span>
          <h3 class="card-headline">Choose Sustainable for a Better Tomorrow.</h3>
          <p class="card-copy">
            Accelerate the transition towards a circular economy with less
            single-use plastic. By combining local manufacturing agility with
            environmental standards, we help brands turn sustainability from an
            obligation into a business advantage.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==============================================
       SECTION 03: THE SCIENCE BEHIND CORN STARCH BAGS
       ============================================== -->
  <section class="page-section section-science" id="science">
    <div class="content-container">
      <div class="science-split-container">
        <!-- Left Panel: Light Sage -->
        <div class="science-left-panel">
          <span class="section-kicker">03 — THE SCIENCE BEHIND CORN STARCH BAGS</span>
          <h2 class="science-headline">
            Plant starch.<br />
            <span class="serif-italic">Purposeful Engineering.</span>
          </h2>

          <p class="science-para">
            Corn starch bags blend renewable plant-derived starch with compostable
            polymers such as PBAT. Unlike oxo-degradable plastics that fragment,
            certified compostable formulations are evaluated for biodegradation,
            disintegration, and compost safety.
          </p>

          <p class="science-para">
            Made from bagasse and PLA  plant-based fibers that fully decompose within 
            6 months of disposal. Zero petroleum, zero microplastics.


          </p>

          <div class="pills-tag-row">
            <span class="science-pill">Tensile strength</span>
            <span class="science-pill">Load-bearing capacity</span>
            <span class="science-pill">Puncture resistance</span>
            <span class="science-pill">Moisture protection</span>
          </div>
        </div>

        <!-- Right Panel: Deep Forest Green -->
        <div class="science-right-panel">
          <div class="science-panel-top">
            <svg class="science-leaf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
              <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
            </svg>
            <span class="timeline-kicker">UNDERSTANDING COMPOSTING TIMELINES</span>
          </div>

          <div class="stat-highlight-block">
            <div class="stat-large">60–180 <span class="stat-unit sarief-italic">days*</span></div>
            <p class="stat-caption">
              An indicative range requiring product-specific test evidence - not a
              guarantee for open soil, landfill, oceans, or home compost.
            </p>
          </div>

          <div class="science-panel-divider"></div>

        </div>
      </div>
    </div>
  </section>

  <!-- ==============================================
       SECTION 04: CERTIFICATIONS & REGULATORY COMPLIANCE
       ============================================== -->
  <section class="page-section section-certifications" id="certifications">
    <div class="content-container">
      <div class="section-header-block">
        <span class="section-kicker">04 — CERTIFIED QUALITY & REGULATORY COMPLIANCE</span>
        <h2 class="section-title-large">
          Confidence In Every Order.<br />
          <span class="sarief-italic">Clarity In Every Claim.</span>
        </h2>
        <p class="section-lead-muted">
          Each compostable product we create comes with verified lab reports, transparent material sourcing, 
          and government certifications - giving your business a fully compliant, 
          worry-free alternative to conventional plastic.
        </p>
      </div>

      <div class="cert-cards-grid">
        <!-- Card 01 -->
        <div class="cert-card">
          <div class="cert-card-top">
            <svg class="cert-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="M9 12l2 2 4-4"></path>
            </svg>
            <span class="cert-card-num">01</span>
          </div>
          <h3 class="cert-card-title">CPCB certification</h3>
          <p class="cert-card-desc">
            Approved By Government/CPCB Confirming “Compostable” Standards.
          </p>
        </div>

        <!-- Card 02 -->
        <div class="cert-card">
          <div class="cert-card-top">
            <svg class="cert-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
              <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
            </svg>
            <span class="cert-card-num">02</span>
          </div>
          <h3 class="cert-card-title">CIPET & IS/ISO 17088</h3>
          <p class="cert-card-desc">
            CIPET certified test reports and IS/ISO 17088
            compostability documentation to support procurement and compliance
            reviews.
          </p>
        </div>

        <!-- Card 03 -->
        <div class="cert-card">
          <div class="cert-card-top">
            <svg class="cert-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span class="cert-card-num">03</span>
          </div>
          <h3 class="cert-card-title">Global benchmarks</h3>
          <p class="cert-card-desc">
            EN 13432 and ASTM D6400 are internationally recognised compostability
            standards. Confirm which test evidence applies to each product.
          </p>
        </div>

        <!-- Card 04 -->
        <div class="cert-card">
          <div class="cert-card-top">
            <svg class="cert-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
            <span class="cert-card-num">04</span>
          </div>
          <h3 class="cert-card-title">Full traceability</h3>
          <p class="cert-card-desc">
            Applicable for CPCB compliance details, and
            supporting documentation help your team prepare for audits with
            confidence.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==============================================
       SECTION 05: SERVING KARNATAKA & BEYOND (ACCORDION)
       ============================================== -->
  <section class="page-section section-industries" id="industries">
    <div class="content-container">
      <div class="split-section-grid">
        <!-- Left: Intro -->
        <div class="section-heading-col">
          <span class="section-kicker">SERVING KARNATAKA & BEYOND</span>
          <h2 class="section-title-large">
            Different Businesses.<br />
            <span class="serif-italic">One shared planet.</span>
          </h2>
          <p class="section-lead-muted" style="margin-top: 1.25rem;">
            A neighbourhood shop in Mangaluru or a hospitality group in Udupi or an
            online brand in Bengaluru shipping across India - Packaging should fit
            the way you work.
          </p>
          <div class="section-link-wrapper" style="margin-top: 2rem;">
            <a href="/contact-us/" class="underlined-action-link">
              Find your solution
              <span class="action-icon">→</span>
            </a>
          </div>
        </div>

        <!-- Right: Accordion Items -->
        <div class="section-body-col">
          <div class="industries-accordion" id="industries-accordion">
            {
              industries.map((ind) => (
                <div class={`accordion-row ${ind.open ? "is-open" : ""}`} data-accordion-item>
                  <button class="accordion-trigger" type="button" aria-expanded={ind.open ? "true" : "false"}>
                    <span class="trigger-num">{ind.num}</span>
                    <span class="trigger-title">{ind.title}</span>
                    <span class="trigger-symbol">{ind.open ? "−" : "+"}</span>
                  </button>
                  <div class="accordion-panel" style={ind.open ? "display: block;" : "display: none;"}>
                    <p class="panel-text">{ind.content}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==============================================
       SECTION 06: WHY BUSINESSES PARTNER WITH SAKRT
       ============================================== -->
  <section class="page-section section-why-sakrt" id="why-sakrt">
    <div class="content-container">
      <div class="split-section-grid">
        <!-- Left: Heading -->
        <div class="section-heading-col">
          <span class="section-kicker">06 — WHY BUSINESSES PARTNER WITH SAKRT</span>
          <h2 class="section-title-large">
            Your Packaging.<br />
            Your Brand.<br />
            <span class="serif-italic">Our Commitment.</span>
          </h2>
          <p class="section-lead-muted" style="margin-top: 1.25rem;">
            A manufacturing partner should support your reputation and your bottom
            line. We work with procurement teams across South India to make the
            switch practical.
          </p>
        </div>

        <!-- Right: 2x2 Grid -->
        <div class="section-body-col">
          <div class="why-reasons-grid">
            <!-- 01 -->
            <div class="why-reason-item">
              <span class="reason-num">01</span>
              <h3 class="reason-headline">Factory-direct advantage</h3>
              <p class="reason-para">
                Local manufacturing in Kinnigoli, Mangalore reduces middlemen and
                supports competitive wholesale pricing and responsive dispatch
                across Karnataka.
              </p>
            </div>

            <!-- 02 -->
            <div class="why-reason-item">
              <span class="reason-num">02</span>
              <h3 class="reason-headline">Custom branding & specifications</h3>
              <p class="reason-para">
                Discuss flexible MOQs, custom sizes, GSM or micron thickness,
                gusset styles, and suitable ink printing to reflect your brand
                identity.
              </p>
            </div>

            <!-- 03 -->
            <div class="why-reason-item">
              <span class="reason-num">03</span>
              <h3 class="reason-headline">Scalable B2B fulfilment</h3>
              <p class="reason-para">
                From local retailers to national distributors, plan bulk volumes,
                inventory requirements, and delivery schedules with our team.
              </p>
            </div>

            <!-- 04 -->
            <div class="why-reason-item">
              <span class="reason-num">04</span>
              <h3 class="reason-headline">Dedicated account support</h3>
              <p class="reason-para">
                Get practical guidance on the right gauge, format, and compliance
                documents for your application and procurement process.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==============================================
       SECTION 07: LOCAL ROOTS. CIRCULAR THINKING.
       ============================================== -->
  <section class="page-section section-roots" id="roots">
    <div class="content-container">
      <div class="split-section-grid">
        <!-- Left: Story & Quote CTA -->
        <div class="section-heading-col">
          <span class="section-kicker">LOCAL ROOTS. CIRCULAR THINKING.</span>
          <h2 class="section-title-large">
            Best Compostable Product Dealer<br>
            <span class="serif-italic">In Mangaluru</span>
          </h2>

          <div class="roots-body-paragraphs">
            <p>
              Local manufacturing in Mangaluru keeps us close to customers and
              our supply chain. It supports factory-direct pricing, flexible
              minimum order quantities, and responsive turnaround for bulk and
              custom-branded orders.
            </p>
            <p>
              Our team works with B2B buyers, distributors, and institutions on
              consistent inventory, practical product selection, and certification
              documentation. Share your format, volume, and branding needs for a
              tailored quote.
            </p>
          </div>

          <div class="section-link-wrapper" style="margin-top: 2rem;">
            <a href="/contact-us/" class="underlined-action-link">
              Discuss a bulk or custom order
              <span class="action-icon">↗</span>
            </a>
          </div>
        </div>

        <!-- Right: Circular Vision Card -->
        <div class="section-body-col">
          <div class="circular-vision-card">
            <span class="card-kicker">OUR CIRCULAR VISION</span>
            <h3 class="vision-headline">
              A better ending starts<br />with a better system.
            </h3>
            <p class="vision-para">
              Compostable packaging only fulfils its purpose when it reaches an
              appropriate collection and composting system. Closing the loop
              means connecting production, responsible consumption, and renewal.
            </p>

            <div class="vision-steps-list">
              <div class="vision-step-item">
                <span class="step-badge">01</span>
                <div class="step-content">
                  <h4 class="step-title">Thoughtful production</h4>
