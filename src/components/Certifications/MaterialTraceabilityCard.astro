
---
// MaterialTraceabilityCard.astro
---

<div class="glass-card full-width-card">
  <!-- Left Side: Content & Steps -->
  <div class="content-side">
    <span class="card-tag">Process Engineering</span>
    <h2 class="card-title">Material Traceability</h2>
    <p class="card-description">
      From raw corn-starch extraction to the final product in your hand, every
      SAKRT item carries a digital fingerprint. We utilize a secure chain-of-custody
      model that ensures ethical sourcing and authentic compostability.
    </p>

    <!-- Numbered Steps -->
    <div class="steps-list">
      <div class="step-item">
        <span class="step-num">01</span>
        <div class="step-text">
          <h4 class="step-title">ETHICAL SOURCING</h4>
          <p class="step-desc">Certified agricultural non-GMO biomass procurement.</p>
        </div>
      </div>

      <div class="step-item">
        <span class="step-num">02</span>
        <div class="step-text">
          <h4 class="step-title">MOLECULAR ANALYSIS</h4>
          <p class="step-desc">Batch-level testing for polymer purity and density.</p>
        </div>
      </div>

      <div class="step-item">
        <span class="step-num">03</span>
        <div class="step-text">
          <h4 class="step-title">IMPACT TRACKING</h4>
          <p class="step-desc">LCA (Life Cycle Assessment) data generated per production run.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Right Side: Interactive QR Floating Card Graphics -->
  <div class="graphic-side">
    <!-- Concentric Target Radar Circles -->
    <div class="radar-circle circle-1"></div>
    <div class="radar-circle circle-2"></div>
    <div class="radar-circle circle-3"></div>

    <!-- Tilted QR Badge Card -->
    <div class="qr-floating-card">
      <div class="qr-box">
        <!-- Built-in SVG QR Code -->
        <svg class="qr-code" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 3h6v6H3V3zm2 2v2h2V5H5zm8-2h6v6h-6V3zm2 2v2h2V5h-2zM3 13h6v6H3v-6zm2 2v2h2v-2H5zm13-2h3v3h-3v-3zm-5 0h3v3h-3v-3zm0 5h3v3h-3v-3zm3-2h3v3h-3v-3z" fill="#0a2319"/>
        </svg>
      </div>
      <div class="qr-footer">
        <span class="qr-label">SCAN FOR TRACEABILITY DATA</span>
        <div class="lime-bar"></div>
      </div>
    </div>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Playfair+Display:ital,wght@0,400..700;1,400..700&family=Inter:wght@400;500&display=swap');

  .full-width-card {
    grid-column: 1 / -1; /* Spans across full width of parent grid */
    background: rgba(243, 245, 242, 0.65);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(197, 255, 73, 0.35); /* Subtle lime accent border */
    border-radius: 2rem;
    padding: 3.5rem;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 2rem;
    align-items: center;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
    box-shadow: 0 8px 32px 0 rgba(10, 35, 25, 0.03);
    margin-top: 1.5rem;
  }

  /* Left Side Styles */
  .content-side {
    max-width: 540px;
    z-index: 2;
  }

  .card-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    font-weight: 500;
    color: #597915;
    background: rgba(10, 35, 25, 0.04);
    display: inline-block;
    margin-bottom: 1rem;
    letter-spacing: 0.05em;
  }

  /* Matching the exact Serif Font Family from image_cbe639.png */
  .card-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2.75rem;
    font-weight: 400;
    color: #0a2319;
    margin: 0 0 1.25rem 0;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .card-description {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    line-height: 1.65;
    color: #4a5550;
    margin: 0 0 2.5rem 0;
  }

  /* Steps List */
  .steps-list {
    display: flex;
    flex-direction: column;
  }

  .step-item {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid rgba(10, 35, 25, 0.08);
  }

  .step-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .step-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.1rem;
    font-weight: 500;
    color: #b5c2ba;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .step-text {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .step-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.725rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #0a2319;
    margin: 0;
    text-transform: uppercase;
  }

  .step-desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    color: #55625c;
    margin: 0;
  }

  /* Right Side Graphics & 3D QR Floating Card */
  .graphic-side {
    position: relative;
    height: 100%;
    min-height: 360px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .radar-circle {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(10, 35, 25, 0.05);
    pointer-events: none;
  }

  .circle-1 { width: 220px; height: 220px; }
  .circle-2 { width: 340px; height: 340px; }
  .circle-3 { width: 460px; height: 460px; }

  /* Tilted QR Card Styling */
  .qr-floating-card {
    width: 200px;
    background: #ffffff;
    border-radius: 1.25rem;
    padding: 1.25rem;
    box-shadow: 0 20px 40px rgba(10, 35, 25, 0.08), 0 2px 6px rgba(0, 0, 0, 0.04);
    transform: rotate(5deg) translateY(-5px);
    transition: transform 0.4s ease;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .full-width-card:hover .qr-floating-card {
    transform: rotate(2deg) translateY(-10px);
  }

  .qr-box {
    width: 100%;
    aspect-ratio: 1;
    background: #f0f3ef;
    border-radius: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .qr-code {
    width: 60%;
    height: 60%;
  }

  .qr-footer {
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .qr-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #6a7870;
  }

  .lime-bar {
    width: 100%;
    height: 3px;
    background-color: #c5ff49;
    border-radius: 2px;
  }

  /* Mobile Responsiveness */
  @media (max-width: 900px) {
    .full-width-card {
      grid-template-columns: 1fr;
      padding: 2.25rem 1.75rem;
    }

    .graphic-side {
      min-height: 280px;
      margin-top: 1.5rem;
    }

    .card-title {
      font-size: 2.15rem;
    }
  }
</style>

