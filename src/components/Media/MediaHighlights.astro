---
// MediaHighlights.astro
import WorldEnvironmentCard from './WorldEnvironmentCard.astro';
import InstagramReelCard from './InstagramReelCard.astro';
---

<section class="media-index sk-section sk-section--band">
  <div class="sk-wrap media-index__grid" data-reveal-group>
    <div class="media-index__lead">
      <WorldEnvironmentCard />
    </div>

    <div class="media-index__aside">
      <InstagramReelCard />
    </div>
  </div>
</section>

<style>
  /* One lead story, one supporting item, split by a hairline instead of
     two competing card boxes of different heights. */
  .media-index__grid {
    display: grid;
    gap: var(--s-10);
  }

  .media-index__lead,
  .media-index__aside { min-width: 0; }

  .media-index__aside {
    border-top: 1px solid var(--hairline-strong);
    padding-top: var(--s-10);
  }

  @media (min-width: 960px) {
    .media-index__grid {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      column-gap: var(--s-12);
    }

    .media-index__aside {
      border-top: 0;
      padding-top: 0;
      border-left: 1px solid var(--hairline-strong);
      padding-left: var(--s-12);
    }
  }
</style>
