---
// SecondaryMediaSection.astro
import RecognitionCard from './RecognitionCard.astro';
import ImpactLocationCard from './ImpactLocationCard.astro';
---

<section class="secondary-media-section">
  <div class="cards-grid">
    <div class="left-col">
      <RecognitionCard />
    </div>
    <div class="right-col">
      <ImpactLocationCard />
    </div>
  </div>
</section>

<style>
  .secondary-media-section {
    width: 100%;
    max-width: 1340px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    box-sizing: border-box;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem;
    align-items: stretch;
  }

  @media (max-width: 1024px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>