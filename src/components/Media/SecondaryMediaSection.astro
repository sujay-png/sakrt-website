---
// SecondaryMediaSection.astro
import RecognitionCard from './RecognitionCard.astro';
import ImpactLocationCard from './ImpactLocationCard.astro';
---

<section class="secondary-media sk-section">
  <div class="sk-wrap secondary-media__grid" data-reveal-group>
    <div class="secondary-media__col">
      <RecognitionCard />
    </div>

    <div class="secondary-media__col secondary-media__col--ruled">
      <ImpactLocationCard />
    </div>
  </div>
</section>

<style>
  /* Two evenly proportioned tiles, ruled apart rather than boxed. */
  .secondary-media__grid {
    display: grid;
    gap: var(--s-10);
  }

  .secondary-media__col { min-width: 0; }

  .secondary-media__col--ruled {
    border-top: 1px solid var(--hairline-strong);
    padding-top: var(--s-10);
  }

  @media (min-width: 900px) {
    .secondary-media__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--s-12);
    }

    .secondary-media__col--ruled {
      border-top: 0;
      padding-top: 0;
      border-left: 1px solid var(--hairline-strong);
      padding-left: var(--s-12);
    }
  }
</style>
