---
// ImpactLocationCard.astro

export interface Props {
  title?: string;
  description?: string;
  mapImageSrc?: string;
  mapAlt?: string;
}

const {
  title = "Sustainable Impact in Mangalore",
  description = "Based in Mangalore, Karnataka, SAKRT features highlight the milestones that matter — from participation in World Environment Day celebrations to reducing plastic pollution across the state.",
  mapImageSrc = "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcT5dYnJ7iL5siLUsk1ajb-wfuupyqs1CugNycT7iGxxhHP0MNegNP0__qI&s",
  mapAlt = "Mangalore Location Map Graphic"
} = Astro.props;
---

<article class="impact">
  <div class="impact__body">
    <h2 class="impact__title">{title}</h2>
    <p class="impact__description">{description}</p>
  </div>

  <div class="impact__media sk-media">
    <img src={mapImageSrc} alt={mapAlt} class="impact__map" loading="lazy" />
  </div>
</article>

<style>
  /* Same ratio box as the tile beside it so the row reads evenly.
     The map is a graphic, not a photograph, so it is contained rather
     than cropped, on a pulp-deep field. */
  .impact {
    display: grid;
    gap: var(--s-6);
    align-content: start;
    height: 100%;
    min-width: 0;
  }

  .impact__media {
    grid-row: 1;
    --ar: 4 / 3;
    border: 1px solid var(--hairline);
    background: var(--pulp-deep);
  }

  .impact__map {
    object-fit: contain;
    padding: var(--s-6);
  }

  .impact__body {
    grid-row: 2;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .impact__title {
    margin: 0;
    max-width: 26ch;
    font-family: var(--font-display);
    font-weight: 400;
    font-synthesis-weight: none;
    font-size: var(--fs-h3);
    line-height: 1.16;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .impact__description {
    margin: 0;
    max-width: 50ch;
    font-size: var(--fs-sm);
    line-height: 1.7;
    color: var(--ink-soft);
  }
</style>
