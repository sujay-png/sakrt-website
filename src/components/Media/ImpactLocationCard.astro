---
// ImpactLocationCard.astro

export interface Props {
  title?: string;
  description?: string;
  mapImageSrc?: string;
  mapAlt?: string;
}

const {
  title = "Sustainable Impact in Mangalore",
  description = "Based in Mangalore, Karnataka, SAKRT features highlight the milestones that matter — from participation in World Environment Day celebrations to reducing plastic pollution across the state.",
  mapImageSrc = "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcT5dYnJ7iL5siLUsk1ajb-wfuupyqs1CugNycT7iGxxhHP0MNegNP0__qI&s",
  mapAlt = "Mangalore Location Map Graphic"
} = Astro.props;
---

<div class="impact-card">
  <div class="text-content">
    <h2 class="card-title">{title}</h2>
    <p class="card-description">{description}</p>
  </div>

  <div class="map-graphic-wrapper">
    <div class="map-circle">
      <img src={mapImageSrc} alt={mapAlt} class="map-image" loading="lazy" />
    </div>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600&family=Inter:wght@400;500&display=swap');

  .impact-card {
    background-color: #f7f9f6; /* Soft Off-White/Light Sage Tint */
    border-radius: 1.75rem;
    padding: 3.5rem 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 380px;
    box-sizing: border-box;
    border: 1px solid rgba(13, 43, 29, 0.04);
  }

  .text-content {
    flex: 1;
    max-width: 580px;
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 1.70rem;
    font-weight: 400;
    color: #0d2b1d;
    line-height: 1.25;
    margin: 0 0 1.25rem 0;
  }

  .card-description {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    line-height: 1.65;
    color: #4a5852;
    margin: 0;
  }

  /* Circular Badge with Soft Shadow */
  .map-graphic-wrapper {
    flex-shrink: 0;
  }

  .map-circle {
    width: 170px;
    height: 170px;
    border-radius: 50%;
    overflow: hidden;
    background: #ffffff;
    padding: 6px; /* White border inset ring */
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .map-image {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  @media (max-width: 860px) {
    .impact-card {
      flex-direction: column-reverse;
      text-align: left;
      align-items: flex-start;
      padding: 2.5rem 2rem;
    }

    .map-circle {
      width: 130px;
      height: 130px;
    }
  }
</style>