---
// MediaHero.astro
---

<header class="media-hero" id="media-hero">
  <div class="sk-wrap hero-inner">

    <!-- Masthead: folio label, headline, standfirst -->
    <div class="masthead" data-reveal>
      
      <div class="masthead__label sk-eyebrow">
        <span class="category-tag">MEDIA & IMPACT</span>
      </div>

      <h1 class="hero-title">
        Watch Our Latest Public<br />Appearance
      </h1>

      <div class="hero-standfirst">
        <p class="hero-lede">
          Stay connected with SAKRT's growing presence in India's sustainability movement. Our media page brings together the latest press coverage, public appearances, and recognitions celebrating our commitment to eco-friendly polythene bags. From industry events to state-level sustainability awards, SAKRT continues to be recognized as a trusted name in <a href="/blog/food-packaging/compostable-cutlery-the-sustainable-shift">compostable packaging</a> manufacturing.
        </p>
      </div>
    </div>

    <!-- Folio rule: the old glow layer, kept and reduced to a hairline -->
    <div class="hero-rule" id="media-glow"></div>

    <!-- Body copy set in ruled columns -->
    <div class="hero-columns" data-reveal-group>
      <p class="hero-para">
          Based in Mangalore, Karnataka, SAKRT proudly represents Envirly Innovations Pvt Ltd, delivering government-certified compostable bags, polythene bagsfilms, pouches, and tableware to retailers and industrial enterprises across India. Our media features highlight the milestones that matter — from participation in World Environment Day celebrations at ICAR-CPCRI to being honored at eco-awareness events for our contribution to reducing plastic pollution.
      </p>
      <p class="hero-para">
          Each feature reflects our core mission: helping businesses transition away from single-use plastics through certified, biodegradable alternatives that meet CPCB compliance standards. Whether it's a news article, a social media spotlight, or an award recognition, this page keeps you informed about SAKRT's expanding impact in sustainable packaging.
      </p>
      <p class="hero-para">
          Follow our journey as we continue building partnerships with businesses ready to make the switch to eco-friendly solutions. Explore our latest media coverage below, and connect with us to learn how SAKRT's compostable products can support your sustainability&nbsp;goals.
      </p>
    </div>
  </div>
</header>

<style>
  /* Media masthead, set like the front page of a press index:
     folio label, one display headline, a standfirst, a hairline,
     then the body copy in ruled columns. No glow, no centred prose. */
  .media-hero {
    position: relative;
    background: var(--pulp);
    padding-top: clamp(104px, 14vh, 140px);
    padding-bottom: var(--section-y);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
  }

  /* ---------- Masthead ---------- */
  .masthead {
    display: grid;
    gap: var(--s-6);
    justify-items: start;
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-synthesis-weight: none;
    font-size: var(--fs-h1);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  .hero-standfirst { max-width: 64ch; }

  .hero-lede {
    margin: 0;
    font-size: var(--fs-lede);
    line-height: 1.7;
    color: var(--ink-soft);
  }

  /* Hairlines do the structural work instead of boxes. */
  .hero-rule {
    height: 1px;
    background: var(--hairline-strong);
  }

  /* ---------- Ruled prose columns ---------- */
  .hero-columns {
    display: grid;
    gap: var(--s-8);
  }

  .hero-para {
    margin: 0;
    max-width: 62ch;
    font-size: var(--fs-body);
    line-height: 1.7;
    color: var(--ink-soft);
    overflow-wrap: break-word;
  }

  .hero-standfirst a,
  .hero-para a {
    color: var(--brand);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--hairline-strong);
    text-underline-offset: 4px;
    transition: color var(--dur-1) var(--ease-out),
                text-decoration-color var(--dur-1) var(--ease-out);
  }

  @media (hover: hover) {
    .hero-standfirst a:hover,
    .hero-para a:hover {
      color: var(--ink);
      text-decoration-color: var(--lime-ink);
    }
  }

  @media (min-width: 780px) {
    .hero-standfirst {
      padding-left: var(--s-8);
      border-left: 1px solid var(--hairline);
    }

    .hero-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--s-12);
    }

    .hero-columns > .hero-para:last-child { grid-column: 1 / -1; }
  }

  @media (min-width: 920px) {
    .hero-inner { gap: var(--s-12); }
    .masthead { gap: var(--s-8); }
  }

  @media (min-width: 1080px) {
    .hero-columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--s-10);
    }

    .hero-columns > .hero-para:last-child { grid-column: auto; }
  }
</style>
