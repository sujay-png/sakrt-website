---
// MediaHero.astro
---

<header class="media-hero-section" id="media-hero">
  <!-- Interactive Ambient Spotlight Backdrop -->
  <div class="ambient-glow" id="media-glow"></div>

  <!-- Hero Main Content -->
  <div class="hero-container">
    <div class="hero-content">
      
      <!-- Tag / Category Header with Pulsing Dot -->
      <div class="tag-wrapper animate-item">
        <span class="pulsing-emerald"></span>
        <span class="category-tag">MEDIA & IMPACT</span>
        <span class="tag-line"></span>
      </div>

      <!-- Main Headline (Clipped Line Reveal) -->
      <div class="title-mask">
        <h1 class="hero-title animate-title">
          Watch Our Latest Public<br />Appearance
        </h1>
      </div>

      <!-- Description Paragraphs (Staggered Blur & Fade-Up) -->
      <div class="hero-description">
        <p class="animate-para" style="--delay: 0.15s">
          Stay connected with SAKRT's growing presence in India's sustainability movement. Our media page brings together the latest press coverage, public appearances, and recognitions celebrating our commitment to eco-friendly polythene bags. From industry events to state-level sustainability awards, SAKRT continues to be recognized as a trusted name in <a href="/blog/food-packaging/compostable-cutlery-the-sustainable-shift">compostable packaging</a> manufacturing.
        </p>
        <p class="animate-para" style="--delay: 0.28s">
          Based in Mangalore, Karnataka, SAKRT proudly represents Envirly Innovations Pvt Ltd, delivering government-certified compostable bags, polythene bagsfilms, pouches, and tableware to retailers and industrial enterprises across India. Our media features highlight the milestones that matter — from participation in World Environment Day celebrations at ICAR-CPCRI to being honored at eco-awareness events for our contribution to reducing plastic pollution.
        </p>
        <p class="animate-para" style="--delay: 0.40s">
          Each feature reflects our core mission: helping businesses transition away from single-use plastics through certified, biodegradable alternatives that meet CPCB compliance standards. Whether it's a news article, a social media spotlight, or an award recognition, this page keeps you informed about SAKRT's expanding impact in sustainable packaging.
        </p>
        <p class="animate-para" style="--delay: 0.52s">
          Follow our journey as we continue building partnerships with businesses ready to make the switch to eco-friendly solutions. Explore our latest media coverage below, and connect with us to learn how SAKRT's compostable products can support your sustainability&nbsp;goals.
        </p>
      </div>

    </div>
  </div>
</header>

<style>
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Playfair+Display:ital,wght@0,400..700;1,400..700&family=Inter:wght@400;500;600&display=swap');

  :root {
    --ease-spring: cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Container Setup */
  .media-hero-section {
    position: relative;
    width: 100%;
    padding: 120px 3rem 5rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
  }

  /* Interactive Cursor Spotlight Background */
  .ambient-glow {
    position: absolute;
    width: 650px;
    height: 650px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(197, 255, 73, 0.15) 0%, rgba(255, 255, 255, 0) 70%);
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: left 0.15s ease-out, top 0.15s ease-out;
    z-index: 1;
  }

  /* --- Navbar Styles --- */
  .navbar {
    width: 100%;
    max-width: 1240px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0;
    margin-bottom: 5rem;
    position: relative;
    z-index: 2;
  }

  .logo a {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 400;
    color: #0a2319;
    text-decoration: none;
    letter-spacing: 0.12em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    color: #4a5550;
    text-decoration: none;
    transition: color 0.2s ease;
    padding-bottom: 4px;
    position: relative;
  }

  .nav-links a:hover {
    color: #0a2319;
  }

  /* Lime Underline for Active Menu item */
  .nav-links a.active {
    color: #0a2319;
    font-weight: 500;
  }

  .nav-links a.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: #c5ff49;
    border-radius: 2px;
  }

  .btn-inquire {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    background-color: #0a2319;
    color: #ffffff;
    padding: 0.6rem 1.6rem;
    border-radius: 2rem;
    text-decoration: none;
    transition: background-color 0.25s ease, transform 0.25s var(--ease-spring);
  }

  .btn-inquire:hover {
    background-color: #12382a;
    transform: translateY(-2px);
  }

  /* --- Hero Body Styles --- */
  .hero-container {
    width: 100%;
    max-width: 1240px;
    display: flex;
    justify-content: center;
    position: relative;
    z-index: 2;
  }

  .hero-content {
    max-width: 1000px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Tag Line */
  .tag-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .pulsing-emerald {
    width: 7px;
    height: 7px;
    background-color: #3b8c66;
    border-radius: 50%;
    box-shadow: 0 0 10px #3b8c66;
    animation: emeraldPulse 2s infinite ease-in-out;
  }

  @keyframes emeraldPulse {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.4); }
  }

  .category-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    color: #55625c;
    text-transform: uppercase;
  }

  .tag-line {
    width: 32px;
    height: 1px;
    background-color: #b0bab4;
  }

  /* Title Mask Reveal */
  .title-mask {
    overflow: hidden;
    margin-bottom: 1.75rem;
  }

  .hero-title {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: 2.98rem;
    font-weight: 400;
    line-height: 1.12;
    color: #0a2319;
    margin: 0;
    letter-spacing: -0.02em;
    text-align: center;
    transform: translateY(110%);
    opacity: 0;
    transition: transform 0.9s var(--ease-spring), opacity 0.9s var(--ease-spring);
  }

  .media-hero-section.is-visible .hero-title {
    transform: translateY(0);
    opacity: 1;
  }

  /* Paragraph Staggering */
  .hero-description {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    line-height: 1.8;
    color: #4a5550;
    max-width: 100%;
    text-align: center;
    margin: 0 0 3rem 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  
  .hero-description p {
    margin: 0;
    opacity: 0;
    filter: blur(8px);
    transform: translateY(20px);
    transition: 
      opacity 0.8s var(--ease-spring) var(--delay, 0s),
      filter 0.8s var(--ease-spring) var(--delay, 0s),
      transform 0.8s var(--ease-spring) var(--delay, 0s);
  }

  .media-hero-section.is-visible .hero-description p {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
  }

  /* Link Hover Interactions */
  .hero-description a {
    color: #3b8c66;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgba(59, 140, 102, 0.4);
    text-underline-offset: 4px;
    transition: text-decoration-color 0.25s ease, color 0.25s ease;
  }

  .hero-description a:hover {
    color: #0a2319;
    text-decoration-color: rgba(10, 35, 25, 1);
  }

  /* Responsive Queries */
  @media (max-width: 900px) {
    .media-hero-section {
      padding: 120px 1.5rem 3rem;
    }

    .nav-links {
      display: none;
    }

    .hero-title {
      font-size: 2.5rem;
    }
  }

  @media (max-width: 480px) {
    .hero-title {
      font-size: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-description p {
      opacity: 1 !important;
      filter: none !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  function initMediaHeroAnimation() {
    const section = document.getElementById('media-hero');
    const glow = document.getElementById('media-glow');

    if (!section) return;

    // 1. Interactive Mouse Spotlight Tracking
    if (glow) {
      section.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = section.getBoundingClientRect();
        glow.style.left = `${e.clientX - rect.left}px`;
        glow.style.top = `${e.clientY - rect.top}px`;
      });
    }

    // 2. IntersectionObserver Trigger for Entrance
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    observer.observe(section);
  }

  document.addEventListener('DOMContentLoaded', initMediaHeroAnimation);
  document.addEventListener('astro:page-load', initMediaHeroAnimation);
</script>