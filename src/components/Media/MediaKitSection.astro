---
// MediaKitSection.astro

export interface KitItem {
  iconType: 'identity' | 'paper' | 'gallery';
  title: string;
  description: string;
  actionText: string;
  actionUrl: string;
  isExternal?: boolean;
}

const defaultItems: KitItem[] = [
  {
    iconType: 'identity',
    title: 'Visual Identity',
    description: 'Official logos, color codes, and brand guidelines for publication.',
    actionText: 'DOWNLOAD ASSETS',
    actionUrl: '/assets/sakrt-brand-assets.zip',
    isExternal: false
  },
  {
    iconType: 'paper',
    title: 'Technical Whitepapers',
    description: 'Detailed certifications and compliance standards for compostable products.',
    actionText: 'DOWNLOAD PDF',
    actionUrl: '/docs/technical-whitepaper.pdf',
    isExternal: false
  },
  {
    iconType: 'gallery',
    title: 'Image Bank',
    description: 'High-resolution photography of our manufacturing process and materials.',
    actionText: 'BROWSE GALLERY',
    actionUrl: '/gallery',
    isExternal: true
  }
];

const {
  sectionTitle = "Media Kit",
  subtitle = "Clinical precision for press and partners.",
  version = "VER 2.0 / 2026",
  items = defaultItems
} = Astro.props;
---

<section class="media-kit sk-section">
  <div class="sk-wrap">
    <!-- Section Header -->
    <div class="section-header" data-reveal>
      <div class="header-text">
        <h2 class="title">{sectionTitle}</h2>
        <p class="subtitle">{subtitle}</p>
      </div>
      <span class="version-tag">{version}</span>
    </div>

    <hr class="header-divider" />

    <!-- 3-Column Cards Grid -->
    <div class="cards-grid" data-reveal-group>
      {items.map((item: KitItem) => (
        <div class="kit-card">
          <div class="card-top">
            <!-- Custom SVG Icon Header -->
            <div class="icon-wrapper">
              {item.iconType === 'identity' && (
                <svg class="kit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                  <path d="M12 3v3m0 12v3M3 12h3m12 0h3" stroke-linecap="round"/>
                  <circle cx="12" cy="12" r="5" stroke-linecap="round"/>
                  <path d="M18.364 5.636l-2.122 2.122M7.757 16.243l-2.12 2.12" stroke-linecap="round"/>
                </svg>
              )}

              {item.iconType === 'paper' && (
                <svg class="kit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}

              {item.iconType === 'gallery' && (
                <svg class="kit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                  <rect x="3" y="3" width="18" height="18" rx="2" stroke-linecap="round" stroke-linejoin="round"/>
                  <circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/>
                  <path d="M21 15l-5-5L5 21" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
            </div>

            <h3 class="card-title">{item.title}</h3>
            <p class="card-description">{item.description}</p>
          </div>

          <!-- Card Action Link Footer -->
          <a 
            href={item.actionUrl} 
            target={item.isExternal ? "_blank" : "_self"} 
            rel={item.isExternal ? "noopener noreferrer" : ""} 
            class="action-link"
          >
            <span>{item.actionText}</span>

            {item.isExternal ? (
              /* External Link Icon */
              <svg class="action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            ) : (
              /* Download Icon */
              <svg class="action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            )}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Press kit set as a register: ruled columns, mono labels, no card boxes. */
  .section-header {
    display: grid;
    gap: var(--s-3);
    align-items: end;
  }

  .header-text {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-synthesis-weight: none;
    font-size: var(--fs-h2);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .subtitle {
    margin: 0;
    max-width: 52ch;
    font-size: var(--fs-lede);
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .version-tag {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .header-divider {
    border: 0;
    height: 1px;
    background: var(--hairline-strong);
    margin: var(--s-8) 0 0;
  }

  .cards-grid {
    display: grid;
  }

  .kit-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--s-8);
    padding-block: var(--s-8);
    border-top: 1px solid var(--hairline);
    min-width: 0;
  }

  .kit-card:first-child { border-top: 0; }

  .card-top {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .icon-wrapper {
    color: var(--ink);
    line-height: 0;
  }

  .kit-icon {
    width: 26px;
    height: 26px;
  }

  .card-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-synthesis-weight: none;
    font-size: var(--fs-h3);
    line-height: 1.16;
    color: var(--ink);
  }

  .card-description {
    margin: 0;
    max-width: 44ch;
    font-size: var(--fs-sm);
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .action-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--hairline-strong);
    text-underline-offset: 5px;
    overflow-wrap: anywhere;
    transition: color var(--dur-1) var(--ease-out),
                text-decoration-color var(--dur-1) var(--ease-out);
  }

  .action-icon {
    width: 15px;
    height: 15px;
    flex: none;
  }

  @media (hover: hover) {
    .action-link:hover {
      color: var(--brand);
      text-decoration-color: var(--brand);
    }
  }

  @media (min-width: 860px) {
    .section-header { grid-template-columns: 1fr auto; }

    .cards-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }

    .kit-card {
      border-top: 0;
      padding-block: var(--s-10) 0;
      padding-inline: var(--s-6);
    }

    .kit-card:first-child { padding-left: 0; }
    .kit-card:last-child { padding-right: 0; }
    .kit-card + .kit-card { border-left: 1px solid var(--hairline); }
  }
</style>
