---
// RecognitionCard.astro

export interface Props {
  tag?: string;
  title?: string;
  description?: string;
  buttonText?: string;
  buttonLink?: string;
}

const {
  tag = "RECOGNITION",
  title = "SAKRT Wins Public Praise for Commitment to Eco-Friendly Innovation",
  description = "Helping businesses transition away from single-use plastics through certified, biodegradable alternatives that meet CPCB compliance standards.",
  buttonText = "View Public Recognition",
  buttonLink = "https://www.instagram.com/reel/DTrm_4QgLCf/?utm_source=ig_web_copy_link&igsh=MzRlODBiNWFlZA=="
} = Astro.props;
---

<article class="recognition">
  <div class="recognition__media sk-media">
    <div class="recognition__image"></div>
  </div>

  <div class="recognition__body">
    <div class="recognition__meta">
      <span class="card-tag">{tag}</span>
    </div>

    <h2 class="recognition__title">{title}</h2>

    <p class="recognition__text">{description}</p>

    <a href={buttonLink} target="_blank" rel="noopener noreferrer" class="recognition__cta sk-btn sk-btn--ghost">
      <span class="btn-text">{buttonText}</span>
      <span class="btn-icon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </span>
    </a>
  </div>
</article>

<style>
  /* Recognition tile. Previously white type over a photo with an animated
     lime glow border and a frosted button; now a fixed-ratio image and the
     story set on pulp, matching the tile beside it. */
  .recognition {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
    height: 100%;
    min-width: 0;
  }

  .recognition__media {
    --ar: 4 / 3;
    border: 1px solid var(--hairline);
  }

  .recognition__image {
    position: absolute;
    inset: 0;
    background-image: url('/media/event-win.jpg');
    background-size: cover;
    background-position: center;
    transition: transform 1.1s var(--ease-settle);
  }

  .recognition__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-4);
    flex: 1;
  }

  .recognition__meta {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .recognition__title {
    margin: 0;
    max-width: 26ch;
    font-family: var(--font-display);
    font-weight: 400;
    font-synthesis-weight: none;
    font-size: var(--fs-h3);
    line-height: 1.16;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .recognition__text {
    margin: 0;
    max-width: 50ch;
    font-size: var(--fs-sm);
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .recognition__cta {
    margin-top: auto;
    padding-inline: 22px;
  }

  .btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--dur-1) var(--ease-out);
  }

  @media (hover: hover) {
    .recognition:hover .recognition__image { transform: scale(1.045); }
    .recognition__cta:hover .btn-icon { transform: translateX(3px); }
  }
</style>
