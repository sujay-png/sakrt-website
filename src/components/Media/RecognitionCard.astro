---
// RecognitionCard.astro

export interface Props {
  tag?: string;
  title?: string;
  description?: string;
  buttonText?: string;
  buttonLink?: string;
}

const {
  tag = "RECOGNITION",
  title = "SAKRT Wins Public Praise for Commitment to Eco-Friendly Innovation",
  description = "Helping businesses transition away from single-use plastics through certified, biodegradable alternatives that meet CPCB compliance standards.",
  buttonText = "View Public Recognition",
  buttonLink = "/blogs"
} = Astro.props;
---

<div class="recognition-card">
  <div class="card-content">
    <span class="card-tag">{tag}</span>
    <h2 class="card-title">{title}</h2>
    <p class="card-description">{description}</p>
  </div>

  <a href={buttonLink} class="outlined-btn">
    {buttonText}
  </a>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@600&family=Playfair+Display:wght@500;600&family=Inter:wght@400;500&display=swap');

  .recognition-card {
    background-color: #0d2b1d;
    border-radius: 1.75rem;
    padding: 4rem 2.8rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 380px;
    box-sizing: border-box;
  }

  .card-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    font-weight: 600;
    color: #c5ff49; /* Bright Lime Accent */
    letter-spacing: 0.15em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 1.25rem;
  }

  .card-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2.125rem;
    font-weight: 500;
    color: #ffffff;
    line-height: 1.2;
    margin: 0 0 1.5rem 0;
  }

  .card-description {
    font-family: 'Inter', sans-serif;
    font-size: 0.925rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.75);
    margin: 0 0 2rem 0;
  }

  .outlined-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.95rem 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 0.75rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    color: #ffffff;
    text-decoration: none;
    transition: all 0.25s ease;
    box-sizing: border-box;
  }

  .outlined-btn:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 640px) {
    .recognition-card {
      padding: 2rem 1.5rem;
      min-height: auto;
    }

    .card-title {
      font-size: 1.65rem;
    }
  }
</style>