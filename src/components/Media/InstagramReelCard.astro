---
// YouTubeCard.astro

export interface Props {
  tag?: string;
  title?: string;
  videoThumbnail?: string;
  youtubeUrl?: string;
}

const {
  tag = "YOUTUBE VIDEO",
  title = "SAKRT Honored at State-Level Eco Awareness Event",
  videoThumbnail = "src/images/choose-sustainable.webp",
  youtubeUrl = "https://youtu.be/A6YEPwwKUEk"
} = Astro.props;
---

<div class="video-card">
  <span class="card-tag">{tag}</span>

  <h3 class="card-title">{title}</h3>

  <!-- Video Thumbnail with Play Button Overlay -->
  <a href={youtubeUrl} target="_blank" rel="noopener noreferrer" class="thumbnail-wrapper" aria-label="Watch on YouTube">
    <img src={videoThumbnail} alt={title} class="thumbnail-img" loading="lazy" />
    <div class="play-button">
      <svg class="play-icon" viewBox="0 0 24 24" fill="currentColor">
        <path d="M8 5v14l11-7z"/>
      </svg>
    </div>
  </a>

  <!-- Footer Link -->
  <a href={youtubeUrl} target="_blank" rel="noopener noreferrer" class="video-footer-link">
    <span>WATCH ON YOUTUBE</span>
    <svg class="external-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600&family=Playfair+Display:wght@500;600&display=swap');

  .video-card {
    background: #f1f4f0; /* Soft tint card background */
    border-radius: 1.75rem;
    padding: 2.25rem 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    box-sizing: border-box;
    border: 1px solid rgba(10, 35, 25, 0.05);
  }

  .card-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.725rem;
    font-weight: 500;
    color: #6a7870;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.85rem;
    display: block;
  }

  .card-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 500;
    color: #0a2319;
    line-height: 1.25;
    margin: 0 0 1.75rem 0;
  }

  .thumbnail-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 1rem;
    overflow: hidden;
    display: block;
    margin-bottom: 2rem;
  }

  .thumbnail-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .thumbnail-wrapper:hover .thumbnail-img {
    transform: scale(1.04);
  }

  /* Floating Play Button */
  .play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 52px;
    height: 52px;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
    transition: all 0.3s ease;
  }

  .thumbnail-wrapper:hover .play-button {
    background: #0a2319;
    color: #ffffff;
    transform: translate(-50%, -50%) scale(1.1);
  }

  .play-icon {
    width: 22px;
    height: 22px;
    color: #0a2319;
    margin-left: 3px; /* Visual center adjustment */
    transition: color 0.3s ease;
  }

  .thumbnail-wrapper:hover .play-icon {
    color: #ffffff;
  }

  /* Bottom External Link */
  .video-footer-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.725rem;
    font-weight: 600;
    color: #4a5550;
    letter-spacing: 0.12em;
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .video-footer-link:hover {
    color: #0a2319;
  }

  .external-icon {
    width: 16px;
    height: 16px;
  }
</style>