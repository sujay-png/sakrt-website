---
// YouTubeCard.astro

export interface Props {
  tag?: string;
  title?: string;
  videoThumbnail?: string;
  youtubeUrl?: string;
}

const {
  tag = "YOUTUBE VIDEO",
  title = "SAKRT Honored at State-Level Eco Awareness Event",
  videoThumbnail = "src/images/choose-sustainable.webp",
  youtubeUrl = "https://youtu.be/A6YEPwwKUEk"
} = Astro.props;
---

<article class="reel">
  <span class="reel__tag">{tag}</span>

  <h3 class="reel__title">{title}</h3>

  <!-- Embedded YouTube Video -->
  <div class="reel__frame">
    <iframe width="100%" height="100%" src="https://www.youtube.com/embed/A6YEPwwKUEk?si=3zK_01SnUWebn2Wb" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
  </div>

  <!-- Footer Link -->
  <a href={youtubeUrl} target="_blank" rel="noopener noreferrer" class="reel__link">
    <span>WATCH ON YOUTUBE</span>
    <svg class="external-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>
</article>

<style>
  /* Second item in the index. No card box: the hairline in the parent
     grid separates it from the lead story. */
  .reel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-4);
    min-width: 0;
  }

  .reel__tag {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .reel__title {
    margin: 0;
    max-width: 30ch;
    font-family: var(--font-display);
    font-weight: 400;
    font-synthesis-weight: none;
    font-size: var(--fs-h3);
    line-height: 1.16;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  /* Responsive embed: ratio box, never a fixed pixel height */
  .reel__frame {
    position: relative;
    width: 100%;
    max-width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    background: var(--ink);
  }

  .reel__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .reel__link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--hairline-strong);
    text-underline-offset: 5px;
    overflow-wrap: anywhere;
    transition: color var(--dur-1) var(--ease-out),
                text-decoration-color var(--dur-1) var(--ease-out);
  }

  .external-icon {
    width: 15px;
    height: 15px;
    flex: none;
  }

  @media (hover: hover) {
    .reel__link:hover {
      color: var(--brand);
      text-decoration-color: var(--brand);
    }
  }
</style>
