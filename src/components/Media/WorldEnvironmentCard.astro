---
// WorldEnvironmentCard.astro

export interface Props {
  tag?: string;
  date?: string;
  title?: string;
  description?: string;
  imageSrc?: string;
  readMoreLink?: string;
}

const {
  tag = "NEWS UPDATE",
  date = "05.06.2026",
  title = "WORLD ENVIRONMENT DAY 2026 Celebration at ICAR-CPCRI",
  description = "SAKRT proudly represents Envirly Innovations Pvt Ltd, delivering government-certified compostable solutions across India.",
  imageSrc = "/media/world-env-day.webp",
  readMoreLink = "https://www.facebook.com/cpcrikasaragod.kerala/posts/pfbid02iupD8AKPYjbpddwPacdMP72a8SxWYj4j2gosz77ZZNhFjWgf8TGueQoaCNDUGdRRl?rdid=3kXyGqdVH2zgoX6v#"
} = Astro.props;
---

<article class="lead">
  <!-- Lead image in a fixed-ratio box so the index never runs ragged -->
  <div class="lead__media sk-media">
    <img src={imageSrc} alt={title} class="lead__image" loading="lazy" />
  </div>

  <div class="lead__body">
    <div class="lead__meta">
      <span class="tag-text">{tag}</span>
      <span class="tag-divider">—</span>
      <span class="tag-date">{date}</span>
    </div>

    <h2 class="lead__title">{title}</h2>

    <p class="lead__standfirst">{description}</p>

    <a href={readMoreLink} target="_blank" rel="noopener noreferrer" class="lead__link">
      <span>Read Full Story</span>
      <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</article>

<style>
  /* Lead item of the press index. The old version stacked white type over
     a photo behind a gradient scrim; the type is now on pulp where it is
     legible, and the photo sits in a fixed 16/9 box. */
  .lead {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
    min-width: 0;
  }

  .lead__media {
    --ar: 16 / 9;
    border: 1px solid var(--hairline);
  }

  .lead__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-4);
  }

  /* Publication label and date in mono, with the section's single lime mark */
  .lead__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .lead__meta::before {
    content: '';
    width: 26px;
    height: 3px;
    flex: none;
    background: var(--lime);
    border-radius: var(--r-pill);
  }

  .tag-divider { color: var(--hairline-strong); }
  .tag-date { color: var(--ink); }

  .lead__title {
    margin: 0;
    max-width: 26ch;
    font-family: var(--font-display);
    font-weight: 400;
    font-synthesis-weight: none;
    font-size: var(--fs-h2);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ink);
    overflow-wrap: break-word;
  }

  .lead__standfirst {
    margin: 0;
    max-width: 56ch;
    font-size: var(--fs-lede);
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .lead__link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--hairline-strong);
    text-underline-offset: 5px;
    transition: color var(--dur-1) var(--ease-out),
                text-decoration-color var(--dur-1) var(--ease-out);
  }

  .arrow-icon {
    width: 18px;
    height: 18px;
    flex: none;
    transition: transform var(--dur-1) var(--ease-out);
  }

  @media (hover: hover) {
    .lead:hover .lead__image { transform: scale(1.04); }

    .lead__link:hover {
      color: var(--brand);
      text-decoration-color: var(--brand);
    }

    .lead__link:hover .arrow-icon { transform: translateX(4px); }
  }
</style>
