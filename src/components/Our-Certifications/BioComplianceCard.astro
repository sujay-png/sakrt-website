---
// BioComplianceCard.astro
---

<div class="dark-card bio-card cert-preview-trigger" data-cert-url="/certificates/global.pdf" data-cert-type="pdf" data-reveal style="--i: 3">
  <div class="card-top">
    <h3 class="card-title">CIPET Lab Test Report</h3>
  </div>

  <div class="standards-grid">
    <div class="standard-item">
      <span class="standard-label">MATERIAL ID</span>
      <span class="standard-val">PLA & PBAT</span>
    </div>

    <div class="standard-item">
      <span class="standard-label">FILLER CONTENT</span>
      <span class="standard-val">42.94%</span>
    </div>
  </div>

  <!-- Decorative Leaf Background Watermark -->
  <div class="leaf-watermark">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" fill="currentColor">
      <path d="M100 20C40 20 20 80 20 180c100 0 160-20 160-80S160 20 100 20zm0 140C60 160 40 120 40 80c40 0 80 20 80 60 0 13.33-6.67 20-20 20z" opacity="0.08"/>
    </svg>
  </div>
</div>

<style>
  .dark-card {
    background-color: var(--brand);
    border: 1px solid var(--brand);
    border-radius: var(--r-lg);
    padding: clamp(1.75rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
    height: 100%;
    min-height: 200px;
    cursor: pointer;
    transition: transform var(--dur-2) var(--ease-settle),
                box-shadow var(--dur-2) var(--ease-settle);
  }

  @media (hover: hover) {
    .dark-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-3);
    }
  }

  .card-top {
    position: relative;
    z-index: 2;
    margin-bottom: var(--s-8);
  }

  /* The single lime moment of the section — a serif title as a seal. */
  .card-title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 400;
    font-synthesis-weight: none;
    line-height: 1.15;
    color: var(--lime);
    margin: 0;
  }

  .standards-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-6);
    position: relative;
    z-index: 2;
  }

  .standard-item {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .standard-label {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 400;
    letter-spacing: 0.12em;
    color: var(--on-dark-muted);
  }

  .standard-val {
    font-family: var(--font-mono);
    font-size: var(--fs-h4);
    font-weight: 700;
    color: var(--on-dark);
    letter-spacing: 0.02em;
  }

  /* Bottom-Right Leaf Watermark */
  .leaf-watermark {
    position: absolute;
    bottom: -30px;
    right: -30px;
    width: 220px;
    height: 220px;
    color: var(--on-dark);
    pointer-events: none;
    z-index: 1;
  }

  @media (max-width: 480px) {
    .standards-grid {
      grid-template-columns: 1fr;
      gap: var(--s-5);
    }
  }
</style>
