---
// CipetCard.astro
import cipetSeal from "../../images/cipet-seal.png";
---

<div class="cert-card cipet-card cert-preview-trigger" data-cert-url="/certificates/CIPET.webp" data-cert-type="image" data-reveal style="--i: 2">
  <div class="card-content">
    <div class="image-wrapper">
      <!-- Replace src with your actual seal image path -->
      <img
        src={cipetSeal.src}
        alt="CIPET Validation Stamp"
        class="seal-image"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
      <!-- Fallback placeholder if image is missing -->
      <div class="seal-placeholder" style="display: none;">
        <span>BOTANICAL<br/>STAMP</span>
      </div>
    </div>

    <div class="text-group">
      <h3 class="card-title">CIPET-Tested for Complete Biodegradation</h3>
      <p class="card-text">
        Independently tested at the Central Institute of Petrochemicals Engineering & Technology (CIPET) for full biodegradation and disintegration under industrial composting conditions — proof that SAKRT products break down safely, not just claim to.
      </p>
    </div>
  </div>
</div>

<style>
  .cert-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-1);
    padding: clamp(1.75rem, 3vw, 2.5rem);
    display: flex;
    align-items: center;
    box-sizing: border-box;
    height: 100%;
    cursor: pointer;
    transition: transform var(--dur-2) var(--ease-settle),
                box-shadow var(--dur-2) var(--ease-settle),
                border-color var(--dur-2) var(--ease-settle);
  }

  @media (hover: hover) {
    .cert-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-2);
      border-color: var(--hairline-strong);
    }
  }

  .card-content {
    display: flex;
    align-items: center;
    gap: var(--s-6);
  }

  .image-wrapper {
    width: 112px;
    height: 112px;
    flex-shrink: 0;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--pulp-deep);
    border: 1px solid var(--hairline);
  }

  .seal-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .seal-placeholder {
    width: 100%;
    height: 100%;
    background: var(--pulp-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.3;
    color: var(--ink-muted);
  }

  .text-group {
    display: flex;
    flex-direction: column;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 400;
    font-synthesis-weight: none;
    line-height: 1.15;
    color: var(--ink);
    margin: 0 0 var(--s-3) 0;
  }

  .card-text {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    line-height: 1.65;
    color: var(--ink-soft);
    margin: 0;
  }

  @media (max-width: 520px) {
    .card-content {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-5);
    }
  }
</style>
