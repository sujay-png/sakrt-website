---
// IsoCard.astro
---

<div class="cert-card cert-preview-trigger" data-cert-url="/certificates/ISO.webp" data-cert-type="image" data-reveal style="--i: 1">
  <div class="card-top">
    <div class="card-header">
      <div class="dark-icon-badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="5" r="2"/>
          <path d="m3 21 7.5-13"/>
          <path d="m21 21-7.5-13"/>
          <path d="M7 16h10"/>
        </svg>
      </div>
    </div>

    <h3 class="card-title">ISO-Certified Manufacturing Standards</h3>

    <ul class="iso-list">
      <li>
        <span class="bullet-dot"></span>
        <span class="iso-code">ISO 14001:2015 — Environmental Management System</span>
      </li>
      <li>
        <span class="bullet-dot"></span>
        <span class="iso-code">ISO 9001:2015 — Quality Management System</span>
      </li>
    </ul>
  </div>

  <div class="card-bottom">
    <p class="subtext">
      Globally audited for consistent quality and sustainable manufacturing practices across every batch.
    </p>
  </div>
</div>

<style>
  .cert-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-1);
    padding: clamp(1.75rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 310px;
    box-sizing: border-box;
    height: 100%;
    cursor: pointer;
    transition: transform var(--dur-2) var(--ease-settle),
                box-shadow var(--dur-2) var(--ease-settle),
                border-color var(--dur-2) var(--ease-settle);
  }

  @media (hover: hover) {
    .cert-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-2);
      border-color: var(--hairline-strong);
    }
  }

  .card-top {
    display: flex;
    flex-direction: column;
  }

  .card-header {
    display: flex;
    align-items: center;
    min-height: 2.25rem;
    margin-bottom: var(--s-8);
  }

  .dark-icon-badge {
    width: 2.5rem;
    height: 2.5rem;
    background-color: var(--ink);
    color: var(--on-dark);
    border-radius: var(--r-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 400;
    font-synthesis-weight: none;
    line-height: 1.15;
    color: var(--ink);
    margin: 0 0 var(--s-6) 0;
  }

  .iso-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .iso-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--s-3);
  }

  /* Small lime tick — a mark, never text. */
  .bullet-dot {
    width: 7px;
    height: 7px;
    background-color: var(--lime);
    border-radius: 50%;
    display: inline-block;
    flex: none;
    margin-top: 0.5em;
  }

  .iso-code {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.5;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  .card-bottom {
    margin-top: var(--s-8);
  }

  .subtext {
    font-family: var(--font-sans);
    font-style: italic;
    font-size: var(--fs-xs);
    line-height: 1.6;
    color: var(--ink-muted);
    margin: 0;
  }
</style>
