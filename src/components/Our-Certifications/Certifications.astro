---
// Certifications.astro
import CpcbCard from './CpcbCard.astro';
import IsoCard from './IsoCard.astro';
import CipetCard from './CipetCard.astro';
import BioComplianceCard from './BioComplianceCard.astro';
import CertificationsMarquee from './CertificationsMarquee.astro';
import CertificatePreviewModal from './CertificatePreviewModal.astro';
---

<section class="certifications-section">
  <!-- Header Area -->
  <div class="header-container">
    <span class="section-tag">VERIFIED ECOLOGY </span>
    <h2 class="section-title">Government-Certified Compostable Packaging Manufacturer in India</h2>
    <p class="section-description">
      SAKRT is a CPCB-certified manufacturer and distributor of compostable bags, pouches, films, and tableware made from PLA, PBAT, cornstarch, and sugarcane bagasse. Every product we make is backed by verified lab testing, full material traceability, and government-approved certifications — so your business can switch from plastic with complete confidence and compliance.
    </p>
  </div>

  <!-- Responsive Cards Grid -->
  <div class="cards-grid">
    <CpcbCard />
    <IsoCard />
    <CipetCard />
    <BioComplianceCard />
    
    <!-- Certification Logos Marquee -->
    <CertificationsMarquee />

    <!-- Certificate Preview Modal -->
    <CertificatePreviewModal />
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500&family=Playfair+Display:wght@600&family=Inter:wght@400&display=swap');

  .certifications-section {
    width: 100%;
    max-width: 1340px;
    margin: 0 auto;
    padding: 10.5rem 1.5rem 5rem 1.5rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  .header-container {
    max-width: 780px;
    width: 100%;
    margin: 0 auto 3.5rem auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
  }

  .section-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: #4a5550;
    display: inline-block;
    margin-bottom: 1rem;
    text-transform: uppercase;
    text-align: center;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 400;
    color: #0a2319;
    margin: 0 0 1rem 0;
    text-align: center;
  }

  .section-description {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    line-height: 1.65;
    color: #4a5550;
    margin: 0;
    text-align: center;
    max-width: 760px;
  }

  /* Side-by-side Grid Layout */
  .cards-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 1.5rem;
    align-items: stretch;
    width: 100%;
  }

  @media (max-width: 1000px) {
    .certifications-section {
      padding-top: 8.5rem;
    }

    .header-container {
      margin-bottom: 2.75rem;
    }
  }

  @media (max-width: 850px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .certifications-section {
      padding-top: 7.5rem;
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .header-container {
      margin-bottom: 2.25rem;
    }
  }
</style>