---
// Certifications.astro
import CpcbCard from './CpcbCard.astro';
import IsoCard from './IsoCard.astro';
import CipetCard from './CipetCard.astro';
import BioComplianceCard from './BioComplianceCard.astro';
import CertificationsMarquee from './CertificationsMarquee.astro';
import CertificatePreviewModal from './CertificatePreviewModal.astro';
---

<section class="certifications-section">
  <!-- Header Area -->
  <div class="header-container" data-reveal>
    <span class="section-tag">VERIFIED ECOLOGY</span>
    <h2 class="section-title">Government-Certified Compostable Packaging Manufacturer in India</h2>
    <p class="section-description">
      SAKRT is a CPCB-certified manufacturer and distributor of compostable bags, pouches, films, and tableware made from PLA, PBAT, cornstarch, and sugarcane bagasse. Every product we make is backed by verified lab testing, full material traceability, and government-approved certifications — so your business can switch from plastic with complete confidence and compliance.
    </p>
  </div>

  <!-- Responsive Cards Grid -->
  <div class="cards-grid">
    <CpcbCard />
    <IsoCard />
    <CipetCard />
    <BioComplianceCard />

    <!-- Certification Logos Marquee -->
    <CertificationsMarquee />

    <!-- Certificate Preview Modal -->
    <CertificatePreviewModal />
  </div>
</section>

<style>
  .certifications-section {
    width: 100%;
    max-width: var(--maxw);
    margin: 0 auto;
    padding: var(--section-y) var(--gutter);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }

  .header-container {
    max-width: 640px;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  /* Eyebrow — mono label with the one lime rule (fill, never text). */
  .section-tag {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--ink-muted);
    text-transform: uppercase;
    margin-bottom: var(--s-5);
  }
  .section-tag::before {
    content: '';
    width: 26px;
    height: 3px;
    background: var(--lime);
    border-radius: var(--r-pill);
    flex: none;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 400;
    font-synthesis-weight: none;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 var(--s-5) 0;
    text-wrap: balance;
  }

  .section-description {
    font-family: var(--font-sans);
    font-size: var(--fs-lede);
    line-height: 1.7;
    color: var(--ink-soft);
    margin: 0;
  }

  /* Register layout: a wide primary column and a narrower companion. */
  .cards-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--s-5);
    align-items: stretch;
    width: 100%;
  }

  @media (max-width: 850px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
