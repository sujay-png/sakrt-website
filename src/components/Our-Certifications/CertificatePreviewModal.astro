---
// CertificatePreviewModal.astro
---

<dialog id="cert-preview-modal" class="cert-modal">
  <div class="modal-content">
    <button id="close-modal-btn" class="close-btn" aria-label="Close Preview">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <div id="modal-body" class="modal-body">
      <!-- Content injected by JS -->
    </div>
  </div>
</dialog>

<style>
  .cert-modal {
    padding: 0;
    border: none;
    border-radius: 12px;
    background: transparent;
    width: 95vw;
    max-width: 800px;
    max-height: 90vh;
    margin: auto; /* Forces center in modern browsers */
    overflow: visible;
  }
  
  .cert-modal::backdrop {
    background: rgba(10, 35, 25, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  
  .modal-content {
    background: #fff;
    border-radius: 12px;
    position: relative;
    width: 100%;
    height: 100%;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  }

  .close-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(0, 0, 0, 0.5);
    color: white;
    border: none;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: background 0.2s ease;
  }

  .close-btn:hover {
    background: rgba(0, 0, 0, 0.8);
  }

  .modal-body {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f1f5f9;
    min-height: 400px;
    padding: 1rem;
    box-sizing: border-box;
  }

  /* Target dynamic elements */
  :global(.modal-body img) {
    max-width: 100%;
    max-height: 85vh;
    object-fit: contain;
    display: block;
    margin: auto;
  }
  
  :global(.modal-body iframe) {
    width: 100%;
    height: 80vh;
    border: none;
    display: block;
  }

  @media (max-width: 768px) {
    .modal-body {
      min-height: 300px;
      padding: 0.5rem;
    }
    
    .close-btn {
      top: 8px;
      right: 8px;
      width: 30px;
      height: 30px;
    }
    
    :global(.modal-body iframe) {
      height: 70vh;
    }
  }
</style>

<script>
  function setupCertPreview() {
    const modal = document.getElementById('cert-preview-modal') as HTMLDialogElement;
    const closeBtn = document.getElementById('close-modal-btn');
    const modalBody = document.getElementById('modal-body');
    const triggers = document.querySelectorAll('.cert-preview-trigger');

    if (!modal || !closeBtn || !modalBody) return;

    // Open modal on click
    triggers.forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        // Prevent default if it's a link
        e.preventDefault();
        
        // Find the closest wrapper with the data attributes
        const el = e.currentTarget as HTMLElement;
        const url = el.getAttribute('data-cert-url');
        const type = el.getAttribute('data-cert-type');

        if (!url) return;

        // Inject appropriate content
        if (type === 'pdf') {
          // view=FitH forces the PDF viewer to fit the width of the page
          modalBody.innerHTML = `<iframe src="${url}#toolbar=0&navpanes=0&scrollbar=0&view=FitH" title="Certificate Preview"></iframe>`;
        } else {
          modalBody.innerHTML = `<img src="${url}" alt="Certificate Preview" loading="lazy" />`;
        }

        modal.showModal();
      });
    });

    // Close on button click
    closeBtn.addEventListener('click', () => {
      modal.close();
      modalBody.innerHTML = ''; // Clear content
    });

    // Close on backdrop click
    modal.addEventListener('click', (e) => {
      const dialogDimensions = modal.getBoundingClientRect();
      if (
        e.clientX < dialogDimensions.left ||
        e.clientX > dialogDimensions.right ||
        e.clientY < dialogDimensions.top ||
        e.clientY > dialogDimensions.bottom
      ) {
        modal.close();
        modalBody.innerHTML = '';
      }
    });
  }

  // Setup on initial load and Astro page transitions
  setupCertPreview();
  document.addEventListener('astro:page-load', setupCertPreview);
</script>
