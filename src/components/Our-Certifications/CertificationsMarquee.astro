---
// CertificationsMarquee.astro

import cipetImg from '../../images/CIPET.webp';
import isoImg from '../../images/iso.png';
import cpcbImg from '../../images/cpcb.png';
import bioComplianceImg from '../../images/bio-compliance.png';

// 1. TypeScript Interface for Logo Data
export interface CertificateLogo {
  id: string;
  name: string;
  src: string;
  href: string; // URL destination for modal preview
  certType: 'image' | 'pdf';
  openInNewTab?: boolean;
}

// 2. TypeScript Props Definition
interface Props {
  logos?: CertificateLogo[];
  speedInSeconds?: number;
}

const {
  speedInSeconds = 22,
  logos = [
    {
      id: 'cipet',
      name: 'CIPET Certificate',
      src: cipetImg.src,
      href: '/certificates/CIPET.webp',
      certType: 'image',
    },
    {
      id: 'iso',
      name: 'ISO Certification',
      src: isoImg.src,
      href: '/certificates/ISO.webp',
      certType: 'image',
    },
    {
      id: 'cpcb',
      name: 'CPCB Certificate',
      src: cpcbImg.src,
      href: '/certificates/CPCB.pdf',
      certType: 'pdf',
    },
    {
      id: 'bio-compliance',
      name: 'Bio-Compliance Certificate',
      src: bioComplianceImg.src,
      href: '/certificates/global.pdf',
      certType: 'pdf',
    },
  ],
} = Astro.props;
---

<div class="marquee-section">
  <p class="marquee-hint">Tap the icons to view the certificates</p>

  <div class="marquee-container">
    <div class="marquee-track" style={`--marquee-speed: ${speedInSeconds}s;`}>
      <!-- Set 1 -->
      {
        logos.map((logo) => (
          <button
            type="button"
            class="logo-card cert-preview-trigger"
            data-cert-url={logo.href}
            data-cert-type={logo.certType}
            aria-label={`Preview ${logo.name}`}
          >
            <img src={logo.src} alt={logo.name} loading="lazy" />
          </button>
        ))
      }

      <!-- Duplicate Set 2 for Infinite Scrolling Loop -->
      {
        logos.map((logo) => (
          <button
            type="button"
            class="logo-card cert-preview-trigger"
            data-cert-url={logo.href}
            data-cert-type={logo.certType}
            aria-label={`Preview ${logo.name}`}
          >
            <img src={logo.src} alt={logo.name} loading="lazy" />
          </button>
        ))
      }
    </div>
  </div>
</div>

<!-- Navigation handled by CertificatePreviewModal.astro -->

<style>
  .marquee-section {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    overflow: hidden;
  }

  .marquee-hint {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--ink-muted);
    margin: 0 0 var(--s-8) 0;
    text-align: center;
  }

  .marquee-container {
    width: 100%;
    display: flex;
    overflow: hidden;
    position: relative;
    mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 1) 12%,
      rgba(0, 0, 0, 1) 88%,
      rgba(0, 0, 0, 0) 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 1) 12%,
      rgba(0, 0, 0, 1) 88%,
      rgba(0, 0, 0, 0) 100%
    );
  }

  .marquee-track {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    width: max-content;
    animation: marquee-scroll var(--marquee-speed, 22s) linear infinite;
  }

  .marquee-container:hover .marquee-track {
    animation-play-state: paused;
  }

  .logo-card {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 180px;
    height: 110px;
    padding: var(--s-5);
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-1);
    transition: transform var(--dur-2) var(--ease-settle),
                border-color var(--dur-2) var(--ease-settle),
                box-shadow var(--dur-2) var(--ease-settle);
    box-sizing: border-box;
    cursor: pointer;
    outline: none;
  }

  .logo-card img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: grayscale(15%) opacity(0.9);
    transition: filter var(--dur-2) var(--ease-out);
    pointer-events: none; /* Prevents image dragging */
  }

  @media (hover: hover) {
    .logo-card:hover {
      background: var(--surface);
      border-color: var(--hairline-strong);
      transform: translateY(-4px);
      box-shadow: var(--shadow-2);
    }

    .logo-card:hover img {
      filter: grayscale(0%) opacity(1);
    }
  }

  @keyframes marquee-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Honour reduced motion: stop the strip cleanly rather than jittering. */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
  }

  @media (max-width: 600px) {
    .logo-card {
      width: 140px;
      height: 90px;
      padding: var(--s-4);
    }

    .marquee-track {
      gap: var(--s-4);
    }
  }
</style>
