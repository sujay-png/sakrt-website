---
// CertificationsCta.astro
---

<div class="certifications-cta">
  <p class="cta-subtitle">Ready to transition your ecosystem?</p>
  <div class="cta-actions">
    <a href="#request-sample" class="btn btn-primary">
      Request Sample Kit
    </a>
    <a href="/credentials.pdf" download class="btn btn-secondary">
      Download Full Credentials
    </a>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..700;1,400..700&family=Inter:wght@400;500;600&display=swap');

  .certifications-cta {
    grid-column: 1 / -1; /* Spans full grid width */
    place-self: center; /* Force center alignment inside grid */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    max-width: 600px;
    margin: 3.5rem auto 1rem;
    box-sizing: border-box;
  }

  .cta-subtitle {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.2rem;
    font-weight: 400;
    color: #0a2319;
    margin: 0 0 1.5rem 0;
    letter-spacing: -0.01em;
    text-align: center;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    width: 100%;
  }

  .btn {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.85rem 1.75rem;
    border-radius: 0.6rem;
    text-decoration: none;
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-sizing: border-box;
  }

  /* Dark Green Solid Button */
  .btn-primary {
    background-color: #0a2319;
    color: #ffffff;
    border: 1px solid #0a2319;
    box-shadow: 0 4px 14px rgba(10, 35, 25, 0.12);
  }

  .btn-primary:hover {
    background-color: #12382a;
    border-color: #12382a;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(10, 35, 25, 0.18);
  }

  /* Outline Light Button */
  .btn-secondary {
    background-color: rgba(243, 245, 242, 0.4);
    color: #0a2319;
    border: 1px solid rgba(10, 35, 25, 0.35);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.9);
    border-color: #0a2319;
    transform: translateY(-1px);
  }

  @media (max-width: 520px) {
    .cta-actions {
      flex-direction: column;
      width: 100%;
    }

    .btn {
      width: 100%;
    }
  }
</style>