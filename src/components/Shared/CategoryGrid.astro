---
export interface Product {
  name: string;
  image: string;
  slug: string;
  category: string; // The category slug used in the URL, e.g. "designer-tableware"
}

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

<div class="sk-section category-grid-container">
  <div class="sk-wrap">
    <div class="category-grid" data-reveal-group>
      {products.map((product) => (
        <div class="product-card">
          <a href={`/compostable-product/${product.category}/${product.slug}`} class="sk-media image-wrapper" style="--ar: 1 / 1">
            <img src={product.image} alt={product.name} loading="lazy" />
          </a>
          <div class="product-info">
            <h3 class="product-name">{product.name}</h3>
            <a href={`/compostable-product/${product.category}/${product.slug}`} class="view-details-btn">
              View Details
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .category-grid-container {
    position: relative;
    z-index: 10;
  }

  /* Specimen grid: one ratio, one tile colour, identical padding. The
     consistency across the grid is the whole job here. */
  .category-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-10) var(--s-6);
  }

  @media (min-width: 560px) {
    .category-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1024px) {
    .category-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .product-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* .sk-media supplies the 1:1 box; this adds the plate padding so the
     product sits inside the tile rather than bleeding to its edges. */
  .image-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--s-6);
    border: 1px solid var(--hairline);
    margin-bottom: var(--s-5);
    transition: border-color var(--dur-2) var(--ease-settle);
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* Product shots ship on white; multiply drops the box into the tile. */
    mix-blend-mode: multiply;
    transition: transform 1.1s var(--ease-settle);
  }

  .product-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-4);
    min-width: 0;
  }

  /* Display serif, held at 20px+ so Instrument Serif never goes spindly. */
  .product-name {
    font-family: var(--font-display);
    font-weight: 400;
    font-synthesis-weight: none;
    font-size: clamp(1.25rem, 1.7vw, 1.375rem);
    line-height: 1.14;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0;
    overflow-wrap: anywhere;
  }

  .view-details-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
    text-decoration: underline;
    text-decoration-color: var(--hairline-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition: color var(--dur-1) var(--ease-out),
                text-decoration-color var(--dur-2) var(--ease-settle);
  }

  @media (hover: hover) {
    .product-card:hover .image-wrapper { border-color: var(--hairline-strong); }
    .product-card:hover .image-wrapper img { transform: scale(1.045); }
    .view-details-btn:hover {
      color: var(--ink);
      text-decoration-color: var(--lime);
    }
  }
</style>
