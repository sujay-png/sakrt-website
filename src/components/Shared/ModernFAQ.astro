---
export interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  faqs: FAQItem[];
}

const { title, faqs } = Astro.props;
---

<div class="faq-container">
  <h2 class="faq-title">{title}</h2>
  
  <div class="faq-list">
    {faqs.map((faq, index) => (
      <details class="faq-item" name="faq-accordion">
        <summary class="faq-question">
          <span class="question-text">
            <strong>{index + 1}.</strong> {faq.question}
          </span>
          <span class="faq-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="chevron">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </summary>
        <div class="faq-answer">
          <div class="faq-answer-inner">
            <p>{faq.answer}</p>
          </div>
        </div>
      </details>
    ))}
  </div>
</div>

<style>
  .faq-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.5rem 6rem;
    font-family: system-ui, -apple-system, sans-serif;
  }

  .faq-title {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    color: #0b2218;
    margin-bottom: 2rem;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid #e2e8f0;
  }

  .faq-item {
    border-bottom: 1px solid #e2e8f0;
  }

  .faq-item::details-content {
    transition: height 0.3s ease, opacity 0.3s ease;
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 0;
    cursor: pointer;
    font-weight: 500;
    font-size: 1rem;
    color: #1e293b;
    list-style: none; /* Hide default marker */
    transition: color 0.2s ease;
  }

  /* Hide default details marker for Webkit */
  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question:hover {
    color: #0b2218;
    text-decoration: underline;
  }

  .question-text {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .question-text strong {
    font-weight: 600;
  }

  .faq-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #64748b;
    transition: transform 0.3s ease;
  }

  /* Rotate icon when open */
  details[open] .faq-icon {
    transform: rotate(180deg);
  }

  .faq-answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease-out;
  }

  details[open] .faq-answer {
    grid-template-rows: 1fr;
  }

  .faq-answer-inner {
    overflow: hidden;
  }

  .faq-answer p {
    margin: 0;
    padding-bottom: 1.5rem;
    padding-left: 1.85rem;
    color: #475569;
    line-height: 1.6;
    font-size: 0.95rem;
  }
</style>
