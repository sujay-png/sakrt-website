---
// src/components/Shared/ReadyToGoGreen.astro
---
<section class="sk-section go-green-section">
  <div class="sk-wrap go-green-wrap">
    <div class="go-green-container" data-reveal>
      <h2 class="go-green-title">Ready to Go Green?</h2>
      <p class="go-green-desc">Reach out for bulk orders, custom branding, or distribution partnerships.</p>

      <div class="go-green-actions">
        <a href="/contact-us" class="btn-primary">
          GET IN TOUCH
        </a>
        <a href="/compostable-product" class="btn-secondary">
          EXPLORE PRODUCTS
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .go-green-section {
    position: relative;
    z-index: 10;
    background: var(--pulp);
  }

  .go-green-wrap {
    max-width: 940px;
  }

  /* Was a two-stop gradient panel. Now a hairline-ruled specimen panel:
     one surface, one border, no gradient. */
  .go-green-container {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-xl);
    padding: clamp(36px, 6vw, 64px) var(--s-6);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .go-green-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-synthesis-weight: none;
    font-size: var(--fs-h2);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 var(--s-4);
  }

  .go-green-desc {
    font-family: var(--font-sans);
    font-size: var(--fs-lede);
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 48ch;
    margin: 0 0 var(--s-10);
  }

  .go-green-actions {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 26px;
    border: 1px solid transparent;
    border-radius: var(--r-pill);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    transition: background-color var(--dur-1) var(--ease-out),
                border-color var(--dur-1) var(--ease-out),
                color var(--dur-1) var(--ease-out),
                transform var(--dur-1) var(--ease-out);
  }

  .btn-primary {
    background: var(--ink);
    color: var(--on-dark);
  }

  .btn-secondary {
    background: transparent;
    color: var(--ink);
    border-color: var(--hairline-strong);
  }

  @media (hover: hover) {
    .btn-primary:hover {
      background: var(--brand);
      transform: translateY(-2px);
    }
    .btn-secondary:hover {
      border-color: var(--ink);
      background: rgba(16, 40, 28, 0.04);
      transform: translateY(-2px);
    }
  }

  @media (max-width: 560px) {
    .go-green-actions {
      flex-direction: column;
      width: 100%;
      max-width: 300px;
    }
    .btn-primary,
    .btn-secondary { width: 100%; }
  }
</style>
