---
---
<section class="go-green-section">
  <div class="go-green-container">
    <h2 class="go-green-title">Ready to Go Green?</h2>
    <p class="go-green-desc">Reach out for bulk orders, custom branding, or distribution partnerships.</p>
    
    <div class="go-green-actions">
      <a href="/contactus" class="btn-primary">
        GET IN TOUCH
      </a>
      <a href="/products" class="btn-secondary">
        EXPLORE PRODUCTS
      </a>
    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap');

  .go-green-section {
    width: 100%;
    padding: 0 1.5rem 6rem;
    display: flex;
    justify-content: center;
    box-sizing: border-box;
  }

  .go-green-container {
    max-width: 900px;
    width: 100%;
    background: linear-gradient(135deg, #f4f6f1 0%, #ebefe6 100%);
    border-radius: 12px;
    padding: 3.5rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .go-green-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.5rem, 4vw, 3.2rem);
    font-weight: 500;
    color: #0b2218;
    margin: 0 0 1rem 0;
    line-height: 1.1;
  }

  .go-green-desc {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.95rem;
    color: #3b5f4c;
    margin: 0 0 2.5rem 0;
  }

  .go-green-actions {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-primary, .btn-secondary {
    display: inline-block;
    padding: 0.8rem 2rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background-color: #ffffff;
    color: #0b2218;
    border: 1px solid rgba(0,0,0,0.05);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.02);
  }

  .btn-primary:hover {
    background-color: #f8faf9;
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.04);
  }

  .btn-secondary {
    background-color: #ffffff;
    color: #0b2218;
    border: 1px solid rgba(0,0,0,0.05);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.02);
  }

  .btn-secondary:hover {
    background-color: #f8faf9;
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.04);
  }
</style>
