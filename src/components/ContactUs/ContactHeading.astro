---
// ContactHeading.astro
---

<div class="heading-wrapper">
  <span class="section-tag">Get in touch</span>
  <h1 class="main-heading">
    Contact Us
  </h1>
  <br>
  <p class="sub-heading">
    Ready to go green? We partner with retailers and enterprises to bring certified compostable products to market.
  </p>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500&family=Playfair+Display:ital,wght@0,700;0,800;1,700;1,800&display=swap');

  .heading-wrapper {
    margin-top: 0;
    margin-bottom: 2.5rem;
    padding: 0;
    width: 100%;
  }

  .section-tag {
font-family: JetBrains Mono, monospace;
    font-size: .7rem;
    font-weight: 500;
    letter-spacing: .2em;
    color: #b0b4ae;
    text-transform: uppercase;
    display: block;
    margin-top: 3.5rem;
    margin-bottom: 1.1rem;
    padding: 0;
  }

  .main-heading {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 700;
    color: #0A2F1F;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .sub-heading {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    color: #4a514d;
    line-height: 1.5;
    margin-top: 0;
    max-width: 600px;
  }

  @media (min-width: 768px) {
    .main-heading {
      font-size: 3.5rem;
    }
    .sub-heading {
      font-size: 1.25rem;
    }
  }
</style>