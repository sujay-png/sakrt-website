---
// src/components/ContactUs/PhysicalAnchor.astro
---

<div class="card cream-card">
  <span class="card-tag muted">PHYSICAL ANCHOR</span>
  
  <div class="map-container">
    <div class="map-placeholder">
      <p class="data-tag">CONTACT US - SAKRT</p>
      <div class="blueprint-graphic">
        <svg viewBox="0 0 300 150" fill="none" stroke="#8c857b" stroke-width="1">
          <rect x="20" y="20" width="60" height="40" rx="4" />
          <rect x="90" y="10" width="80" height="50" rx="4" />
          <rect x="180" y="30" width="70" height="60" rx="4" />
          <path d="M 10 110 C 100 110, 150 70, 290 120" stroke-dasharray="4 4" />
          <circle cx="200" cy="60" r="12" stroke="#112d22" stroke-width="2"/>
        </svg>
      </div>
      <div class="hq-badge">HQ COORDINATES</div>
    </div>
  </div>
</div>

<style>
  .card {
    border-radius: 1.25rem;
    padding: 2rem;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
  }

  .card-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 1.5rem;
  }

  .card-tag.muted {
    color: #8c857b;
  }

  .cream-card {
    background-color: #f3ede6;
    height: 100%;
    min-height: 240px;
    display: flex;
    flex-direction: column;
  }

  .map-container {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.5);
    border-radius: 0.75rem;
    padding: 1rem;
    position: relative;
  }

  .map-placeholder {
    width: 100%;
    text-align: center;
    position: relative;
  }

  .data-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    color: #706a61;
    margin-bottom: 0.5rem;
    letter-spacing: 0.05em;
  }

  .blueprint-graphic svg {
    width: 100%;
    max-height: 100px;
  }

  .hq-badge {
    position: absolute;
    bottom: 0px;
    left: 0px;
    background-color: rgba(255, 255, 255, 0.9);
    border: 1px solid #e2ded8;
    border-radius: 0.25rem;
    padding: 0.25rem 0.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.55rem;
    font-weight: 700;
    color: #0a2319;
  }
</style>