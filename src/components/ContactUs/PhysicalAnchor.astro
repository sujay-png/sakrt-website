---
// src/components/contact-us/PhysicalAnchor.astro
---

<div class="card cream-card">
  <div class="map-container">
    <iframe 
      src="https://maps.google.com/maps?q=2-43,+Kripam,+Padmanoor,+Kinnigoli+Mangalore,+Karnataka+574150&t=m&z=10&output=embed" 
      width="100%" 
      height="100%" 
      style="border:0; border-radius: 0.5rem;" 
      allowfullscreen="" 
      loading="lazy" 
      referrerpolicy="no-referrer-when-downgrade">
    </iframe>
  </div>
</div>

<style>
  .card {
    border-radius: 1.25rem;
    padding: 0.5rem; /* Beige margin around map */
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
  }

  .cream-card {
    background-color: #f3ede6;
    height: 100%;
    min-height: 240px;
    border-radius: 1rem;
    display: flex;
    flex-direction: column;
  }

  .map-container {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    position: relative;
    min-height: 300px; /* Ensure map has good height */
  }
</style>