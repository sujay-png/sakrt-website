---
// DirectComms.astro
---

<div class="card dark-card">
  <span class="card-tag">DIRECT COMMS</span>

  <div class="comms-group">
    <span class="comms-label">E-MAIL</span>
    <a href="mailto:hello@sakrt.in" class="comms-value neon-text">hello@sakrt.in</a>
  </div>

  <div class="comms-group">
    <span class="comms-label">VOICE</span>
    <a href="tel:7975310662" class="comms-value neon-text">7975310662</a>
  </div>

  <div class="comms-footer">
    <div class="signal-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9.375 9.375a5.25 5.25 0 017.25 0m-10.75-3.5a10.25 10.25 0 0114.25 0M12 18.75h.008v.008H12v-.008z" />
      </svg>
    </div>
    <div class="latency-info">
      <span class="latency-label">RESPONSE LATENCY</span>
      <span class="latency-value">EST. 4-6 HOURS</span>
    </div>
  </div>
</div>

<style>
  .card {
    border-radius: 1.25rem;
    padding: 2rem;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
  }

  .card-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #8dfd22;
    text-transform: uppercase;
    display: block;
    margin-bottom: 1.5rem;
  }

  .dark-card {
    background-color: #0A2F1F;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    min-height: 260px;
  }

  .comms-group {
    margin-bottom: 1.25rem;
  }

  .comms-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #698578;
    display: block;
    margin-bottom: 0.25rem;
  }

  .comms-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.15rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.02em;
  }

  .neon-text {
    color: #8dfd22;
  }

  .comms-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 0.5rem;
  }

  .signal-icon svg {
    width: 1.25rem;
    height: 1.25rem;
    color: #8dfd22;
  }

  .latency-info {
    text-align: right;
  }

  .latency-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.55rem;
    color: #698578;
    display: block;
    margin-bottom: 0.1rem;
  }

  .latency-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    font-weight: 700;
    color: #8dfd22;
  }
</style>