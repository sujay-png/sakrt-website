---
// DirectComms.astro
---

<div class="card details-card">
  <span class="card-tag">Our details</span>
  <h2 class="card-heading">Let's build something sustainable together</h2>

  <div class="details-list">
    <!-- Address -->
    <div class="detail-item">
      <div class="detail-icon">
        <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
      </div>
      <div class="detail-content">
        <span class="detail-label">Address</span>
        <span class="detail-value text-green">2-43(1), Kripam, Padmanoor, Kinnigoli Mangalore, Karnataka 574150</span>
      </div>
    </div>

    <!-- Phone -->
    <div class="detail-item">
      <div class="detail-icon">
        <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.864-1.051l-3.202-.534c-.538-.09-1.077.17-1.341.644l-1.298 2.337a12.023 12.023 0 01-5.632-5.632l2.337-1.298c.474-.264.734-.803.644-1.341l-.534-3.202c-.085-.513-.535-.864-1.051-.864H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
      </div>
      <div class="detail-content">
        <span class="detail-label">Phone</span>
        <a href="tel:+917975310662" class="detail-value text-green">+91 79753 10662</a>
      </div>
    </div>

    <!-- Email -->
    <div class="detail-item">
      <div class="detail-icon">
        <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.909A2.25 2.25 0 012.25 6.993V6.75m19.5 0a48.667 48.667 0 00-9.75 0" /></svg>
      </div>
      <div class="detail-content">
        <span class="detail-label">Email</span>
        <a href="mailto:hello@sakrt.in" class="detail-value text-green">hello@sakrt.in</a>
      </div>
    </div>
  </div>
</div>

<style>
  .card {
    border-radius: 1.25rem;
    padding: 2.5rem;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
  }

  .details-card {
    background-color: #f3ede6; /* Beige color to match */
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .card-tag {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    color: #333;
    display: block;
    margin-bottom: 1.5rem;
  }

  .card-heading {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 500;
    color: #0A2F1F;
    line-height: 1.2;
    margin-top: 0;
    margin-bottom: 2rem;
  }

  .details-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .detail-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .detail-icon {
    width: 24px;
    height: 24px;
    color: #6c7870;
    margin-top: 2px;
  }

  .detail-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .detail-label {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    color: #6c7870;
  }

  .detail-value {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    line-height: 1.5;
    text-decoration: none;
  }

  .text-green {
    color: #348e5b;
  }

  @media (min-width: 768px) {
    .card-heading {
      font-size: 2.5rem;
    }
  }
</style>