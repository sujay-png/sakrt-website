---
// InquiryForm.astro
---

<div class="card form-card">
  <div class="form-header">
    <h2 class="form-title">Send an Inquiry</h2>
    <div class="watermark-at">@</div>
  </div>

  <form class="inquiry-form" id="inquiryForm" novalidate>
    <div class="form-row">
      <div class="form-group">
        <label for="name">NAME</label>
        <input type="text" id="name" placeholder="Full Name" required />
      </div>

      <div class="form-group">
        <label for="phone">PHONE NUMBER</label>
        <input type="tel" id="phone" placeholder="Phone Number" pattern="[0-9+\s-]{7,15}" required />
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="company">COMPANY NAME</label>
        <input type="text" id="company" placeholder="Company Name" required />
      </div>

      <div class="form-group">
        <label for="email">EMAIL ADDRESS</label>
        <input type="email" id="email" placeholder="Email" required />
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="product_type">PRODUCT TYPE</label>
        <input type="text" id="product_type" placeholder="Product Type" required />
      </div>

      <div class="form-group">
        <label for="item_quality">ITEM QUALITY</label>
        <input type="text" id="item_quality" placeholder="Item Quality" required />
      </div>
    </div>

    <div class="form-group">
      <label for="message">YOUR MESSAGE</label>
      <textarea id="message" rows="3" placeholder="How can we advance together?" required></textarea>
    </div>

    <div class="form-action">
      <button type="submit" class="submit-btn">
        <span>TRANSMIT MESSAGE</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </button>
    </div>
  </form>
</div>

<style>
  .card {
    border-radius: 1.25rem;
    padding: 1.5rem;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
  }

  .form-card {
    background-color: #ffffff;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .form-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 2rem;
  }

  .form-title {
    font-family: var(--font-serif);
    font-size: 1.49rem;
    font-weight: 400;
    color: #0a2319;
    margin: 0;
  }

  .watermark-at {
    font-family: 'Inter', sans-serif;
    font-size: 4.5rem;
    font-weight: 300;
    color: #f0ece7;
    line-height: 0.8;
    user-select: none;
  }

  .inquiry-form {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    flex-grow: 1;
    justify-content: space-between;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 600px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
    .card {
      padding: 2.5rem;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #727a75;
    text-transform: uppercase;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    border: none;
    border-bottom: 1px solid #e2ded8;
    padding: 0.5rem 0;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    color: #0a2319;
    background: transparent;
    outline: none;
    transition: border-color 0.2s ease;
    box-sizing: border-box;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    border-bottom-color: #0a2319;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: #a0a6a2;
  }

  .form-group textarea {
    resize: vertical;
  }

  .form-action {
    margin-top: 1rem;
  }

  .submit-btn {
    background-color: #0a2319;
    color: #ffffff;
    border: none;
    border-radius: 0.5rem;
    padding: 0.85rem 1.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .submit-btn:hover {
    background-color: #123829;
  }

  .submit-btn svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  /* Validation styles (Error highlighting) */
  .form-group input.invalid,
  .form-group textarea.invalid {
    border-bottom-color: #d93838 !important;
  }

  .form-group label.invalid-label {
    color: #d93838 !important;
  }
</style>


  <script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('inquiryForm') as HTMLFormElement | null;
    if (!form) return;

    // Cast NodeList items to HTMLInputElement | HTMLTextAreaElement
    const inputs = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea');

    // Real-time cleanup on input
    inputs.forEach((input) => {
      input.addEventListener('input', () => {
        if (input.checkValidity()) {
          input.classList.remove('invalid');
          const label = input.parentElement?.querySelector('label');
          if (label) label.classList.remove('invalid-label');
        }
      });
    });

    // Handle Form Submission with Validation
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      let isFormValid = true;

      inputs.forEach((input) => {
        const label = input.parentElement?.querySelector('label');
        if (!input.checkValidity()) {
          isFormValid = false;
          input.classList.add('invalid');
          if (label) label.classList.add('invalid-label');
        } else {
          input.classList.remove('invalid');
          if (label) label.classList.remove('invalid-label');
        }
      });

      if (isFormValid) {
        const submitBtn = form.querySelector('.submit-btn') as HTMLButtonElement;
        const submitBtnText = submitBtn?.querySelector('span');
        
        if (submitBtnText) submitBtnText.textContent = 'TRANSMITTING...';
        if (submitBtn) submitBtn.disabled = true;

        const name = (document.getElementById('name') as HTMLInputElement).value;
        const phone = (document.getElementById('phone') as HTMLInputElement).value;
        const company = (document.getElementById('company') as HTMLInputElement).value;
        const email = (document.getElementById('email') as HTMLInputElement).value;
        const product_type = (document.getElementById('product_type') as HTMLInputElement).value;
        const item_quality = (document.getElementById('item_quality') as HTMLInputElement).value;
        const message = (document.getElementById('message') as HTMLTextAreaElement).value;

        const payload = { name, phone, company, email, product_type, item_quality, message };

        const text =
            `*New Contact Inquiry*%0A%0A` +
            `*Name:* ${name}%0A` +
            `*Phone:* ${phone}%0A` +
            `*Company:* ${company}%0A` +
            `*Email:* ${email}%0A` +
            `*Product Type:* ${product_type}%0A` +
            `*Item Quality:* ${item_quality}%0A` +
            `*Message:* ${message}`;

        const whatsappNumber = "+917975310662";
        const url = `https://wa.me/${whatsappNumber}?text=${text}`;

        try {
            await Promise.all([
                fetch('/api/enquiry', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                }),
                new Promise<void>((resolve) => {
                    window.open(url, "_blank");
                    resolve();
                })
            ]);
            
            alert('Message transmitted successfully!');
            form.reset();
        } catch (error) {
            console.error('Error submitting form:', error);
            alert('Something went wrong submitting to the backend, but WhatsApp should have opened.');
        } finally {
            if (submitBtnText) submitBtnText.textContent = 'TRANSMIT MESSAGE';
            if (submitBtn) submitBtn.disabled = false;
        }
      }
    });
  });
</script>