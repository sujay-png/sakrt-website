---
/* src/components/Product/PouchesCard.astro */
interface Props {
  seriesNumber?: string;
  category?: string;
  isNew?: boolean;
  title?: string;
  availableSizes?: string;
  barrierLevel?: string;
}

const {
  seriesNumber = "04",
  category = "BARRIER",
  isNew = true,
  title = "Stand-up Pouches",
  availableSizes = "250g, 500g, 1kg, 5kg Custom",
  barrierLevel = "High Moisture & Oxygen",
} = Astro.props;
---

<div class="pouches-card">
  <!-- Top Header with Badge -->
  <div class="card-header">
    <span class="header-meta">{seriesNumber} // {category}</span>
    {isNew && <span class="new-badge">NEW</span>}
  </div>

  <!-- Main Title -->
  <h2 class="card-title">{title}</h2>

  <!-- 2-Column Specs Layout -->
  <div class="specs-row">
    <div class="spec-col">
      <div class="divider-line"></div>
      <span class="spec-label">AVAILABLE SIZES</span>
      <p class="spec-value">{availableSizes}</p>
    </div>
    <div class="spec-col">
      <div class="divider-line"></div>
      <span class="spec-label">BARRIER LEVEL</span>
      <p class="spec-value">{barrierLevel}</p>
    </div>
  </div>

  <!-- Bottom Action / Category Icons -->
  <div class="card-actions">
    <div class="icon-box">
      <!-- Box Icon -->
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
        <path d="M21 8L12 3L3 8V16L12 21L21 16V8Z"></path>
        <path d="M3 8L12 13L21 8"></path>
        <path d="M12 13V21"></path>
      </svg>
    </div>
    <div class="icon-box">
      <!-- Layers Icon -->
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
        <polyline points="2 17 12 22 22 17"></polyline>
        <polyline points="2 12 12 17 22 12"></polyline>
      </svg>
    </div>
  </div>
</div>

<style>
  /* Shared product-card language: --surface shell, hairline border,
     --r-lg corners, one settle hover. See sibling Product/*Card.astro. */
  .pouches-card {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 340px;
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    box-shadow: var(--shadow-1);
    transition: transform var(--dur-2) var(--ease-settle),
                box-shadow var(--dur-2) var(--ease-settle),
                border-color var(--dur-2) var(--ease-settle);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--s-5);
  }

  .header-meta {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--ink-muted);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /* The single lime mark for this card: ink on lime = 12.7:1. */
  .new-badge {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--ink);
    background-color: var(--lime);
    padding: 4px 10px;
    border-radius: var(--r-pill);
    letter-spacing: 0.08em;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 400;
    font-synthesis-weight: none;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 var(--s-8) 0;
    color: var(--ink);
  }

  .specs-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-6);
    margin-bottom: var(--s-8);
  }

  .spec-col {
    display: flex;
    flex-direction: column;
  }

  .divider-line {
    width: 100%;
    height: 1px;
    background-color: var(--hairline);
    margin-bottom: var(--s-5);
  }

  .spec-label {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--ink-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--s-3);
  }

  .spec-value {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--ink);
    margin: 0;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .card-actions {
    margin-top: auto;
    display: flex;
    gap: var(--s-3);
  }

  .icon-box {
    width: 88px;
    height: 88px;
    border-radius: var(--r-md);
    background-color: var(--pulp-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-muted);
    transition: transform var(--dur-1) var(--ease-out),
                background-color var(--dur-1) var(--ease-out);
  }

  .icon-box svg {
    width: 34px;
    height: 34px;
  }

  @media (hover: hover) {
    .pouches-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-2);
      border-color: var(--hairline-strong);
    }
    .icon-box:hover {
      background-color: var(--hairline);
      transform: translateY(-2px);
    }
  }

  @media (max-width: 640px) {
    .pouches-card {
      padding: var(--s-6);
    }
  }
</style>