---
/* src/components/SakrtStandard.astro */
---

<section class="sakrt-standard">
  <div class="standard-container">
    
    <!-- Left Content Column -->
    <div class="left-content">
      <h2 class="section-title">The SAKRT Standard</h2>
      <p class="section-description">
        Every product in our catalog undergoes rigorous ISO 17088 testing 
        to ensure molecular integrity and environmental safety.
      </p>

      <!-- Feature Cards Grid -->
      <div class="feature-cards">
        
        <!-- Certifications Card -->
        <div class="feature-card">
          <div class="card-icon green">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
          </div>
          <h3 class="card-title">Certifications</h3>
          <p class="card-text">TUV OK COMPOST, ASTM D6400, EN 13432.</p>
        </div>

        <!-- R&D Lab Card -->
        <div class="feature-card">
          <div class="card-icon green">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M10 2v7.5M14 2v7.5M12 2v10.5M8.5 15a4.5 4.5 0 1 0 7 0H8.5z"></path>
            </svg>
          </div>
          <h3 class="card-title">R&D Lab</h3>
          <p class="card-text">In-house molecular testing for custom barrier properties.</p>
        </div>

      </div>
    </div>

    <!-- Right Badge Column -->
    <div class="right-content">
      <!-- Outer translucent halo -->
      <div class="halo-circle">
        
        <!-- Main Dark Green Circle -->
        <div class="stat-circle">
          <span class="badge-label">CARBON FOOTPRINT</span>
          <div class="stat-number">-68%</div>
          <p class="stat-description">
            Lower emissions compared to traditional petrochemical plastics.
          </p>
        </div>

        <!-- Extra Floating Tag (bottom left edge) -->
        <div class="floating-tag">FREE</div>

      </div>
    </div>

  </div>
</section>

<style>
  .sakrt-standard {
    width: 100%;
    background-color: var(--pulp-deep);
    padding: 5rem var(--gutter);
    overflow: hidden;
    box-sizing: border-box;
  }

  .standard-container {
    max-width: var(--maxw);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 3rem;
  }

  /* Left Column Styling */
  .section-title {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 400;
    font-synthesis-weight: none;
    color: var(--ink);
    margin: 0 0 1.25rem 0;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .section-description {
    font-family: var(--font-sans);
    font-size: var(--fs-lede);
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 480px;
    margin: 0 0 3rem 0;
  }

  .feature-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .feature-card {
    background-color: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
    padding: 1.75rem 1.5rem;
    box-shadow: var(--shadow-1);
  }

  .card-icon {
    width: 28px;
    height: 28px;
    margin-bottom: 1.25rem;
  }

  .card-icon.green {
    color: var(--brand);
  }

  .card-icon svg {
    width: 100%;
    height: 100%;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 400;
    font-synthesis-weight: none;
    color: var(--ink);
    margin: 0 0 0.5rem 0;
    line-height: 1.1;
  }

  .card-text {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--ink-muted);
    line-height: 1.5;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  /* Right Column Styling - Circular Badge */
  .right-content {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .halo-circle {
    position: relative;
    width: min(440px, 100%);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background-color: rgba(242, 243, 237, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stat-circle {
    position: relative;
    z-index: 1;
    width: 78%;
    max-width: 340px;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background-color: var(--brand);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2.5rem;
    box-sizing: border-box;
    box-shadow: var(--shadow-2);
  }

  .badge-label {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--lime);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: 3.82rem;
    font-weight: 400;
    font-synthesis-weight: none;
    color: var(--on-dark);
    line-height: 1;
    margin-bottom: 1rem;
  }

  .stat-description {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    color: var(--on-dark-muted);
    line-height: 1.5;
    margin: 0;
    max-width: 220px;
  }

  .floating-tag {
    position: static;
    bottom: 28px;
    left: 20px;
    background-color: var(--surface);
    padding: .35rem .75rem;
    border-radius: var(--r-sm);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: .08em;
    box-shadow: var(--shadow-1);
  }

  /* Responsive Layout */
  @media (max-width: 900px) {
    .standard-container {
      grid-template-columns: 1fr;
    }

    .feature-cards {
      grid-template-columns: 1fr;
    }

    .stat-number {
      font-size: 3.5rem;
    }
  }
</style>