---
// src/components/Product/ProductHero.astro
---

<section class="product-hero">
  <div class="hero-container">
    <div class="hero-left">
      <span class="sub-label">02 // PRODUCT CATALOG</span>
      <h1 class="hero-title">Advanced Bio-Polymer <br/>
         Solutions</h1>
      <p class="hero-description">
        Engineered for high performance. Designed for complete circularity.Explore our range of industrial-<br/>
        grade compostable materials.
      </p>
    </div>

    <div class="hero-right">
      <nav class="filter-pills" aria-label="Product Categories">
        <button class="pill-btn active">All Products</button>
        <button class="pill-btn">Rigid Packaging</button>
        <button class="pill-btn">Flexible Films</button>
        <button class="pill-btn">Textiles</button>
      </nav>
    </div>
  </div>
</section>

<style>
  .product-hero {
    width: 100%;
    padding: 4rem 2rem 2rem;
    max-width: 1280px;
    margin: 0 auto;
  }

  .hero-container {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .hero-left {
       max-width: 650px;
    margin-top: 5rem;
  }

  .sub-label {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-accent-lime);
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: var(--font-serif);
        font-size: clamp(3rem, 5vw, 5.2rem);
    line-height: 1.05;
    color: var(--color-primary-dark);
    font-weight: 500;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .hero-description {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 520px;
  }

  /* Filter Navigation Bar */
  .hero-right {
    margin-bottom: 0.5rem;
  }

  .filter-pills {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    background-color: var(--color-bg-pill);
    padding: 0.35rem;
    border-radius: 12px;
    border: 1px solid var(--color-border-subtle);
  }

  .pill-btn {
    background: transparent;
    border: none;
    padding: 0.65rem 1.25rem;
    border-radius: 8px;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-body);
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .pill-btn:hover {
    color: var(--color-primary-dark);
  }

  .pill-btn.active {
    background-color: var(--color-primary-dark);
    color: var(--color-text-light);
  }

  @media (max-width: 900px) {
    .hero-container {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero-right {
      width: 100%;
      overflow-x: auto;
      padding-bottom: 0.5rem;
    }

    .filter-pills {
      min-width: max-content;
    }
  }
</style>