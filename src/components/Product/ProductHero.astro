---
// src/components/Product/ProductHero.astro
---

<section class="product-hero">
  <div class="hero-container">
    <div class="hero-left">
      <span class="sub-label">02 // PRODUCT CATALOG</span>
      <h1 class="hero-title">Advanced Bio-Polymer <br/>
         Solutions</h1>
      <p class="hero-description">
        Engineered for high performance. Designed for complete circularity.Explore our range of industrial-<br/>
        grade compostable materials.
      </p>
    </div>

    <div class="hero-right">
      <nav class="filter-pills" aria-label="Product Categories">
        <button class="pill-btn active">All Products</button>
        <button class="pill-btn">Rigid Packaging</button>
        <button class="pill-btn">Flexible Films</button>
        <button class="pill-btn">Textiles</button>
      </nav>
    </div>
  </div>
</section>

<style>
  .product-hero {
    width: 100%;
    padding: 4rem var(--gutter) 2rem;
    max-width: var(--maxw);
    margin: 0 auto;
  }

  .hero-container {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .hero-left {
    max-width: 650px;
    margin-top: 5rem;
  }

  /* Was lime text on pulp (1.5:1, illegible). Now a mono eyebrow in
     --ink-muted with the lime kept as a rule/mark, per the design system. */
  .sub-label {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--ink-muted);
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .sub-label::before {
    content: '';
    width: 26px;
    height: 3px;
    background: var(--lime);
    border-radius: var(--r-pill);
    flex: none;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 5vw, 4.42rem);
    line-height: 1.05;
    color: var(--brand);
    font-weight: 400;
    font-synthesis-weight: none;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .hero-description {
    font-family: var(--font-sans);
    font-size: var(--fs-lede);
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 520px;
  }

  /* Filter Navigation Bar */
  .hero-right {
    margin-bottom: 0.5rem;
  }

  .filter-pills {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    background-color: var(--pulp-deep);
    padding: 0.35rem;
    border-radius: var(--r-md);
    border: 1px solid var(--hairline);
  }

  .pill-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    background: transparent;
    border: none;
    padding: 0.65rem 1.25rem;
    border-radius: var(--r-sm);
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--ink-soft);
    cursor: pointer;
    transition: color var(--dur-1) var(--ease-out),
                background-color var(--dur-1) var(--ease-out);
    white-space: nowrap;
  }

  @media (hover: hover) {
    .pill-btn:hover {
      color: var(--ink);
    }
  }

  .pill-btn.active {
    background-color: var(--brand);
    color: var(--on-dark);
  }

  @media (max-width: 900px) {
    .hero-container {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero-right {
      width: 100%;
      overflow-x: auto;
      padding-bottom: 0.5rem;
    }

    .filter-pills {
      min-width: max-content;
    }
  }
</style>