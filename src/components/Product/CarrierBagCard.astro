---
/* src/components/Product/CarrierBagCard.astro */
interface Props {
  badgeText?: string;
  title?: string;
  specs?: { label: string; value: string }[];
  bgImage?: string;
  href?: string;
}

const {
  badgeText = "• BIO-TECH SERIES",
  title = "Compostable Carrier Bags",
  specs = [
    { label: "TENSILE STRENGTH", value: "45 MPa" },
    { label: "LOAD CAPACITY", value: "12 KG" },
    { label: "DEGRADATION", value: "180 DAYS" },
  ],
  bgImage,
  href = "#specs",
} = Astro.props;
---

<div class="carrier-card">
  {bgImage && (
    <div class="bg-wrapper">
      <img src={bgImage} alt={title} class="bg-img" />
      <div class="overlay"></div>
    </div>
  )}

  <div class="card-content">
    <div class="bottom-section">
      <div class="badge">{badgeText}</div>
      <h2 class="card-title">{title}</h2>

      <div class="card-footer">
        <div class="specs-grid">
          {specs.map((spec) => (
            <div class="spec-item">
              <span class="spec-label">{spec.label}</span>
              <span class="spec-value">{spec.value}</span>
            </div>
          ))}
        </div>

        <a href={href} class="arrow-button" aria-label="View Details">
          <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  /* Shared product-card language: --surface shell, hairline border,
     --r-lg corners, one settle hover. See sibling Product/*Card.astro. */
  .carrier-card {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 340px;
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--hairline);
    box-shadow: var(--shadow-1);
    overflow: hidden;
    box-sizing: border-box;
    transition: transform var(--dur-2) var(--ease-settle),
                box-shadow var(--dur-2) var(--ease-settle),
                border-color var(--dur-2) var(--ease-settle);
  }

  /* Optional background photo path (only rendered when bgImage is passed):
     a light pulp scrim keeps the ink text legible over any image. */
  .bg-wrapper {
    position: absolute;
    inset: 0;
  }

  .bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-settle);
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg,
      rgba(242, 243, 237, 0.35) 0%,
      rgba(242, 243, 237, 0.82) 62%,
      rgba(242, 243, 237, 0.94) 100%);
  }

  .card-content {
    position: relative;
    z-index: 2;
    height: 100%;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    color: var(--ink-soft);
  }

  .bottom-section {
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .badge {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--ink-muted);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: var(--s-3);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 400;
    font-synthesis-weight: none;
    color: var(--ink);
    margin: 0 0 var(--s-6) 0;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .card-footer {
    margin-top: auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-6);
    width: 100%;
  }

  .specs-grid {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: var(--s-6);
    font-family: var(--font-mono);
  }

  .spec-item {
    display: flex;
    flex-direction: column;
  }

  .spec-label {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--ink-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .spec-value {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--ink);
    margin-top: var(--s-2);
  }

  /* The single lime mark for this card: ink on lime = 12.7:1. */
  .arrow-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    border-radius: var(--r-pill);
    background-color: var(--lime);
    color: var(--ink);
    text-decoration: none;
    flex-shrink: 0;
    transition: transform var(--dur-1) var(--ease-out);
  }

  .arrow-icon {
    width: 20px;
    height: 20px;
  }

  @media (hover: hover) {
    .carrier-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-2);
      border-color: var(--hairline-strong);
    }
    .carrier-card:hover .bg-img { transform: scale(1.045); }
    .arrow-button:hover { transform: scale(1.06); }
  }

  @media (max-width: 640px) {
    .card-content {
      padding: var(--s-6);
    }
    .card-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-5);
    }
    .specs-grid {
      grid-template-columns: repeat(auto-fit, minmax(72px, 1fr));
      gap: var(--s-5) var(--s-4);
      width: 100%;
    }
  }
</style>