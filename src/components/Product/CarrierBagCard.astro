---
/* src/components/Product/CarrierBagCard.astro */
interface Props {
  badgeText?: string;
  title?: string;
  specs?: { label: string; value: string }[];
  bgImage?: string;
  href?: string;
}

const {
  badgeText = "• BIO-TECH SERIES",
  title = "Compostable Carrier Bags",
  specs = [
    { label: "TENSILE STRENGTH", value: "45 MPa" },
    { label: "LOAD CAPACITY", value: "12 KG" },
    { label: "DEGRADATION", value: "180 DAYS" },
  ],
  bgImage,
  href = "#specs",
} = Astro.props;
---

<div class="carrier-card">
  {bgImage && (
    <div class="bg-wrapper">
      <img src={bgImage} alt={title} class="bg-img" />
      <div class="overlay"></div>
    </div>
  )}

  <div class="card-content">
    <div class="bottom-section">
      <div class="badge">{badgeText}</div>
      <h2 class="card-title">{title}</h2>

      <div class="card-footer">
        <div class="specs-grid">
          {specs.map((spec) => (
            <div class="spec-item">
              <span class="spec-label">{spec.label}</span>
              <span class="spec-value">{spec.value}</span>
            </div>
          ))}
        </div>

        <a href={href} class="arrow-button" aria-label="View Details">
          <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .carrier-card {
    position: relative;
    width: 100%;
    min-height: 520px;
    border-radius: 20px;
    background: linear-gradient(180deg, #e4e2dc 0%, #a4b09b 50%, #344838 100%);
    overflow: hidden;
    box-sizing: border-box;
  }

  .bg-wrapper {
    position: absolute;
    inset: 0;
  }

  .bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(20, 32, 23, 0.88) 100%);
  }

  .card-content {
    position: relative;
    z-index: 2;
    height: 100%;
    min-height: 520px;
    padding: 3rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    box-sizing: border-box;
    color: #ffffff;
  }

  .bottom-section {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .badge {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    color: #b3f73c;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .card-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2.75rem;
    font-weight: 500;
    color: #ffffff;
    margin: 0 0 1.75rem 0;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .card-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
  }

  .specs-grid {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 2rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .spec-item {
    display: flex;
    flex-direction: column;
  }

  .spec-label {
    font-size: 0.65rem;
    font-weight: 700;
    color: #b0b8b2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .spec-value {
    font-size: 1.1rem;
    font-weight: 700;
    color: #ffffff;
    margin-top: 0.35rem;
  }

  .arrow-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background-color: #b3f73c;
    color: #000000;
    text-decoration: none;
    flex-shrink: 0;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .arrow-button:hover {
    transform: scale(1.05);
    background-color: #a3e62c;
  }

  .arrow-icon {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 640px) {
    .card-content {
      padding: 1.5rem;
      min-height: 440px;
    }
    .card-title {
      font-size: 2rem;
    }
    .specs-grid {
      gap: 1rem;
    }
  }
</style>