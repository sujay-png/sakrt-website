---
/* src/components/Product/ProductBarrierSection.astro */
import PouchesCard from './PouchesCard.astro';
import FilmsCard from './FilmsCard.astro';
---

<section class="barrier-section">
  <!-- Product Cards Grid -->
  <div class="barrier-grid" data-reveal-group>
    <a href="/compostable-product/compostable-pouches" class="card-link">
      <PouchesCard />
    </a>
    <FilmsCard linkHref="/compostable-product/compostable-films" />
  </div>

  <!-- Full-Width Bottom Grey Divider Line -->
  <hr class="section-divider" />
</section>

<style>
  .barrier-section {
    padding: 1.5rem var(--gutter) 3rem;
    max-width: var(--maxw);
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  .card-link {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  /* Narrow + wide specimen pair, equal height via stretch. */
  .barrier-grid {
    display: grid;
    grid-template-columns: 1.2fr 1.6fr;
    gap: 1.5rem;
    align-items: stretch;
    margin-bottom: 4rem;
  }

  .section-divider {
    border: none;
    height: 1px;
    background-color: var(--hairline);
    width: 100%;
    margin: 0;
  }

  @media (max-width: 992px) {
    .barrier-grid {
      grid-template-columns: 1fr;
    }
  }
</style>