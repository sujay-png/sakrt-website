---
/* src/components/Product/WaterBottleCard.astro */
import { Image } from 'astro:assets';
import defaultProductImg from '../../images/biodegradable_water.png';

interface Props {
  seriesNumber?: string;
  category?: string;
  title?: string;
  productImage?: ImageMetadata | string;
  description?: string;
  specsHref?: string;
}

const {
  seriesNumber = "01",
  category = "HYDRATION",
  title = "Eco-Friendly Water Bottles",
  productImage = defaultProductImg,
  description = "Plant-based polymer with 0% microplastic leaching.",
  specsHref = "#specs",
} = Astro.props;
---

<div class="bottle-card">
  <!-- Top Header Metadata -->
  <div class="card-header">
    <span class="header-meta">{seriesNumber} // {category}</span>
    <svg class="droplet-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
    </svg>
  </div>

  <!-- Title -->
  <h2 class="card-title">{title}</h2>

  <!-- Central Product Image Container with Zoom Hover Effect -->
  <div 
    class="image-wrapper" 
    style="overflow: hidden; display: flex; align-items: center; justify-content: center; width: 100%; min-height: 220px; cursor: pointer;"
  >
    {typeof productImage === 'string' ? (
      <img 
        src={productImage} 
        alt={title} 
        class="zoom-img"
        style="max-height: 200px; width: auto; object-fit: contain; transition: transform 1.1s var(--ease-settle); transform-origin: center center;"
      />
    ) : (
      <Image 
        src={productImage} 
        alt={title} 
        class="zoom-img"
        style="max-height: 200px; width: auto; object-fit: contain; transition: transform 1.1s var(--ease-settle); transform-origin: center center;" 
      />
    )}
  </div>

  <!-- Footer Specs & Summary -->
  <div class="card-footer">
    <p class="description">{description}</p>
    <a href={specsHref} class="specs-link">VIEW SPECS</a>
  </div>
</div>

<style>
  /* Shared product-card language: --surface shell, hairline border,
     --r-lg corners, one settle hover. See sibling Product/*Card.astro. */
  .bottle-card {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 340px;
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    box-shadow: var(--shadow-1);
    transition: transform var(--dur-2) var(--ease-settle),
                box-shadow var(--dur-2) var(--ease-settle),
                border-color var(--dur-2) var(--ease-settle);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--s-5);
  }

  .header-meta {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--ink-muted);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .droplet-icon {
    width: 18px;
    height: 18px;
    color: var(--ink-muted);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 400;
    font-synthesis-weight: none;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 var(--s-6) 0;
    color: var(--ink);
  }

  /* The photo sits in an identical --pulp-deep specimen tile. */
  .image-wrapper {
    flex-grow: 1;
    margin-bottom: var(--s-8);
    background: var(--pulp-deep);
    border-radius: var(--r-md);
    padding: var(--s-5);
  }

  .zoom-img {
    transition: transform 1.1s var(--ease-settle);
  }

  .card-footer {
    border-top: 1px solid var(--hairline);
    padding-top: var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .description {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
  }

  /* Was lime text on white (1.5:1). Ink link keeps it legible. */
  .specs-link {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    letter-spacing: 0.1em;
  }

  @media (hover: hover) {
    .bottle-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-2);
      border-color: var(--hairline-strong);
    }
    .bottle-card:hover .zoom-img { transform: scale(1.045); }
  }

  @media (max-width: 640px) {
    .bottle-card {
      padding: var(--s-6);
    }
  }
</style>