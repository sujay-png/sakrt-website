---
/* src/components/Product/FilmsCard.astro */
import { Image } from 'astro:assets';
import defaultFilmsImg from '../../images/compostable_film.png'; // Update path to your image

interface Props {
  seriesNumber?: string;
  category?: string;
  title?: string;
  description?: string;
  linkHref?: string;
  productImage?: ImageMetadata | string;
}

const {
  seriesNumber = "05",
  category = "INDUSTRIAL",
  title = "Compostable Films",
  description = "Ultra-thin, high-clarity stretch and shrink films for logistics.",
  linkHref = "#tech-data",
  productImage = defaultFilmsImg,
} = Astro.props;
---

<div class="films-card">
  <!-- Content Side -->
  <div class="card-content">
    <div class="card-header">
      <span class="header-meta">{seriesNumber} // {category}</span>
    </div>

    <h2 class="card-title">{title}</h2>
    <p class="description">{description}</p>

    <a href={linkHref} class="tech-link">
      <span>VIEW TECHNICAL DATA</span>
      <svg class="external-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        <polyline points="15 3 21 3 21 9"></polyline>
        <line x1="10" y1="14" x2="21" y2="3"></line>
      </svg>
    </a>
  </div>

  <!-- Image Side with Zoom Hover -->
  <div 
    class="image-wrapper" 
    style="overflow: hidden; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; cursor: pointer;"
  >
    {typeof productImage === 'string' ? (
      <img 
        src={productImage} 
        alt={title} 
        class="zoom-img"
        style="width: 100%; height: 100%; object-fit: contain; transition: transform 1.1s var(--ease-settle); transform-origin: center center;"
      />
    ) : (
      <Image 
        src={productImage} 
        alt={title} 
        class="zoom-img"
        style="width: 100%; height: 100%; object-fit: contain; transition: transform 1.1s var(--ease-settle); transform-origin: center center;" 
      />
    )}
  </div>
</div>

<style>
  /* Shared product-card language: --surface shell, hairline border,
     --r-lg corners, one settle hover. See sibling Product/*Card.astro. */
  .films-card {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 340px;
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--hairline);
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
    box-sizing: border-box;
    box-shadow: var(--shadow-1);
    transition: transform var(--dur-2) var(--ease-settle),
                box-shadow var(--dur-2) var(--ease-settle),
                border-color var(--dur-2) var(--ease-settle);
  }

  .card-content {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
  }

  .card-header {
    margin-bottom: var(--s-5);
  }

  .header-meta {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--ink-muted);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 400;
    font-synthesis-weight: none;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 var(--s-5) 0;
    color: var(--ink);
  }

  .description {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0 0 var(--s-8) 0;
    max-width: 42ch;
  }

  .tech-link {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: 0.1em;
    transition: color var(--dur-1) var(--ease-out);
  }

  .external-icon {
    width: 14px;
    height: 14px;
  }

  /* The photo sits in an identical --pulp-deep specimen tile. */
  .image-wrapper {
    background: var(--pulp-deep);
    padding: var(--s-6);
  }

  .zoom-img {
    transition: transform 1.1s var(--ease-settle);
  }

  @media (hover: hover) {
    .films-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-2);
      border-color: var(--hairline-strong);
    }
    .films-card:hover .zoom-img { transform: scale(1.045); }
    .tech-link:hover { color: var(--brand); }
  }

  @media (max-width: 992px) {
    .films-card {
      grid-template-columns: 1fr;
    }
    .image-wrapper {
      height: 260px !important;
    }
  }

  @media (max-width: 640px) {
    .card-content {
      padding: var(--s-6);
    }
  }
</style>