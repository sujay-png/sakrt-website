---
/* src/components/Product/TableWareCard.astro */
import { Image } from 'astro:assets';
import defaultTablewareImg from '../../images/Tableware.png'; // Update image path if needed

interface Props {
  seriesNumber?: string;
  category?: string;
  title?: string;
  features?: string[];
  productImage?: ImageMetadata | string;
  buttonText?: string;
  buttonHref?: string;
}

const {
  seriesNumber = "03",
  category = "CULINARY",
  title = "Designer Table Ware",
  features = [
    "Heat resistant up to 100°C",
    "Microwave & Freezer safe",
    "100% Home compostable",
  ],
  productImage = defaultTablewareImg,
  buttonText = "EXPLORE RANGE",
  buttonHref = "#explore",
} = Astro.props;
---

<div class="tableware-card">
  <!-- Left Side Text & Specs -->
  <div class="text-content">
    <div class="card-header">
      <span class="header-meta">{seriesNumber} // {category}</span>
    </div>

    <h2 class="card-title">{title}</h2>

    <ul class="features-list">
      {features.map((feature) => (
        <li class="feature-item">
          <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M8 12l3 3 5-5"></path>
          </svg>
          <span>{feature}</span>
        </li>
      ))}
    </ul>

    <a href={buttonHref} class="explore-btn">
      <span>{buttonText}</span>
      <svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>

  <!-- Right Side Product Image with Zoom Hover Effect -->
  <div 
    class="image-wrapper" 
    style="overflow: hidden; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; cursor: pointer;"
  >
    {typeof productImage === 'string' ? (
      <img 
        src={productImage} 
        alt={title} 
        class="zoom-img"
        style="width: 100%; height: 100%; object-fit: contain; transition: transform 1.1s var(--ease-settle); transform-origin: center center;"
      />
    ) : (
      <Image 
        src={productImage} 
        alt={title} 
        class="zoom-img"
        style="width: 100%; height: 100%; object-fit: contain; transition: transform 1.1s var(--ease-settle); transform-origin: center center;" 
      />
    )}
  </div>
</div>

<style>
  /* Shared product-card language: --surface shell, hairline border,
     --r-lg corners, one settle hover. See sibling Product/*Card.astro. */
  .tableware-card {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 340px;
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(1.5rem, 3vw, 2rem);
    align-items: center;
    box-sizing: border-box;
    box-shadow: var(--shadow-1);
    transition: transform var(--dur-2) var(--ease-settle),
                box-shadow var(--dur-2) var(--ease-settle),
                border-color var(--dur-2) var(--ease-settle);
  }

  .text-content {
    display: flex;
    flex-direction: column;
  }

  .card-header {
    margin-bottom: var(--s-5);
  }

  .header-meta {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--ink-muted);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 400;
    font-synthesis-weight: none;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 var(--s-8) 0;
    color: var(--ink);
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--s-10) 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    color: var(--ink-soft);
  }

  .check-icon {
    width: 18px;
    height: 18px;
    color: var(--brand);
    flex-shrink: 0;
  }

  .explore-btn {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    width: fit-content;
    min-height: 44px;
    padding: 0 var(--s-5);
    background-color: var(--ink);
    color: var(--on-dark);
    text-decoration: none;
    border-radius: var(--r-pill);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.1em;
    transition: transform var(--dur-1) var(--ease-out),
                background-color var(--dur-1) var(--ease-out);
  }

  .btn-arrow {
    width: 16px;
    height: 16px;
  }

  /* The photo sits in an identical --pulp-deep specimen tile. */
  .image-wrapper {
    background: var(--pulp-deep);
    border-radius: var(--r-md);
    padding: var(--s-5);
  }

  .zoom-img {
    transition: transform 1.1s var(--ease-settle);
  }

  @media (hover: hover) {
    .tableware-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-2);
      border-color: var(--hairline-strong);
    }
    .tableware-card:hover .zoom-img { transform: scale(1.045); }
    .explore-btn:hover {
      background-color: var(--brand);
      transform: translateY(-2px);
    }
  }

  @media (max-width: 992px) {
    .tableware-card {
      grid-template-columns: 1fr;
    }
    .image-wrapper {
      height: 280px !important;
    }
  }

  @media (max-width: 640px) {
    .tableware-card {
      padding: var(--s-6);
    }
  }
</style> 