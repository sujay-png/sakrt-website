---
/* src/components/Product/TableWareCard.astro */
import { Image } from 'astro:assets';
import defaultTablewareImg from '../../images/Tableware.png'; // Update image path if needed

interface Props {
  seriesNumber?: string;
  category?: string;
  title?: string;
  features?: string[];
  productImage?: ImageMetadata | string;
  buttonText?: string;
  buttonHref?: string;
}

const {
  seriesNumber = "03",
  category = "CULINARY",
  title = "Designer Table Ware",
  features = [
    "Heat resistant up to 100°C",
    "Microwave & Freezer safe",
    "100% Home compostable",
  ],
  productImage = defaultTablewareImg,
  buttonText = "EXPLORE RANGE",
  buttonHref = "#explore",
} = Astro.props;
---

<div class="tableware-card">
  <!-- Left Side Text & Specs -->
  <div class="text-content">
    <div class="card-header">
      <span class="header-meta">{seriesNumber} // {category}</span>
    </div>

    <h2 class="card-title">{title}</h2>

    <ul class="features-list">
      {features.map((feature) => (
        <li class="feature-item">
          <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M8 12l3 3 5-5"></path>
          </svg>
          <span>{feature}</span>
        </li>
      ))}
    </ul>

    <a href={buttonHref} class="explore-btn">
      <span>{buttonText}</span>
      <svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>

  <!-- Right Side Product Image with Zoom Hover Effect -->
  <div 
    class="image-wrapper" 
    style="overflow: hidden; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; cursor: pointer;"
  >
    {typeof productImage === 'string' ? (
      <img 
        src={productImage} 
        alt={title} 
        class="zoom-img"
        style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease-in-out; transform-origin: center center;"
      />
    ) : (
      <Image 
        src={productImage} 
        alt={title} 
        class="zoom-img"
        style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease-in-out; transform-origin: center center;" 
      />
    )}
  </div>
</div>

<style>
  .tableware-card {
    position: relative;
    width: 100%;
    min-height: 520px;
    border-radius: 20px;
    background-color: #ffffff;
    padding: 3.5rem;
    margin-right: 2rem;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 2rem;
    align-items: center;
    box-sizing: border-box;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  .text-content {
    display: flex;
    flex-direction: column;
  }

  .card-header {
    margin-bottom: 1.25rem;
  }

  .header-meta {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 600;
    color: #444444;
    letter-spacing: 0.05em;
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1.10;
  margin: 0 0rem 2rem 0;
    color: #0b2e1b;
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 0.9rem;
    color: #333333;
  }

  .check-icon {
    width: 18px;
    height: 18px;
    color: #84cc16;
    flex-shrink: 0;
  }

  .explore-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: fit-content;
    padding: 0.85rem 1.5rem;
    background-color: #0b2e1b;
    color: #ffffff;
    text-decoration: none;
    border-radius: 8px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    transition: background-color 0.2s ease;
  }

  .explore-btn:hover {
    background-color: #12452a;
  }

  .btn-arrow {
    width: 16px;
    height: 16px;
  }

  .image-wrapper {
    border-radius: 16px;
  }

  /* Direct CSS Hover Target for the image */
  .tableware-card:hover .zoom-img,
  .image-wrapper:hover .zoom-img {
    transform: scale(1.08) !important;
  }

  @media (max-width: 992px) {
    .tableware-card {
      grid-template-columns: 1fr;
    }
    .image-wrapper {
      height: 280px !important;
    }
  }
</style> 