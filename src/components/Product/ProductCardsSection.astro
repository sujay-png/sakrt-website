---
/* src/components/Product/ProductCardsSection.astro */
import CarrierBagCard from './CarrierBagCard.astro';
import WaterBottleCard from './WaterBottleCard.astro';
---

<section class="cards-section">
  <div class="cards-grid" data-reveal-group>
    <CarrierBagCard href="/compostable-product/carry-bags" />
    <WaterBottleCard specsHref="/compostable-product/biodegradable-water-bottles" />
  </div>
</section>

<style>
  .cards-section {
    padding: 3rem var(--gutter);
    max-width: var(--maxw);
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  /* Wide + narrow specimen pair, equal height via stretch. */
  .cards-grid {
    display: grid;
    grid-template-columns: 2.1fr 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  @media (max-width: 992px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>