---
// src/components/Product/AllProductsGrid.astro

// Centralized catalog of all products using images from the public directory
const products = [
  { title: "Biodegradable Water Bottle", url: "/productdetails/biodegradable-water-bottle", image: "/biodegradable_water.png" },
  { title: "Compostable Bag", url: "/productdetails/compostable-bags/compostable-bag", image: "/compostable-bags/imgi_4_biodegradable-bags-compostable-products-ecofriendly-bags-1-1.webp" },
  { title: "Compostable Nursery Bags", url: "/productdetails/compostable-bags/compostable-nursery-bags", image: "/compostable-bags/imgi_7_Compostable-grow-bags-e1780576071172.webp"},
  { title: "Compostable Grocery Bag", url: "/productdetails/compostable-bags/compostable-grocery-bag", image: "/compostable-bags/imgi_12_biodegradable-bags-compostable-products-eco-products-3.webp" },
  
  { title: "Compostable Medical Waste Bags", url: "/productdetails/compostable-bags/compostable-medical-waste-bags", image: "/compostable-bags/imgi_8_biodegradable-bags-compostable-products-ecofriendly-bags-1-3.webp" },
  { title: "Compostable Mailer Bags", url: "/productdetails/compostable-bags/compostable-mailer-bags", image: "/compostable-bags/imgi_11_courier-bags.webp" },
  { title: "Stand-up Pouches", url: "/productdetails/stand-up-pouches/stand-up-pouch", image: "src/images/biodegradable_greybags.png" },
  { title: "Compostable Garment Bags", url: "/productdetails/compostable-bags/compostable-garment-bags", image: "/compostable-bags/imgi_9_biodegradable-bags-compostable-products-ecofriendly-bags-2-1.webp" },
  
  { title: "Compostable Dona Bowl", url: "/productdetails/designer-tableware/compostable-dona-bowl", image: "/tableware/imgi_12_biodegradable-bags-compostable-products-eco-product-1.webp" },
  { title: "Compostable Plates", url: "/productdetails/designer-tableware/compostable-food-plates", image: "/tableware/imgi_7_biodegradable-bags-compostable-products-eco-product.-1.webp" },
  { title: "Compostable Bowls", url: "/productdetails/designer-tableware/compostable-bowl", image: "/tableware/imgi_6_biodegradable-bags-compostable-products-eco-product.webp" },
  { title: "Compostable Round Cup", url: "/productdetails/designer-tableware/compostable-round-cup", image: "/tableware/imgi_5_biodegradable-bags-compostable-products-eco-products.webp" },
  
  { title: "Compostable Compartment Trays", url: "/productdetails/designer-tableware/compostable-compartment-plate", image:"/tableware/imgi_13_biodegradable-bags-compostable-products-eco-products-1.webp"  },
  { title: "Compostable Cutlery", url: "/productdetails/designer-tableware/compostable-cutleries", image: "/tableware/imgi_10_biodegradable-bags-compostable-products-eco-product.-2.webp"  },
  { title: "Compostable Wrapping Films", url: "/productdetails/compostable-films/compostable-wrapping-film", image: "/compostable-films/imgi_4_compostable-strecth-films.webp" },
  { title: "Compostable Heat Shrink Films", url: "/productdetails/compostable-films/compostable-heat-shrink-films", image: "/compostable-films/imgi_6_Shirnk-films.webp" }
];
---

<section class="all-products-section">
  <div class="grid-container">
    
    <div class="product-grid" id="productGrid">
      {products.map((product, index) => (
        <div class="product-card" data-index={index}>
          <div class="card-image-box">
            <img src={product.image} alt={product.title} loading="lazy" />
          </div>
          <div class="card-content">
            <h3 class="product-title">{product.title}</h3>
            <a href={product.url} class="view-details-btn">View Details</a>
          </div>
        </div>
      ))}
    </div>

    <div class="toggle-wrapper">
      <button id="toggleGridBtn" class="toggle-btn">VIEW MORE</button>
    </div>

  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  :root {
    --color-bg: #f8f9f6;
    --color-card-bg: #ffffff;
    --color-text-dark: #0d3d26;
    --color-btn-green: #256449; /* Dark green button color from screenshot */
  }

  .all-products-section {
    background-color: var(--color-bg);
    padding: 0 24px 80px 24px;
    display: flex;
    justify-content: center;
  }

  .grid-container {
    max-width: 1100px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* 4 Column Grid on Desktop */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px 24px;
    width: 100%;
    margin-bottom: 50px;
    scroll-margin-top: 120px; /* Offset for fixed header when View Less is clicked */
  }

  /* Product Card matches screenshot structure */
  .product-card {
    background-color: transparent;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .card-image-box {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 16px;
    border: 1px solid #e2e8e4;
    transition: box-shadow 0.3s ease;
  }

  .card-image-box img {
    max-width: 85%;
    max-height: 85%;
    object-fit: contain;
    transition: transform 0.4s ease;
  }

  .product-card:hover .card-image-box {
    box-shadow: 0 12px 24px rgba(13, 61, 38, 0.08);
  }

  .product-card:hover .card-image-box img {
    transform: scale(1.05);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .product-title {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-dark);
    line-height: 1.4;
    margin: 0 0 12px 0;
    min-height: 40px; /* Aligns buttons nicely */
  }

  .view-details-btn {
    background-color: var(--color-btn-green);
    color: #ffffff;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    padding: 8px 24px;
    border-radius: 4px; /* Slight roundness like screenshot */
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .view-details-btn:hover {
    background-color: #17422f;
    transform: translateY(-2px);
  }

  /* Toggle Button */
  .toggle-wrapper {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: 20px;
  }

  .toggle-btn {
    background-color: transparent;
    border: 1px solid var(--color-text-dark);
    color: var(--color-text-dark);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 14px 32px;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .toggle-btn:hover {
    background-color: var(--color-text-dark);
    color: #ffffff;
  }

  /* Visibility Logic */
  .product-card.hidden {
    display: none !important;
  }

  /* Responsive styling */
  @media (max-width: 900px) {
    .product-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px 16px;
    }
    .all-products-section {
      padding: 0 16px 60px 16px;
    }
  }

  @media (max-width: 480px) {
    .product-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function initGridToggle() {
    const grid = document.getElementById('productGrid');
    const toggleBtn = document.getElementById('toggleGridBtn') as HTMLButtonElement;
    
    if (!grid || !toggleBtn) return;
    
    const cards = grid.querySelectorAll('.product-card');
    let isExpanded = false;

    function getLimit() {
      // 3 lines in pc (4 cols * 3 = 12, or 3 cols * 3 = 9), 5 items in phone
      const width = window.innerWidth;
      if (width <= 480) return 5;
      if (width <= 900) return 9; 
      return 12; 
    }

    function updateVisibility() {
      const limit = getLimit();
      
      cards.forEach((card, index) => {
        if (isExpanded) {
          card.classList.remove('hidden');
        } else {
          if (index < limit) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        }
      });
      
      toggleBtn.textContent = isExpanded ? 'VIEW LESS' : 'VIEW MORE';

      if (cards.length <= limit) {
        toggleBtn.style.display = 'none';
      } else {
        toggleBtn.style.display = 'inline-block';
      }
    }

    updateVisibility();

    toggleBtn.addEventListener('click', () => {
      isExpanded = !isExpanded;
      updateVisibility();
      
      if (!isExpanded) {
         grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    window.addEventListener('resize', () => {
      if (!isExpanded) {
        updateVisibility();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initGridToggle);
  document.addEventListener('astro:page-load', initGridToggle);
</script>
