---
/* src/components/Product/GrowBagsCard.astro */
interface Props {
  badgeText?: string;
  title?: string;
  description?: string;
  tags?: string[];
  bgImage?: string;
}

const {
  badgeText = "AGRI-TECH",
  title = "Compostable Grow Bags",
  description = "Industrial-strength aeration fabrics for vertical farming and commercial nurseries.",
  tags = ["UV RESISTANT", "ROOT-PRUNING"],
  bgImage,
} = Astro.props;
---

<div class="grow-card">
  {bgImage && (
    <div class="bg-wrapper">
      <img src={bgImage} alt={title} class="bg-img" />
      <div class="overlay"></div>
    </div>
  )}

  <div class="card-content">
    <div class="bottom-section">
      <div class="badge">{badgeText}</div>
      <h2 class="card-title">{title}</h2>
      <p class="description">{description}</p>

      <div class="tags-row">
        {tags.map((tag) => (
          <span class="pill-tag">{tag}</span>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  /* Shared product-card language: --surface shell, hairline border,
     --r-lg corners, one settle hover. See sibling Product/*Card.astro. */
  .grow-card {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 340px;
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--hairline);
    box-shadow: var(--shadow-1);
    overflow: hidden;
    box-sizing: border-box;
    transition: transform var(--dur-2) var(--ease-settle),
                box-shadow var(--dur-2) var(--ease-settle),
                border-color var(--dur-2) var(--ease-settle);
  }

  /* Optional background photo path (only rendered when bgImage is passed):
     a light pulp scrim keeps the ink text legible over any image. */
  .bg-wrapper {
    position: absolute;
    inset: 0;
  }

  .bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-settle);
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg,
      rgba(242, 243, 237, 0.35) 0%,
      rgba(242, 243, 237, 0.82) 62%,
      rgba(242, 243, 237, 0.94) 100%);
  }

  .card-content {
    position: relative;
    z-index: 2;
    height: 100%;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    color: var(--ink-soft);
  }

  .bottom-section {
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .badge {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--ink-muted);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: var(--s-3);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 400;
    font-synthesis-weight: none;
    color: var(--ink);
    margin: 0 0 var(--s-4);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .description {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0 0 var(--s-8) 0;
    max-width: 46ch;
  }

  .tags-row {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .pill-tag {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--ink-muted);
    background-color: var(--pulp);
    border: 1px solid var(--hairline);
    padding: 6px 12px;
    border-radius: var(--r-pill);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (hover: hover) {
    .grow-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-2);
      border-color: var(--hairline-strong);
    }
    .grow-card:hover .bg-img { transform: scale(1.045); }
  }

  @media (max-width: 640px) {
    .card-content {
      padding: var(--s-6);
    }
  }
</style>