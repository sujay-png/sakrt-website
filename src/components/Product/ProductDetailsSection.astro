---
/* src/components/Product/compostable-productSection.astro */
import GrowBagsCard from './GrowBagsCard.astro';
import TableWareCard from './TableWareCard.astro';
---

<section class="cards-section">
  <div class="cards-grid">
    <a href="/compostable-product/compostable-grow-bags" class="card-link">
      <GrowBagsCard />
    </a>
    <TableWareCard buttonHref="/compostable-product/food-packaging-boxes" />
  </div>
</section>

<style>
  .cards-section {
    padding: 1.5rem;
    max-width: 1320px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  /* Adjust grid columns to make GrowBagsCard wider and shift TableWareCard to the right */
  .cards-grid {
    display: grid;
    /* 
      1fr 1.4fr makes the GrowBags card wider relative to before, 
      while giving TableWare enough room to rest on the right side.
    */

    grid-template-columns: 1.5fr 1.95fr;
    gap: 1.94rem;
    align-items: stretch;
  }

  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  @media (max-width: 992px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>