---
/* src/components/Product/compostable-productSection.astro */
import GrowBagsCard from './GrowBagsCard.astro';
import TableWareCard from './TableWareCard.astro';
---

<section class="cards-section">
  <div class="cards-grid" data-reveal-group>
    <a href="/compostable-product/compostable-grow-bags" class="card-link">
      <GrowBagsCard />
    </a>
    <TableWareCard buttonHref="/compostable-product/food-packaging-boxes" />
  </div>
</section>

<style>
  .cards-section {
    padding: 1.5rem var(--gutter);
    max-width: var(--maxw);
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  /* Narrow + wide specimen pair, equal height via stretch. */
  .cards-grid {
    display: grid;
    grid-template-columns: 1.5fr 1.95fr;
    gap: 1.5rem;
    align-items: stretch;
  }

  .card-link {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  @media (max-width: 992px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>