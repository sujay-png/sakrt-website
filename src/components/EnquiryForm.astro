<div class="inquiry-card">
    <h3 class="inquiry-title">Inquire for Bulk Supply</h3>

    <form class="inquiry-form" id="inquiryForm">
        <div class="input-group">
            <input
                type="text"
                id="fullName"
                placeholder="Full Name"
                required
                class="form-input"
            />
        </div>
        <div class="input-group">
            <input
                type="text"
                id="phoneNumber"
                placeholder="Phone Number"
                required
                class="form-input"
            />
        </div>
        <div class="input-group">
            <input
                type="text"
                id="companyName"
                placeholder="Company Name"
                required
                class="form-input"
            />
        </div>

        <div class="input-group">
            <input
                type="email"
                id="businessEmail"
                placeholder="Business Email"
                required
                class="form-input"
            />
        </div>

        <div class="input-group">
            <input
                type="text"
                id="productCategory"
                placeholder="Product Type / Category"
                required
                class="form-input"
            />
        </div>
        <div class="input-group">
            <input
                type="text"
                id="productName"
                placeholder="Product Name"
                required
                class="form-input"
            />
        </div>

        <div class="input-group">
            <div class="number-wrapper">
                <input
                    type="number"
                    id="itemQuantity"
                    placeholder="Item Quantity"
                    required
                    class="form-input no-spin"
                    min="1"
                    value="1"
                />
                <div class="spin-arrows">
                    <button
                        type="button"
                        class="spin-up"
                        aria-label="Increase"
                        onclick="document.getElementById('itemQuantity').stepUp()"
                    >
                        <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><polyline points="18 15 12 9 6 15"></polyline></svg
                        >
                    </button>
                    <button
                        type="button"
                        class="spin-down"
                        aria-label="Decrease"
                        onclick="document.getElementById('itemQuantity').stepDown()"
                    >
                        <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><polyline points="6 9 12 15 18 9"></polyline></svg
                        >
                    </button>
                </div>
            </div>
        </div>
        <div class="input-group full-width">
            <textarea
                id="message"
                placeholder="Message"
                required
                class="form-input"></textarea>
        </div>

        <div class="full-width">
            <button type="submit" class="submit-btn"> SUBMIT INQUIRY </button>
        </div>
    </form>
</div>

<style>
    .inquiry-card {
        background-color: #0d3d26;
        border-radius: 20px;
        padding: 3rem 4rem;
    }

    .inquiry-title {
        font-family: var(--font-serif);
        font-size: 1.7rem;
        font-weight: 400;
        color: #ffffff;
        margin: 0 0 2rem 0;
        text-align: center;
    }

    .inquiry-form {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .input-group {
        position: relative;
        width: 100%;
    }

    /* Custom Number Input Spinners */
    .number-wrapper {
        position: relative;
        width: 100%;
    }

    .no-spin::-webkit-inner-spin-button,
    .no-spin::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    .no-spin {
        -moz-appearance: textfield;
        padding-right: 2.5rem;
    }

    .spin-arrows {
        position: absolute;
        right: 0.5rem;
        top: 0;
        bottom: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 4px;
    }

    .spin-arrows button {
        background: transparent;
        border: none;
        color: #bef264;
        cursor: pointer;
        padding: 0;
        height: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .spin-arrows button svg {
        width: 16px;
        height: 16px;
        transition: transform 0.1s;
    }

    .spin-arrows button:hover svg {
        transform: scale(1.2);
    }

    .form-input,
    .form-select {
        width: 100%;
        background-color: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 8px;
        padding: 0.85rem 1rem;
        font-size: 0.875rem;
        color: #ffffff;
        box-sizing: border-box;
        outline: none;
        transition: border-color 0.2s ease;
    }

    .form-input::placeholder {
        color: #8da397;
    }

    .form-input:focus,
    .form-select:focus {
        border-color: #a3e635;
    }

    .form-select {
        appearance: none;
        -webkit-appearance: none;
        color: #8da397;
        cursor: pointer;
    }

    .select-arrow {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        width: 16px;
        height: 16px;
        color: #8da397;
        pointer-events: none;
    }

    .submit-btn {
        width: 100%;
        background-color: #bef264;
        color: #0e2d1f;
        border: none;
        border-radius: 8px;
        padding: 1rem;
        font-family:
            ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        cursor: pointer;
        transition: background-color 0.2s ease;
        margin-top: 0.35rem;
    }

    .submit-btn:hover {
        background-color: #a3e635;
    }

    @media (max-width: 768px) {
        .inquiry-form {
            grid-template-columns: 1fr;
        }
        .inquiry-card {
            padding: 1.5rem 1.25rem;
            border-radius: 16px;
        }
        .inquiry-title {
            font-size: 1.35rem;
            margin-bottom: 1.5rem;
        }
    }
</style>
<script>
    async function handleFormSubmit(event: SubmitEvent) {
        event.preventDefault();

        const form = event.target as HTMLFormElement;
        const submitBtn = form.querySelector(
            ".submit-btn",
        ) as HTMLButtonElement;

        if (submitBtn) {
            submitBtn.textContent = "TRANSMITTING...";
            submitBtn.disabled = true;
        }

        const fullName = (
            document.getElementById("fullName") as HTMLInputElement
        ).value;
        const phoneNumber = (
            document.getElementById("phoneNumber") as HTMLInputElement
        ).value;
        const companyName = (
            document.getElementById("companyName") as HTMLInputElement
        ).value;
        const businessEmail = (
            document.getElementById("businessEmail") as HTMLInputElement
        ).value;
        const productCategory = (
            document.getElementById("productCategory") as HTMLInputElement
        ).value;
        const productName = (
            document.getElementById("productName") as HTMLInputElement
        ).value;
        const itemQuantity = (
            document.getElementById("itemQuantity") as HTMLInputElement
        ).value;
        const message = (
            document.getElementById("message") as HTMLTextAreaElement
        ).value;

        const payload = {
            fullName,
            phoneNumber,
            companyName,
            businessEmail,
            productCategory,
            productName,
            itemQuantity,
            message,
        };

        const text =
            `*New Bulk Supply Inquiry*%0A%0A` +
            `*Name:* ${fullName}%0A` +
            `*Phone:* ${phoneNumber}%0A` +
            `*Company:* ${companyName}%0A` +
            `*Email:* ${businessEmail}%0A` +
            `*Category:* ${productCategory}%0A` +
            `*Product:* ${productName}%0A` +
            `*Quantity:* ${itemQuantity}%0A` +
            `*Message:* ${message}`;

        const whatsappNumber = "+917975310662";
        const url = `https://wa.me/${whatsappNumber}?text=${text}`;

        try {
            // Option B: Run both API call (Sheets) and WhatsApp popup in parallel
            await Promise.all([
                fetch("/api/enquiry", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload),
                }),
                new Promise<void>((resolve) => {
                    window.open(url, "_blank");
                    resolve();
                }),
            ]);

            form.reset();
            alert("Your inquiry has been successfully submitted!");
        } catch (error) {
            console.error("Error submitting form:", error);
            alert(
                "Something went wrong submitting to the backend, but WhatsApp should have opened.",
            );
        } finally {
            if (submitBtn) {
                submitBtn.textContent = "SUBMIT INQUIRY";
                submitBtn.disabled = false;
            }
        }
    }

    const form = document.getElementById("inquiryForm") as HTMLFormElement;
    if (form) {
        form.addEventListener("submit", handleFormSubmit);
    }
</script>
