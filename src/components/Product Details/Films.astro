---
/* src/components/CompostableBag.astro */
---

<section class="product-detail-section">
  <div class="product-container">
    <!-- LEFT COLUMN: Product Gallery & Schematics -->
    <div class="left-column">
      <!-- Main Featured Image Showcase -->
      <div class="main-image-card" data-reveal>
        <!-- Replace src with your real product image path -->
        <img
          src="/src/images/compostable-bag.webp"
          alt="Compostable Bags"
          class="product-image"
        />

        <!-- Floating Material Focus Tag -->
        <div class="floating-material-card">
          <span class="tag-label">MATERIAL FOCUS</span>
          <h4 class="tag-title">100% Plant-Based Polymer</h4>
        </div>
      </div>

      <!-- Secondary Info Cards Grid -->
      <div class="schematics-grid" data-reveal-group>
        <!-- Technical Schematic Card -->
        <div class="spec-card schematic-card">
          <div class="schematic-diagram">
            <div class="height-indicator">
              <span>240MM HEIGHT</span>
            </div>
            <div class="bottle-outline"></div>
          </div>
          <p class="card-caption">TECHNICAL SCHEMATIC 01</p>
        </div>

        <!-- Total Capacity Card -->
        <div class="spec-card capacity-card">
          <div class="leaf-icon">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                d="M11 20A9 9 0 0 0 20 11V3h-8a9 9 0 0 0-9 9 9 9 0 0 0 8 8zm0 0V11"
              ></path>
            </svg>
          </div>
          <h3 class="capacity-number">650ml</h3>
          <p class="card-caption">TOTAL CAPACITY</p>
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: Details, Specs, & Inquire Form -->
    <div class="right-column">
      <div class="product-info-card" data-reveal>
        <!-- Badges -->
        <div class="badge-group">
          <span class="badge lime-badge">CPCB CERTIFIED</span>
          <span class="badge muted-badge">COMPOSTABLE</span>
        </div>

        <!-- Title & Description -->
        <h1 class="product-title">
          Eco-Friendly carry bag for Shopping,<br />Food, and Everyday Use
        </h1>
        <p class="product-description">
          1)Made from 100% biodegradable, plant-based resources. 2)Supports
          custom photo printing for vibrant, attention-grabbing designs.
          3)Breaks down naturally without polluting soil or water. 4)Strong
          enough for everyday shopping and handling. 5)Ideal for eco-conscious
          brands, events, and retail stores. 6)A clean, sustainable replacement
          for traditional plastic bags. 7)Carry bag.
        </p>

        <!-- Technical Specifications Grid -->
        <div class="tech-specs-container">
          <h2 class="specs-section-title">TECHNICAL SPECIFICATIONS</h2>
          <div class="specs-grid" data-reveal-group>
            <div class="spec-item">
              <span class="spec-label">COMPOSITION</span>
              <span class="spec-value">100% Bio-Polymer</span>
            </div>

            <div class="spec-item">
              <span class="spec-label">CERTIFICATION</span>
              <span class="spec-value">ISO 17088 / CPCB</span>
            </div>

            <div class="spec-item">
              <span class="spec-label">TOXICITY</span>
              <span class="spec-value">Zero-BPA / Non-Toxic</span>
            </div>

            <div class="spec-item">
              <span class="spec-label">DEGRADATION</span>
              <span class="spec-value">180 Days (Industrial)</span>
            </div>
          </div>
        </div>

        <!-- Dark Bulk Supply Form Card -->
        <div class="inquiry-card">
          <h3 class="inquiry-title">Inquire for Bulk Supply</h3>

          <form class="inquiry-form" onsubmit="event.preventDefault();">
            <div class="input-group">
              <input
                type="text"
                placeholder="Full Name"
                required
                class="form-input"
              />
            </div>

            <div class="input-group">
              <input
                type="email"
                placeholder="Business Email"
                required
                class="form-input"
              />
            </div>

            <div class="input-group">
              <select class="form-select" required>
                <option value="" disabled selected
                  >Quantity: 1k - 5k units</option
                >
                <option value="1k-5k">1k - 5k units</option>
                <option value="5k-10k">5k - 10k units</option>
                <option value="10k+">10k+ units</option>
              </select>
              <svg
                class="select-arrow"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>

            <button type="submit" class="submit-btn"> REQUEST A QUOTE </button>
          </form>
        </div>

        <!-- Footer Verification Tag -->
        <div class="verified-footer">
          <svg
            class="check-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          <span>VERIFIED CIRCULAR ECONOMY ASSET</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Base Layout */
  .product-detail-section {
    width: 100%;
    background-color: var(--pulp);
    padding: 8rem 1.5rem 3rem;
    box-sizing: border-box;
    font-family: var(--font-sans);
  }

  .product-container {
    max-width: var(--maxw);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2rem;
    align-items: start;
  }

  /* LEFT COLUMN STYLES */
  .left-column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Main Featured Image Card */
  .main-image-card {
    position: relative;
    width: 100%;
    height: 520px;
    border-radius: var(--r-xl);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-image {
    width: 50%;
    height: 120%;
    object-fit: cover;
    object-position: center;
  }

  /* Floating Tag inside Main Image */
  .floating-material-card {
    position: absolute;
    bottom: 24px;
    left: 24px;
    background-color: var(--brand);
    padding: 1.25rem 1.5rem;
    border-radius: var(--r-md);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    max-width: 260px;
  }

  .tag-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--lime);
    letter-spacing: 0.12em;
    margin-bottom: 0.4rem;
  }

  .tag-title {
    font-family: var(--font-display);
    font-size: var(--fs-body);
    font-weight: 400;
    color: var(--on-dark);
    margin: 0;
    line-height: 1.25;
  }

  /* Schematics & Spec Cards Grid */
  .schematics-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .spec-card {
    height: 220px;
    border-radius: var(--r-lg);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
  }

  .card-caption {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--ink-muted);
    letter-spacing: 0.12em;
    margin: 0;
    text-transform: uppercase;
  }

  /* Schematic Card Specifics */
  .schematic-card {
    background-color: var(--pulp-deep);
  }

  .schematic-diagram {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 1.25rem;
  }

  .height-indicator {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--ink-soft);
    letter-spacing: 0.1em;
  }

  .bottle-outline {
    width: 65px;
    height: 110px;
    border: 1.5px dashed rgba(58, 74, 65, 0.4);
    border-radius: var(--r-xs);
    position: relative;
  }

  /* Capacity Card Specifics */
  .capacity-card {
    background-color: var(--pulp-deep);
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .leaf-icon {
    width: 32px;
    height: 32px;
    color: var(--brand);
    margin-bottom: 0.5rem;
  }

  .capacity-number {
    font-family: var(--font-display);
    font-size: 1.91rem;
    font-weight: 400;
    color: var(--brand);
    margin: 0 0 0.25rem 0;
  }

  /* RIGHT COLUMN STYLES */
  .product-info-card {
    background-color: var(--surface);
    border-radius: var(--r-xl);
    padding: 3rem 2.5rem 2.5rem 2.5rem;
    box-shadow: var(--shadow-1);
  }

  /* Badges */
  .badge-group {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 1.75rem;
  }

  .badge {
    padding: 0.35rem 0.65rem;
    border-radius: var(--r-xs);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .lime-badge {
    background-color: var(--lime-soft);
    color: var(--lime-ink);
  }

  .muted-badge {
    background-color: var(--pulp-deep);
    color: var(--ink-muted);
  }

  /* Product Title & Info */
  .product-title {
    font-family: var(--font-display);
    font-size: 2.98rem;
    font-weight: 400;
    color: var(--brand);
    line-height: 1.05;
    margin: 0 0 1.25rem 0;
    letter-spacing: -0.02em;
  }

  .product-description {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0 0 2.25rem 0;
  }

  /* Specifications Grid */
  .tech-specs-container {
    border-top: 1px solid var(--hairline);
    padding-top: 1.75rem;
    margin-bottom: 2rem;
  }

  .specs-section-title {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--ink-soft);
    letter-spacing: 0.12em;
    margin: 0 0 1.5rem 0;
  }

  .specs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 2rem;
  }

  .spec-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .spec-label {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--ink-muted);
    letter-spacing: 0.08em;
  }

  .spec-value {
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--ink);
  }

  /* Bulk Supply Form Box */
  .inquiry-card {
    background-color: var(--brand);
    border-radius: var(--r-md);
    padding: 1.75rem;
    margin-bottom: 1.5rem;
  }

  .inquiry-title {
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    font-weight: 400;
    color: var(--on-dark);
    margin: 0 0 1.25rem 0;
  }

  .inquiry-form {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .input-group {
    position: relative;
    width: 100%;
  }

  .form-input,
  .form-select {
    width: 100%;
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--r-sm);
    padding: 0.85rem 1rem;
    font-size: var(--fs-sm);
    color: var(--on-dark);
    box-sizing: border-box;
    outline: none;
    transition: border-color var(--dur-1) var(--ease-out);
  }

  .form-input::placeholder {
    color: var(--on-dark-muted);
  }

  .form-input:focus,
  .form-select:focus {
    border-color: var(--lime);
  }

  .form-select {
    appearance: none;
    -webkit-appearance: none;
    color: var(--on-dark-muted);
    cursor: pointer;
  }

  .select-arrow {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: var(--on-dark-muted);
    pointer-events: none;
  }

  .submit-btn {
    width: 100%;
    background-color: var(--lime);
    color: var(--ink);
    border: none;
    border-radius: var(--r-sm);
    padding: 1rem;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: background-color var(--dur-1) var(--ease-out);
    margin-top: 0.35rem;
  }

  @media (hover: hover) {
    .submit-btn:hover {
      background-color: #c2ec24;
    }
  }

  /* Verified Footer Tag */
  .verified-footer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    color: var(--ink-muted);
    letter-spacing: 0.08em;
    padding-left: 0.25rem;
  }

  .check-icon {
    width: 14px;
    height: 14px;
    color: var(--ink-muted);
  }

  /* Responsive Adjustments */
  @media (max-width: 1024px) {
    .product-container {
      grid-template-columns: 1fr;
    }

    .main-image-card {
      height: 420px;
    }
  }

  @media (max-width: 640px) {
    .product-title {
      font-size: 2.5rem;
    }

    .schematics-grid,
    .specs-grid {
      grid-template-columns: 1fr;
    }

    .product-info-card {
      padding: 1.75rem 1.25rem;
    }
  }
</style>
