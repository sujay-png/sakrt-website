---
import EnquiryForm from '../EnquiryForm.astro';
import Accordion from '../Shared/Accordion.astro';
import RelatedProducts from '../Shared/RelatedProducts.astro';
import ModernFAQ from '../Shared/ModernFAQ.astro';

export interface ProductData {
  longTitle?: string;
  aboutTitle?: string;
  aboutBullets?: string[];
  ratingText?: string;
  whyChooseTitle?: string;
  whyChooseText?: string[];
  additionalDetailsTitle?: string;
  additionalDetails?: string[];
  usageApplications?: string[];
  badges?: { id?: string; title: string; subtitle: string; svg: string }[];
  faqs?: { question: string; answer: string }[];
  hideCpcbBadge?: boolean;
}

export interface Props {
  productName?: string;
  productImage?: string;
  relatedProducts?: any[];
  productData?: ProductData | Record<string, any>;
  accordionPlacement?: 'right' | 'bottom';
  accordionItems?: any[];
  faqs?: { question: string; answer: string }[];
}

const { 
  productName = "Compostable Product",
  productImage = "",
  relatedProducts = [],
  productData = {},
  accordionPlacement = "right",
  faqs = productData?.faqs || []
} = Astro.props;

const accordionOnRight = accordionPlacement === "right";

const longTitle = productData?.longTitle || productName;
const aboutTitle = productData?.aboutTitle || "About This Item";
const aboutBullets = productData?.aboutBullets || [];
const ratingText = productData?.ratingText || "";
const whyChooseTitle = productData?.whyChooseTitle || `Why Choose ${productName}?`;
const whyChooseText = productData?.whyChooseText || [];
const additionalDetailsTitle = productData?.additionalDetailsTitle || "Additional Product Details";
const additionalDetails = productData?.additionalDetails || [];
const usageApplications = productData?.usageApplications || [];
const hideCpcbBadge = productData?.hideCpcbBadge === true;

const defaultFeatureBadges = [
  {
    id: "certified",
    title: "Certified",
    subtitle: "Product",
    svg: `<svg class="badge-icon-svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>`
  },
  {
    id: "delivery",
    title: "Ontime",
    subtitle: "Delivery",
    svg: `<svg class="badge-icon-svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.24-4.05A1 1 0 0 0 17.76 8H14"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/><path d="M1 9h3"/><path d="M2 13h2"/></svg>`
  },
  {
    id: "custom",
    title: "Custom",
    subtitle: "Orders",
    svg: `<svg class="badge-icon-svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20h10"/><path d="M14 20v-2"/><path d="M17 20v-3"/><path d="M20 20v-2"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/><path d="m15 5 3 3"/></svg>`
  },
  {
    id: "returns",
    title: "Easy",
    subtitle: "Returns",
    svg: `<svg class="badge-icon-svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 2.5-6.14L3 8"/><path d="M3 3v5h5"/><rect x="9" y="9.5" width="6" height="5.5" rx="1"/><path d="M9 12h6"/></svg>`
  }
];

const featureBadges = productData?.badges || defaultFeatureBadges;

const accordionItems = Astro.props.accordionItems || [
  whyChooseText && whyChooseText.length > 0 && {
    value: "why-choose",
    trigger: whyChooseTitle,
    content: Array.isArray(whyChooseText)
      ? whyChooseText.map((text: string) => `<p>${text}</p>`).join("")
      : `<p>${whyChooseText}</p>`
  },
  additionalDetails && additionalDetails.length > 0 && {
    value: "additional-details",
    trigger: additionalDetailsTitle,
    content: `<ul class="bullet-list">` + additionalDetails.map((detail: string) => `<li>${detail}</li>`).join("") + `</ul>`
  },
  usageApplications && usageApplications.length > 0 && {
    value: "usage-applications",
    trigger: "Usage Applications",
    content: `<ul class="bullet-list">` + usageApplications.map((app: string) => `<li>${app}</li>`).join("") + `</ul>`
  }
].filter(Boolean);
---

<section class="product-detail-page">
  <div class="container">
    
    <!-- Top Section: Image and Title/Bullets -->
    <div class={`top-section ${accordionOnRight ? 'accordion-on-right' : ''}`}>
      <div class="image-column">
        <div class="image-wrapper">
          <img src={productImage} alt={productName} class="main-image" />
        </div>
      </div>
      
      <div class="info-column">
        <h1 class="product-title">{longTitle}</h1>
        
        <div class="badges-row">
          {featureBadges.map((badge: any) => (
            <div class="badge-item">
              <div class="badge-icon-circle">
                <Fragment set:html={badge.svg} />
              </div>
              <span class="badge-label">{badge.title}<br/>{badge.subtitle}</span>
            </div>
          ))}
        </div>
        
        {aboutBullets && aboutBullets.length > 0 && (
          <>
            <h3 class="about-title">{aboutTitle}</h3>
            <ul class="feature-list">
              {aboutBullets.map((bullet: string) => (
                <li><Fragment set:html={bullet} /></li>
              ))}
            </ul>
          </>
        )}

        {(!hideCpcbBadge || ratingText) && (
          <div class="certification-block">
            {!hideCpcbBadge && (
              <div class="cpcb-tag">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                <span>CPCB CERTIFIED</span>
              </div>
            )}
            {ratingText && (
              <div class="rating-text">
                {ratingText} <span class="stars">★★★★★</span>
              </div>
            )}
          </div>
        )}

        <div class="product-action-buttons">
          <a href="/contact-us" class="btn-primary">ENQUIRE NOW</a>
          <a href="#bulk-order-form" class="btn-secondary">ORDER IN BULK</a>
        </div>

        <!-- Trust Badges Row -->
        <div class="product-trust-badges">
          <div class="trust-badge">
            <div class="trust-badge-circle">
              <svg class="trust-badge-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
            </div>
            <span class="trust-badge-text">CIPET Certified</span>
          </div>

          <div class="trust-badge">
            <div class="trust-badge-circle">
              <svg class="trust-badge-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
                <path d="m3.3 7 8.7 5 8.7-5"></path>
                <path d="M12 12v10"></path>
              </svg>
            </div>
            <span class="trust-badge-text">Easy Order</span>
          </div>

          <div class="trust-badge">
            <div class="trust-badge-circle">
              <svg class="trust-badge-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9.5"></circle>
                <path d="M8.5 7.5h7"></path>
                <path d="M8.5 10.5h5"></path>
                <path d="M10.5 7.5v1.2a2.4 2.4 0 0 0 0 4.8h.5l3.5 4.5"></path>
              </svg>
            </div>
            <span class="trust-badge-text">Easy Payment</span>
          </div>
        </div>
      </div>

      {accordionItems && accordionItems.length > 0 && accordionOnRight && (
        <div class="accordion-column">
          <Accordion items={accordionItems} />
        </div>
      )}
    </div>

    <!-- Accordion Section (default placement for other pages until approved) -->
    {accordionItems && accordionItems.length > 0 && !accordionOnRight && (
      <Accordion items={accordionItems} />
    )}

    {faqs && faqs.length > 0 && (
      <div class="faqs-wrapper" style="margin-top: 3.5rem;">
        <ModernFAQ title="Frequently Asked Questions" faqs={faqs} />
      </div>
    )}

    {relatedProducts && relatedProducts.length > 0 && (
      <RelatedProducts products={relatedProducts} />
    )}

    <!-- Enquiry Form Section -->
    <div class="enquiry-section" id="bulk-order-form">
      <h2 class="section-title text-center">Ready to Go Green?</h2>
      <p class="section-subtitle text-center">Reach out for bulk orders, custom branding, or distribution partnerships.</p>
      
      <div class="form-wrapper">
        <EnquiryForm />
      </div>
    </div>

  </div>
</section>

<style>
  .product-detail-page {
    background-color: #ffffff;
    padding: 2.5rem 1rem 3.5rem;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #333;
    overflow-x: clip;
  }

  @media (min-width: 768px) {
    .product-detail-page {
      padding: 3.5rem 1.5rem 4rem;
    }
  }

  @media (min-width: 1025px) {
    .product-detail-page {
      padding: 8rem 1.5rem 4rem;
    }
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  /* Typography */
  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 1.25rem;
  }

  .sub-section-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 1rem;
  }
  
  .description-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #555;
    margin-bottom: 1.25rem;
  }

  .text-center {
    text-align: center;
  }

  .product-title {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.2;
    color: #111;
    margin-bottom: 1.5rem;
    word-break: break-word;
  }

  @media (min-width: 768px) {
    .product-title {
      font-size: 2.25rem;
      margin-bottom: 1.75rem;
    }
  }

  @media (min-width: 1025px) {
    .product-title {
      font-size: 2.5rem;
      margin-bottom: 2rem;
    }
  }

  @media (max-width: 480px) {
    .product-title {
      font-size: 1.5rem;
      line-height: 1.25;
      margin-bottom: 1.25rem;
    }
  }

  /* Top Section */
  .top-section {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: 3.5rem;
  }

  .image-column {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .info-column {
    width: 100%;
    min-width: 0;
  }

  /* Image Container & Responsiveness */
  .image-wrapper {
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
    border-radius: 12px;
    background-color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .main-image {
    width: 100%;
    max-width: 100%;
    height: auto;
    max-height: 480px;
    object-fit: contain;
    display: block;
  }

  @media (max-width: 480px) {
    .image-wrapper {
      max-width: 100%;
    }

    .main-image {
      max-height: 380px;
    }
  }

  /* Accordion on Right Layout:
     - Mobile & Tablet (<= 1024px): 1 single column (image on top, details below it, accordion at bottom)
     - Laptop/Desktop (>= 1025px): 2 columns (image on left, details & accordion on right, exactly as before)
  */
  .top-section.accordion-on-right {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: 3.5rem;
  }

  .top-section.accordion-on-right .image-column {
    grid-column: 1;
    grid-row: 1;
    position: static;
    align-self: auto;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .top-section.accordion-on-right .info-column {
    grid-column: 1;
    grid-row: 2;
    width: 100%;
    min-width: 0;
  }

  .top-section.accordion-on-right .accordion-column {
    grid-column: 1;
    grid-row: 3;
    width: 100%;
    min-width: 0;
  }

  /* Laptop & Desktop (min-width: 1025px): Image on left, details and accordion on right (EXACT original design) */
  @media (min-width: 1025px) {
    .top-section.accordion-on-right {
      grid-template-columns: 1fr 1fr;
      column-gap: 4rem;
      row-gap: 2rem;
      align-items: start;
      margin-bottom: 4rem;
    }

    .top-section.accordion-on-right .image-column {
      grid-column: 1;
      grid-row: 1 / span 2;
      position: sticky;
      top: 120px;
      align-self: start;
      display: block;
    }

    .top-section.accordion-on-right .image-wrapper {
      max-width: none;
      margin: 0;
    }

    .top-section.accordion-on-right .main-image {
      max-height: none;
    }

    .top-section.accordion-on-right .info-column {
      grid-column: 2;
      grid-row: 1;
    }

    .top-section.accordion-on-right .accordion-column {
      grid-column: 2;
      grid-row: 2;
    }

    .top-section.accordion-on-right .accordion-column :global(.shadcn-accordion) {
      margin-bottom: 0;
    }
  }

  /* Badges Row - 4 Feature Icons Row */
  .badges-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-bottom: 2.25rem;
    width: 100%;
    box-sizing: border-box;
    padding: 0.35rem 0;
  }

  .badges-row .badge-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
    padding: 6px 8px;
    box-sizing: border-box;
    cursor: default;
    background: transparent !important;
    background-color: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    min-height: 0 !important;
    box-shadow: none !important;
    transition: transform 0.25s ease;
  }

  /* Thin light divider line between items on tablet/desktop */
  .badges-row .badge-item:not(:last-child)::after {
    content: "";
    position: absolute;
    right: 0;
    top: 15%;
    height: 70%;
    width: 1px;
    background-color: #dcece1;
  }

  /* Round soft green circle */
  .badges-row .badge-icon-circle {
    width: 56px;
    height: 56px;
    min-width: 56px;
    min-height: 56px;
    border-radius: 50% !important;
    background-color: #eef7f2 !important;
    border: 1px solid #cce8d5 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: #0d3d26;
    margin-bottom: 0.65rem;
    box-sizing: border-box;
    transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
  }

  /* Reach SVG drawings inside the circle without Astro scoping blockage */
  .badges-row :global(.badge-icon-svg),
  .badges-row .badge-icon-circle :global(svg) {
    width: 28px !important;
    height: 28px !important;
    min-width: 28px !important;
    min-height: 28px !important;
    stroke: currentColor !important;
    color: #0d3d26;
    display: block !important;
    flex-shrink: 0;
    transition: transform 0.25s ease, stroke 0.25s ease;
  }

  /* Label below circle: bold, clean, dark green */
  .badges-row .badge-label {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.25;
    color: #0d3d26 !important;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-align: center;
  }

  /* Hover on laptop: circle fills with dark green, icon turns white, lifts with soft shadow */
  @media (hover: hover) and (pointer: fine) {
    .badges-row .badge-item:hover {
      transform: translateY(-3px);
    }

    .badges-row .badge-item:hover .badge-icon-circle {
      background-color: #0d3d26 !important;
      border-color: #0d3d26 !important;
      color: #ffffff !important;
      box-shadow: 0 6px 16px rgba(13, 61, 38, 0.2) !important;
    }

    .badges-row .badge-item:hover :global(svg) {
      stroke: #ffffff !important;
      color: #ffffff !important;
    }
  }

  /* Tablet: all 4 in one row with divider lines */
  @media (max-width: 1024px) and (min-width: 641px) {
    .badges-row {
      margin-bottom: 2rem;
    }

    .badges-row .badge-item {
      padding: 6px 6px;
    }

    .badges-row .badge-icon-circle {
      width: 52px;
      height: 52px;
      min-width: 52px;
      min-height: 52px;
      margin-bottom: 0.55rem;
    }

    .badges-row :global(.badge-icon-svg),
    .badges-row .badge-icon-circle :global(svg) {
      width: 26px !important;
      height: 26px !important;
      min-width: 26px !important;
      min-height: 26px !important;
    }

    .badges-row .badge-label {
      font-size: 0.74rem;
    }
  }

  /* Mobile: 2x2 grid with equal spacing, no divider lines */
  @media (max-width: 640px) {
    .badges-row {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 16px 12px;
      margin-bottom: 1.75rem;
    }

    .badges-row .badge-item {
      padding: 10px 6px;
    }

    .badges-row .badge-item:not(:last-child)::after {
      display: none !important;
    }

    .badges-row .badge-icon-circle {
      width: 50px;
      height: 50px;
      min-width: 50px;
      min-height: 50px;
      margin-bottom: 0.55rem;
    }

    .badges-row :global(.badge-icon-svg),
    .badges-row .badge-icon-circle :global(svg) {
      width: 24px !important;
      height: 24px !important;
      min-width: 24px !important;
      min-height: 24px !important;
    }

    .badges-row .badge-label {
      font-size: 0.74rem;
    }
  }

  @media (max-width: 360px) {
    .badges-row {
      gap: 12px 6px;
    }

    .badges-row .badge-item {
      padding: 8px 4px;
    }

    .badges-row .badge-icon-circle {
      width: 46px;
      height: 46px;
      min-width: 46px;
      min-height: 46px;
      margin-bottom: 0.45rem;
    }

    .badges-row :global(.badge-icon-svg),
    .badges-row .badge-icon-circle :global(svg) {
      width: 22px !important;
      height: 22px !important;
      min-width: 22px !important;
      min-height: 22px !important;
    }

    .badges-row .badge-label {
      font-size: 0.68rem;
    }
  }

  /* Features List */
  .about-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 1rem;
  }

  .feature-list {
    list-style: disc;
    padding-left: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .feature-list li {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #555;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 480px) {
    .feature-list li {
      font-size: 0.9rem;
      line-height: 1.55;
    }
  }

  /* CPCB Certification Block */
  .certification-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.65rem;
    margin-top: 2rem;
    margin-bottom: 1.75rem;
    width: 100%;
  }

  .cpcb-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: #4da674;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }

  .rating-text {
    font-size: 0.85rem;
    color: #666;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    text-align: center;
    gap: 0.35rem;
    width: 100%;
  }

  .stars {
    color: #fbbf24;
    font-size: 1rem;
    margin-left: 0.25rem;
    white-space: nowrap;
    display: inline-block;
  }

  /* Action Buttons */
  .product-action-buttons {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 0;
    margin-bottom: 24px;
    width: 100%;
    box-sizing: border-box;
  }

  .product-action-buttons a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 14px 28px;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.3s ease;
    min-height: 48px;
    box-sizing: border-box;
    touch-action: manipulation;
  }

  .btn-primary {
    background-color: var(--color-accent-lime, #8ce02c);
    color: var(--color-primary-dark, #0d3d26);
    box-shadow: 0 8px 20px rgba(140, 224, 44, 0.2);
  }

  .btn-primary:hover {
    background-color: var(--color-accent-lime-bright, #CFF737);
    transform: translateY(-2px);
    box-shadow: 0 12px 25px rgba(140, 224, 44, 0.3);
  }

  .btn-secondary {
    background-color: #ffffff;
    color: #000000;
    border: 1.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
  }

  .btn-secondary:hover {
    transform: translate(2px, 2px);
