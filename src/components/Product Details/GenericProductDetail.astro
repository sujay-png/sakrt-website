---
import EnquiryForm from '../EnquiryForm.astro';

export interface Props {
  productName?: string;
  productImage?: string;
  relatedProducts?: any[];
  productData?: any;
}

const { 
  productName = "Compostable Product",
  productImage = "",
  relatedProducts = [],
  productData = {}
} = Astro.props;

const longTitle = productData?.longTitle || productName;
const aboutTitle = productData?.aboutTitle || "About This Item";
const aboutBullets = productData?.aboutBullets || [
  "Made from 100% biodegradable, plant-based resources.",
  "Supports custom photo printing for vibrant, attention-grabbing designs.",
  "Breaks down naturally without polluting soil or water.",
  "Strong enough for everyday shopping and handling.",
  "Ideal for eco-conscious brands, events, and retail stores.",
  "A clean, sustainable replacement for traditional plastic bags."
];
const ratingText = productData?.ratingText || "BPA-free and non-toxic, safe for daily use.";
const whyChooseTitle = productData?.whyChooseTitle || `Why Choose ${productName}?`;
const whyChooseText = productData?.whyChooseText || [
  "Compostable products are a great eco-friendly option instead of plastic. They help cut down on pollution, help the environment in a sustainable way, and turn into harmless organic material on their own. Using compostable bags means businesses and people are helping to make the planet cleaner, while also getting strong, good-looking, and safe packaging options.",
  "Compostable products help the environment by using materials made from plants, like cornstarch, which break down completely into nutrients, water, and carbon dioxide without leaving harmful microplastics. These products cut down on carbon emissions, lessen the need for fossil fuels, improve soil health, and provide a strong, eco-friendly alternative to plastic. They make waste management easier and help support efforts to create a circular economy."
];
const additionalDetailsTitle = productData?.additionalDetailsTitle || "Additional Product Details";
const additionalDetails = productData?.additionalDetails || [
  "<strong>Material:</strong> Made from 100% plant-based, biodegradable materials.",
  "<strong>Sizes & Shapes:</strong> Available in multiple sizes to suit groceries, retail items, and takeaway food.",
  "<strong>Durability:</strong> Strong and tear-resistant for everyday use.",
  "<strong>Design Options:</strong> Can be custom printed with logos or vibrant images for branding purposes.",
  "<strong>Safety:</strong> Non-toxic, food-safe, and environmentally friendly."
];
const usageApplications = productData?.usageApplications || [
  "Perfect for groceries, boutiques, and eco-conscious stores.",
  "Ideal for takeaway, catering, or bakery items.",
  "Great for giveaways, exhibitions, and eco-friendly campaigns.",
  "Convenient for carrying personal items, books, or small household goods."
];
---

<section class="product-detail-page">
  <div class="container">
    
    <!-- Top Section: Image and Title/Bullets -->
    <div class="top-section">
      <div class="image-column">
        <div class="image-wrapper">
          <img src={productImage} alt={productName} class="main-image" />
        </div>
      </div>
      
      <div class="info-column">
        <h1 class="product-title">{longTitle}</h1>
        
        <div class="badges-row">
          <div class="badge-item">
            <img class="badge-icon" src="/products-icon/imgi_5_product.png" alt="Certified Product" />
            <span>Certified<br/>Product</span>
          </div>
          <div class="badge-item">
            <img class="badge-icon" src="/products-icon/imgi_6_order.png" alt="Ontime Delivery" />
            <span>Ontime<br/>Delivery</span>
          </div>
          <div class="badge-item">
            <img class="badge-icon" src="/products-icon/imgi_7_bag.png" alt="Custom Orders" />
            <span>Custom<br/>Orders</span>
          </div>
          <div class="badge-item">
            <img class="badge-icon" src="/products-icon/imgi_8_exchange.png" alt="Easy Returns" />
            <span>Easy<br/>Returns</span>
          </div>
        </div>
        
        <h3 class="about-title">{aboutTitle}</h3>
        <ul class="feature-list">
          {aboutBullets.map((bullet: string) => (
            <li><Fragment set:html={bullet} /></li>
          ))}
        </ul>

        <div class="certification-block">
          <div class="cpcb-tag">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            <span>CPCB CERTIFIED</span>
          </div>
          <div class="rating-text">
            {ratingText} <span class="stars">★★★★★</span>
          </div>
        </div>

        <div class="product-action-buttons">
          <a href="/contact-us" class="btn-primary">ENQUIRE NOW</a>
          <a href="#bulk-order-form" class="btn-secondary">ORDER IN BULK</a>
        </div>
      </div>
    </div>

    <!-- Why Choose Section -->
    <div class="why-choose-section">
      <h2 class="section-title">{whyChooseTitle}</h2>
      {whyChooseText.map((text: string) => (
        <p class="description-text">{text}</p>
      ))}
    </div>

    <!-- Additional Details & Usage Grid -->
    <div class="details-usage-grid">
      <div class="additional-details">
        <h3 class="sub-section-title">{additionalDetailsTitle}</h3>
        <ul class="details-list">
          {additionalDetails.map((detail: string) => (
            <li><Fragment set:html={detail} /></li>
          ))}
        </ul>
      </div>
      
      <div class="usage-applications">
        <h3 class="sub-section-title">Usage Applications:</h3>
        <ul class="usage-list">
          {usageApplications.map((app: string) => (
            <li><Fragment set:html={app} /></li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Related Products -->
    {relatedProducts && relatedProducts.length > 0 && (
      <div class="related-products-section">
        <h2 class="section-title">Related Products</h2>
        <div class="related-grid">
          {relatedProducts.map((rp: any) => (
            <div class="related-card">
              <a href={`/compostable-product/${rp.category}/${rp.slug}`} class="related-img-wrapper">
                <img src={rp.image} alt={rp.name} />
              </a>
              <h4 class="related-title">{rp.name}</h4>
              <a href={`/compostable-product/${rp.category}/${rp.slug}`} class="view-details-btn">View Details</a>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Enquiry Form Section -->
    <div class="enquiry-section" id="bulk-order-form">
      <h2 class="section-title text-center">Ready to Go Green?</h2>
      <p class="section-subtitle text-center">Reach out for bulk orders, custom branding, or distribution partnerships.</p>
      
      <div class="form-wrapper">
        <EnquiryForm />
      </div>
    </div>

  </div>
</section>

<style>
  .product-detail-page {
    background-color: #ffffff;
    padding: 8rem 1.5rem 4rem;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #333;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Typography */
  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 1.25rem;
  }

  .sub-section-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 1rem;
  }
  
  .description-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #555;
    margin-bottom: 1.25rem;
  }

  .text-center {
    text-align: center;
  }

  /* Top Section */
  .top-section {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 768px) {
    .top-section {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  .image-wrapper {
    width: 100%;
    border-radius: 12px;
    background-color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .main-image {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .product-title {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    color: #111;
    margin-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .product-title {
      font-size: 2.5rem;
    }
  }

  /* Badges Row */
  .badges-row {
    display: flex;
    gap: 2rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .badge-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    font-size: 0.75rem;
    color: #4da674;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badge-icon {
    width: 40px;
    height: 40px;
    margin-bottom: 0.5rem;
    object-fit: contain;
  }

  /* Features List */
  .about-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 1rem;
  }

  .feature-list {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 2rem;
  }

  .feature-list li {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #555;
    margin-bottom: 0.5rem;
  }

  /* CPCB Certification Block */
  .certification-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cpcb-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #4da674;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }

  .rating-text {
    font-size: 0.85rem;
    color: #666;
  }

  .stars {
    color: #fbbf24;
    font-size: 1rem;
    margin-left: 0.25rem;
  }

  /* Why Choose Section */
  .why-choose-section {
    margin-bottom: 4rem;
  }

  /* Details and Usage Grid */
  .details-usage-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 768px) {
    .details-usage-grid {
      grid-template-columns: 6fr 4fr;
      gap: 3rem;
    }
  }

  .details-list, .usage-list {
    list-style: disc;
    padding-left: 1.25rem;
  }

  .details-list li, .usage-list li {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #555;
    margin-bottom: 0.5rem;
  }

  .details-list strong {
    color: #111;
  }

  .usage-applications {
    background-color: #f3f4f6; /* Light grey box */
    padding: 2rem;
    border-radius: 8px;
  }

  /* Related Products */
  .related-products-section {
    margin-bottom: 5rem;
    border-top: 1px solid #eee;
    padding-top: 3rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }

  @media (min-width: 768px) {
    .related-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }
  }

  .related-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .related-img-wrapper {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f9f9f9;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .related-img-wrapper:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
  }

  .related-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  
  .related-img-wrapper:hover img {
    transform: scale(1.05);
  }

  .related-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: #111;
    margin-bottom: 1rem;
    height: 2.4em; /* clamp height to align buttons */
    overflow: hidden;
  }

  .view-details-btn {
    background-color: #2b7a4b;
    color: white;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.6rem 1.5rem;
    border-radius: 20px;
    transition: background-color 0.2s;
  }

  .view-details-btn:hover {
    background-color: #1e5c37;
  }

  /* Enquiry Section */
  .enquiry-section {
    padding: 2rem 0;
    margin-top: 4rem;
    margin-bottom: 2rem;
  }

  .section-subtitle {
    font-size: 1rem;
    color: #555;
    margin-bottom: 2.5rem;
  }

  .form-wrapper {
    max-width: 700px;
    margin: 0 auto;
  }

  /* Action Buttons */
  .product-action-buttons {
    display: flex;
    gap: 16px;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  .product-action-buttons a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 14px 28px;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .btn-primary {
    background-color: var(--color-accent-lime, #8ce02c);
    color: var(--color-primary-dark, #0d3d26);
    box-shadow: 0 8px 20px rgba(140, 224, 44, 0.2);
  }

  .btn-primary:hover {
    background-color: var(--color-accent-lime-bright, #CFF737);
    transform: translateY(-2px);
    box-shadow: 0 12px 25px rgba(140, 224, 44, 0.3);
  }

  .btn-secondary {
    background-color: #ffffff;
    color: #000000;
    border: 1.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
  }

  .btn-secondary:hover {
    transform: translate(2px, 2px);
    box-shadow: 0px 0px 0px #000000;
  }

  @media (max-width: 768px) {
    .product-action-buttons {
      flex-direction: column;
      width: 100%;
      gap: 12px;
    }
    
    .product-action-buttons a {
      width: 100%;
      text-align: center;
    }
  }
</style>
