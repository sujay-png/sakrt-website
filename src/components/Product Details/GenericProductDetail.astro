---
import EnquiryForm from '../EnquiryForm.astro';
import Accordion from '../Shared/Accordion.astro';
import RelatedProducts from '../Shared/RelatedProducts.astro';



export interface ProductData {
  longTitle?: string;
  aboutTitle?: string;
  aboutBullets?: string[];
  ratingText?: string;
  whyChooseTitle?: string;
  whyChooseText?: string[];
  additionalDetailsTitle?: string;
  additionalDetails?: string[];
  usageApplications?: string[];
  badges?: { icon: string; title: string; subtitle: string }[];
}

export interface Props {
  productName?: string;
  productImage?: string;
  relatedProducts?: any[];
  productData?: ProductData | Record<string, any>;
  accordionPlacement?: 'right' | 'bottom';
}

const { 
  productName = "Compostable Product",
  productImage = "",
  relatedProducts = [],
  productData = {},
  accordionPlacement
} = Astro.props;

const accordionOnRight = accordionPlacement ? accordionPlacement === "right" : true;

const longTitle = productData?.longTitle || productName;
const aboutTitle = productData?.aboutTitle || "About This Item";
const aboutBullets = productData?.aboutBullets || [
  "Made from 100% biodegradable, plant-based resources.",
  "Supports custom photo printing for vibrant, attention-grabbing designs.",
  "Breaks down naturally without polluting soil or water.",
  "Strong enough for everyday shopping and handling.",
  "Ideal for eco-conscious brands, events, and retail stores.",
  "A clean, sustainable replacement for traditional plastic bags."
];
const ratingText = productData?.ratingText || "BPA-free and non-toxic, safe for daily use.";
const whyChooseTitle = productData?.whyChooseTitle || `Why Choose ${productName}?`;
const whyChooseText = productData?.whyChooseText || [
  "Compostable products are a great eco-friendly option instead of plastic. They help cut down on pollution, help the environment in a sustainable way, and turn into harmless organic material on their own. Using compostable bags means businesses and people are helping to make the planet cleaner, while also getting strong, good-looking, and safe packaging options.",
  "Compostable products help the environment by using materials made from plants, like cornstarch, which break down completely into nutrients, water, and carbon dioxide without leaving harmful microplastics. These products cut down on carbon emissions, lessen the need for fossil fuels, improve soil health, and provide a strong, eco-friendly alternative to plastic. They make waste management easier and help support efforts to create a circular economy."
];
const additionalDetailsTitle = productData?.additionalDetailsTitle || "Additional Product Details";
const additionalDetails = productData?.additionalDetails || [
  "<strong>Material:</strong> Made from 100% plant-based, biodegradable materials.",
  "<strong>Sizes & Shapes:</strong> Available in multiple sizes to suit groceries, retail items, and takeaway food.",
  "<strong>Durability:</strong> Strong and tear-resistant for everyday use.",
  "<strong>Design Options:</strong> Can be custom printed with logos or vibrant images for branding purposes.",
  "<strong>Safety:</strong> Non-toxic, food-safe, and environmentally friendly."
];
const usageApplications = productData?.usageApplications || [
  "Perfect for groceries, boutiques, and eco-conscious stores.",
  "Ideal for takeaway, catering, or bakery items.",
  "Great for giveaways, exhibitions, and eco-friendly campaigns.",
  "Convenient for carrying personal items, books, or small household goods."
];

const accordionItems = [
  {
    value: "why-choose",
    trigger: whyChooseTitle,
    content: whyChooseText.map((text: string) => `<p>${text}</p>`).join("")
  },
  {
    value: "additional-details",
    trigger: additionalDetailsTitle,
    content: `<ul class="bullet-list">` + additionalDetails.map((detail: string) => `<li>${detail}</li>`).join("") + `</ul>`
  },
  {
    value: "usage-applications",
    trigger: "Usage Applications",
    content: `<ul class="bullet-list">` + usageApplications.map((app: string) => `<li>${app}</li>`).join("") + `</ul>`
  }
];
---

<section class="product-detail-page">
  <div class="container">
    
    <!-- Top Section: Image and Title/Bullets -->
    <div class={`top-section ${accordionOnRight ? 'accordion-on-right' : ''}`}>
      <div class="image-column">
        <div class="image-wrapper">
          <img src={productImage} alt={productName} class="main-image" />
        </div>
      </div>
      
      <div class="info-column">
        <h1 class="product-title">{longTitle}</h1>
        
        <div class="badges-row">
          <div class="badge-item">
            <img class="badge-icon" src="/products-icon/imgi_5_product.png" alt="Certified Product" />
            <span>Certified<br/>Product</span>
          </div>
          <div class="badge-item">
            <img class="badge-icon" src="/products-icon/imgi_6_order.png" alt="Ontime Delivery" />
            <span>Ontime<br/>Delivery</span>
          </div>
          <div class="badge-item">
            <img class="badge-icon" src="/products-icon/imgi_7_bag.png" alt="Custom Orders" />
            <span>Custom<br/>Orders</span>
          </div>
          <div class="badge-item">
            <img class="badge-icon" src="/products-icon/imgi_8_exchange.png" alt="Easy Returns" />
            <span>Easy<br/>Returns</span>
          </div>
        </div>
        
        <h3 class="about-title">{aboutTitle}</h3>
        <ul class="feature-list">
          {aboutBullets.map((bullet: string) => (
            <li><Fragment set:html={bullet} /></li>
          ))}
        </ul>

        <div class="certification-block">
          <div class="cpcb-tag">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            <span>CPCB CERTIFIED</span>
          </div>
          <div class="rating-text">
            {ratingText} <span class="stars">★★★★★</span>
          </div>
        </div>

        <div class="product-action-buttons">
          <a href="/contact-us" class="btn-primary">ENQUIRE NOW</a>
          <a href="#bulk-order-form" class="btn-secondary">ORDER IN BULK</a>
        </div>

        <!-- Trust Badges Row -->
        <div class="product-trust-badges">
          <div class="trust-badge">
            <div class="trust-badge-circle">
              <svg class="trust-badge-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
            </div>
            <span class="trust-badge-text">CIPET Certified</span>
          </div>

          <div class="trust-badge">
            <div class="trust-badge-circle">
              <svg class="trust-badge-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
                <path d="m3.3 7 8.7 5 8.7-5"></path>
                <path d="M12 12v10"></path>
              </svg>
            </div>
            <span class="trust-badge-text">Easy Order</span>
          </div>

          <div class="trust-badge">
            <div class="trust-badge-circle">
              <svg class="trust-badge-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9.5"></circle>
                <path d="M8.5 7.5h7"></path>
                <path d="M8.5 10.5h5"></path>
                <path d="M10.5 7.5v1.2a2.4 2.4 0 0 0 0 4.8h.5l3.5 4.5"></path>
              </svg>
            </div>
            <span class="trust-badge-text">Easy Payment</span>
          </div>
        </div>
      </div>

      {accordionOnRight && (
        <div class="accordion-column">
          <Accordion items={accordionItems} />
        </div>
      )}
    </div>

    <!-- Accordion Section (default placement for other pages until approved) -->
    {!accordionOnRight && (
      <Accordion items={accordionItems} />
    )}

    <!-- Related Products -->
    <RelatedProducts products={relatedProducts} />

    <!-- Enquiry Form Section -->
    <div class="enquiry-section" id="bulk-order-form">
      <h2 class="section-title text-center">Ready to Go Green?</h2>
      <p class="section-subtitle text-center">Reach out for bulk orders, custom branding, or distribution partnerships.</p>
      
      <div class="form-wrapper">
        <EnquiryForm />
      </div>
    </div>

  </div>
</section>

<style>
  .product-detail-page {
    background-color: #ffffff;
    padding: 2.5rem 1rem 3.5rem;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #333;
    overflow-x: clip;
  }

  @media (min-width: 768px) {
    .product-detail-page {
      padding: 3.5rem 1.5rem 4rem;
    }
  }

  @media (min-width: 1025px) {
    .product-detail-page {
      padding: 8rem 1.5rem 4rem;
    }
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  /* Typography */
  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 1.25rem;
  }

  .sub-section-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 1rem;
  }
  
  .description-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #555;
    margin-bottom: 1.25rem;
  }

  .text-center {
    text-align: center;
  }

  .product-title {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.2;
    color: #111;
    margin-bottom: 1.5rem;
    word-break: break-word;
  }

  @media (min-width: 768px) {
    .product-title {
      font-size: 2.25rem;
      margin-bottom: 1.75rem;
    }
  }

  @media (min-width: 1025px) {
    .product-title {
      font-size: 2.5rem;
      margin-bottom: 2rem;
    }
  }

  @media (max-width: 480px) {
    .product-title {
      font-size: 1.5rem;
      line-height: 1.25;
      margin-bottom: 1.25rem;
    }
  }

  /* Top Section */
  .top-section {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: 3.5rem;
  }

  .image-column {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .info-column {
    width: 100%;
    min-width: 0;
  }

  /* Image Container & Responsiveness */
  .image-wrapper {
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
    border-radius: 12px;
    background-color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .main-image {
    width: 100%;
    max-width: 100%;
    height: auto;
    max-height: 480px;
    object-fit: contain;
    display: block;
  }

  @media (max-width: 480px) {
    .image-wrapper {
      max-width: 100%;
    }

    .main-image {
      max-height: 380px;
    }
  }

  /* Accordion on Right Layout:
     - Mobile & Tablet (<= 1024px): 1 single column (image on top, details below it, accordion at bottom)
     - Laptop/Desktop (>= 1025px): 2 columns (image on left, details & accordion on right, exactly as before)
  */
  .top-section.accordion-on-right {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: 3.5rem;
  }

  .top-section.accordion-on-right .image-column {
    grid-column: 1;
    grid-row: 1;
    position: static;
    align-self: auto;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .top-section.accordion-on-right .info-column {
    grid-column: 1;
    grid-row: 2;
    width: 100%;
    min-width: 0;
  }

  .top-section.accordion-on-right .accordion-column {
    grid-column: 1;
    grid-row: 3;
    width: 100%;
    min-width: 0;
  }

  /* Laptop & Desktop (min-width: 1025px): Image on left, details and accordion on right (EXACT original design) */
  @media (min-width: 1025px) {
    .top-section.accordion-on-right {
      grid-template-columns: 1fr 1fr;
      column-gap: 4rem;
      row-gap: 2rem;
      align-items: start;
      margin-bottom: 4rem;
    }

    .top-section.accordion-on-right .image-column {
      grid-column: 1;
      grid-row: 1 / span 2;
      position: sticky;
      top: 120px;
      align-self: start;
      display: block;
    }

    .top-section.accordion-on-right .image-wrapper {
      max-width: none;
      margin: 0;
    }

    .top-section.accordion-on-right .main-image {
      max-height: none;
    }

    .top-section.accordion-on-right .info-column {
      grid-column: 2;
      grid-row: 1;
    }

    .top-section.accordion-on-right .accordion-column {
      grid-column: 2;
      grid-row: 2;
    }

    .top-section.accordion-on-right .accordion-column :global(.shadcn-accordion) {
      margin-bottom: 0;
    }
  }

  /* Badges Row - The 4 icons row (fits without overflow or horizontal scroll) */
  .badges-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 2rem;
    width: 100%;
    box-sizing: border-box;
  }

  .badge-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    font-size: 0.72rem;
    color: #4da674;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    min-width: 0;
  }

  .badge-item span {
    display: block;
    line-height: 1.25;
  }

  .badge-icon {
    width: 36px;
    height: 36px;
    margin-bottom: 0.5rem;
    object-fit: contain;
    flex-shrink: 0;
  }

  @media (min-width: 1025px) {
    .badges-row {
      display: flex;
      grid-template-columns: none;
      gap: 2rem;
      margin-bottom: 2rem;
      flex-wrap: wrap;
    }

    .badge-item {
      font-size: 0.75rem;
      letter-spacing: 0.05em;
    }

    .badge-icon {
      width: 40px;
      height: 40px;
    }
  }

  @media (max-width: 480px) {
    .badges-row {
      gap: 6px;
      margin-bottom: 1.5rem;
    }

    .badge-item {
      font-size: 0.64rem;
      letter-spacing: 0.01em;
    }

    .badge-icon {
      width: 30px;
      height: 30px;
      margin-bottom: 0.35rem;
    }
  }

  @media (max-width: 340px) {
    .badges-row {
      gap: 4px;
    }

    .badge-item {
      font-size: 0.58rem;
    }

    .badge-icon {
      width: 26px;
      height: 26px;
    }
  }

  /* Features List */
  .about-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 1rem;
  }

  .feature-list {
    list-style: disc;
    padding-left: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .feature-list li {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #555;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 480px) {
    .feature-list li {
      font-size: 0.9rem;
      line-height: 1.55;
    }
  }

  /* CPCB Certification Block */
  .certification-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .cpcb-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #4da674;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }

  .rating-text {
    font-size: 0.85rem;
    color: #666;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .stars {
    color: #fbbf24;
    font-size: 1rem;
    margin-left: 0.25rem;
  }

  /* Action Buttons */
  .product-action-buttons {
    display: flex;
    gap: 16px;
    margin-top: 28px;
    flex-wrap: wrap;
    width: 100%;
    box-sizing: border-box;
  }

  .product-action-buttons a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 14px 28px;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.3s ease;
    min-height: 48px;
    box-sizing: border-box;
    touch-action: manipulation;
  }

  .btn-primary {
    background-color: var(--color-accent-lime, #8ce02c);
    color: var(--color-primary-dark, #0d3d26);
    box-shadow: 0 8px 20px rgba(140, 224, 44, 0.2);
  }

  .btn-primary:hover {
    background-color: var(--color-accent-lime-bright, #CFF737);
    transform: translateY(-2px);
    box-shadow: 0 12px 25px rgba(140, 224, 44, 0.3);
  }

  .btn-secondary {
    background-color: #ffffff;
    color: #000000;
    border: 1.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
  }

  .btn-secondary:hover {
    transform: translate(2px, 2px);
    box-shadow: 0px 0px 0px #000000;
  }

  @media (min-width: 1025px) {
    .product-action-buttons {
      margin-top: 32px;
    }
  }

  @media (max-width: 600px) {
    .product-action-buttons {
      flex-direction: column;
      width: 100%;
      gap: 12px;
      margin-top: 24px;
    }

    .product-action-buttons a {
      width: 100%;
      padding: 14px 20px;
      text-align: center;
    }
  }

  /* Trust Badges Strip - The 3 icons row */
  .product-trust-badges {
    width: 100%;
    box-sizing: border-box;
    margin-top: 20px;
    margin-bottom: 20px;
    padding: 14px 0;
    border-top: 1px solid var(--color-border-subtle, #e3e5e0);
    border-bottom: 1px solid var(--color-border-subtle, #e3e5e0);
  }

  /* Desktop (>= 1025px): Exactly as original */
  @media (min-width: 1025px) {
    .product-trust-badges {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .trust-badge {
      display: inline-flex;
      flex-direction: row;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }

    .trust-badge-circle {
      width: 44px;
      height: 44px;
      min-width: 44px;
      min-height: 44px;
      border-radius: 50%;
      background-color: #0b2218;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .trust-badge-icon {
      width: 22px;
      height: 22px;
      min-width: 22px;
      min-height: 22px;
      color: #ffffff;
      stroke-width: 1.75px;
      flex-shrink: 0;
    }

    .trust-badge-text {
      font-size: 14px;
      font-weight: 500;
      color: var(--color-primary-dark, #103527);
      line-height: 1.2;
      white-space: nowrap;
    }
  }

  /* Tablet (601px - 1024px): Row layout with comfortable spacing across single column */
  @media (min-width: 601px) and (max-width: 1024px) {
    .product-trust-badges {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-around;
      gap: 16px;
    }

    .trust-badge {
      display: inline-flex;
      flex-direction: row;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }

    .trust-badge-circle {
      width: 40px;
      height: 40px;
      min-width: 40px;
      min-height: 40px;
      border-radius: 50%;
      background-color: #0b2218;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .trust-badge-icon {
      width: 20px;
      height: 20px;
      min-width: 20px;
      min-height: 20px;
      color: #ffffff;
      stroke-width: 1.75px;
      flex-shrink: 0;
    }

    .trust-badge-text {
      font-size: 13px;
      font-weight: 500;
      color: var(--color-primary-dark, #103527);
      line-height: 1.2;
      white-space: nowrap;
    }
  }

  /* Mobile (<= 600px): Clean 3-column grid, icon on top, text centered below. No overflow, no clipping */
  @media (max-width: 600px) {
    .product-trust-badges {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
      padding: 12px 0;
    }

    .trust-badge {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 6px;
      min-width: 0;
      width: 100%;
    }

    .trust-badge-circle {
      width: 36px;
      height: 36px;
      min-width: 36px;
      min-height: 36px;
      border-radius: 50%;
      background-color: #0b2218;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .trust-badge-icon {
      width: 18px;
      height: 18px;
      min-width: 18px;
      min-height: 18px;
      color: #ffffff;
      stroke-width: 1.75px;
    }

    .trust-badge-text {
      font-size: 11px;
      font-weight: 500;
      color: var(--color-primary-dark, #103527);
      line-height: 1.25;
      text-align: center;
      white-space: normal;
      word-break: normal;
    }
  }

  @media (max-width: 360px) {
    .product-trust-badges {
      gap: 4px;
    }

    .trust-badge-circle {
      width: 32px;
      height: 32px;
      min-width: 32px;
      min-height: 32px;
    }

    .trust-badge-icon {
      width: 16px;
      height: 16px;
    }

    .trust-badge-text {
      font-size: 10px;
    }
  }

  /* Enquiry Section */
  .enquiry-section {
    padding: 2rem 0;
    margin-top: 4rem;
    margin-bottom: 2rem;
  }

  .section-subtitle {
    font-size: 1rem;
    color: #555;
    margin-bottom: 2.5rem;
  }

  .form-wrapper {
    max-width: 700px;
    margin: 0 auto;
  }
</style>
