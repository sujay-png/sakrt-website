---
// src/components/Product Details/BiodegradableWaterBottle.astro
import productImg from '../../images/biodegradable_water.png';
import GenericProductDetail from './GenericProductDetail.astro';

const relatedProducts = [
  { name: "Compostable Wrapping Film", slug: "compostable-wrapping-film", category: "compostable-films", image: "/compostable-films/imgi_4_compostable-strecth-films.webp" },
  { name: "Compostable Medical Waste Bag", slug: "compostable-medical-waste-bags", category: "carry-bags", image: "/compostable-bags/imgi_8_biodegradable-bags-compostable-products-ecofriendly-bags-1-3.webp" },
  { name: "Compostable Custom Made Bag", slug: "compostable-custom-made-bag", category: "carry-bags", image: "/compostable-bags/imgi_6_biodegradable-bags-compostable-products-eco-product.-3.webp" },
  { name: "Compostable Mulch Films", slug: "compostable-mulch-films", category: "compostable-films", image: "/compostable-films/imgi_5_biodegradable-bags-compostable-products-ecofriendly-bags-1.webp" }
];

const faqs = [
  { question: "Do biodegradable plastic water bottles does not contain plastic content?", answer: "yes, biodegradable plastic water bottles don’t contain plastic materials. Biodegradable plastic water bottles are made from pla based compostable materials. Sugarcane bagasse and corn starch are the main two raw materials used to manufacture biodegradable plastic bottles. Biodegradable plastic is 100% compostable in nature. They are made from Sugarcane bagasse and corn starch which are the main two raw materials used to manufacture biodegradable plastic bottles and other biodegradable material." },
  { question: "How biodegradable plastic bottles are made?", answer: "Right now, they are mostly made from things like corn, beets, sugar cane, wood, potatoes, tapioca roots, or even nuts. But in the future, they will probably be made from leftover materials and waste. The word “renewable” usually means something that can be used again within 10 years. Biobased plastics can either be compostable or recyclable, depending on what they are made from." },
  { question: "What material is 100% biodegradable?", answer: "Materials such as PLA (Polylactic Acid) and PHA are fully biodegradable when placed in the correct composting environment." },
  { question: "What is the best eco-friendly water bottle?", answer: "Bottles made from recycled aluminum have the smallest effect on the environment among single–use containers. Recycling aluminum uses less energy and makes a smaller impact on the climate than making new aluminum from scratch." },
  { question: "What materials are used to make biodegradable bottles?", answer: "We use high-quality, food-safe plant-based resins and bagasse derivatives to ensure strength, clarity, and complete compostability." }
];

const productData = {
  name: "Eco Friendly Biodegradable Bottles",
  longTitle: "Eco Friendly Biodegradable Bottles",
  aboutTitle: "About Our Biodegradable Bottles",
  aboutBullets: [
    "These biodegradable water bottles are made from plant-based materials that break down naturally without harming the environment.",
    "Designed as an eco-friendly alternative to single-use plastic bottles.",
    "Helps reduce plastic pollution and landfill waste.",
    "Strong, durable, and suitable for daily water storage and transport.",
    "Lightweight and easy to carry for travel, events, offices, and outdoor use.",
    "Supports businesses and individuals moving toward sustainable packaging solutions.",
    "Ideal for corporate events, hospitals, educational institutions, and eco-conscious brands.",
    "Standard sizes available."
  ],
  ratingText: "5.0 / 5.0 from verified buyers & rating websites",
  whyChooseTitle: "Why Choose Biodegradable Water Bottles",
  whyChooseText: [
    "Biodegradable water bottles are a smart step toward reducing plastic pollution without compromising convenience. Unlike traditional plastic bottles that remain in landfills and oceans for hundreds of years, these bottles are designed to break down naturally under the right conditions, leaving a much smaller environmental footprint.",
    "One of the biggest advantages of biodegradable water bottles is their eco-friendly composition. Made from plant-based or compostable materials, they help lower dependence on fossil fuels and reduce harmful carbon emissions. This makes them an ideal solution for businesses, events, hospitals, and environmentally conscious consumers looking to adopt sustainable alternatives."
  ],
  additionalDetailsTitle: "Additional Product Details",
  additionalDetails: [
    "Made from plant-based, biodegradable materials instead of petroleum plastics.",
    "Designed to break down naturally under proper composting or disposal conditions.",
    "Strong, durable structure with leak-resistant design.",
    "Lightweight and easy to carry.",
    "Helps reduce plastic waste and carbon footprint.",
    "Manufactured following eco-friendly production practices.",
    "Available in multiple sizes and capacities."
  ],
  usageApplications: [
    "Corporate offices promoting eco-friendly initiatives.",
    "Hospitals & healthcare facilities reducing plastic waste.",
    "Events, exhibitions & conferences as sustainable giveaway bottles.",
    "Schools & colleges encouraging green habits among students.",
    "Hotels & resorts offering eco-conscious guest amenities."
  ],
  faqs
};
---

<GenericProductDetail
  productName={productData.name}
  productImage={typeof productImg === 'string' ? productImg : productImg.src}
  relatedProducts={relatedProducts}
  productData={productData}
/>
