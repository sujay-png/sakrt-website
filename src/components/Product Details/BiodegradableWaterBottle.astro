---
// src/components/Product Details/BiodegradableWaterBottle.astro
import productImg from '../../images/biodegradable_water.png';
import GenericProductDetail from './GenericProductDetail.astro';

const relatedProducts = [
  { name: "Compostable Wrapping Film", slug: "compostable-wrapping-film", category: "compostable-films", image: "/compostable-films/imgi_4_compostable-strecth-films.webp" },
  { name: "Compostable Medical Waste Bag", slug: "compostable-medical-waste-bags", category: "carry-bags", image: "/compostable-bags/imgi_8_biodegradable-bags-compostable-products-ecofriendly-bags-1-3.webp" },
  { name: "Compostable Custom Made Bag", slug: "compostable-custom-made-bag", category: "carry-bags", image: "/compostable-bags/imgi_6_biodegradable-bags-compostable-products-eco-product.-3.webp" },
  { name: "Compostable Mulch Films", slug: "compostable-mulch-films", category: "compostable-films", image: "/compostable-films/imgi_5_biodegradable-bags-compostable-products-ecofriendly-bags-1.webp" }
];

const faqs = [
  { question: "Do biodegradable plastic water bottles does not contain plastic content?", answer: "yes, biodegradable plastic water bottles don’t contain plastic materials. Biodegradable plastic water bottles are made from pla based compostable materials. Sugarcane bagasse and corn starch are the main two raw materials used to manufacture biodegradable plastic bottles. Biodegradable plastic is 100% compostable in nature. They are made from Sugarcane bagasse and corn starch which are the main two raw materials used to manufacture biodegradable plastic bottles and other biodegradable material." },
  { question: "How biodegradable plastic bottles are made?", answer: "Right now, they are mostly made from things like corn, beets, sugar cane, wood, potatoes, tapioca roots, or even nuts. But in the future, they will probably be made from leftover materials and waste. The word “renewable” usually means something that can be used again within 10 years. Biobased plastics can either be compostable or recyclable, depending on what they are made from." },
  { question: "What material is 100% biodegradable?", answer: "Materials such as PLA (Polylactic Acid) and PHA are fully biodegradable when placed in the correct composting environment." },
  { question: "What is the best eco-friendly water bottle?", answer: "Bottles made from recycled aluminum have the smallest effect on the environment among single–use containers. Recycling aluminum uses less energy and makes a smaller impact on the climate than making new aluminum from scratch." },
  { question: "What materials are used to make biodegradable bottles?", answer: "We use high-quality, food-safe plant-based resins and bagasse derivatives to ensure strength, clarity, and complete compostability." }
];

const productData = {
  name: "CPCB-Certified Biodegradable & Compostable Water Bottles",
  longTitle: "CPCB-Certified Biodegradable & Compostable Water Bottles",

  specificationsTitle: "Product Specifications",
  specifications: [
    {
      label: "Material Composition",
      value: "100% Plant-Based Food-Grade Biopolymer / PLA Resin (Zero PET, BPA, or Phthalates)"
    },
    {
      label: "Available Capacities",
      value: "250 ml, 500 ml, 750 ml, 1000 ml (Custom sizes available on bulk order)"
    },
    {
      label: "Certifications",
      value: "CPCB Approved, CIPET Tested, IS 17088 / EN 13432 / ASTM D6400 Compliant"
    },
    {
      label: "Composting Timeline",
      value: "90 to 180 days under industrial composting conditions"
    },
    {
      label: "Temperature Suitability",
      value: "Cold and ambient-temperature beverages (up to 45°C)"
    },
    {
      label: "Customization",
      value: "Custom bottle embossing, eco-friendly label printing, and flexible MOQs"
    },
    {
      label: "Supply & MOQ",
      value: "Factory-direct wholesale supply from Padmanoor, Kinnigoli, Mangaluru"
    }
  ],
  ratingText: "4.5 / 5.0 from verified buyers & rating websites",
  whyChooseTitle: "Why Switch to Plant-Based Biodegradable Plastic Bottles?",
  whyChooseText: [
    "100% Plastic-Free & Microplastic-Safe: Unlike conventional petroleum-based plastic bottles, biodegradable PLA bottles are crafted from renewable plant starches and contain zero BPA, phthalates, or toxic chemical leachates.",
    "Single-Use Plastic Ban Compliant: Fully tested by CIPET and certified by the Central Pollution Control Board (CPCB) under IS 17088 standards, helping organizations comply with Indian environmental mandates.",
    "High Clarity & Structural Strength: Lightweight, crystal-clear, and leak-resistant for reliable daily storage, transport, and commercial distribution.",
    "Rapid Organic Breakdown: Engineered to decompose cleanly into nutrient-rich organic matter within 90 to 180 days in industrial composting facilities without polluting landfills or waterways."
  ],
  additionalDetailsTitle: "Industries & Applications Served",
  additionalDetails: [
    "Hotels, Resorts & Hospitality: Eco-friendly in-room and dining hydration for sustainable hospitality brands.",
    "Corporate Events, Conferences & Weddings: Zero-plastic single-use water bottles for summits, exhibitions, and large gatherings.",
    "Hospitals & Healthcare Facilities: Non-toxic, food-grade drinking water bottles for patients, visitors, and medical campuses.",
    "Educational Institutions & Corporate Offices: Sustainable daily hydration for schools, colleges, and green workplaces.",
    "Private-Label Beverage Brands: Custom-molded and branded biodegradable bottles for bottled water companies transitioning away from PET.",

  ],
  usageApplicationsTitle: "Composting Process, Storage & Bulk Supply Details",
  usageApplications: [
    "<strong>How Biodegradation Works:</strong> Unlike conventional plastic bottles, biodegradable PLA bottles break down through microbial activity in industrial composting facilities (at 55°C–60°C), converting into water, carbon dioxide, and nutrient-rich biomass within 90 to 180 days.",
    "<strong>Storage & Shelf Life:</strong> Store eco water bottles in a cool, dry warehouse away from direct sunlight and heat sources (below 40°C) for an optimal shelf life of 9 to 12 months.",
    "<strong>Temperature Guidelines:</strong> Ideal for cold and room-temperature drinking water (up to 45°C); not intended for boiling water or hot beverages.",
    "<strong>Wholesale MOQ & Custom Branding:</strong> Manufactured factory-direct in Kinnigoli, Mangaluru with flexible Minimum Order Quantities (MOQs), custom bottle capacities (250 ml to 1000 ml), and eco-friendly label printing."
  ],
  faqs
};
---

<GenericProductDetail
  productName={productData.name}
  productImage={typeof productImg === 'string' ? productImg : productImg.src}
  relatedProducts={relatedProducts}
  productData={productData}
/>
