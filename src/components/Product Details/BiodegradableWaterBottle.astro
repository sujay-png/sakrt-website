---
import productImg from '../../images/biodegradable_water.png';
import CategoryGrid from '../Shared/CategoryGrid.astro';
import ModernFAQ from '../Shared/ModernFAQ.astro';
import CallToAction from '../../components/Home/CallToAction.astro';
import EnquiryForm from '../EnquiryForm.astro';

const relatedProducts = [
  { name: "Compostable Wrapping Film", slug: "compostable-wrapping-film", category: "compostable-films", image: "/compostable-films/imgi_4_compostable-strecth-films.webp" },
  { name: "Compostable Medical Waste Bag", slug: "compostable-medical-waste-bags", category: "compostable-bags", image: "/compostable-bags/imgi_8_biodegradable-bags-compostable-products-ecofriendly-bags-1-3.webp" },
  { name: "Compostable Custom Made Bag", slug: "compostable-custom-made-bag", category: "compostable-bags", image: "/compostable-bags/imgi_6_biodegradable-bags-compostable-products-eco-product.-3.webp" },
  { name: "Compostable Mulch Films", slug: "compostable-mulch-films", category: "compostable-films", image: "/compostable-films/imgi_5_biodegradable-bags-compostable-products-ecofriendly-bags-1.webp" }
];

const faqs = [
  { question: "Do biodegradable plastic water bottles does not contain plastic content?", answer: "yes, biodegradable plastic water bottles don’t contain plastic materials. Biodegradable plastic water bottles are made from pla based compostable materials. Sugarcane bagasse and corn starch are the main two raw materials used to manufacture biodegradable plastic bottles. Biodegradable plastic is 100% compostable in nature. They are made from Sugarcane bagasse and corn starch which are the main two raw materials used to manufacture biodegradable plastic bottles and other biodegradable material." },
  { question: "How biodegradable plastic bottles are made?", answer: "Right now, they are mostly made from things like corn, beets, sugar cane, wood, potatoes, tapioca roots, or even nuts. But in the future, they will probably be made from leftover materials and waste. The word “renewable” usually means something that can be used again within 10 years. Biobased plastics can either be compostable or recyclable, depending on what they are made from." },
  { question: "What material is 100% biodegradable?", answer: "Materials such as PLA (Polylactic Acid) and PHA are fully biodegradable when placed in the correct composting environment." },
  { question: "What is the best eco-friendly water bottle?", answer: "Bottles made from recycled aluminum have the smallest effect on the environment among single–use containers. Recycling aluminum uses less energy and makes a smaller impact on the climate than making new aluminum from scratch." },
  { question: "What materials are used to make biodegradable bottles?", answer: "We use high-quality, food-safe plant-based resins and bagasse derivatives to ensure strength, clarity, and complete compostability." }
];
---

<section class="bottle-page">
  <div class="content-container">
    
    <!-- Hero Section -->
    <div class="hero-grid" data-reveal-group>
      <div class="hero-image">
        <img src={productImg.src} alt="Eco Friendly Biodegradable Bottle" />
      </div>
      
      <div class="hero-content">
        <h1 class="hero-title">Eco Friendly Biodegradable Bottles</h1>
        
        <div class="feature-icons">
          <div class="icon-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <span>Certified Product</span>
          </div>
          <div class="icon-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            <span>Secure Delivery</span>
          </div>
          <div class="icon-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 8v4l3 3"></path></svg>
            <span>Custom Orders</span>
          </div>
          <div class="icon-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2.5 2v6h6M21.5 22v-6h-6M22 11.5A10 10 0 0 0 3.2 7.2M2 12.5a10 10 0 0 0 18.8 4.2"></path></svg>
            <span>Easy Returns</span>
          </div>
        </div>

        <h3 class="section-subtitle">About Our Biodegradable Bottles</h3>
        <ul class="bullet-list">
          <li>These biodegradable water bottles are made from plant-based materials that break down naturally without harming the environment.</li>
          <li>Designed as an eco-friendly alternative to single-use plastic bottles.</li>
          <li>Helps reduce plastic pollution and landfill waste.</li>
          <li>Strong, durable, and suitable for daily water storage and transport.</li>
          <li>Lightweight and easy to carry for travel, events, offices, and outdoor use.</li>
          <li>Supports businesses and individuals moving toward sustainable packaging solutions.</li>
          <li>Ideal for corporate events, hospitals, educational institutions, and eco-conscious brands.</li>
          <li>Standard sizes available.</li>
        </ul>

        <div class="cpcb-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          <span>CPCB CERTIFIED</span>
        </div>

        <div class="rating-row">
          <span class="rating-text">5.0 / 5.0 from verified buyers & rating websites</span>
          <div class="stars">
            ★★★★★
          </div>
        </div>

        <div class="action-buttons">
          <a href="/contact-us" class="btn btn-primary">ENQUIRE NOW</a>
          <a href="/contact-us" class="btn btn-outline">ORDER IN BULK</a>
        </div>
      </div>
    </div>

    <!-- Why Choose Section -->
    <div class="why-choose" data-reveal>
      <h2>Why Choose Biodegradable Water Bottles</h2>
      <p>Biodegradable water bottles are a smart step toward reducing plastic pollution without compromising convenience. Unlike traditional plastic bottles that remain in landfills and oceans for hundreds of years, these bottles are designed to break down naturally under the right conditions, leaving a much smaller environmental footprint.</p>
      <p>One of the biggest advantages of biodegradable water bottles is their eco-friendly composition. Made from plant-based or compostable materials, they help lower dependence on fossil fuels and reduce harmful carbon emissions. This makes them an ideal solution for businesses, events, hospitals, and environmentally conscious consumers looking to adopt sustainable alternatives.</p>
    </div>

    <!-- Additional Details Grid -->
    <div class="details-grid" data-reveal-group>
      <div class="details-box">
        <h3>Additional Product Details</h3>
        <ul class="bullet-list">
          <li>Made from plant-based, biodegradable materials instead of petroleum plastics.</li>
          <li>Designed to break down naturally under proper composting or disposal conditions.</li>
          <li>Strong, durable structure with leak-resistant design.</li>
          <li>Lightweight and easy to carry.</li>
          <li>Helps reduce plastic waste and carbon footprint.</li>
          <li>Manufactured following eco-friendly production practices.</li>
          <li>Available in multiple sizes and capacities.</li>
        </ul>
      </div>
      <div class="details-box usage-box">
        <h3>Usage Applications:</h3>
        <ul class="bullet-list">
          <li>Corporate offices promoting eco-friendly initiatives.</li>
          <li>Hospitals & healthcare facilities reducing plastic waste.</li>
          <li>Events, exhibitions & conferences as sustainable giveaway bottles.</li>
          <li>Schools & colleges encouraging green habits among students.</li>
          <li>Hotels & resorts offering eco-conscious guest amenities.</li>
        </ul>
      </div>
    </div>

    <!-- FAQ Section -->
    <div style="margin-top: 4rem;">
      <ModernFAQ title="Frequently Asked Questions" faqs={faqs} />
    </div>

    <!-- Banner -->
    <div class="banner-wrapper" style="margin-top: 4rem; margin-bottom: 2rem;">
      <EnquiryForm />
    </div>

  </div>
</section>

<style>
  .bottle-page {
    --rating-star: #fbbf24;
    background-color: var(--pulp);
    padding-top: 120px;
    font-family: var(--font-sans);
  }

  .content-container {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* Hero Section */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    margin-bottom: 4rem;
  }

  .hero-image {
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .hero-image img {
    max-width: 100%;
    height: auto;
    object-fit: cover;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 2.13rem);
    font-weight: 400;
    color: var(--ink);
    margin: 0 0 1.5rem 0;
  }

  .feature-icons {
    display: flex;
    gap: 2rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 1.5rem;
  }

  .icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-xs);
    color: var(--ink-muted);
    text-align: center;
  }

  .icon-item svg {
    width: 24px;
    height: 24px;
    color: var(--ink-soft);
  }

  .section-subtitle {
    font-size: var(--fs-lede);
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 1rem 0;
  }

  .bullet-list {
    margin: 0 0 2rem 0;
    padding-left: 1.2rem;
    color: var(--ink-soft);
    font-size: var(--fs-body);
    line-height: 1.6;
  }

  .bullet-list li {
    margin-bottom: 0.5rem;
  }

  .cpcb-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background-color: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-pill);
    font-weight: 700;
    font-size: var(--fs-label);
    color: var(--ink-soft);
    margin-bottom: 1.5rem;
  }

  .cpcb-badge svg {
    width: 16px;
    height: 16px;
  }

  .rating-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    font-size: var(--fs-sm);
    color: var(--ink-muted);
  }

  .stars {
    color: var(--rating-star);
    font-size: 1.2rem;
    letter-spacing: 2px;
  }

  .action-buttons {
    display: flex;
    gap: 1rem;
  }

  .btn {
    padding: 0.8rem 2rem;
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    font-weight: 600;
    border-radius: var(--r-pill);
    text-decoration: none;
    text-align: center;
    transition: transform var(--dur-1) var(--ease-out), background-color var(--dur-1) var(--ease-out), color var(--dur-1) var(--ease-out), border-color var(--dur-1) var(--ease-out);
    letter-spacing: 0.5px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
  }

  .btn-primary {
    background-color: var(--brand);
    color: var(--on-dark);
  }

  .btn-outline {
    background-color: transparent;
    color: var(--ink-soft);
    border-color: var(--hairline-strong);
  }

  @media (hover: hover) {
    .btn:hover {
      transform: translateY(-2px);
    }
    .btn-primary:hover {
      background-color: var(--ink);
    }
    .btn-outline:hover {
      background-color: rgba(16, 40, 28, 0.04);
      border-color: var(--ink);
    }
  }

  /* Why Choose */
  .why-choose {
    margin-bottom: 4rem;
  }

  .why-choose h2 {
    font-family: var(--font-display);
    font-size: 1.49rem;
    color: var(--ink);
    margin-bottom: 1rem;
    font-weight: 400;
  }

  .why-choose p {
    color: var(--ink-soft);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  /* Details Grid */
  .details-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .details-box {
    background-color: var(--surface);
    border-radius: var(--r-md);
    border: 1px solid var(--hairline);
    padding: 2rem;
    transition: transform var(--dur-2) var(--ease-settle), box-shadow var(--dur-2) var(--ease-settle), border-color var(--dur-2) var(--ease-settle);
  }

  @media (hover: hover) {
    .details-box:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-2);
      border-color: var(--hairline-strong);
    }
  }

  .details-box h3 {
    font-size: var(--fs-h4);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 1rem;
  }

  /* Banner */
  .banner {
    background-color: var(--brand);
    border-radius: var(--r-lg);
    padding: 4rem 2rem;
    text-align: center;
    color: var(--on-dark);
    margin-bottom: 4rem;
  }

  .banner-tag {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 1rem;
    color: var(--on-dark-muted);
  }

  .banner h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 2.55rem);
    font-weight: 400;
    margin: 0 0 1rem 0;
  }

  .banner p {
    color: var(--on-dark-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .banner-buttons {
    justify-content: center;
  }

  .btn-primary-light {
    background-color: var(--lime);
    color: var(--ink);
    border: 1px solid transparent;
  }

  .btn-outline-light {
    background-color: transparent;
    color: var(--on-dark);
    border: 1px solid var(--on-dark-muted);
  }

  @media (hover: hover) {
    .btn-primary-light:hover {
      background-color: #c2ec24;
    }
    .btn-outline-light:hover {
      background-color: rgba(255, 255, 255, 0.1);
      border-color: var(--on-dark);
    }
  }

  /* Related Products */
  .related-products h2 {
    font-family: var(--font-display);
    font-size: 1.49rem;
    font-weight: 400;
    color: var(--ink);
    margin-bottom: -1rem; /* Grid adds top padding */
  }

  @media (max-width: 900px) {
    .hero-grid, .details-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
