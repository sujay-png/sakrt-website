---
// src/components/Footer.astro
import cipetImg from '../images/CIPET.webp';
import isoImg from '../images/iso.png';
---

<footer class="footer-section">
  <div class="footer-container">
    <div class="footer-card">
      
      <!-- Top Content Grid -->
      <div class="footer-grid">
        
        <!-- Column 1: Brand & Bio -->
        <div class="footer-col brand-col">
          <a href="/" class="footer-logo-link" aria-label="SAKRT Home">
            <img src="/logo/footer-logo.webp" alt="SAKRT Logo" class="footer-logo" />
          </a>
          <p class="footer-desc">
            SAKRT is the reliable partner in Manufacturing & Distributing Govt certified compostable products for retailers and industrial enterprises.
          </p>
          <div class="footer-badges">
            <a href="/our-certifications" aria-label="Our Certifications">
              <img src={typeof cipetImg === 'string' ? cipetImg : cipetImg.src} alt="CIPET Certified" class="footer-badge" />
            </a>
            <a href="/our-certifications" aria-label="Our Certifications">
              <img src={typeof isoImg === 'string' ? isoImg : isoImg.src} alt="ISO Certified" class="footer-badge" />
            </a>
          </div>
        </div>

        <!-- Column 2: Solutions -->
        <div class="footer-col">
          <h3 class="col-title">Solutions</h3>
          <ul class="footer-menu">
            <li><a href="/compostable-product/food-packaging-boxes" class="footer-link">Compostable Tableware</a></li>
            <li><a href="/compostable-product/compostable-pouches" class="footer-link">Compostable Pouches</a></li>
            <li><a href="/compostable-product/compostable-films" class="footer-link">Compostable Films</a></li>
            <li><a href="/compostable-product/carry-bags" class="footer-link">Compostable Carry Bags</a></li>
          </ul>
        </div>

        <!-- Column 2.5: Contact Info -->
        <div class="footer-col">
          <h3 class="col-title">Contact Info</h3>
          <ul class="footer-menu contact-info-menu">
            <li class="contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="contact-icon"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span>7975310662</span>
            </li>
            <li class="contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="contact-icon"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <a href="mailto:hello@sakrt.in" class="footer-link">hello@sakrt.in</a>
            </li>
            <li class="contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="contact-icon"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              <a href="https://maps.app.goo.gl/irUXwFQzNL6KtPYV7" target="_blank" rel="noopener noreferrer" class="footer-link">2-43(1), Kripam, Padmanoor, Kinnigoli, Mangalore, Karnataka 574150</a>
            </li>
          </ul>
        </div>

        <!-- Column 3: Connect -->
        <div class="footer-col">
          <h3 class="col-title">Connect</h3>
          <ul class="footer-menu">
            <li><a href="/contact-us" class="footer-link">Contact Us</a></li>
            <li><a href="/our-certifications" class="footer-link">Certifications</a></li>
            <li><a href="/blog" class="footer-link">Our Blog</a></li>
          </ul>
          <div class="social-links connect-socials">
            <a href="https://www.facebook.com/people/Sakrt-India/pfbid02P6xVxSQAayJhvjzSmpCpmhmvuBF5NQRbJMZq2iRG23dFoxiWooBHy6BuVm1tDDmfl/" target="_blank" rel="noopener noreferrer" class="footer-link" aria-label="Facebook">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="social-icon"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            <a href="https://www.linkedin.com/company/sakrt/" target="_blank" rel="noopener noreferrer" class="footer-link" aria-label="LinkedIn">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="social-icon"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
            <a href="https://www.instagram.com/sakrt.in/" target="_blank" rel="noopener noreferrer" class="footer-link" aria-label="Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="social-icon"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
            </a>
          </div>
        </div>

      </div>

      <!-- Footer Bottom -->
      <div class="footer-bottom">
        <p class="copyright">&copy; {new Date().getFullYear()} SAKRT. All rights reserved.</p>
      </div>

    </div>
  </div>
</footer>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@400&family=Space+Mono:wght@400;700&display=swap');

  :root {
    --hover-lime: #b1d867;
  }

  .footer-section {
    position: relative;
    background-color: #0d3d26; /* Matches your main dark theme background to fill edge gaps */
    padding: 0 24px 20px 24px;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    border-top-left-radius: 25px;
     border-top-right-radius: 25px;
  }

  .footer-container {
    max-width: 1240px;
    width: 100%;
    background-color: #0d3d26; 
  }

  .footer-card {
    background-color: #0d3d26;  /* Sage green background tone */
    border-top-left-radius: 40px;
    border-top-right-radius: 40px;
    border-bottom-left-radius: 40px;
    border-bottom-right-radius: 40px;
    padding: 80px 60px 40px 60px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
  }

  /* Grid structure */
  .footer-grid {
    display: grid;
    grid-template-columns: 2.2fr 1.2fr 1.5fr 1fr;
    gap: 40px;
    margin-bottom: 70px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  /* Typography & Links */
  .footer-logo-link {
    display: inline-block;
    margin-bottom: 20px;
  }

  .footer-logo {
    height: 80px;
    width: 80px;
    object-fit: cover;
    border-radius: 50%;
    transition: transform 0.3s ease;
  }

  .footer-logo:hover {
    transform: scale(1.02);
  }

  .footer-desc {
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    font-size: 15px;
    color: #d0d7d3;
    line-height: 1.9;
    max-width: 360px;
    margin: 0 0 35px 0;
  }

  .col-title {
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1px;
    color: var(--hover-lime);
    text-transform: uppercase;
    margin: 0 0 24px 0;
  }

  .footer-menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .social-links {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .connect-socials {
    margin-top: 50px; /* Increased margin as requested */
  }

  .footer-badges {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-top: 10px;
  }

  .footer-badge {
    height: 60px; /* Resized to be similar to logo size */
    width: auto;
    object-fit: contain;
    background: #ffffff;
    padding: 6px;
    border-radius: 6px;
    transition: transform 0.2s ease;
  }

  .footer-badge:hover {
    transform: translateY(-2px);
  }

  /* Contact Info Styles */
  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    font-size: 14px;
    color: #d0d7d3;
    line-height: 1.5;
  }

  .contact-icon {
    color: var(--hover-lime);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .footer-link {
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    font-size: 14px;
    color: #d0d7d3;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  /* Hover color requested (#b1d867) */
  .footer-link:hover {
    color: var(--hover-lime);
  }

  .social-icon {
    color: #ffffff;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .footer-link:hover .social-icon {
    color: var(--hover-lime);
    transform: translateY(-2px);
  }

  /* Bottom Section */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: 30px;
    gap: 12px;
  }

  .copyright {
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    font-size: 13px;
    letter-spacing: 1px;
    color: #d0d7d3;
    margin: 0;
  }



  /* Responsive Layout */
  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 2fr 1.5fr 1fr;
    }
    .contact-info-menu {
      grid-column: 1 / -1;
      margin-top: 20px;
    }
  }

  @media (max-width: 768px) {
    .footer-card {
      padding: 50px 24px 30px 24px;
      border-top-left-radius: 28px;
      border-top-right-radius: 28px;
      border-bottom-left-radius: 28px;
      border-bottom-right-radius: 28px;
    }
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 40px 20px;
      margin-bottom: 50px;
    }
    .brand-col {
      grid-column: 1 / -1;
    }
    .social-links {
      gap: 16px;
    }
  }
</style>