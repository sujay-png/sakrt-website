---
// src/components/Footer.astro
---

<footer class="footer-section">
  <div class="sk-wrap footer-container">

    <!-- Top Content Grid -->
    <div class="footer-grid">

      <!-- Column 1: Brand & Bio -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-logo-link" aria-label="SAKRT Home">
          <img src="/logo/footer-logo.webp" alt="SAKRT Logo" class="footer-logo" />
        </a>
        <p class="footer-desc">
          SAKRT is the reliable partner in Manufacturing & Distributing Govt certified compostable products for retailers and industrial enterprises.
        </p>
        <div class="social-links">
          <a href="https://www.facebook.com/people/Sakrt-India/pfbid02P6xVxSQAayJhvjzSmpCpmhmvuBF5NQRbJMZq2iRG23dFoxiWooBHy6BuVm1tDDmfl/" target="_blank" rel="noopener noreferrer" class="footer-link">Facebook</a>
          <a href="https://www.linkedin.com/company/sakrt/" target="_blank" rel="noopener noreferrer" class="footer-link">Linkedin</a>
          <a href="https://www.instagram.com/sakrt.in/" target="_blank" rel="noopener noreferrer" class="footer-link">Instagram</a>
        </div>
      </div>

      <!-- Column 2: Solutions -->
      <div class="footer-col">
        <h3 class="col-title">Solutions</h3>
        <ul class="footer-menu">
          <li><a href="/compostable-product/food-packaging-boxes" class="footer-link">Tablewares</a></li>
          <li><a href="/compostable-product/compostable-pouches" class="footer-link">Pouches</a></li>
          <li><a href="/compostable-product/compostable-films" class="footer-link">Films</a></li>
          <li><a href="/compostable-product/carry-bags" class="footer-link">Carry Bags</a></li>
        </ul>
      </div>

      <!-- Column 3: Connect -->
      <div class="footer-col">
        <h3 class="col-title">Connect</h3>
        <ul class="footer-menu">
          <li><a href="/contact-us" class="footer-link">Contact Us</a></li>
          <li><a href="/our-certifications" class="footer-link">Certifications</a></li>
          <li><a href="/blog" class="footer-link">Our Blog</a></li>
        </ul>
      </div>

    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom">
      <p class="copyright">&copy; 2024 SAKRT. All rights reserved.</p>
    </div>

  </div>
</footer>

<style>
  /* No @import here — every face is loaded once in Layout.astro.
     One surface, one radius, no nested duplicate backgrounds. Sits above
     the homepage's position:sticky hero. */
  .footer-section {
    position: relative;
    z-index: 10;
    background: var(--ink);
    color: var(--on-dark-muted);
    border-top-left-radius: var(--r-xl);
    border-top-right-radius: var(--r-xl);
    padding-block: var(--s-20) var(--s-8);
    overflow: hidden;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-12) var(--s-10);
    padding-bottom: var(--s-16);
  }

  @media (min-width: 560px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .brand-col { grid-column: 1 / -1; }
  }

  @media (min-width: 900px) {
    .footer-grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    }
    .brand-col { grid-column: auto; }
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .footer-logo-link {
    display: inline-block;
    align-self: flex-start;
    margin-bottom: var(--s-5);
  }

  .footer-logo {
    height: 72px;
    width: 72px;
    object-fit: cover;
    border-radius: var(--r-pill);
    transition: transform var(--dur-2) var(--ease-settle);
  }

  .footer-desc {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    line-height: 1.8;
    color: var(--on-dark-muted);
    max-width: 44ch;
    margin: 0 0 var(--s-8) 0;
  }

  /* Column headings read as register labels, so mono and letterspaced. */
  .col-title {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--on-dark);
    margin: 0 0 var(--s-6) 0;
  }

  .footer-menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-4);
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-6);
  }

  .footer-link {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    color: var(--on-dark-muted);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    overflow-wrap: anywhere;
    transition: color var(--dur-1) var(--ease-out),
                text-decoration-color var(--dur-2) var(--ease-settle);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    border-top: 1px solid rgba(242, 243, 237, 0.14);
    padding-top: var(--s-6);
    gap: var(--s-3);
  }

  .copyright {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    color: var(--on-dark-muted);
    margin: 0;
  }

  @media (hover: hover) {
    .footer-logo-link:hover .footer-logo { transform: scale(1.02); }

    /* Lime arrives as a rule, never as the link colour. */
    .footer-link:hover {
      color: var(--on-dark);
      text-decoration-color: var(--lime);
    }
  }
</style>
