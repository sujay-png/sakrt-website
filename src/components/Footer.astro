<footer class="footer-section">
  <div class="footer-container">
    <div class="footer-card">
      
      <!-- Top Content Grid -->
      <div class="footer-grid">
        
        <!-- Column 1: Brand & Bio -->
        <div class="footer-col brand-col">
          <a href="/" class="footer-logo-link" aria-label="SAKRT Home">
            <img src="/logo/footer-logo.webp" alt="SAKRT Logo" class="footer-logo" />
          </a>
          <p class="footer-desc">
            SAKRT is the reliable partner in Manufacturing & Distributing Govt certified compostable products for retailers and industrial enterprises.
          </p>
          <div class="social-links">
            <a href="https://www.facebook.com/people/Sakrt-India/pfbid02P6xVxSQAayJhvjzSmpCpmhmvuBF5NQRbJMZq2iRG23dFoxiWooBHy6BuVm1tDDmfl/" target="_blank" rel="noopener noreferrer" class="footer-link">Facebook</a>
            <a href="https://www.linkedin.com/company/sakrt/" target="_blank" rel="noopener noreferrer" class="footer-link">Linkedin</a>
            <a href="https://www.instagram.com/sakrt.in/" target="_blank" rel="noopener noreferrer" class="footer-link">Instagram</a>
          </div>
        </div>

        <!-- Column 2: Solutions -->
        <div class="footer-col">
          <h3 class="col-title">Solutions</h3>
          <ul class="footer-menu">
            <li><a href="/compostable-product/food-packaging-boxes" class="footer-link">Tablewares</a></li>
            <li><a href="/compostable-product/compostable-pouches" class="footer-link">Pouches</a></li>
            <li><a href="/compostable-product/compostable-films" class="footer-link">Films</a></li>
            <li><a href="/compostable-product/carry-bags" class="footer-link">Carry Bags</a></li>
          </ul>
        </div>

        <!-- Column 3: Connect -->
        <div class="footer-col">
          <h3 class="col-title">Connect</h3>
          <ul class="footer-menu">
            <li><a href="/contact-us" class="footer-link">Contact Us</a></li>
            <li><a href="/our-certifications" class="footer-link">Certifications</a></li>
            <li><a href="/blog" class="footer-link">Our Blog</a></li>
          </ul>
        </div>

      </div>

      <!-- Footer Bottom -->
      <div class="footer-bottom">
        <p class="copyright">&copy; 2024 SAKRT. All rights reserved.</p>
      </div>

    </div>
  </div>
</footer>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@400&family=Space+Mono:wght@400;700&display=swap');

  :root {
    --hover-lime: #b1d867;
  }

  .footer-section {
    position: relative;
    background-color: #0d3d26; /* Matches your main dark theme background to fill edge gaps */
    padding: 0 24px 20px 24px;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    border-top-left-radius: 25px;
     border-top-right-radius: 25px;
  }

  .footer-container {
    max-width: 1240px;
    width: 100%;
    background-color: #0d3d26; 
  }

  .footer-card {
    background-color: #0d3d26;  /* Sage green background tone */
    border-top-left-radius: 40px;
    border-top-right-radius: 40px;
    border-bottom-left-radius: 40px;
    border-bottom-right-radius: 40px;
    padding: 80px 60px 40px 60px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
  }

  /* Grid structure */
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 70px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  /* Typography & Links */
  .footer-logo-link {
    display: inline-block;
    margin-bottom: 20px;
  }

  .footer-logo {
    height: 80px;
    width: 80px;
    object-fit: cover;
    border-radius: 50%;
    transition: transform 0.3s ease;
  }

  .footer-logo:hover {
    transform: scale(1.02);
  }

  .footer-desc {
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    font-size: 15px;
    color: #d0d7d3;
    line-height: 1.9;
    max-width: 360px;
    margin: 0 0 35px 0;
  }

  .col-title {
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1px;
    color: var(--hover-lime);
    text-transform: uppercase;
    margin: 0 0 24px 0;
  }

  .footer-menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .social-links {
    display: flex;
    gap: 24px;
  }

  .footer-link {
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    font-size: 14px;
    color: #d0d7d3;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  /* Hover color requested (#b1d867) */
  .footer-link:hover {
    color: var(--hover-lime);
  }

  /* Bottom Section */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: 30px;
    gap: 12px;
  }

  .copyright {
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    font-size: 13px;
    letter-spacing: 1px;
    color: #d0d7d3;
    margin: 0;
  }



  /* Responsive Layout */
  @media (max-width: 768px) {
    .footer-card {
      padding: 50px 24px 30px 24px;
      border-top-left-radius: 28px;
      border-top-right-radius: 28px;
      border-bottom-left-radius: 28px;
      border-bottom-right-radius: 28px;
    }
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px 20px;
      margin-bottom: 50px;
    }
    .brand-col {
      grid-column: 1 / -1;
    }
    .social-links {
      gap: 16px;
    }
  }
</style>