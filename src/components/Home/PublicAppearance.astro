---
// src/components/Home/PublicAppearance.astro
---

<section class="public-appearance-section">
  <div class="pa-container">
    <h2 class="pa-heading">Watch Our Latest Public Appearance</h2>
    <div class="pa-underline"></div>
    <div class="pa-video-wrapper">
      <div class="youtube-facade" id="yt-facade">
        <img src="https://i.ytimg.com/vi/A6YEPwwKUEk/maxresdefault.jpg" alt="SAKRT Public Appearance" class="yt-thumbnail" loading="lazy" />
        <button class="yt-play-btn" aria-label="Play Video">
          <svg viewBox="0 0 68 48"><path class="ytp-large-play-button-bg" d="M66.52,7.74c-0.78-2.93-2.49-5.41-5.42-6.19C55.79,.13,34,0,34,0S12.21,.13,6.9,1.55 C3.97,2.33,2.27,4.81,1.48,7.74C0.06,13.05,0,24,0,24s0.06,10.95,1.48,16.26c0.78,2.93,2.49,5.41,5.42,6.19 C12.21,47.87,34,48,34,48s21.79-0.13,27.1-1.55c2.93-0.78,4.64-3.26,5.42-6.19C67.94,34.95,68,24,68,24S67.94,13.05,66.52,7.74z" fill="#FF0000"></path><path d="M 45,24 27,14 27,34" fill="#fff"></path></svg>
        </button>
      </div>
      <template id="yt-iframe-template">
        <iframe 
          width="100%" 
          height="100%" 
          src="https://www.youtube.com/embed/A6YEPwwKUEk?si=N8iajocHU-sHEnjS&autoplay=1" 
          title="YouTube video player" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
          referrerpolicy="strict-origin-when-cross-origin" 
          allowfullscreen>
        </iframe>
      </template>
    </div>
  </div>
</section>

<script>
  function initYouTubeFacade() {
    const facade = document.getElementById('yt-facade');
    const template = document.getElementById('yt-iframe-template') as HTMLTemplateElement;
    if (facade && template && !facade.dataset.initialized) {
      facade.dataset.initialized = 'true';
      facade.addEventListener('click', () => {
        facade.replaceWith(template.content.cloneNode(true));
      });
    }
  }

  // Run on initial load
  initYouTubeFacade();
  
  // Support Astro View Transitions
  document.addEventListener('astro:page-load', initYouTubeFacade);
</script>

<style>
  .public-appearance-section {
    padding: 60px 24px 80px 24px;
    display: flex;
    justify-content: center;
    position: relative;
    z-index: 10;
    background-color: var(--color-bg-page, #f8f9f6);
  }

  .pa-container {
    max-width: 1000px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .pa-heading {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 400;
    color: #163728;
    margin: 0 0 15px 0;
  }

  .pa-underline {
    width: 80px;
    height: 3px;
    background-color: #EBB13B;
    margin-bottom: 40px;
  }

  .pa-video-wrapper {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    position: relative;
    background-color: #000;
  }

  .pa-video-wrapper iframe {
    width: 100%;
    height: 100%;
    border: none;
    border-radius: 10px;
    display: block;
  }

  .youtube-facade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
    background-color: #000;
  }

  .youtube-facade img.yt-thumbnail {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    z-index: 1;
    transition: filter 0.3s ease;
  }

  .youtube-facade:hover img.yt-thumbnail {
    filter: brightness(0.9);
  }

  .yt-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 10;
    background: none;
    border: none;
    width: 68px;
    height: 48px;
    cursor: pointer;
    padding: 0;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.4));
  }

  .yt-play-btn svg {
    width: 100%;
    height: 100%;
    transition: transform 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .youtube-facade:hover .yt-play-btn {
    transform: translate(-50%, -50%) scale(1.05);
  }

  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .public-appearance-section {
      padding: 20px 24px 60px 24px;
    }
    .pa-underline {
      margin-bottom: 30px;
    }
    .yt-play-btn {
      width: 56px;
      height: 40px;
    }
  }
</style>
