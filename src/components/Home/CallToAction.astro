---
// src/components/Home/CallToAction.astro
---

<section class="sk-section cta-section">
  <div class="sk-wrap cta-container">
    <div class="cta-card" data-reveal="grow" data-reveal-group>
      <span class="cta-subtitle" data-reveal>ALL YOU NEED TO KNOW</span>
      <h2 class="cta-title" data-reveal>Ready to Go Green?</h2>
      <p class="cta-description" data-reveal>
        Join hundreds of businesses making the switch to eco-friendly packaging solutions.
      </p>

      <div class="cta-buttons" data-reveal>
        <a href="/contact-us" id="global-cta-contact-btn" class="btn-primary">Get In Touch</a>
        <a href="/compostable-product" id="global-cta-explore-btn" class="btn-secondary">Explore Catalogue</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Opaque + raised: the homepage hero is position:sticky beneath. */
  .cta-section {
    position: relative;
    z-index: 10;
    background: var(--pulp);
  }

  .cta-container {
    max-width: 1000px;
  }

  /* Ink plate, closing statement. Radius from the token scale, no shadow. */
  .cta-card {
    background: var(--ink);
    border-radius: var(--r-xl);
    padding: clamp(40px, 7vw, 76px) var(--s-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Mono eyebrow. On ink, --on-dark-muted measures well above AA. */
  .cta-subtitle {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
    margin-bottom: var(--s-5);
  }

  .cta-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-synthesis-weight: none;
    font-size: var(--fs-h2);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--on-dark);
    margin: 0 0 var(--s-4);
  }

  /* Was Space Mono at 14px for a whole sentence. Prose belongs in sans. */
  .cta-description {
    font-family: var(--font-sans);
    font-size: var(--fs-lede);
    line-height: 1.7;
    color: var(--on-dark-muted);
    max-width: 46ch;
    margin: 0 0 var(--s-10);
  }

  .cta-buttons {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 26px;
    border: 1px solid transparent;
    border-radius: var(--r-pill);
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--dur-1) var(--ease-out),
                border-color var(--dur-1) var(--ease-out),
                transform var(--dur-1) var(--ease-out);
  }

  /* Ink on lime = 12.7:1. */
  .btn-primary {
    background: var(--lime);
    color: var(--ink);
  }

  .btn-secondary {
    background: transparent;
    color: var(--on-dark);
    border-color: rgba(242, 243, 237, 0.28);
  }

  @media (hover: hover) {
    .btn-primary:hover {
      /* --lime-soft is the token's documented hover wash. */
      background: var(--lime-soft);
      transform: translateY(-2px);
    }
    .btn-secondary:hover {
      border-color: var(--on-dark);
      background: rgba(242, 243, 237, 0.08);
      transform: translateY(-2px);
    }
  }

  @media (max-width: 560px) {
    .cta-buttons {
      flex-direction: column;
      width: 100%;
      max-width: 300px;
    }
    .btn-primary,
    .btn-secondary { width: 100%; }
  }
</style>
