            <path d="M24 24.5C25.5 23.5 26.8 23 27.5 22.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </div>
        <span class="hero-feature-label">100% Plant-Based &<br />Compostable</span>
      </div>

      <div class="hero-feature-item">
        <div class="hero-feature-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M19 28L16 41L21 38.5L24 41L23 29" fill="currentColor"/>
            <path d="M29 28L32 41L27 38.5L24 41L25 29" fill="currentColor"/>
            <path d="M24 6.5C25.2 6.5 26.3 7.3 27.3 7.7C28.4 8.1 29.6 8.1 30.6 8.8C31.6 9.4 32.3 10.4 33.1 11.3C33.9 12.1 34.9 12.8 35.5 13.8C36.1 14.8 36.2 16.1 36.5 17.2C36.9 18.3 37.6 19.3 37.6 20.5C37.6 21.7 36.9 22.7 36.5 23.8C36.2 24.9 36.1 26.2 35.5 27.2C34.9 28.2 33.9 28.9 33.1 29.7C32.3 30.6 31.6 31.6 30.6 32.2C29.6 32.9 28.4 32.9 27.3 33.3C26.3 33.7 25.2 34.5 24 34.5C22.8 34.5 21.7 33.7 20.7 33.3C19.6 32.9 18.4 32.9 17.4 32.2C16.4 31.6 15.7 30.6 14.9 29.7C14.1 28.9 13.1 28.2 12.5 27.2C11.9 26.2 11.8 24.9 11.5 23.8C11.1 22.7 10.4 21.7 10.4 20.5C10.4 19.3 11.1 18.3 11.5 17.2C11.8 16.1 11.9 14.8 12.5 13.8C13.1 12.8 14.1 12.1 14.9 11.3C15.7 10.4 16.4 9.4 17.4 8.8C18.4 8.1 19.6 8.1 20.7 7.7C21.7 7.3 22.8 6.5 24 6.5Z" fill="currentColor"/>
