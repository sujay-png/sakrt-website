            <path d="M38.5 22.5C39.5 26.2 38.6 30.2 36.2 33.2C34.2 35.8 31.2 37.5 28 38.2" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M28.5 33.5V39H34" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M18.5 38.5C14.8 37.2 11.8 34.2 10.2 30.5C8.8 26.8 9.2 22.5 11 19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M16 20.5H10.5V26" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M24 30.5C20.5 27 19.5 21.5 24 16C28.5 21.5 27.5 27 24 30.5Z" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
