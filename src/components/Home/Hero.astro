---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
---

<section class="hero-section">
  <!-- Soft overlay for background contrast -->
  <div class="hero-bg-overlay"></div>

  <!-- Animated content container -->
  <div class="hero-content">

    
    <h1 class="h1">
      SAKRT Compostable<br />
      Product Lasts Only<br />
      <em>Till Six Months.</em>
    </h1>
  
    <p>
      Switch To Planet-friendly Enterprise by Choosing Reliable, Government Certified<br class="desktop-br" />
      Biodegradable Food Containers Biodegradable Poly Bags & Packaging Solutions
    </p>

    <div class="hero-buttons">
      <a href="/contact-us" id="hero-get-in-touch-btn" class="btn btn-primary">
        Get in Touch <span class="arrow">→</span>
      </a>
      <a href="/compostable-product" id="hero-explore-products-btn" class="btn btn-secondary">
        Explore Products
      </a>
    </div>


  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Space+Mono:wght@400;700&display=swap');

  :root {
    --lime-color: #d6f85aa9;
    --dark-green: #0b2219;
  }

  /* 1. Full Screen Layout & Top Offset for Header Clearance */
  .hero-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Generous top padding keeps content safely below floating header */
    padding: 120px 24px 60px;
    background: url('../../images/planet.png') center/cover no-repeat;
    overflow: hidden;
    box-sizing: border-box;
  }

  /* 2. Soft Background Overlay */
  .hero-bg-overlay {
   position: absolute;
    inset: 0;
    background: rgba(205, 211, 206, 0.486); /* Reduced opacity */
    backdrop-filter: blur(2px); /* Reduced blur */
    -webkit-backdrop-filter: blur(2px);
    z-index: 1;
  }

  /* 3. Hero Content Container & Subtle Wave Animation */
  .hero-content {
    position: relative;
    z-index: 8;
    text-align: center;
    max-width: 1100px;
    width: 100%;
    margin: 0 auto;
    animation: waveFloat 6s ease-in-out infinite;
  }

  @keyframes waveFloat {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  /* 4. Badge Styling */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 30px;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.25);
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 2px;
    color: #0b2219;
    margin-bottom: 46px;
    backdrop-filter: blur(8px);
  }

  .badge .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--lime-color);
  }

  /* 5. Main Title & Subtitle */
  h1 {
  font-family: var(--font-serif);
  font-size: clamp(3rem, 10vw, 6.80rem);
  font-weight: 300;
  line-height: 0.9;
  letter-spacing: -0.03em;

  color: rgba(9, 36, 25, 0.95);

  max-width: 1200px;
  margin: 2px auto 28px;

  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  }

  h1 em {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--lime-color);
    font-weight: 300;
      margin: 2px auto 28px;
  }

  p {
    color: var(--color-text-body);
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0 auto 36px;
    max-width: 720px;
  }

  /* 6. Action Buttons */
  .hero-buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
  }

  .btn {
    padding: 12px 28px;
    border-radius: 8px;
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 46px;
    box-sizing: border-box;
  }

  .btn-primary {
    background-color: #0b2219;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 4px 14px rgba(11, 34, 25, 0.25);
  }

  .btn-primary:hover {
    background-color: #123528;
    transform: translateY(-2px);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.35);
    color: var(--color-forest-dark);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.5);
    transform: translateY(-2px);
  }

  .arrow {
    transition: transform 0.2s ease;
  }

  .btn-primary:hover .arrow {
    transform: translateX(4px);
  }



  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .h1 {
      font-size: clamp(3rem, 10vw, 4rem);
    }
    .hero-section p {
      font-size: 1.1rem;
    }
    .desktop-br {
      display: none;
    }
    .hero-buttons {
      flex-direction: column;
      width: 100%;
      max-width: 300px;
      margin: 0 auto;
    }

    .btn {
      width: 100%;
    }
  }
</style>