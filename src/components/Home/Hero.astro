<section class="hero-section" id="hero-section">
  <div class="hero-photo" data-scrub aria-hidden="true">
    <div class="hero-photo__inner"></div>
  </div>
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="hero-grain" aria-hidden="true"></div>

  <div class="hero-content" id="hero-content">

    <h1 class="h1">
      <span class="line-mask"><span class="line-inner" style="--delay: 0.15s">CPCB-Certified Compostable Bag Manufacturers in </span></span>
      <span class="line-mask"><span class="line-inner" style="--delay: 0.28s"><em class="glow-text">Mangalore, Karnataka</em></span></span>
    </h1>

    <p class="fade-blur" style="--delay: 0.72s">
      SAKRT manufactures CIPET-tested, CPCB-certified biodegradable and compostable packaging for commercial enterprises, retailers, and distributors.<br /><br />
      From custom GSM carry bags to durable bio-liners, our 100% plant-derived products break down naturally within 60 to 180 days, offering your brand an affordable, fully compliant, factory-direct alternative to single-use plastics.
    </p>

    <div class="hero-buttons fade-blur" style="--delay: 0.9s">
      <a href="/contact-us" id="hero-get-in-touch-btn" class="btn btn-primary shine-btn">
        <span>Get in Touch</span> <span class="arrow">→</span>
      </a>
      <a href="/compostable-product" id="hero-explore-products-btn" class="btn btn-secondary">
        Explore Products
      </a>
    </div>

    <!-- 4 Feature Highlights Row -->
    <div class="hero-features fade-blur" style="--delay: 1.05s">
      <div class="hero-feature-item">
        <div class="hero-feature-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
