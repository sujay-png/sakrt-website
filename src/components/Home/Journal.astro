---
// src/components/Home/Journal.astro
import { wpquery } from '../../lib/wordpress.ts';

const data = await wpquery({
  query: `
    query GetLatestJournals {
      posts(first: 3) {
        nodes {
          title
          slug
          date
          featuredImage {
            node {
              sourceUrl
            }
          }
          categories {
            nodes {
              name
            }
          }
        }
      }
    }
  `,
});

const posts = data.posts.nodes;

const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  const month = date.toLocaleString('default', { month: 'long' });
  const day = date.getDate();
  const year = date.getFullYear();
  return `${month} ${day}, ${year}`;
};
---

<section class="sk-section sk-section--band journal-section">
  <div class="sk-wrap journal-container">

    <!-- Section Header -->
    <div class="journal-header" data-reveal>
      <h2 class="sk-title journal-title">Our Blogs</h2>
      <a href="/blog" class="see-all-link">
        <span>See All</span>
        <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <!-- Journal Cards Grid -->
    <div class="journal-grid" data-reveal-group>
      {posts.map((post: any) => {
        const catName = post.categories?.nodes?.[0]?.name || "general";
        const catSlug = encodeURIComponent(catName.toLowerCase().replace(/\s+/g, '-'));
        return (
        <a href={`/blog/${catSlug}/${post.slug}`} class="journal-card" data-reveal="grow">
          <div class="sk-media image-wrapper" style="--ar: 4 / 3">
            {post.featuredImage?.node?.sourceUrl ? (
              <div class="card-bg" style={`background-image: linear-gradient(rgba(0,0,0,0.05), rgba(0,0,0,0.05)), url('${post.featuredImage.node.sourceUrl}');`}></div>
            ) : (
              <div class="card-bg img-3">
                <span class="card-internal-text">Sakrt</span>
              </div>
            )}
          </div>
          <div class="card-content">
            <span class="journal-date">{formatDate(post.date)}</span>
            <h3 set:html={post.title}></h3>
          </div>
        </a>
      );
      })}
    </div>

  </div>
</section>

<style>
  /* Opaque + raised over the sticky hero. */
  .journal-section {
    position: relative;
    z-index: 10;
  }

  /* Editorial index header: title left, index link right, ruled off. */
  .journal-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-4);
    padding-bottom: var(--s-6);
    margin-bottom: var(--s-10);
    border-bottom: 1px solid var(--hairline-strong);
  }

  .journal-title {
    margin: 0;
  }

  .see-all-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    padding-inline: 2px;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-1) var(--ease-out);
  }

  .see-all-link .arrow-icon {
    transition: transform var(--dur-1) var(--ease-out);
  }

  @media (hover: hover) {
    .see-all-link:hover { color: var(--brand); }
    .see-all-link:hover .arrow-icon { transform: translateX(4px); }
  }

  .journal-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-10) var(--s-8);
  }

  @media (min-width: 640px) {
    .journal-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1000px) {
    .journal-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .journal-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    text-decoration: none;
  }

  /* One ratio for every thumbnail, whatever WordPress returns.
     .sk-media supplies the ratio box; this only adds the hairline. */
  .image-wrapper {
    background: var(--hairline);
    border: 1px solid var(--hairline);
    margin-bottom: var(--s-5);
    transition: border-color var(--dur-2) var(--ease-settle);
  }

  .card-bg {
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    transition: transform 1.1s var(--ease-settle);
  }

  /* Fallback tile when a post has no featured image. Lime on ink = 12.7:1. */
  .img-3 {
    background-color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-internal-text {
    font-family: var(--font-display);
    font-weight: 400;
    font-synthesis-weight: none;
    font-style: italic;
    font-size: 1.5rem;
    color: var(--lime);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    min-width: 0;
  }

  .journal-date {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .journal-card h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-synthesis-weight: none;
    font-size: var(--fs-h3);
    line-height: 1.14;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0;
    overflow-wrap: anywhere;

    /* Lime arrives as a rule under the title, never as the text colour.
       text-decoration follows every line of a wrapped heading. */
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    transition: text-decoration-color var(--dur-2) var(--ease-settle);
  }

  @media (hover: hover) {
    .journal-card:hover .card-bg { transform: scale(1.045); }
    .journal-card:hover .image-wrapper { border-color: var(--hairline-strong); }
    .journal-card:hover h3 { text-decoration-color: var(--lime); }
  }
</style>
