
---
// src/pages/Home/Journal.astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
---

<section class="journal-section">
  <div class="journal-container">
    
    <!-- Section Header -->
    <div class="journal-header">
      <h2 class="journal-title">Latest Journal</h2>
      <span class="scroll-prompt">SCROLL TO EXPLORE →</span>
    </div>

    <!-- Journal Cards Grid -->
    <div class="journal-grid">
      
      <!-- Card 1 -->
      <a href="/blogs" class="journal-card">
        <div class="image-wrapper">
          <div class="card-bg img-1"></div>
        </div>
        <div class="card-content">
          <span class="journal-date">July 21, 2026</span>
          <h3>Wholesale Carry Bags Manufacturer & Supplier in India</h3>
        </div>
      </a>

      <!-- Card 2 (Height increased via aspect-ratio) -->
      <a href="/blogs" class="journal-card card-tall">
        <div class="image-wrapper">
          <div class="card-bg img-2"></div>
        </div>
        <div class="card-content">
          <span class="journal-date">July 14, 2026</span>
          <h3>How Courier Bags Have Become a Must-Have for E-commerce</h3>
        </div>
      </a>

      <!-- Card 3 -->
      <a href="/blogs" class="journal-card">
        <div class="image-wrapper">
          <div class="card-bg img-3">
            <span class="card-internal-text">Why Compostable?</span>
          </div>
        </div>
        <div class="card-content">
          <span class="journal-date">July 6, 2026</span>
          <h3>Why do we need biodegradable packaging?</h3>
        </div>
      </a>

    </div>

  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Space+Mono:wght@400;700&display=swap');
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,400&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@400&display=swap');
  :root {
    --dark-green: #0d3d26;
    --accent-lime: #b5e800;
  }

  .journal-section {
    position: relative;
    padding: 80px 24px 120px 24px;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
  }

  .journal-container {
    max-width: 1240px;
    width: 100%;
  }

  /* Header Layout */
  .journal-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 50px;
  }

  .journal-title {
   font-family: "Bodoni Moda", serif;
    font-weight: 400;
    font-size: clamp(3rem, 5vw, 5.2rem);
    color: var(--dark-green);
    margin: 0;
    line-height: 1.1;
  }

  .scroll-prompt {
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    font-size: 10.5px;
    letter-spacing: 2.5px;
    color: #999999;
    text-transform: uppercase;
  }

  /* Grid Layout with align-items: flex-start to allow variable heights cleanly */
  .journal-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    align-items: flex-start;
  }

  /* Card Styles */
  .journal-card {
    font-family: "Bodoni Moda", serif;
    text-decoration: none;
    display: flex;
    flex-direction: column;
  }

  .image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1; /* Standard square for cards 1 and 3 */
    border-radius: 24px;
    overflow: hidden;
    background-color: #e5e5e7;
    margin-bottom: 20px;
  }

  /* Increased height specifically for the second card image wrapper */
  .journal-card.card-tall .image-wrapper {
    aspect-ratio: 1 / 1.35; /* Taller height for card 2 */
  }

  .card-bg {
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Hover Zoom Effect */
  .journal-card:hover .card-bg {
    transform: scale(1.06);
  }

  /* Background Images for Cards */
  .img-1 {
    background-color: #c5c9d1;
    background-image: linear-gradient(rgba(0,0,0,0.05), rgba(0,0,0,0.05)), url('../../images/plastic courier bag.webp');
  }

  .img-2 {
    background-image: linear-gradient(rgba(0,0,0,0.05), rgba(0,0,0,0.05)), url('../../images/Sakrt Plant-Based PLA Straws.png');
  }

  .img-3 {
    background-color: #0d3d26;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .card-internal-text {
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
    font-size: 1.8rem;
    color: var(--accent-lime);
  }

  /* Content Text */
  .card-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .journal-date {
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    font-size: 10px;
    letter-spacing: 1.5px;
    color: #888888;
    text-transform: uppercase;
  }

  .journal-card h3 {
font-family: 'Playfair Display', Georgia, serif;
   font-size: 1.6rem;
    font-weight: 380;
    color: var(--dark-green);
    margin: 0;
    line-height: 1.15;
    transition: color 0.3s ease;
  }

  /* Text color change on hover */
  .journal-card:hover h3 {
    color: #72e555;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .journal-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .scroll-prompt {
      display: none;
    }
  }
</style>

