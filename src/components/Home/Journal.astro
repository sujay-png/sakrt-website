
---
// src/components/Home/Journal.astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { wpquery } from '../../lib/wordpress.ts';

const data = await wpquery({
  query: `
    query GetLatestJournals {
      posts(first: 3) {
        nodes {
          title
          slug
          date
          featuredImage {
            node {
              sourceUrl
            }
          }
          categories {
            nodes {
              name
            }
          }
        }
      }
    }
  `,
});

const posts = data.posts.nodes;

const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  const month = date.toLocaleString('default', { month: 'long' });
  const day = date.getDate();
  const year = date.getFullYear();
  return `${month} ${day}, ${year}`;
};
---

<section class="journal-section">
  <div class="journal-container">
    
    <!-- Section Header -->
    <div class="journal-header">
      <h2 class="journal-title">Our Blogs</h2>
      <a href="/blog" class="see-all-link">
        <span>See All</span>
        <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <!-- Journal Cards Grid -->
    <div class="journal-grid">
      {posts.map((post: any) => {
        const catName = post.categories?.nodes?.[0]?.name || "general";
        const catSlug = encodeURIComponent(catName.toLowerCase().replace(/\s+/g, '-'));
        return (
        <a href={`/blog/${catSlug}/${post.slug}`} class="journal-card">
          <div class="image-wrapper">
            {post.featuredImage?.node?.sourceUrl ? (
              <div class="card-bg" style={`background-image: linear-gradient(rgba(0,0,0,0.05), rgba(0,0,0,0.05)), url('${post.featuredImage.node.sourceUrl}');`}></div>
            ) : (
              <div class="card-bg img-3">
                <span class="card-internal-text">Sakrt</span>
              </div>
            )}
          </div>
          <div class="card-content">
            <span class="journal-date">{formatDate(post.date)}</span>
            <h3 set:html={post.title}></h3>
          </div>
        </a>
      );
      })}
    </div>

  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Space+Mono:wght@400;700&display=swap');
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,400&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@400&display=swap');
  :root {
    --dark-green: #0d3d26;
    --accent-lime: #b5e800;
  }

  .journal-section {
    position: relative;
    padding: 80px 24px 120px 24px;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
  }

  .journal-container {
    max-width: 1240px;
    width: 100%;
  }

  /* Header Layout */
  .journal-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 50px;
  }

  .journal-title {
   font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(3rem, 5vw, 4.42rem);
    color: var(--dark-green);
    margin: 0;
    line-height: 1.1;
  }

  /* See All Link with Hover-to-Button Transition */
  .see-all-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: transparent;
    color: var(--dark-green);
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    font-size: 13px;
    font-weight: 700;
    padding: 10px 18px;
    border-radius: 30px;
    text-decoration: none;
    letter-spacing: 0.5px;
    white-space: nowrap;
    transition: background-color 0.3s ease, color 0.3s ease, transform 0.2s ease;
  }

  .see-all-link .arrow-icon {
    transition: transform 0.25s ease;
  }

  .see-all-link:hover {
    background-color: var(--dark-green);
    color: #ffffff;
    transform: translateY(-2px);
  }

  .see-all-link:hover .arrow-icon {
    transform: translateX(4px);
  }

  /* Grid Layout with align-items: flex-start to allow variable heights cleanly */
  .journal-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    align-items: flex-start;
  }

  /* Card Styles */
  .journal-card {
    font-family: var(--font-serif);
    text-decoration: none;
    display: flex;
    flex-direction: column;
  }

  .image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1; /* Standard square for cards 1 and 3 */
    border-radius: 10px;
    overflow: hidden;
    background-color: #e5e5e7;
    margin-bottom: 20px;
  }



  .card-bg {
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Hover Zoom Effect */
  .journal-card:hover .card-bg {
    transform: scale(1.06);
  }

  /* Background Images for Cards */
  .img-1 {
    background-color: #c5c9d1;
    background-image: linear-gradient(rgba(0,0,0,0.05), rgba(0,0,0,0.05)), url('../../images/plastic courier bag.webp');
  }

  .img-2 {
    background-image: linear-gradient(rgba(0,0,0,0.05), rgba(0,0,0,0.05)), url('../../images/Sakrt Plant-Based PLA Straws.png');
  }

  .img-3 {
    background-color: #0d3d26;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .card-internal-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.53rem;
    color: var(--accent-lime);
  }

  /* Content Text */
  .card-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .journal-date {
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    font-size: 10px;
    letter-spacing: 1.5px;
    color: #888888;
    text-transform: uppercase;
  }

  .journal-card h3 {
font-family: var(--font-serif);
   font-size: 1.36rem;
    font-weight: 380;
    color: var(--dark-green);
    margin: 0;
    line-height: 1.15;
    transition: color 0.3s ease;
  }

  /* Text color change on hover */
  .journal-card:hover h3 {
    color: #72e555;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .journal-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .scroll-prompt {
      display: none;
    }
  }
</style>

