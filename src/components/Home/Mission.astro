
---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

import cipetImg from '../../images/CIPET.webp';
import isoImg from '../../images/iso.png';
import cpcbImg from '../../images/cpcb.png';
import bioComplianceImg from '../../images/bio-compliance.png';
---



  <section class="mission-section">
    <div class="mission-container">
      
      <div class="mission-left">
        <span class="section-tag">OUR MISSION</span>
        <h2 class="mission-title">Let's Get Back To Nature</h2>
        <p class="mission-desc">
          SAKRT is a CPCB certified manufacturer and distributor of biodegradable poly bags. We supply a wide range of biodegradable solutions from water bottles, carry bags, food packaging, to tableware and agricultural products.
        </p>
        <p class="mission-desc mission-desc-secondary" style="margin-top: 1rem;">
          Our mission is to help businesses seamlessly replace plastic with high-performance, earth-friendly biodegradable poly bags alternatives that support global climate goals.
        </p>
        <a href="/about" class="mission-btn" style="margin-top: 2rem; display: inline-block;">
          More About SAKRT
        </a>
      </div>

      <!-- Right Column: Certification Info -->
      <div class="mission-right">
        <h3 class="cert-heading">Government Approved Product</h3>
        <div class="cert-underline"></div>
        <div class="cert-grid">
          <a href="/our-certifications" class="cert-logo-link">
            <img src={cipetImg.src} alt="CIPET Certificate" class="cert-logo" />
          </a>
          <a href="/our-certifications" class="cert-logo-link">
            <img src={isoImg.src} alt="ISO Certificate" class="cert-logo" />
          </a>
          <a href="/our-certifications" class="cert-logo-link">
            <img src={cpcbImg.src} alt="CPCB Certificate" class="cert-logo" />
          </a>
          <a href="/our-certifications" class="cert-logo-link">
            <img src={bioComplianceImg.src} alt="Bio Compliance Certificate" class="cert-logo" />
          </a>
        </div>
      </div>

    </div>
  </section>


<style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400&family=Space+Mono:wght@400&display=swap');
  @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Space+Mono:wght@400;700&display=swap');

  :root {
    --dark-green: #0b2218;
  }

  .mission-section {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 24px 40px 24px;
    z-index: 10;
    box-sizing: border-box;
  }

  /* 2. Content Grid Container */
  .mission-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 120px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 180px;
  }

  /* 3. Left Column Content */
  .section-tag {
     font-family:'Space Mono', monospace;
    font-size:14px;
    letter-spacing:5px;
    text-transform:uppercase;
    color:#8a9892;
    display:block;
    margin-bottom:34px;
  }

  .mission-title {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 5vw, 4.42rem);
    font-weight:300;
    line-height:.98;
    letter-spacing:-0.03em;
    color:#0d3426;
    margin:0 0 48px;
  }

  .mission-desc {
     max-width:650px;
    font-family:system-ui,sans-serif;
    font-size:20px;
    line-height:1.9;
    color:#50695f;
    font-weight:400;
  }

  .mission-left {
    flex: 0 0 58%;
    max-width: 720px;
  }

  .mission-btn {
    font-family: var(--font-mono, 'Space Mono', monospace);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    background-color: #0b2219;
    color: #ffffff;
    padding: 14px 32px;
    border-radius: 40px;
    text-decoration: none;
    transition: background-color 0.3s ease, transform 0.3s ease;
    box-shadow: 0 4px 14px rgba(11, 34, 25, 0.25);
  }

  .mission-btn:hover {
    background-color: #123528;
    transform: translateY(-2px);
  }

  /* 4. Right Column Certification Box */
  .mission-right {
    flex: 0 0 26%;
    padding-top: 48px;
    text-align: left; 
  }

   
  .cert-heading {
    font-family: var(--font-serif);
    font-size: 2.2rem;
    font-weight: 300;
    color: #163728;
    margin: 0 0 10px 0;
    line-height: 1.2;
  }

  .cert-underline {
    width: 60px;
    height: 3px;
    background-color: #EBB13B;
    margin-bottom: 24px;
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    max-width: 250px;
  }

  .cert-logo-link {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    border-radius: 8px;
    padding: 10px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  }

  .cert-logo-link:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 15px rgba(0,0,0,0.1);
  }

  .cert-logo {
    max-width: 100%;
    max-height: 60px;
    object-fit: contain;
  }

  /* Responsive Adjustments */
  @media (max-width: 900px) {
    .mission-container {
      flex-direction: column;
      padding: 0 24px;
      gap: 40px;
    }
    .mission-desc-secondary {
      display: none;
    }
    .mission-right {
      padding-top: 30px;
      border-top: 1px solid rgba(0, 0, 0, 0.08);
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .cert-grid {
      max-width: 100%;
      width: 100%;
      grid-template-columns: repeat(4, 1fr);
    }
    .cert-logo {
      max-height: 50px;
    }
  }
  @media (max-width: 500px) {
    .cert-grid {
      grid-template-columns: repeat(2, 1fr);
      max-width: 280px;
    }
  }
</style>

