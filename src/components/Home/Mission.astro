---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

import cipetImg from '../../images/CIPET.webp';
import isoImg from '../../images/iso.png';
import cpcbImg from '../../images/cpcb.png';
import bioComplianceImg from '../../images/bio-compliance.png';
---

<section class="mission-section" id="mission-section">
  <!-- Subtle Dynamic Glow Following Cursor -->
  <div class="cursor-glow" id="cursor-glow"></div>

  <div class="mission-container">
    
    <!-- Left Column: Glass Card Content -->
    <div class="mission-left tilt-card" data-tilt>
      <div class="glass-content-card">
        <span class="section-tag">
          <span class="tag-dot"></span> OUR MISSION
        </span>

        <h2 class="mission-title">
          Let's Get Back To <span class="highlight-text">Nature</span>
        </h2>

        <p class="mission-desc">
          SAKRT is a CPCB certified manufacturer and distributor of biodegradable poly bags. We supply a wide range of biodegradable solutions from water bottles, carry bags, food packaging, to tableware and agricultural products.
        </p>

        <p class="mission-desc mission-desc-secondary">
          Our mission is to help businesses seamlessly replace plastic with high-performance, earth-friendly biodegradable poly bags alternatives that support global climate goals.
        </p>

        <div class="btn-wrapper">
          <a href="/about" class="mission-btn magnetic-btn">
            <span class="btn-text">More About SAKRT</span>
            <div class="btn-icon-circle">
              <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- Right Column: Interactive Certification Showcase -->
    <div class="mission-right">
      <div class="cert-header-box">
        <h3 class="cert-heading">Government Approved Product</h3>
        <div class="cert-pulse-bar"></div>
      </div>

      <div class="cert-grid">
        <a href="/our-certifications" class="cert-logo-link magnetic-card" data-tilt>
          <div class="card-glow-border"></div>
          <img src={typeof cipetImg === 'string' ? cipetImg : cipetImg.src} alt="CIPET Certificate" class="cert-logo" />
        </a>
        <a href="/our-certifications" class="cert-logo-link magnetic-card" data-tilt>
          <div class="card-glow-border"></div>
          <img src={typeof isoImg === 'string' ? isoImg : isoImg.src} alt="ISO Certificate" class="cert-logo" />
        </a>
        <a href="/our-certifications" class="cert-logo-link magnetic-card" data-tilt>
          <div class="card-glow-border"></div>
          <img src={typeof cpcbImg === 'string' ? cpcbImg : cpcbImg.src} alt="CPCB Certificate" class="cert-logo" />
        </a>
        <a href="/our-certifications" class="cert-logo-link magnetic-card" data-tilt>
          <div class="card-glow-border"></div>
          <img src={typeof bioComplianceImg === 'string' ? bioComplianceImg : bioComplianceImg.src} alt="Bio Compliance Certificate" class="cert-logo" />
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Space+Mono:wght@400;700&display=swap');

  .mission-section {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 120px 24px;
    z-index: 10;
    box-sizing: border-box;
    overflow: hidden;
    background: radial-gradient(circle at 50% 50%, #ffffff 0%, #f4f8f5 100%);
  }

  /* Ambient Cursor Tracking Glow */
  .cursor-glow {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(214, 248, 90, 0.18) 0%, rgba(255, 255, 255, 0) 70%);
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: width 0.3s, height 0.3s;
    z-index: 1;
  }

  .mission-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 80px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 80px;
    position: relative;
    z-index: 2;
  }

  /* --- LEFT COLUMN: Glass Card & Floating Reveal --- */
  .mission-left {
    flex: 0 0 58%;
    max-width: 720px;
    perspective: 1000px;
  }

  .glass-content-card {
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(13, 52, 38, 0.08);
    border-radius: 28px;
    padding: 48px;
    box-shadow: 0 20px 50px rgba(11, 34, 25, 0.05);
    transform-style: preserve-3d;
    transition: transform 0.2s ease-out, box-shadow 0.4s ease;
  }

  .glass-content-card:hover {
    box-shadow: 0 30px 60px rgba(11, 34, 25, 0.1);
  }

  .section-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Space Mono', monospace;
    font-size: 13px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: #50695f;
    margin-bottom: 20px;
  }

  .tag-dot {
    width: 8px;
    height: 8px;
    background-color: #ebb13b;
    border-radius: 50%;
    box-shadow: 0 0 10px #ebb13b;
    animation: pulseGlow 2s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%, 100% { transform: scale(1); opacity: 0.8; }
    50% { transform: scale(1.4); opacity: 1; }
  }

  .mission-title {
    font-family: var(--font-serif, 'Instrument Serif', serif);
    font-size: clamp(3rem, 5vw, 4.2rem);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: #0d3426;
    margin: 0 0 28px;
  }

  .highlight-text {
    font-style: italic;
    color: #1b5e43;
    position: relative;
  }

  .highlight-text::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 0;
    width: 100%;
    height: 6px;
    background: rgba(235, 177, 59, 0.35);
    border-radius: 4px;
    z-index: -1;
  }

  .mission-desc {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 1.1rem;
    line-height: 1.8;
    color: #435a51;
    margin-bottom: 16px;
  }

  /* Floating Magnetic Button */
  .btn-wrapper {
    margin-top: 36px;
  }

  .mission-btn {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    font-family: 'Space Mono', monospace;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    background-color: #0b2219;
    color: #ffffff;
    padding: 10px 10px 10px 28px;
    border-radius: 50px;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    box-shadow: 0 10px 25px rgba(11, 34, 25, 0.2);
  }

  .btn-icon-circle {
    width: 42px;
    height: 42px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.4s ease, background 0.3s ease;
  }

  .mission-btn:hover {
    background-color: #144231;
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 16px 32px rgba(11, 34, 25, 0.3);
  }

  .mission-btn:hover .btn-icon-circle {
    background: #ebb13b;
    color: #0b2219;
    transform: rotate(45deg);
  }

  /* --- RIGHT COLUMN: 3D Tilting Certification Grid --- */
  .mission-right {
    flex: 0 0 36%;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .cert-heading {
    font-family: var(--font-serif, 'Instrument Serif', serif);
    font-size: 2.2rem;
    font-weight: 300;
    color: #163728;
    margin: 0 0 8px 0;
  }

  .cert-pulse-bar {
    width: 50px;
    height: 3px;
    background: linear-gradient(90deg, #ebb13b, transparent);
    border-radius: 2px;
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    perspective: 1000px;
  }

  .cert-logo-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    border-radius: 16px;
    padding: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.06);
    transition: transform 0.2s ease-out, box-shadow 0.3s ease;
    transform-style: preserve-3d;
  }

  .card-glow-border {
    position: absolute;
    inset: -1px;
    border-radius: 17px;
    background: linear-gradient(135deg, rgba(235, 177, 59, 0.6), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: -1;
  }

  .cert-logo-link:hover .card-glow-border {
    opacity: 1;
  }

  .cert-logo-link:hover {
    box-shadow: 0 20px 40px rgba(11, 34, 25, 0.12);
  }

  .cert-logo {
    max-width: 100%;
    max-height: 60px;
    object-fit: contain;
    transform: translateZ(20px);
    transition: transform 0.3s ease;
  }

  /* Responsive Adjustments */
  @media (max-width: 1024px) {
    .mission-container {
      flex-direction: column;
      padding: 0 24px;
      gap: 50px;
    }
    .mission-left, .mission-right {
      flex: 0 0 100%;
      max-width: 100%;
    }
    .glass-content-card {
      padding: 32px;
    }
  }

  @media (max-width: 768px) {
    .mission-desc-secondary {
      display: none;
    }
    .mission-container {
      padding: 0 16px;
    }
    .glass-content-card {
      padding: 24px 20px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('mission-section');
    const glow = document.getElementById('cursor-glow');
    const tiltCards = document.querySelectorAll('[data-tilt]');

    // 1. Smooth Cursor Tracking Spotlight Effect
    if (section && glow) {
      section.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = section.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        glow.style.left = `${x}px`;
        glow.style.top = `${y}px`;
      });
    }

    // 2. 3D Tilt Effect on Hover
    tiltCards.forEach((card) => {
      const el = card as HTMLElement;
      
      el.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = el.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;

        const rotateX = ((y - centerY) / centerY) * -4;
        const rotateY = ((x - centerX) / centerX) * 4;

        el.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.01, 1.01, 1.01)`;
      });

      el.addEventListener('mouseleave', () => {
        el.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
      });
    });
  });
</script>