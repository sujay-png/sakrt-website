---
// src/components/Home/Mission.astro
import cipetImg from '../../images/CIPET.webp';
import isoImg from '../../images/iso.png';
import cpcbImg from '../../images/cpcb.png';
import bioComplianceImg from '../../images/bio-compliance.png';
---

<section class="sk-section mission-section" id="mission-section">
  <div class="sk-wrap mission-container">

    <!-- Left Column: statement -->
    <div class="mission-left">
      <div class="mission-copy" data-reveal-group>
        <span class="sk-eyebrow section-tag">
          <span class="tag-dot" data-scrub></span> OUR MISSION
        </span>

        <h2 class="sk-title sk-title--lg mission-title">
          Let's Get Back To <span class="highlight-text">Nature</span>
        </h2>

        <p class="mission-desc">
          SAKRT is a CPCB certified manufacturer and distributor of biodegradable poly bags. We supply a wide range of biodegradable solutions from water bottles, carry bags, food packaging, to tableware and agricultural products.
        </p>

        <p class="mission-desc mission-desc-secondary">
          Our mission is to help businesses seamlessly replace plastic with high-performance, earth-friendly biodegradable poly bags alternatives that support global climate goals.
        </p>

        <div class="btn-wrapper">
          <a href="/about" class="mission-btn">
            <span class="btn-text">More About SAKRT</span>
            <div class="btn-icon-circle">
              <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- Right Column: certification register -->
    <div class="mission-right">
      <div class="cert-header-box" data-reveal>
        <h3 class="cert-heading">Government Approved Product</h3>
        <div class="cert-pulse-bar" data-scrub></div>
      </div>

      <div class="cert-grid" data-reveal-group>
        <a href="/our-certifications" class="cert-logo-link" data-reveal="grow">
          <img src={typeof cipetImg === 'string' ? cipetImg : cipetImg.src} alt="CIPET Certificate" class="cert-logo" />
        </a>
        <a href="/our-certifications" class="cert-logo-link" data-reveal="grow">
          <img src={typeof isoImg === 'string' ? isoImg : isoImg.src} alt="ISO Certificate" class="cert-logo" />
        </a>
        <a href="/our-certifications" class="cert-logo-link" data-reveal="grow">
          <img src={typeof cpcbImg === 'string' ? cpcbImg : cpcbImg.src} alt="CPCB Certificate" class="cert-logo" />
        </a>
        <a href="/our-certifications" class="cert-logo-link" data-reveal="grow">
          <img src={typeof bioComplianceImg === 'string' ? bioComplianceImg : bioComplianceImg.src} alt="Bio Compliance Certificate" class="cert-logo" />
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  /* Opaque + raised: the hero is position:sticky beneath this section. */
  .mission-section {
    position: relative;
    z-index: 10;
    background: var(--pulp);
  }

  .mission-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-16);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .mission-container {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: clamp(48px, 6vw, 96px);
      align-items: center;
    }
  }

  .mission-copy {
    max-width: 62ch;
  }

  /* .tag-dot becomes the single lime rule, replacing the primitive's
     pseudo-element so the eyebrow carries one mark, not two. */
  .section-tag::before { display: none; }

  .tag-dot {
    width: 26px;
    height: 3px;
    background: var(--lime);
    border-radius: var(--r-pill);
    flex: none;
    transform: scaleX(var(--p, 1));
    transform-origin: left;
    will-change: transform;
  }

  .mission-title {
    margin: var(--s-5) 0 var(--s-6);
  }

  /* Was italic mid-green on a wash. Now ink on a lime marker: 12.7:1. */
  .highlight-text {
    font-style: italic;
    color: var(--ink);
    position: relative;
    display: inline-block;
    padding-inline: 0.08em;
    isolation: isolate;
  }

  .highlight-text::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.08em;
    height: 0.3em;
    z-index: -1;
    background: var(--lime);
    border-radius: 2px 6px 3px 8px;
  }

  .mission-desc {
    font-size: var(--fs-lede);
    line-height: 1.75;
    color: var(--ink-soft);
    margin-bottom: var(--s-4);
  }

  .mission-desc-secondary {
    margin-bottom: 0;
  }

  .btn-wrapper {
    margin-top: var(--s-10);
  }

  .mission-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--s-4);
    min-height: 48px;
    padding: 5px 5px 5px 26px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--on-dark);
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--dur-1) var(--ease-out),
                transform var(--dur-1) var(--ease-out);
  }

  .btn-icon-circle {
    width: 38px;
    height: 38px;
    flex: none;
    border-radius: var(--r-pill);
    background: rgba(242, 243, 237, 0.14);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--dur-2) var(--ease-settle),
                color var(--dur-2) var(--ease-settle),
                transform var(--dur-2) var(--ease-settle);
  }

  @media (hover: hover) {
    .mission-btn:hover {
      background: var(--brand);
      transform: translateY(-2px);
    }
    .mission-btn:hover .btn-icon-circle {
      background: var(--lime);
      color: var(--ink);
      transform: translateX(3px);
    }
  }

  /* --- Certification register --- */
  .mission-right {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  .cert-heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-synthesis-weight: none;
    font-size: var(--fs-h3);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0 0 var(--s-3);
  }

  .cert-pulse-bar {
    width: 44px;
    height: 3px;
    background: var(--lime);
    border-radius: var(--r-pill);
    transform: scaleX(var(--p, 1));
    transform-origin: left;
    will-change: transform;
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .cert-logo-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 116px;
    padding: var(--s-6) var(--s-5);
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    transition: border-color var(--dur-2) var(--ease-settle),
                transform var(--dur-2) var(--ease-settle);
  }

  .cert-logo {
    max-width: 100%;
    max-height: 58px;
    width: auto;
    object-fit: contain;
  }

  @media (hover: hover) {
    .cert-logo-link:hover {
      border-color: var(--hairline-strong);
      transform: translateY(-3px);
    }
  }
</style>
