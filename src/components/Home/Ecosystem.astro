          </div>
        </div>
      </a>

      <!-- 4. Tableware & Utensils -->
      <a href="/compostable-product/food-packaging-boxes" class="card-wrap">
        <div class="product-card">
          <div class="card-media">
            <span class="card-badge">04</span>
            <div class="card-blur-bg tableware-bg" aria-hidden="true"></div>
            <div class="card-image-wrap">
              <div class="card-image tableware-bg"></div>
            </div>
          </div>
          <div class="card-content-box">
            <span class="category-subtitle">FOOD SERVICE</span>
            <h3 class="card-heading">Bio-Tableware & Containers</h3>
