</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Space+Mono:wght@400;700&display=swap');

  /* 1. SECTION & CONTAINER */
  .ecosystem-section {
    position: relative;
    padding: 64px 20px;
    background: #FFFFFF;
    border-top: 1px solid #E8F0E3;
    border-bottom: 1px solid #E8F0E3;
    box-sizing: border-box;
  }

  .ecosystem-container {
    max-width: 1100px;
    width: 100%;
    margin: 0 auto;
    position: relative;
    box-sizing: border-box;
  }

  /* 2. SECTION HEADER */
  .ecosystem-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 36px;
    gap: 20px;
  }

  .header-left {
    display: flex;
    flex-direction: column;
  }

  .section-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: #2F6B3F;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .pulsing-emerald {
    width: 7px;
    height: 7px;
    background-color: #8FBF6A;
    border-radius: 50%;
    box-shadow: 0 0 6px rgba(143, 191, 106, 0.7);
    display: inline-block;
  }

  .ecosystem-title {
    font-family: var(--font-serif, 'Instrument Serif', serif);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 400;
    color: #0B3B26;
    margin: 0;
    line-height: 1.15;
  }

  /* 3. GRID LAYOUT & SLIDING HOVER HIGHLIGHT */
  .ecosystem-grid {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    width: 100%;
    box-sizing: border-box;
  }

  .hover-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    opacity: 0;
    pointer-events: none;
    background: #DCEBCF;
    border-radius: 24px;
    z-index: 1;
    grid-column: 1 / -1;
    grid-row: 1 / -1;
    transition: transform 0.25s ease, width 0.25s ease, height 0.25s ease, opacity 0.15s ease;
  }

  /* 4. CARD WRAPPER & VERTICAL COMPACT PRODUCT CARD */
  .card-wrap {
    display: flex;
    flex-direction: column;
    padding: 8px;
    text-decoration: none;
    color: inherit;
    position: relative;
    z-index: 2;
    border-radius: 24px;
    box-sizing: border-box;
    height: 100%;
    opacity: 0;
    transform: translateY(16px);
    transition: transform 0.45s ease, opacity 0.45s ease;
  }

  /* FADE-UP ON SCROLL */
  .ecosystem-section.is-visible .card-wrap {
    opacity: 1;
    transform: translateY(0);
  }

  .ecosystem-section.is-visible .card-wrap:nth-child(2) { transition-delay: 0ms; }
  .ecosystem-section.is-visible .card-wrap:nth-child(3) { transition-delay: 60ms; }
  .ecosystem-section.is-visible .card-wrap:nth-child(4) { transition-delay: 120ms; }
  .ecosystem-section.is-visible .card-wrap:nth-child(5) { transition-delay: 180ms; }
  .ecosystem-section.is-visible .card-wrap:nth-child(6) { transition-delay: 240ms; }
  .ecosystem-section.is-visible .card-wrap:nth-child(7) { transition-delay: 300ms; }

  .product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #FFFFFF;
    border: 1px solid #E3EDDC;
    border-radius: 16px;
    padding: 0;
    overflow: hidden;
    box-shadow: 0 2px 10px rgba(11, 59, 38, 0.05);
    box-sizing: border-box;
    position: relative;
    z-index: 2;
    transition: border-color 0.25s ease;
  }

  /* CARD HOVER STATE (NO LIFT, NO ZOOM) */
  .card-wrap:hover .product-card {
    border-color: #8FBF6A;
  }

  .card-wrap:hover .view-details-text {
    color: #2F6B3F;
    text-decoration-color: #8FBF6A;
  }

  .card-wrap:focus-visible {
    outline: 2px solid #8FBF6A;
    outline-offset: 2px;
  }

  .card-wrap:focus-visible .view-details-text {
    color: #2F6B3F;
    text-decoration-color: #8FBF6A;
    outline: 2px solid #8FBF6A;
    outline-offset: 2px;
  }

  /* 5. IMAGE AREA (TOP OF CARD) */
  .card-media {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
    padding: 0;
    box-sizing: border-box;
  }

  .card-blur-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    object-fit: cover;
    filter: blur(18px);
    transform: scale(1.15);
    z-index: 1;
    pointer-events: none;
  }

  .card-blur-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.25);
  }

  .card-image-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 8px;
    box-sizing: border-box;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-image {
    width: 100%;
    height: 100%;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    object-fit: contain;
    transition: transform 0.35s ease;
  }

  .card-wrap:hover .card-image {
    transform: scale(1.04);
  }

  .card-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #0B3B26;
    color: #FFFFFF;
    border: 2px solid #FFFFFF;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    z-index: 3;
  }

  /* Background Image Classes */
  .bottle-bg { background-image: url('../../images/biodegradable_water.png'); }
  .bag-bg { background-image: url('../../images/sakrt_bag.png'); }
  .film-bg { background-image: url('/compostable-films/imgi_5_biodegradable-bags-compostable-products-ecofriendly-bags-1.webp'); }
  .tableware-bg { background-image: url('../../images/biodegradable_utensils.png'); }
  .pouches-bg { background-image: url('../../images/biodegradable_greybags.png'); }
  .courier-bg { background-image: url('../../images/plastic courier bag.webp'); }

  /* 6. CARD TEXT CONTENT */
  .card-content-box {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 14px 14px 16px 14px;
    min-width: 0;
  }

  .category-subtitle {
    display: inline-block;
    color: #2F6B3F;
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1.2;
    padding: 0;
  }

  .card-heading {
    font-family: var(--font-serif, 'Instrument Serif', serif);
    font-size: 20px;
    font-weight: 600;
    color: #0B3B26;
    margin: 8px 0 0 0;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .card-description {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 13.5px;
    font-weight: 400;
    color: #4A5A50;
    line-height: 1.55;
    margin: 6px 0 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 7. CARD FOOTER ROW */
  .card-footer {
    margin-top: auto;
    padding-top: 14px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    box-sizing: border-box;
  }

  .view-details-text {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: #0B3B26;
    background: none;
    border: none;
    padding: 0;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 0.25s ease, text-decoration-color 0.25s ease;
    display: inline-block;
  }

  .view-details-text:hover {
    color: #2F6B3F;
    text-decoration-color: #8FBF6A;
  }

  /* 8. BOTTOM CENTERED SEE ALL PRODUCTS BUTTON */
  .ecosystem-bottom-cta {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 40px;
    width: 100%;
  }

  .bottom-see-all-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-family: 'Space Mono', monospace;
    font-size: 13px;
    font-weight: 600;
    color: #0B3B26;
    text-decoration: none;
    background: #8FBF6A;
    padding: 12px 28px;
    border-radius: 40px;
    transition: background-color 0.25s ease, transform 0.25s ease;
    white-space: nowrap;
    box-sizing: border-box;
  }

  .bottom-arrow-wrapper {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #0B3B26;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  .bottom-see-all-btn:hover {
    background: #7DAE59;
  }

  .bottom-see-all-btn:hover .bottom-arrow-wrapper {
    transform: translateX(3px);
  }

  /* 9. RESPONSIVE BREAKPOINTS */
  @media (max-width: 900px) {
    .ecosystem-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 4px;
    }

    .card-media {
      height: 210px;
    }
  }

  @media (max-width: 768px) {
    .ecosystem-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 28px;
    }
  }

  @media (max-width: 560px) {
    .ecosystem-section {
      padding: 48px 16px;
    }

    .ecosystem-grid {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .card-media {
      height: 230px;
    }

    .ecosystem-bottom-cta {
      margin-top: 32px;
    }

    .bottom-see-all-btn {
      width: 100%;
      max-width: 280px;
      justify-content: center;
    }

    .card-heading {
      font-size: 19px;
    }

    .card-description {
      font-size: 13.5px;
    }
  }

  @media (hover: none) {
    .hover-bg {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hover-bg {
      transition: none !important;
    }
    .card-wrap {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    .card-image,
    .view-details-text,
    .bottom-see-all-btn,
    .bottom-arrow-wrapper {
      transition: none !important;
    }
  }
</style>

<script>
  function setupEcosystemScroll() {
    const section = document.getElementById('ecosystem-section');
    if (!section) return;

    if (!('IntersectionObserver' in window)) {
      section.classList.add('is-visible');
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          section.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.1
    });

    observer.observe(section);
  }

  function setupSlidingHover() {
    const grid = document.querySelector<HTMLElement>('.ecosystem-grid');
    if (!grid || grid.dataset.hoverInitialized === 'true') return;
    grid.dataset.hoverInitialized = 'true';

    const hoverBg = grid.querySelector<HTMLElement>('.hover-bg');
    const items = grid.querySelectorAll<HTMLElement>('.card-wrap');
    if (!hoverBg || !items.length) return;

    let activeItem: HTMLElement | null = null;
    let isVisible = false;

    function canHover() {
      return window.matchMedia('(hover: hover)').matches;
    }

    function updateHighlight(item: HTMLElement, animate = true) {
      if (!item || !grid || !hoverBg) return;
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const gridRect = grid.getBoundingClientRect();
      const itemRect = item.getBoundingClientRect();

      const x = itemRect.left - gridRect.left;
      const y = itemRect.top - gridRect.top;
      const w = itemRect.width;
      const h = itemRect.height;

      if (!animate || prefersReduced || !isVisible) {
        hoverBg.style.transition = 'none';
        hoverBg.style.transform = `translate3d(${x}px, ${y}px, 0)`;
        hoverBg.style.width = `${w}px`;
        hoverBg.style.height = `${h}px`;
        void hoverBg.offsetHeight; // Force reflow
        if (!prefersReduced) {
          hoverBg.style.transition = '';
        }
      } else {
        hoverBg.style.transform = `translate3d(${x}px, ${y}px, 0)`;
        hoverBg.style.width = `${w}px`;
        hoverBg.style.height = `${h}px`;
      }

      hoverBg.style.opacity = '1';
      isVisible = true;
    }

    items.forEach((item) => {
      item.addEventListener('mouseenter', () => {
        if (!hoverBg) return;
        if (!canHover()) {
          hoverBg.style.opacity = '0';
          isVisible = false;
          activeItem = null;
          return;
        }

        activeItem = item;
        updateHighlight(item, isVisible);
      });
    });

    grid.addEventListener('mouseleave', () => {
      if (!hoverBg) return;
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReduced) {
        hoverBg.style.transition = 'none';
      }
      hoverBg.style.opacity = '0';
      isVisible = false;
      activeItem = null;
    });

    window.addEventListener('resize', () => {
      if (activeItem && isVisible) {
        updateHighlight(activeItem, false);
      } else if (hoverBg) {
        hoverBg.style.opacity = '0';
        isVisible = false;
        activeItem = null;
      }
    });

    // Recalculate highlight position and size after images finish loading
    window.addEventListener('load', () => {
      if (activeItem && isVisible) {
        updateHighlight(activeItem, false);
      }
    });

    const cardImages = grid.querySelectorAll<HTMLElement>('.card-image');
    cardImages.forEach((imgEl) => {
      const bg = window.getComputedStyle(imgEl).backgroundImage;
      const match = bg.match(/url\(['"]?(.*?)['"]?\)/i);
      if (match && match[1]) {
        const img = new Image();
        img.onload = () => {
          if (activeItem && isVisible) {
            updateHighlight(activeItem, false);
          }
        };
        img.src = match[1];
      }
    });
  }

  function initEcosystem() {
    setupEcosystemScroll();
    setupSlidingHover();
  }

  initEcosystem();
  document.addEventListener('astro:page-load', initEcosystem);
</script>