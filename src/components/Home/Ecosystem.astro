---
// src/components/Home/Ecosystem.astro
---

<section class="sk-section sk-section--ink ecosystem-section" id="ecosystem-section" data-scrub>
  <div class="sk-wrap ecosystem-container">

    <!-- Section Header -->
    <div class="ecosystem-header" data-reveal>
      <div class="header-left">
        <span class="sk-eyebrow section-tag">
          <span class="pulsing-emerald"></span> SAKRT ECOSYSTEM
        </span>
        <h2 class="sk-title sk-title--lg ecosystem-title">Most Enquired Products</h2>
      </div>

      <a href="/compostable-product" class="see-all-btn">
        <span>See All Products</span>
        <div class="arrow-wrapper">
          <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </div>
      </a>
    </div>

    <!-- Specimen grid: identical ratios, all copy always visible -->
    <div class="product-grid" data-reveal-group>

      <!-- 1. Biodegradable Water Bottles -->
      <a href="/compostable-product/biodegradable-water-bottles" class="product-card" data-reveal="grow">
        <div class="sk-media card-frame" style="--ar: 4 / 5">
          <div class="card-image bottle-bg"></div>
          <div class="card-overlay"></div>
          <div class="card-badge">01</div>
        </div>

        <div class="card-content-box">
          <span class="category-subtitle">HYDRATION</span>
          <h3 class="card-heading">Biodegradable Water Bottles</h3>
          <p class="card-description">Redefining daily hydration with zero-plastic impact, 100% natural materials.</p>

          <div class="action-row">
            <span class="btn-lime">View Details</span>
          </div>
        </div>
      </a>

      <!-- 2. Compostable Carry Bags -->
      <a href="/compostable-product/carry-bags" class="product-card" data-reveal="grow">
        <div class="sk-media card-frame" style="--ar: 4 / 5">
          <div class="card-image bag-bg"></div>
          <div class="card-overlay"></div>
          <div class="card-badge">02</div>
        </div>

        <div class="card-content-box">
          <span class="category-subtitle">PACKAGING</span>
          <h3 class="card-heading">Compostable Carry Bags</h3>
          <p class="card-description">High-tensile strength carry bags certified for complete natural decomposition.</p>

          <div class="action-row">
            <span class="btn-lime">Explore Bags</span>
          </div>
        </div>
      </a>

      <!-- 3. Grow Bags -->
      <a href="/compostable-product/compostable-grow-bags" class="product-card" data-reveal="grow">
        <div class="sk-media card-frame" style="--ar: 4 / 5">
          <div class="card-image grow-bg"></div>
          <div class="card-overlay"></div>
          <div class="card-badge">03</div>
        </div>

        <div class="card-content-box">
          <span class="category-subtitle">AGRICULTURE</span>
          <h3 class="card-heading">Compostable Grow Bags</h3>
          <p class="card-description">Nurture plants with bio-based nursery bags that blend into soil over time.</p>

          <div class="action-row">
            <span class="btn-lime">View Agritech</span>
          </div>
        </div>
      </a>

      <!-- 4. Tableware & Utensils -->
      <a href="/compostable-product/food-packaging-boxes" class="product-card" data-reveal="grow">
        <div class="sk-media card-frame" style="--ar: 4 / 5">
          <div class="card-image tableware-bg"></div>
          <div class="card-overlay"></div>
          <div class="card-badge">04</div>
        </div>

        <div class="card-content-box">
          <span class="category-subtitle">FOOD SERVICE</span>
          <h3 class="card-heading">Bio-Tableware & Containers</h3>
          <p class="card-description">Sturdy, heat-resistant food packaging made from organic sugarcane fibers.</p>

          <div class="action-row">
            <span class="btn-lime">Explore Tableware</span>
          </div>
        </div>
      </a>

    </div>
  </div>
</section>

<style>
  /* The single dark band on the page. Opaque + raised over the sticky hero. */
  .ecosystem-section {
    position: relative;
    z-index: 10;
    overflow: hidden;
  }

  /* --- Header --- */
  .ecosystem-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-6);
    padding-bottom: var(--s-8);
    margin-bottom: var(--s-10);
    border-bottom: 1px solid rgba(242, 243, 237, 0.14);
  }

  @media (min-width: 768px) {
    .ecosystem-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  /* The empty span becomes the eyebrow's lime rule, replacing the
     primitive's pseudo-element so there is one mark, not two. */
  .section-tag::before { display: none; }

  .pulsing-emerald {
    width: 26px;
    height: 3px;
    background: var(--lime);
    border-radius: var(--r-pill);
    flex: none;
  }

  .ecosystem-title {
    margin: var(--s-4) 0 0;
  }

  .see-all-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 48px;
    padding: 0 8px 0 24px;
    border: 1px solid rgba(242, 243, 237, 0.24);
    border-radius: var(--r-pill);
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--on-dark);
    text-decoration: none;
    flex: none;
    transition: background-color var(--dur-1) var(--ease-out),
                border-color var(--dur-1) var(--ease-out),
                color var(--dur-1) var(--ease-out),
                transform var(--dur-1) var(--ease-out);
  }

  .arrow-wrapper {
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: var(--r-pill);
    background: rgba(242, 243, 237, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--dur-1) var(--ease-out),
                color var(--dur-1) var(--ease-out),
                transform var(--dur-2) var(--ease-settle);
  }

  @media (hover: hover) {
    .see-all-btn:hover {
      border-color: var(--lime);
      transform: translateY(-2px);
    }
    .see-all-btn:hover .arrow-wrapper {
      background: var(--lime);
      color: var(--ink);
      transform: translateX(3px);
    }
  }

  /* --- Grid: four identical specimens --- */
  .product-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-8) var(--s-6);
  }

  @media (min-width: 600px) {
    .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1024px) {
    .product-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .product-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    text-decoration: none;
    color: var(--on-dark-muted);
  }

  /* Fixed ratio for every tile — the fix for four mismatched photographs.
     .sk-media supplies the ratio box; this only restyles the surface. */
  .card-frame {
    background: var(--brand);
    border: 1px solid rgba(242, 243, 237, 0.12);
    margin-bottom: var(--s-5);
    clip-path: inset(calc((1 - var(--p, 1)) * 6%) round var(--r-md));
    will-change: clip-path;
  }

  .card-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transform: scale(calc(1.08 - var(--p, 1) * 0.08));
    transition: transform 1.1s var(--ease-settle);
  }

  .bottle-bg { background-image: url('../../images/biodegradable_water.png'); }
  .bag-bg { background-image: url('../../images/sakrt_bag.png'); }
  .grow-bg { background-image: url('../../images/plants and trees.png'); }
  .tableware-bg { background-image: url('../../images/biodegradable_utensils.png'); }

  /* One quiet ink scrim so four different photos share a tonal range. */
  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(16, 40, 28, 0.1) 0%,
      rgba(16, 40, 28, 0.42) 100%
    );
  }

  .card-badge {
    position: absolute;
    top: var(--s-3);
    left: var(--s-3);
    padding: 4px 10px;
    border-radius: var(--r-pill);
    background: rgba(16, 40, 28, 0.62);
    border: 1px solid rgba(242, 243, 237, 0.22);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--on-dark);
  }

  .card-content-box {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    min-width: 0;
  }

  .category-subtitle {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }

  .card-heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-synthesis-weight: none;
    font-size: var(--fs-h3);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--on-dark);
    margin: 0;
    overflow-wrap: anywhere;
  }

  .card-description {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--on-dark-muted);
    margin: 0;
  }

  .action-row {
    margin-top: var(--s-2);
  }

  /* Lime on ink measures 12.7:1 — the one place lime is allowed as text. */
  .btn-lime {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--lime);
    text-decoration: underline;
    text-decoration-color: rgba(207, 247, 55, 0.45);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition: text-decoration-color var(--dur-2) var(--ease-settle);
  }

  @media (hover: hover) {
    .product-card:hover .card-image { transform: scale(1.045); }
    .product-card:hover .card-frame { border-color: rgba(207, 247, 55, 0.45); }
    .product-card:hover .btn-lime { text-decoration-color: var(--lime); }
  }
</style>
