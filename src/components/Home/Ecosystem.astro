---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

import cipetImg from '../../images/CIPET.webp';
import isoImg from '../../images/iso.png';
import cpcbImg from '../../images/cpcb.png';
import bioComplianceImg from '../../images/bio-compliance.png';
---

<section class="ecosystem-section" id="ecosystem-section">
  <!-- Interactive Ambient Glow Circle -->
  <div class="interactive-glow" id="interactive-glow"></div>

  <div class="ecosystem-container">
    
    <!-- Section Header -->
    <div class="ecosystem-header">
      <div class="header-left">
        <span class="section-tag">
          <span class="pulsing-emerald"></span> SAKRT ECOSYSTEM
        </span>
        <h2 class="ecosystem-title">Most Enquired Products</h2>
      </div>
      
      <a href="/compostable-product" class="see-all-btn">
        <span>See All Products</span>
        <div class="arrow-wrapper">
          <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </div>
      </a>
    </div>

    <!-- Expanding Dynamic Product Accordion Grid -->
    <div class="accordion-grid">
      
      <!-- 1. Biodegradable Water Bottles -->
      <a href="/compostable-product/biodegradable-water-bottles" class="accordion-card active-card" data-card>
        <div class="card-image bottle-bg"></div>
        <div class="card-overlay"></div>
        
        <div class="card-badge">01</div>

        <div class="card-content-box">
          <span class="category-subtitle">HYDRATION</span>
          <h3 class="card-heading">Biodegradable Water Bottles</h3>
          <p class="card-description">Redefining daily hydration with zero-plastic impact, 100% natural materials.</p>
          
          <div class="action-row">
            <span class="btn-lime">View Details</span>
          </div>
        </div>
      </a>

      <!-- 2. Compostable Carry Bags -->
      <a href="/compostable-product/carry-bags" class="accordion-card" data-card>
        <div class="card-image bag-bg"></div>
        <div class="card-overlay"></div>
        
        <div class="card-badge">02</div>

        <div class="card-content-box">
          <span class="category-subtitle">PACKAGING</span>
          <h3 class="card-heading">Compostable Carry Bags</h3>
          <p class="card-description">High-tensile strength carry bags certified for complete natural decomposition.</p>

          <div class="action-row">
            <span class="btn-lime">Explore Bags</span>
          </div>
        </div>
      </a>

      <!-- 3. Compostable Films -->
      <a href="/compostable-product/compostable-films" class="accordion-card" data-card>
        <div class="card-image film-bg"></div>
        <div class="card-overlay"></div>
        
        <div class="card-badge">03</div>

        <div class="card-content-box">
          <span class="category-subtitle">PACKAGING</span>
          <h3 class="card-heading">Compostable Films</h3>
          <p class="card-description">Versatile, eco-friendly films designed to protect goods while minimizing environmental impact.</p>

          <div class="action-row">
            <span class="btn-lime">Explore Films</span>
          </div>
        </div>
      </a>

      <!-- 4. Tableware & Utensils -->
      <a href="/compostable-product/food-packaging-boxes" class="accordion-card" data-card>
        <div class="card-image tableware-bg"></div>
        <div class="card-overlay"></div>
        
        <div class="card-badge">04</div>

        <div class="card-content-box">
          <span class="category-subtitle">FOOD SERVICE</span>
          <h3 class="card-heading">Bio-Tableware & Containers</h3>
          <p class="card-description">Sturdy, heat-resistant food packaging made from organic sugarcane fibers.</p>

          <div class="action-row">
            <span class="btn-lime">Explore Tableware</span>
          </div>
        </div>
      </a>

    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Space+Mono:wght@400;700&display=swap');

  :root {
    --lime-color: #d1ff26;
    --dark-green: #0b2218;
    --ease-spring: cubic-bezier(0.25, 1, 0.3, 1);
  }

  .ecosystem-section {
    position: relative;
    padding: 120px 24px;
    background: #0d3d26;
    color: #ffffff;
    overflow: hidden;
    box-sizing: border-box;
  }

  /* Interactive Background Spotlight */
  .interactive-glow {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(209, 255, 38, 0.12) 0%, rgba(8, 26, 18, 0) 70%);
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: left 0.15s ease-out, top 0.15s ease-out;
    z-index: 1;
  }

  .ecosystem-container {
    max-width: 1320px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  /* SECTION HEADER */
  .ecosystem-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 48px;
  }

  .section-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    letter-spacing: 3px;
    color: #8a9892;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .pulsing-emerald {
    width: 8px;
    height: 8px;
    background-color: var(--lime-color);
    border-radius: 50%;
    box-shadow: 0 0 12px var(--lime-color);
    animation: emeraldPulse 2s infinite ease-in-out;
  }

  @keyframes emeraldPulse {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.4); }
  }

  .ecosystem-title {
    font-family: var(--font-serif, 'Instrument Serif', serif);
    font-size: clamp(2.4rem, 4.5vw, 3.6rem);
    font-weight: 300;
    color: #ffffff;
    margin: 0;
    line-height: 1.05;
  }

  .see-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: 'Space Mono', monospace;
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 12px 24px;
    border-radius: 40px;
    transition: all 0.4s var(--ease-spring);
  }

  .arrow-wrapper {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.4s var(--ease-spring), background 0.3s ease;
  }

  .see-all-btn:hover {
    background: var(--lime-color);
    color: var(--dark-green);
    transform: translateY(-2px);
  }

  .see-all-btn:hover .arrow-wrapper {
    background: var(--dark-green);
    color: var(--lime-color);
    transform: translateX(3px);
  }

  /* EXPANDING ACCORDION GRID */
  .accordion-grid {
    display: flex;
    gap: 20px;
    height: 520px;
    width: 100%;
  }

  .accordion-card {
    position: relative;
    flex: 1;
    border-radius: 24px;
    overflow: hidden;
    text-decoration: none;
    color: #ffffff;
    cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: flex 0.7s var(--ease-spring), border-color 0.4s ease, box-shadow 0.5s ease;
    will-change: flex;
  }

  .accordion-card.active-card {
    flex: 2.8;
    border-color: rgba(209, 255, 38, 0.5);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
  }

  /* Card Background Images */
  .card-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.8s var(--ease-spring), filter 0.5s ease;
    filter: brightness(0.7) saturate(0.9);
  }

  .accordion-card.active-card .card-image {
    filter: brightness(0.9) saturate(1.1);
    transform: scale(1.04);
  }

  .bottle-bg { background-image: url('../../images/biodegradable_water.png'); }
  .bag-bg { background-image: url('../../images/sakrt_bag.png'); }
  .film-bg { background-image: url('/compostable-films/imgi_5_biodegradable-bags-compostable-products-ecofriendly-bags-1.webp'); }
  .tableware-bg { background-image: url('../../images/biodegradable_utensils.png'); }

  /* Dark Gradient Overlay */
  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8, 26, 18, 0.2) 0%, rgba(8, 26, 18, 0.95) 90%);
    z-index: 2;
  }

  /* Badge Number */
  .card-badge {
    position: absolute;
    top: 28px;
    left: 28px;
    z-index: 3;
    font-family: 'Space Mono', monospace;
    font-size: 14px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 6px 14px;
    border-radius: 20px;
    backdrop-filter: blur(8px);
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .accordion-card.active-card .card-badge {
    color: var(--lime-color);
    border-color: var(--lime-color);
  }

  /* Content Box Inside Cards */
  .card-content-box {
    position: absolute;
    bottom: 36px;
    left: 32px;
    right: 32px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .category-subtitle {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--lime-color);
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s ease 0.1s, transform 0.4s var(--ease-spring) 0.1s;
  }

  .accordion-card.active-card .category-subtitle {
    opacity: 1;
    transform: translateY(0);
  }

  .card-heading {
    font-family: var(--font-serif, 'Instrument Serif', serif);
    font-size: clamp(1.6rem, 2.2vw, 2.2rem);
    font-weight: 300;
    margin: 0;
    line-height: 1.1;
    white-space: nowrap;
  }

  .card-description {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.5;
    margin: 4px 0 12px;
    max-width: 320px;
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transform: translateY(15px);
    transition: opacity 0.4s ease 0.15s, max-height 0.5s var(--ease-spring), transform 0.4s var(--ease-spring) 0.15s;
  }

  .accordion-card.active-card .card-description {
    opacity: 1;
    max-height: 80px;
    transform: translateY(0);
  }

  /* Button inside card */
  .action-row {
    opacity: 0;
    transform: translateY(15px);
    transition: opacity 0.4s ease 0.2s, transform 0.4s var(--ease-spring) 0.2s;
  }

  .accordion-card.active-card .action-row {
    opacity: 1;
    transform: translateY(0);
  }

  .btn-lime {
    display: inline-block;
    background: var(--lime-color);
    color: var(--dark-green);
    font-family: system-ui, -apple-system, sans-serif;
    font-weight: 700;
    font-size: 13px;
    padding: 10px 22px;
    border-radius: 30px;
    box-shadow: 0 4px 15px rgba(209, 255, 38, 0.2);
  }

  /* RESPONSIVE DESIGN */
  @media (max-width: 900px) {
    .accordion-grid {
      flex-direction: column;
      height: auto;
    }

    .accordion-card {
      height: 220px;
      flex: none !important;
      transition: height 0.8s var(--ease-spring), border-color 0.4s ease, box-shadow 0.5s ease;
    }

    .accordion-card.active-card {
      height: 380px;
    }

    .card-heading {
      white-space: normal;
    }
  }

  @media (max-width: 768px) {
    .ecosystem-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>

<script>
  function setupAccordion() {
    const section = document.getElementById('ecosystem-section');
    const glow = document.getElementById('interactive-glow');
    const cards = document.querySelectorAll('[data-card]');

    if (!section || cards.length === 0) return;

    // 1. Mouse Tracking Spotlight
    if (glow) {
      section.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = section.getBoundingClientRect();
        glow.style.left = `${e.clientX - rect.left}px`;
        glow.style.top = `${e.clientY - rect.top}px`;
      });
    }

    const isMobile = () => window.innerWidth <= 900;

    // 2. Active Expansion on Hover/Click (Desktop)
    cards.forEach((card) => {
      card.addEventListener('mouseenter', () => {
        if (!isMobile()) {
          cards.forEach((c) => c.classList.remove('active-card'));
          card.classList.add('active-card');
        }
      });
    });

    // 3. Scroll-to-expand using IntersectionObserver (Mobile)
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (!isMobile()) return;

        entries.forEach(entry => {
          if (entry.isIntersecting) {
            cards.forEach((c) => c.classList.remove('active-card'));
            entry.target.classList.add('active-card');
          }
        });
      }, {
        root: null,
        // Trigger when the card enters the middle 40% of the viewport
        rootMargin: '-30% 0px -30% 0px',
        threshold: 0
      });

      cards.forEach(card => observer.observe(card));
    }
  }

  setupAccordion();
  document.addEventListener('astro:page-load', setupAccordion);
</script>