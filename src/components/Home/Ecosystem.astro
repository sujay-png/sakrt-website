---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

import cipetImg from '../../images/CIPET.webp';
import isoImg from '../../images/iso.png';
import cpcbImg from '../../images/cpcb.png';
import bioComplianceImg from '../../images/bio-compliance.png';
---

<section class="ecosystem-section" id="ecosystem-section">
  <!-- Interactive Ambient Glow Circle -->
  <div class="interactive-glow" id="interactive-glow"></div>

  <div class="ecosystem-container">
    
    <!-- Section Header -->
    <div class="ecosystem-header">
      <div class="header-left">
        <span class="section-tag">
          <span class="pulsing-emerald"></span> SAKRT ECOSYSTEM
        </span>
        <h2 class="ecosystem-title">Most Enquired Products</h2>
      </div>
      
      <a href="/compostable-product" class="see-all-btn">
        <span>See All Products</span>
        <div class="arrow-wrapper">
          <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </div>
      </a>
    </div>

    <!-- 6-Product Cards Grid -->
    <div class="ecosystem-grid">
      
      <!-- 1. Biodegradable Water Bottles -->
      <a href="/compostable-product/biodegradable-water-bottles" class="product-card active-card">
        <div class="card-image bottle-bg"></div>
        <div class="card-overlay"></div>
        <div class="card-badge">01</div>
        <div class="card-content-box">
          <span class="category-subtitle">HYDRATION</span>
          <h3 class="card-heading">Biodegradable Water Bottles</h3>
          <p class="card-description">Redefining daily hydration with zero-plastic impact, 100% natural materials.</p>
          <div class="action-row">
            <span class="btn-lime">View Details</span>
          </div>
        </div>
      </a>

      <!-- 2. Compostable Carry Bags -->
      <a href="/compostable-product/carry-bags" class="product-card">
        <div class="card-image bag-bg"></div>
        <div class="card-overlay"></div>
        <div class="card-badge">02</div>
        <div class="card-content-box">
          <span class="category-subtitle">PACKAGING</span>
          <h3 class="card-heading">Compostable Carry Bags</h3>
          <p class="card-description">High-tensile strength carry bags certified for complete natural decomposition.</p>
          <div class="action-row">
            <span class="btn-lime">View Details</span>
          </div>
        </div>
      </a>

      <!-- 3. Compostable Films -->
      <a href="/compostable-product/compostable-films" class="product-card">
        <div class="card-image film-bg"></div>
        <div class="card-overlay"></div>
        <div class="card-badge">03</div>
        <div class="card-content-box">
          <span class="category-subtitle">PACKAGING</span>
          <h3 class="card-heading">Compostable Films</h3>
          <p class="card-description">Versatile, eco-friendly films designed to protect goods while minimizing environmental impact.</p>
          <div class="action-row">
            <span class="btn-lime">View Details</span>
          </div>
        </div>
      </a>

      <!-- 4. Tableware & Utensils -->
      <a href="/compostable-product/food-packaging-boxes" class="product-card">
        <div class="card-image tableware-bg"></div>
        <div class="card-overlay"></div>
        <div class="card-badge">04</div>
        <div class="card-content-box">
          <span class="category-subtitle">FOOD SERVICE</span>
          <h3 class="card-heading">Bio-Tableware & Containers</h3>
          <p class="card-description">Sturdy, heat-resistant food packaging made from organic sugarcane fibers.</p>
          <div class="action-row">
            <span class="btn-lime">View Details</span>
          </div>
        </div>
      </a>

      <!-- 5. Compostable Pouches -->
      <a href="/compostable-product/compostable-pouches" class="product-card">
        <div class="card-image pouches-bg"></div>
        <div class="card-overlay"></div>
        <div class="card-badge">05</div>
        <div class="card-content-box">
          <span class="category-subtitle">PACKAGING</span>
          <h3 class="card-heading">Compostable Pouches</h3>
          <p class="card-description">Multi-layer barrier protection stand-up pouches designed for food, dry goods, and retail items.</p>
          <div class="action-row">
            <span class="btn-lime">View Details</span>
          </div>
        </div>
      </a>

      <!-- 6. Courier & Mailer Bags -->
      <a href="/compostable-product/carry-bags/compostable-mailer-bags" class="product-card">
        <div class="card-image courier-bg"></div>
        <div class="card-overlay"></div>
        <div class="card-badge">06</div>
        <div class="card-content-box">
          <span class="category-subtitle">E-COMMERCE</span>
          <h3 class="card-heading">Courier & Mailer Bags</h3>
          <p class="card-description">Tear-resistant, waterproof shipping mailers certified for 100% natural composting.</p>
          <div class="action-row">
            <span class="btn-lime">View Details</span>
          </div>
        </div>
      </a>

    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Space+Mono:wght@400;700&display=swap');

  :root {
    --color-btn-bg: #8FBF6A;
    --color-btn-hover: #A8D08D;
    --color-btn-border: #8FBF6A;
    --color-btn-text: #0B3B26;
    --color-label: #A8D08D;
    --color-border-active: #8FBF6A;
    --dark-green: #0b2218;
    --ease-spring: cubic-bezier(0.25, 1, 0.3, 1);
  }

  .ecosystem-section {
    position: relative;
    padding: 120px 24px;
    background: #0d3d26;
    color: #ffffff;
    overflow: hidden;
    box-sizing: border-box;
  }

  /* Interactive Background Spotlight */
  .interactive-glow {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(143, 191, 106, 0.1) 0%, rgba(8, 26, 18, 0) 70%);
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: left 0.15s ease-out, top 0.15s ease-out;
    z-index: 1;
  }

  .ecosystem-container {
    max-width: 1320px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  /* SECTION HEADER */
  .ecosystem-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 48px;
  }

  .section-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    letter-spacing: 3px;
    color: #8a9892;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .pulsing-emerald {
    width: 8px;
    height: 8px;
    background-color: var(--color-label, #A8D08D);
    border-radius: 50%;
    box-shadow: 0 0 10px rgba(168, 208, 141, 0.5);
    animation: emeraldPulse 2s infinite ease-in-out;
  }

  @keyframes emeraldPulse {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.4); }
  }

  .ecosystem-title {
    font-family: var(--font-serif, 'Instrument Serif', serif);
    font-size: clamp(2.4rem, 4.5vw, 3.6rem);
    font-weight: 300;
    color: #ffffff;
    margin: 0;
    line-height: 1.05;
  }

  .see-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: 'Space Mono', monospace;
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 12px 24px;
    border-radius: 40px;
    transition: all 0.3s var(--ease-spring);
  }

  .arrow-wrapper {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s var(--ease-spring), background 0.3s ease;
  }

  .see-all-btn:hover {
    background: var(--color-btn-bg, #8FBF6A);
    color: var(--color-btn-text, #0B3B26);
    border-color: var(--color-btn-border, #8FBF6A);
    transform: translateY(-2px);
  }

  .see-all-btn:hover .arrow-wrapper {
    background: rgba(11, 59, 38, 0.15);
    color: var(--color-btn-text, #0B3B26);
    transform: translateX(3px);
  }

  /* PRODUCT CARDS GRID (3 across desktop, 2 tablet, 1 mobile) */
  .ecosystem-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    width: 100%;
  }

  .product-card {
    position: relative;
    height: 480px;
    border-radius: 24px;
    overflow: hidden;
    text-decoration: none;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #081a12;
    transition: transform 0.3s var(--ease-spring), border-color 0.3s ease, box-shadow 0.3s ease;
  }

  /* Active card has its soft green border visible */
  .product-card.active-card {
    border-color: var(--color-border-active, #8FBF6A);
  }

  .product-card:hover {
    transform: translateY(-6px);
    border-color: var(--color-border-active, #8FBF6A);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.4);
  }

  /* Card Background Images */
  .card-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.5s var(--ease-spring), filter 0.3s ease;
    filter: brightness(0.72) saturate(0.95);
  }

  .product-card:hover .card-image {
    filter: brightness(0.88) saturate(1.1);
    transform: scale(1.04);
  }

  .bottle-bg { background-image: url('../../images/biodegradable_water.png'); }
  .bag-bg { background-image: url('../../images/sakrt_bag.png'); }
  .film-bg { background-image: url('/compostable-films/imgi_5_biodegradable-bags-compostable-products-ecofriendly-bags-1.webp'); }
  .tableware-bg { background-image: url('../../images/biodegradable_utensils.png'); }
  .pouches-bg { background-image: url('../../images/biodegradable_greybags.png'); }
  .courier-bg { background-image: url('../../images/plastic courier bag.webp'); }

  /* Dark Gradient Overlay */
  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8, 26, 18, 0.2) 0%, rgba(8, 26, 18, 0.72) 55%, rgba(8, 26, 18, 0.96) 100%);
    z-index: 2;
  }

  /* Badge Number */
  .card-badge {
    position: absolute;
    top: 24px;
    left: 24px;
    z-index: 3;
    font-family: 'Space Mono', monospace;
    font-size: 13px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 6px 14px;
    border-radius: 20px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .product-card.active-card .card-badge,
  .product-card:hover .card-badge {
    color: var(--color-border-active, #8FBF6A);
    border-color: var(--color-border-active, #8FBF6A);
  }

  /* Content Box Inside Cards */
  .card-content-box {
    position: relative;
    z-index: 3;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .category-subtitle {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--color-label, #A8D08D);
    text-transform: uppercase;
    display: block;
  }

  .card-heading {
    font-family: var(--font-serif, 'Instrument Serif', serif);
    font-size: clamp(1.45rem, 1.8vw, 1.85rem);
    font-weight: 300;
    margin: 0;
    line-height: 1.15;
    color: #ffffff;
  }

  .card-description {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.5;
    margin: 4px 0 12px;
  }

  /* Button inside card */
  .action-row {
    margin-top: 4px;
  }

  .btn-lime {
    display: inline-block;
    background: var(--color-btn-bg, #8FBF6A);
    color: var(--color-btn-text, #0B3B26);
    border: 1px solid var(--color-btn-border, #8FBF6A);
    font-family: system-ui, -apple-system, sans-serif;
    font-weight: 600;
    font-size: 13px;
    padding: 10px 22px;
    border-radius: 6px;
    box-shadow: 0 4px 15px rgba(143, 191, 106, 0.2);
    transition: transform 0.3s var(--ease-spring), background-color 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .product-card:hover .btn-lime {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(143, 191, 106, 0.35);
  }

  .btn-lime:hover {
    background: var(--color-btn-hover, #A8D08D);
    color: var(--color-btn-text, #0B3B26);
    border-color: var(--color-btn-hover, #A8D08D);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(143, 191, 106, 0.4);
  }

  /* RESPONSIVE DESIGN */
  @media (max-width: 1024px) {
    .ecosystem-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .product-card {
      height: 440px;
    }
  }

  @media (max-width: 768px) {
    .ecosystem-section {
      padding: 80px 20px;
    }

    .ecosystem-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 36px;
    }
  }

  @media (max-width: 600px) {
    .ecosystem-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .product-card {
      height: 400px;
    }

    .card-content-box {
      padding: 22px;
    }
  }
</style>

<script>
  function setupEcosystemSpotlight() {
    const section = document.getElementById('ecosystem-section');
    const glow = document.getElementById('interactive-glow');

    if (!section || !glow) return;

    section.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = section.getBoundingClientRect();
      glow.style.left = `${e.clientX - rect.left}px`;
      glow.style.top = `${e.clientY - rect.top}px`;
    });
  }

  setupEcosystemSpotlight();
  document.addEventListener('astro:page-load', setupEcosystemSpotlight);
</script>