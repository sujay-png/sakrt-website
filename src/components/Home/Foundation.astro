---
// src/components/Home/Foundation.astro
const whyChoose = [
  {
    title: "We Vet Every Product",
    desc: "Only globally certified compostable products make it into our catalog (EN 13432, ASTM D6400, OK Compost).",
    icon: "/about/imgi_4_biodegradable_carry_bags-biodegradable_bags__compostable-products-ecofriendly-bags.-1.webp"
  },
  {
    title: "Fast Fulfillment",
    desc: "We stock and deliver in bulk perfect for retailers, supermarkets, restaurants, and event suppliers.",
    icon: "/about/imgi_5_biodegradable_carry_bags_biodegradable_bags-compostable-products-ecofriendly-bags.webp"
  },
  {
    title: "Personalized B2B Support",
    desc: "A dedicated account manager ensures smooth ordering, consistent supply, and custom packaging options.",
    icon: "/about/imgi_6_biodegradable_carry_bags-biodegradable_bags_compostable-products-ecofriendly-bags.webp"
  },
  {
    title: "Full Transparency",
    desc: "We provide full material traceability, product certifications, and eco-impact documentation.",
    icon: "/about/imgi_7_biodegradable_carry_bags-biodegradable_bags-compostable-products-ecofriendly_bags.webp"
  },
  {
    title: "Eco-Conscious Partnerships",
    desc: "We work only with manufacturers committed to sustainable agriculture, fair labor, and carbon neutrality.",
    icon: "/about/imgi_8_Biodegradable_carry_bags-biodegradable_bags-compostable-products-ecofriendly-bags.webp"
  },
  {
    title: "Field-Tested Quality",
    desc: "We provide full material traceability, product certifications, and eco-impact documentation.",
    icon: "/about/imgi_9_server-check.png"
  },
  {
    title: "Scalable Supply Chain",
    desc: "From local shops to national distributors, our inventory and logistics are built to grow with you.",
    icon: "/about/imgi_10_supply-chain.png"
  }
];
---

<section class="sk-section foundations-section" id="foundations-section">
  <div class="sk-wrap">
    <div class="why-sakrt-section">
      <div class="why-header" data-reveal>
        <h2 class="sk-title why-title">Why Choose SAKRT Bioplastic Manufacturers?</h2>
      </div>

      <div class="why-grid" data-reveal-group>
        {whyChoose.map((item) => (
          <div class="why-card" data-reveal="grow">
            <div class="why-icon-box">
              <img src={item.icon} alt={item.title} class="why-icon-img" loading="lazy" />
            </div>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Opaque + raised over the sticky hero. Light band after the dark one. */
  .foundations-section {
    position: relative;
    z-index: 10;
    background: var(--pulp);
  }

  .why-header {
    padding-bottom: var(--s-8);
    margin-bottom: var(--s-10);
    border-bottom: 1px solid var(--hairline-strong);
  }

  .why-title {
    max-width: 30ch;
    margin: 0;
  }

  /* Register of reasons: equal ruled cards, seven of them, no orphan row. */
  .why-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-4);
  }

  @media (min-width: 560px) {
    .why-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 900px) {
    .why-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (min-width: 1140px) {
    .why-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .why-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    padding: var(--s-8) var(--s-6);
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
    transition: border-color var(--dur-2) var(--ease-settle),
                transform var(--dur-2) var(--ease-settle),
                box-shadow var(--dur-2) var(--ease-settle);
  }

  /* Icons here are a mix of product photos and flat PNGs. A fixed square
     on pulp-deep with object-fit: contain normalises the set. */
  .why-icon-box {
    width: 60px;
    height: 60px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--s-2);
    background: var(--pulp-deep);
    border-radius: var(--r-sm);
    margin-bottom: var(--s-6);
  }

  .why-icon-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .why-card h3 {
    font-family: var(--font-sans);
    font-size: var(--fs-h4);
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
    margin: 0 0 var(--s-3);
    overflow-wrap: anywhere;
  }

  .why-card p {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    line-height: 1.65;
    color: var(--ink-soft);
    margin: 0;
  }

  @media (hover: hover) {
    .why-card:hover {
      transform: translateY(-4px);
      border-color: var(--hairline-strong);
      box-shadow: var(--shadow-2);
    }
  }
</style>
