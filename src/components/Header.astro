---
// src/components/Header.astro
const pathname = Astro.url.pathname;
const isProductsActive = pathname.startsWith('/products') || 
  ['/products/tableware', '/products/compostable-films', '/products/compostable-pouches', '/products/compostable-bags', '/products/eco-water-bottles'].includes(pathname);
---

<header class="main-header">
  <div class="glass-navbar">

    <!-- Logo -->
    <a href="/" class="logo">SAKRT</a>

    <!-- Mobile Menu Toggle (Checkbox Hack) -->
    <input type="checkbox" id="menu-toggle" class="menu-toggle-cb">
    <label for="menu-toggle" class="hamburger" aria-label="Toggle Menu">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <!-- Navigation Links -->
    <nav class="nav-menu">
      <a href="/" class={pathname === "/" ? "active" : ""}>Home</a>
      <a href="/about" class={pathname === "/about" ? "active" : ""}>About</a>
      
      <!-- Products Dropdown Wrapper -->
      <div class="dropdown-container">
        <a href="/products" class={`dropdown-trigger ${isProductsActive ? "active" : ""}`}>
          Products
          <svg class="dropdown-arrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>
        
        <!-- Dropdown Menu -->
        <ul class="dropdown-menu">
          <li><a href="/productdetails/designer-tableware">Table Ware</a></li>
          <li><a href="/productdetails/compostable-films">Compostable Films</a></li>
          <li><a href="/productdetails/stand-up-pouches">Compostable Pouches</a></li>
          <li><a href="/productdetails/compostable-bags">Compostable Bags</a></li>
          <li><a href="/productdetails/">Eco Friendly Water Bottles</a></li>
        </ul>
      </div>

      <a href="/certifications" class={pathname === "/certifications" ? "active" : ""}>Certifications</a>
      <a href="/blogarticles" class={pathname === "/blogarticles" ? "active" : ""}>Blog Articles</a>
      <a href="/media" class={pathname === "/media" ? "active" : ""}>Media</a>
      <a href="/contactus" class={pathname === "/contactus" ? "active" : ""}>Contact Us</a>
        
      <!-- Mobile-only CTA -->
      <a href="/enquiry" class="enquire-btn mobile-btn">Enquire</a>
    </nav>

    <!-- Desktop Enquire Button -->
    <a href="/enquiry" class="enquire-btn desktop-btn">Enquire</a>

  </div>
</header>

<style>
/* Font Imports */
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Space+Mono:wght@400;700&display=swap');

/* Fixed Header Outer Wrapper */
.main-header {
  position: fixed;
  top: 20px;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0 2rem;
  z-index: 1000;
}

/* Glassmorphism Floating Capsule Navbar */
.glass-navbar {
  width: 100%;
  max-width: 1240px;
  height: 64px;
  
  /* Glass Pill Effect */
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.22);
  border-radius: 20px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);

  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 12px 0 28px;
  gap: 16px;
}

/* Logo Style */
.logo {
  font-family: var(--font-serif, 'Playfair Display', serif);
  font-size: 22px;
  font-weight: 700;
  color: var(--color-primary-dark, #1b3d2f);
  text-decoration: none;
  letter-spacing: 1.5px;
  white-space: nowrap;
}

/* Navigation Menu Container */
.nav-menu {
  display: flex;
  align-items: center;
  gap: 20px;
  position: relative;
  flex-wrap: nowrap;
}

.nav-menu a {
  text-decoration: none;
  color: var(--color-text-muted, rgba(27, 61, 47, 0.7));
  font-family: var(--font-mono, 'Space Mono', monospace);
  font-size: 13px;
  letter-spacing: 0.3px;
  transition: color 0.3s ease;
  position: relative;
  padding: 6px 0;
  white-space: nowrap;
}

.nav-menu a:hover {
  color: var(--color-primary-dark, #1b3d2f);
}

/* Active Link or Hovered Link Accent */
.nav-menu a.active,
.nav-menu a:hover {
  color: var(--color-primary-dark, #1b3d2f);
  font-weight: 700;
}

/* Lime Green Accent Indicator Base Styles */
.nav-menu a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -2px;
  width: 0;
  height: 2px;
  background: var(--color-accent-lime-bright, #CFF737);
  border-radius: 2px;
  transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Keep active page underlined */
.nav-menu a.active::after {
  width: 100%;
}

/* Hover effects for regular menu links */
.nav-menu:hover a:hover::after {
  width: 100%;
}

.nav-menu:hover a:not(:hover).active::after {
  width: 0;
}

/* ==========================================
   PRODUCTS DROPDOWN STYLES
   ========================================== */
.dropdown-container {
  position: relative;
  display: flex;
  align-items: center;
}

.dropdown-trigger {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.dropdown-arrow {
  transition: transform 0.3s ease;
}

.dropdown-container:hover .dropdown-arrow {
  transform: rotate(180deg);
}

/* Glassmorphism Dropdown Menu Card */
.dropdown-menu {
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%) translateY(10px);
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.4);
  border-radius: 16px;
  padding: 10px 0;
  min-width: 210px;
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
  list-style: none;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  pointer-events: none;
  z-index: 1050;
  margin: 0;
}

/* Hover Bridge: Keeps dropdown open when moving cursor down */
.dropdown-container::after {
  content: "";
  position: absolute;
  top: 100%;
  left: 0;
  width: 100%;
  height: 15px;
}

/* Dropdown Reveal */
.dropdown-container:hover .dropdown-menu {
  opacity: 1;
  visibility: visible;
  transform: translateX(-50%) translateY(4px);
  pointer-events: auto;
}

.dropdown-menu li {
  width: 100%;
}

.dropdown-menu li a {
  display: block;
  padding: 10px 20px;
  color: var(--color-primary-dark, #1b3d2f);
  font-family: var(--font-mono, 'Space Mono', monospace);
  font-size: 12px;
  font-weight: 500;
  text-decoration: none;
  transition: background 0.2s ease, color 0.2s ease;
  white-space: nowrap;
}

/* Disable the bottom underline animation inside the dropdown menu */
.dropdown-menu li a::after {
  display: none !important;
}

.dropdown-menu li a:hover {
  background: rgba(27, 61, 47, 0.06);
  color: #0d3225;
  font-weight: 700;
}

/* Dark Green Pill Button */
.enquire-btn {
  background: var(--color-primary-dark, #0d3225);
  color: var(--color-text-light, #ffffff);
  padding: 10px 22px;
  border-radius: 15px;
  text-decoration: none;
  font-family: var(--font-mono, 'Space Mono', monospace);
  font-size: 13px;
  font-weight: 700;
  transition: all 0.3s ease;
  box-shadow: 0 4px 12px rgba(13, 50, 37, 0.3);
  white-space: nowrap;
}

.enquire-btn:hover {
  background: var(--color-forest-medium, #144735);
  transform: translateY(-1px);
}

.mobile-btn {
  display: none;
}

/* Hide Checkbox Toggle */
.menu-toggle-cb {
  display: none;
}

/* Hamburger Icon Style */
.hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  cursor: pointer;
  z-index: 1010;
  margin-right: 12px;
}

.hamburger span {
  width: 24px;
  height: 2px;
  background-color: #1b3d2f;
  border-radius: 2px;
  transition: all 0.3s ease-in-out;
}

/* Mobile Responsiveness */
@media (max-width: 900px) {
  .glass-navbar {
    height: 56px;
    padding: 0 16px 0 24px;
  }

  .desktop-btn {
    display: none;
  }

  .hamburger {
    display: flex;
  }

  /* Slide-out Mobile Menu Container */
  .nav-menu {
    position: fixed;
    top: 75px;
    right: -100%;
    width: calc(100vw - 32px);
    max-width: 400px;
    max-height: 80vh;
    overflow-y: auto;
    background: rgba(13, 50, 37, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 24px;
    padding: 30px 24px;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    gap: 16px;
    transition: right 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  }

  .nav-menu a {
    font-size: 15px;
    color: #ffffff;
  }

  .nav-menu a:hover,
  .nav-menu a.active {
    color: #CFF737;
  }

  .nav-menu:hover a:not(:hover).active::after {
    width: 100%;
  }

  /* Mobile Dropdown Customization */
  .dropdown-container {
    flex-direction: column;
    width: 100%;
    align-items: center;
  }

  .dropdown-menu {
    position: static;
    transform: none;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: none;
    width: 100%;
    text-align: center;
    margin-top: 8px;
    padding: 8px 0;
    border-radius: 12px;
  }

  .dropdown-container:hover .dropdown-menu {
    transform: none;
  }

  .dropdown-menu li a {
    color: rgba(255, 255, 255, 0.85);
    padding: 8px 12px;
    font-size: 13px;
  }

  .dropdown-menu li a:hover {
    background: rgba(207, 247, 55, 0.15);
    color: #CFF737;
  }

  .mobile-btn {
    display: inline-block;
    margin-top: 10px;
    width: 100%;
    text-align: center;
  }

  /* Checkbox Toggle Logic */
  .menu-toggle-cb:checked ~ .nav-menu {
    right: 16px;
  }

  /* Hamburger to 'X' Animation */
  .menu-toggle-cb:checked ~ .hamburger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-toggle-cb:checked ~ .hamburger span:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle-cb:checked ~ .hamburger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
}
</style>