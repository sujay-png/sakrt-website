---
// src/components/Header.astro
const pathname = Astro.url.pathname;
const isProductsActive =
  pathname.startsWith("/compostable-product") ||
  [
    "/compostable-product/tableware",
    "/compostable-product/compostable-films",
    "/compostable-product/compostable-pouches",
    "/compostable-product/compostable-bags",
    "/compostable-product/eco-water-bottles",
  ].includes(pathname);
---

<header class="main-header">
  <div class="glass-navbar">
    <!-- Left: Logo -->
    <div class="nav-left">
      <a href="/" class="logo" aria-label="SAKRT Home">
        <img src="/logo/footer-logo.webp" alt="SAKRT Logo" />
      </a>
    </div>

    <!-- Mobile Menu Toggle (Checkbox Hack) -->
    <input type="checkbox" id="menu-toggle" class="menu-toggle-cb" />
    <label for="menu-toggle" class="hamburger" aria-label="Toggle Menu">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <!-- Center: Navigation Links -->
    <nav class="nav-menu">


      <a href="/" class={pathname === "/" ? "active" : ""}>Home</a>
      <a href="/about" class={pathname === "/about" ? "active" : ""}>About</a>

      <!-- Products Dropdown Wrapper -->
      <div class="dropdown-container">
        <a
          href="/compostable-product"
          class={`dropdown-trigger ${isProductsActive ? "active" : ""}`}
        >
          Products
          <svg
            class="dropdown-arrow"
            viewBox="0 0 24 24"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>

        <!-- Dropdown Menu -->
        <ul class="dropdown-menu">
          <li>
            <a href="/compostable-product/food-packaging-boxes">Table Ware</a>
          </li>
          <li>
            <a href="/compostable-product/compostable-films"
              >Compostable Films</a
            >
          </li>
          <li>
            <a href="/compostable-product/compostable-pouches"
              >Compostable Pouches</a
            >
          </li>
          <li>
            <a href="/compostable-product/carry-bags">Compostable Bags</a>
          </li>
          <li>
            <a href="/compostable-product/biodegradable-water-bottles"
              >Eco Friendly Water Bottles</a
            >
          </li>
        </ul>
      </div>

      <a
        href="/our-certifications"
        class={pathname === "/our-certifications" ? "active" : ""}
        >Certifications</a
      >
      <a href="/blog" class={pathname.startsWith("/blog") ? "active" : ""}
        >Blogs</a
      >
      <a href="/media" class={pathname === "/media" ? "active" : ""}>Media</a>

      <!-- Mobile-only CTA -->
      <a href="/contact-us" class="enquire-btn mobile-btn shine-btn">Inquire</a>
    </nav>

    <!-- Right: Desktop Enquire Button -->
    <div class="nav-right desktop-btn">
      <a href="/contact-us" class="enquire-btn shine-btn">Inquire</a>
    </div>
  </div>
</header>

<style>
  /* No @import here — every face is loaded once in Layout.astro. A CSS
     @import inside a component blocks first paint. */

  /* Fixed Header Outer Wrapper */
  .main-header {
    position: fixed;
    top: var(--s-6);
    left: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding-inline: clamp(16px, 3vw, 32px);
    z-index: 1000;
  }

  /* Floating capsule. Tinted with pulp rather than neutral grey so ink
     text keeps its contrast wherever the light hero photo sits behind it.
     backdrop-filter is allowed here — header and hero buttons only. */
  .glass-navbar {
    width: 100%;
    max-width: 1100px;
    height: 64px;

    background: rgba(242, 243, 237, 0.62);
    backdrop-filter: blur(18px) saturate(115%);
    -webkit-backdrop-filter: blur(18px) saturate(115%);
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: var(--r-lg);
    box-shadow: 0 10px 30px -18px rgba(16, 40, 28, 0.35);

    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 10px 0 var(--s-8);
  }

  /* Flexbox Layout Helpers */
  .nav-left {
    flex: 1;
    display: flex;
    justify-content: flex-start;
    align-items: center;
  }

  .nav-right {
    flex: 1;
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  /* Logo Style */
  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .logo img {
    height: 48px;
    width: 48px;
    object-fit: cover;
    border-radius: var(--r-pill);
    transition: transform var(--dur-2) var(--ease-settle);
  }

  /* Navigation Menu Container */
  .nav-menu {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-8);
    position: relative;
    flex-wrap: nowrap;
  }

  .nav-menu a {
    text-decoration: none;
    color: var(--ink-soft);
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    font-weight: 500;
    letter-spacing: 0.01em;
    transition: color var(--dur-1) var(--ease-out);
    position: relative;
    padding: 6px 0;
    white-space: nowrap;
  }

  .nav-menu a.active {
    color: var(--ink);
  }

  /* Lime as a rule, not as text. Scales rather than animating width. */
  .nav-menu a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--lime);
    border-radius: var(--r-pill);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-2) var(--ease-settle);
  }

  .nav-menu a.active::after {
    transform: scaleX(1);
  }

  /* ==========================================
   PRODUCTS DROPDOWN STYLES
   ========================================== */
  .dropdown-container {
    position: relative;
    display: flex;
    align-items: center;
  }

  .dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
  }

  .dropdown-arrow {
    transition: transform var(--dur-2) var(--ease-settle);
    margin-top: -1px;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    padding: var(--s-2) 0;
    min-width: 210px;
    box-shadow: var(--shadow-2);
    list-style: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--dur-2) var(--ease-settle),
                transform var(--dur-2) var(--ease-settle),
                visibility var(--dur-2) var(--ease-settle);
    pointer-events: none;
    z-index: 1050;
    margin: 0;
  }

  .dropdown-menu li {
    width: 100%;
  }

  .dropdown-menu li a {
    display: block;
    padding: 10px 20px;
    color: var(--ink-soft);
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
    transition: background-color var(--dur-1) var(--ease-out),
                color var(--dur-1) var(--ease-out);
    white-space: nowrap;
  }

  .dropdown-menu li a::after {
    display: none !important;
  }

  /* Keyboard users get the same panel a mouse user gets. Desktop only —
     on mobile the trigger's click handler owns the .open state, and Enter
     on a link fires click, so keyboard works there too. */
  @media (min-width: 1001px) {
    .dropdown-container:focus-within .dropdown-menu {
      opacity: 1;
      visibility: visible;
      transform: translateX(-50%) translateY(4px);
      pointer-events: auto;
    }

    .dropdown-container:focus-within .dropdown-arrow {
      transform: rotate(180deg);
    }
  }

  /* Dark Pill Button */
  .enquire-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 26px;
    background: var(--ink);
    color: var(--on-dark);
    border-radius: var(--r-pill);
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    font-weight: 600;
    white-space: nowrap;
    transition: background-color var(--dur-1) var(--ease-out),
                transform var(--dur-1) var(--ease-out);
  }

  /* Shine Effect for Enquire Button */
  .shine-btn {
    overflow: hidden;
    position: relative;
  }
  .shine-btn::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -60%;
    width: 20%;
    height: 200%;
    background: rgba(255, 255, 255, 0.22);
    transform: rotate(30deg);
    transition: left 0.6s var(--ease-out);
    pointer-events: none;
    animation: shimmerLoop 3s infinite;
  }
  @keyframes shimmerLoop {
    0%, 70% { left: -60%; }
    100% { left: 120%; }
  }
  @media (hover: hover) {
    .shine-btn:hover::after { left: 120%; animation: none; }
  }

  .mobile-btn {
    display: none;
  }

  /* Hidden outright on desktop, where there is no drawer to toggle. It
     becomes a focusable sr-only control inside the mobile query below. */
  .menu-toggle-cb {
    display: none;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    cursor: pointer;
    z-index: 1010;
    -webkit-tap-highlight-color: transparent;
  }

  .hamburger span {
    width: 24px;
    height: 2px;
    background-color: var(--ink);
    border-radius: var(--r-pill);
    transition: transform var(--dur-2) var(--ease-settle),
                opacity var(--dur-1) var(--ease-out);
  }

  .menu-toggle-cb:focus-visible ~ .hamburger {
    outline: 2px solid var(--brand);
    outline-offset: 3px;
  }

  /* ==========================================
   DESKTOP HOVER (pointer devices only, so touch never sticks)
   ========================================== */
  @media (hover: hover) {
    .logo:hover img { transform: scale(1.02); }

    .nav-menu a:hover { color: var(--ink); }
    .nav-menu:hover a:hover::after { transform: scaleX(1); }
    .nav-menu:hover a:not(:hover).active::after { transform: scaleX(0); }

    .dropdown-menu li a:hover {
      background: var(--pulp-deep);
      color: var(--ink);
    }

    .enquire-btn:hover {
      background: var(--brand);
      transform: translateY(-2px);
    }
  }

  @media (hover: hover) and (min-width: 1001px) {
    /* Invisible bridge so the pointer can cross the gap to the panel. */
    .dropdown-container::after {
      content: "";
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      height: 20px;
    }

    .dropdown-container:hover .dropdown-menu {
      opacity: 1;
      visibility: visible;
      transform: translateX(-50%) translateY(4px);
      pointer-events: auto;
    }

    .dropdown-container:hover .dropdown-arrow {
      transform: rotate(180deg);
    }
  }

  /* ==========================================
   MOBILE RESPONSIVENESS
   ========================================== */
  @media (max-width: 1000px) {
    .main-header {
      padding-inline: var(--s-4);
    }

    .glass-navbar {
      height: 56px;
      padding: 0 var(--s-2) 0 var(--s-3);
    }

    .logo img {
      height: 38px;
      width: 38px;
    }

    .nav-left,
    .nav-right {
      flex: unset;
    }

    .desktop-btn {
      display: none;
    }

    .hamburger {
      display: flex;
    }

    /* Visually hidden but focusable, so the drawer is reachable by
       keyboard — it was not, while this was display: none. */
    .menu-toggle-cb {
      display: block;
      position: absolute;
      width: 1px;
      height: 1px;
      margin: 0;
      padding: 0;
      border: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    /* Drop panel. An opaque ink sheet that unfolds from under the
       hamburger and lines up with the navbar's right edge, so it reads as
       the capsule opening — not a stray card floating mid-screen. Opaque
       so link contrast never depends on what scrolls behind it. */
    .nav-menu {
      position: fixed;
      top: 88px;                 /* just below the 56px bar (24 top + 56 + 8 gap) */
      right: var(--s-4);         /* same gutter as the navbar */
      left: auto;
      width: calc(100% - var(--s-8));
      max-width: 360px;
      max-height: 80vh;
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      background: var(--ink);
      border: 1px solid rgba(242, 243, 237, 0.12);
      border-radius: var(--r-lg);
      padding: var(--s-3);
      flex-direction: column;
      justify-content: flex-start;
      align-items: stretch;
      gap: 2px;
      box-shadow: var(--shadow-3);
      transform-origin: top right;
      transform: scale(0.97);
      opacity: 0;
      visibility: hidden;
      transition: transform var(--dur-2) var(--ease-settle),
                  opacity var(--dur-2) var(--ease-out),
                  visibility var(--dur-2) var(--ease-out);
    }

    .nav-menu a {
      font-size: var(--fs-sm);
      font-weight: 500;
      color: var(--on-dark);
      text-align: left;
      padding: 13px 14px;
      border-radius: var(--r-md);
      width: 100%;
      -webkit-tap-highlight-color: transparent;
      transition: color var(--dur-1) var(--ease-out),
                  background-color var(--dur-1) var(--ease-out);
    }

    .nav-menu a.mobile-btn {
      text-align: center;
      display: inline-flex;
      justify-content: center;
      margin-top: var(--s-4);
      width: 100%;
      background: var(--lime);
      color: var(--ink);
    }

    .nav-menu a::after {
      display: none;
    }

    /* Lime on ink measures 12.7:1. A tinted row plus a lime edge back the
       colour up, so the active state never rides on hue alone. */
    .nav-menu a.active {
      color: var(--lime);
      background: rgba(207, 247, 55, 0.09);
      box-shadow: inset 2px 0 0 var(--lime);
    }

    /* Staggered entrance: rows grow up into place just after the sheet
       opens. Driven by an animation (not a delayed transition) so hover
       feedback stays instant and the close fades cleanly with the panel. */
    .nav-menu > * {
      opacity: 1;
      transform: none;
    }
    .menu-toggle-cb:checked ~ .nav-menu > * {
      animation: navItemIn var(--dur-2) var(--ease-settle) both;
    }
    .menu-toggle-cb:checked ~ .nav-menu > *:nth-child(1) { animation-delay: 0.04s; }
    .menu-toggle-cb:checked ~ .nav-menu > *:nth-child(2) { animation-delay: 0.08s; }
    .menu-toggle-cb:checked ~ .nav-menu > *:nth-child(3) { animation-delay: 0.12s; }
    .menu-toggle-cb:checked ~ .nav-menu > *:nth-child(4) { animation-delay: 0.16s; }
    .menu-toggle-cb:checked ~ .nav-menu > *:nth-child(5) { animation-delay: 0.20s; }
    .menu-toggle-cb:checked ~ .nav-menu > *:nth-child(6) { animation-delay: 0.24s; }
    .menu-toggle-cb:checked ~ .nav-menu > *:nth-child(7) { animation-delay: 0.28s; }

    /* Section divider before the secondary group */
    a[href="/our-certifications"] {
      margin-top: var(--s-2);
      border-top: 1px solid rgba(242, 243, 237, 0.1);
      padding-top: var(--s-4);
    }

    /* Mobile Dropdown Customization */
    .dropdown-container {
      flex-direction: column;
      width: 100%;
      align-items: stretch;
    }

    .dropdown-container::after {
      content: none;
    }

    .dropdown-trigger {
      justify-content: space-between;
      width: 100%;
    }

    .dropdown-menu {
      position: static;
      transform: none;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      max-height: 0;
      overflow: hidden;
      background: rgba(242, 243, 237, 0.04);
      border: none;
      border-radius: var(--r-md);
      box-shadow: none;
      width: 100%;
      text-align: left;
      margin-top: 0;
      padding: 0;
      transition: opacity var(--dur-2) var(--ease-out),
                  visibility var(--dur-2) var(--ease-out);
    }

    .dropdown-container.open .dropdown-menu {
      opacity: 1;
      visibility: visible;
      max-height: 350px;
      pointer-events: auto;
      margin: 6px 0 var(--s-2) 0;
      padding: 6px;
    }

    .dropdown-container.open .dropdown-arrow {
      transform: rotate(180deg);
    }

    .dropdown-menu li a {
      color: var(--on-dark-muted);
      padding: 10px 14px 10px var(--s-5);
      font-size: var(--fs-xs);
      display: flex;
      align-items: center;
      gap: var(--s-2);
      border-radius: var(--r-sm);
    }

    /* Dash marker before each submenu item for visual hierarchy */
    .dropdown-menu li a::before {
      content: "—";
      color: var(--lime);
      font-size: 12px;
      opacity: 0.7;
    }

    /* Let the mobile-btn inside nav-menu handle its own styles */

    /* Checkbox Toggle Logic */
    .menu-toggle-cb:checked ~ .nav-menu {
      transform: none;
      opacity: 1;
      visibility: visible;
    }

    .menu-toggle-cb:checked ~ .hamburger {
      /* Background removed */
    }

    /* Hamburger to 'X' Animation */
    .menu-toggle-cb:checked ~ .hamburger span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .menu-toggle-cb:checked ~ .hamburger span:nth-child(2) {
      opacity: 0;
    }
    .menu-toggle-cb:checked ~ .hamburger span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }

  @keyframes navItemIn {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (hover: hover) and (max-width: 1000px) {
    .hamburger:hover {
      /* Background removed */
    }

    .nav-menu a:hover {
      color: var(--lime);
      background: rgba(207, 247, 55, 0.07);
    }

    .dropdown-menu li a:hover {
      background: rgba(242, 243, 237, 0.06);
      color: var(--lime);
    }
  }

  /* Reduced motion: no stagger, no unfold — the sheet just appears. */
  @media (prefers-reduced-motion: reduce) {
    .menu-toggle-cb:checked ~ .nav-menu > * {
      animation: none;
    }
    .nav-menu {
      transform: none;
    }
  }
</style>

<script>
  const initHeaderMenu = () => {
    const dropdownTrigger = document.querySelector(".dropdown-trigger");
    const dropdownContainer = document.querySelector(".dropdown-container");

    if (dropdownTrigger && dropdownContainer) {
      dropdownTrigger.addEventListener("click", (e) => {
        if (window.innerWidth <= 1000) {
          e.preventDefault();
          dropdownContainer.classList.toggle("open");
        }
      });
    }
  };

  initHeaderMenu();
  document.addEventListener("astro:after-swap", initHeaderMenu);
</script>
