---
// src/pages/contactus/index.astro
import Layout from '../../layouts/Layout.astro';
import ContactHeading from '../../components/ContactUs/ContactHeading.astro';
import InquiryForm from '../../components/ContactUs/InquiryForm.astro';
import DirectComms from '../../components/ContactUs/DirectComms.astro';
import PhysicalAnchor from '../../components/ContactUs/PhysicalAnchor.astro';
import ContactInfoCards from '../../components/ContactUs/ContactInfoCards.astro';
---

<Layout title="Contact Us">
  <main class="contact-container">
    <!-- Google Fonts Import -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

    <!-- Title Header -->
    <ContactHeading />

    <!-- 2-Column Grid Layout for the Cards -->
    <div class="cards-grid">
      <div class="form-cell">
        <InquiryForm />
      </div>
      <div class="comms-cell">
        <DirectComms />
      </div>
      <div class="anchor-cell">
        <PhysicalAnchor />
      </div>
       <div class="form-cell"></div>
     
    </div>
     <ContactInfoCards/>
  </main>
</Layout>

<style>
  .contact-container {
    max-width: 1340px;
    margin: 0 auto;
    padding: 8rem 1.5rem 3rem;
    font-family: Inter, sans-serif;
  }

  /* Grid configuration matching images 4 and 5 */
  .cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .contact-container {
      padding-right: 6.5rem;
    }
    
    .cards-grid {
      grid-template-columns: 1.4fr 1fr;
      grid-template-rows: auto auto;
    }

    /* Form Card spans the full height on the left */
    .form-cell {
      grid-column: 1 / 2;
      grid-row: 1 / 3;
    }

    /* Top right card */
    .comms-cell {
      grid-column: 2 / 3;
      grid-row: 1 / 2;
    }

    /* Bottom right card */
    .anchor-cell {
      grid-column: 2 / 3;
      grid-row: 2 / 3;
    }
  }
</style>