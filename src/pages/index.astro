---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Home/Hero.astro';
import Mission from '../components/Home/Mission.astro';
import PublicAppearance from '../components/Home/PublicAppearance.astro';
import Ecosystem from '../components/Home/Ecosystem.astro';
import Foundation from '../components/Home/Foundation.astro';
import Journal from '../components/Home/Journal.astro';
import CallToAction from '../components/Home/CallToAction.astro';
import ProductRange from '../components/Home/ProductRange.astro';
import WhyChooseUs from '../components/Home/WhyChooseUs.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "SAKRT",
  "url": "https://www.sakrt.in",
  "logo": "https://www.sakrt.in/logo/footer-logo.webp",
  "description": "SAKRT is a leading manufacturer of certified compostable packaging, bags, and tableware in India.",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "IN"
  }
};
---

<Layout 
  title=" Mangalore compostable bags manufacturer | SAKRT"
  description="CPCB-certified compostable products including carry bags, bio-films, and cutlery engineered from 100% eco-friendly, renewable materials ."
  schema={schema}
  keyword="Mangalore compostable bags manufacturer and retailer"
>

  <main id="main-content">
    <Hero/>
    <Mission/>
    <PublicAppearance/>
    <ProductRange/>
    <Ecosystem/>
    <Foundation/>
    <Journal/>
    <WhyChooseUs/>
    <CallToAction/>
  </main>
  
 
</Layout>
