const { locationName } = Astro.props;
const { location } = Astro.params;

const locationKey = (location || '').toLowerCase();
const customMeta = locationMetaMap[locationKey];

const metaTitle = customMeta?.title || `Compostable Product Manufacturer in ${locationName} | SAKRT`;
const metaDesc = customMeta?.description || `Your Local Partner For Sustainable, Biodegradable Bags & Films in ${locationName}.`;
const metaH1 = customMeta?.h1 || `Compostable Product Manufacturer In ${locationName}`;
---

<Layout hideHeader={true} title={metaTitle} description={metaDesc}>
  <main class="location-page">
    
    <!-- Hero Section -->
    <section class="location-hero" style="background-image: url('/location-hero.webp');">
      <div class="hero-overlay"></div>
      <div class="container hero-content text-center">
        <h1 class="hero-title">{metaH1}</h1>
        <p class="hero-subtitle">Your Local Partner For Sustainable, Biodegradable Bags & Films</p>
      </div>
    </section>

    <!-- Welcome Section -->
    <section class="welcome-section section-padding bg-light">
      <div class="container text-center">
        <h2 class="welcome-title">Welcome To SAKRT<br/><span class="text-green">Your Sustainable Packaging Expert In {locationName}</span></h2>
        <p class="welcome-text">At Sakrt, we understand that packaging is more than just containment; it's the first impression your brand makes, and it's also one of the biggest opportunities to reduce your environmental impact. We supply eco-friendly, biodegradable, compostable packaging solutions designed for the region's businesses. Whether you are a retailer, e-commerce brand, food service outlet or waste management Compostable products {locationName}, we're here to help you switch from conventional plastics to a greener alternative.</p>
      </div>
    </section>

    <!-- 2 Column Info Section -->
    <section class="info-grid-section section-padding">
      <div class="container info-grid">
        <div class="info-card">
          <h3 class="green-title">Compostable Product Manufacturer in {locationName}</h3>
          <p>Sakrt is a trusted compostable product manufacturer in {locationName}, offering certified, eco-friendly alternatives to single-use plastic. We manufacture and supply high-quality compostable bags and sustainable packaging solutions for businesses, institutions, and bulk buyers across {locationName} and nearby regions.</p>
          <p>Our products are designed to meet Plastic Waste Management Rules while helping businesses transition to environmentally responsible packaging without compromising on strength, quality, or compliance. Compostable products {locationName}.</p>
        </div>
        <div class="info-card">
          <h3 class="green-title">Why Choose Sakrt</h3>
          <p>Businesses across {locationName} choose Sakrt for reliability, compliance, and scale:</p>
          <ul class="custom-check-list">
            <li>CPCB-certified compostable products</li>
            <li>ISO standard manufacturing processes</li>
            <li>Bulk manufacturing capacity for B2B buyers</li>
            <li>Consistent supply across {locationName}</li>
            <li>Custom sizes, thickness & branding options</li>
            <li>Competitive pricing for distributors & institutions</li>
          </ul>
          <p>We support retailers, hotels, restaurants, hospitals, and organizations looking for a dependable compostable products manufacturer in {locationName}. Compostable products {locationName}.</p>
        </div>
      </div>
    </section>

    <!-- Service Areas Section -->
    <section class="service-areas section-padding text-center">
      <div class="container">
        <h3 class="green-title">Service Areas in and Around {locationName}</h3>
        <p class="sub-heading">We supply compostable products across all major areas of {locationName}, including:</p>
        <p class="areas-text">{locationName} City, surrounding districts, industrial hubs, commercial centers, and neighboring regions.</p>
        <p class="areas-text">We also deliver to nearby states and across India.</p>
        <p class="tagline">Compostable products {locationName}</p>
      </div>
    </section>

    <!-- Contact Banner -->
    <section class="contact-banner">
      <div class="container">
        <div class="contact-box text-center">
          <h2>Contact Us</h2>
          <p>Looking for a reliable compostable product manufacturer in {locationName}?<br/>Choose SAKRT for your home, business, or event and make waste disposal environmentally responsible.</p>
          <a href="/contact-us/" class="btn btn-primary mt-4">Click Here</a>
        </div>
      </div>
    </section>

    <!-- Portfolio Section -->
    <section class="portfolio-section section-padding">
      <div class="container">
        <div class="text-center mb-5">
          <h2 class="green-title portfolio-heading">Our Product Portfolio</h2>
        </div>
        
        <div class="portfolio-grid">
          <!-- Card 1 -->
          <div class="portfolio-card">
            <img src="/hero/imgi_5_biodegradable-bags-compostable-products-ecofriendly-bags.webp" alt="Biodegradable Retail & Carry Bags" width="80" height="80" style="width: 80px; height: 80px; object-fit: contain; margin: 0 auto 15px; display: block;" />
            <h4 class="portfolio-title">Biodegradable Retail & Carry Bags</h4>
            <p>Ideal for boutiques, grocery stores, food outlets and retail chains. Strong printed or plain compostable materials that look and feel premium.</p>
          </div>
          <!-- Card 2 -->
          <div class="portfolio-card">
            <img src="/hero/imgi_6_biodegradable-bags-compostable-products-ecofriendly-bags-carry-bags-.webp" alt="Packaging & Mailer Films/Bags" width="80" height="80" style="width: 80px; height: 80px; object-fit: contain; margin: 0 auto 15px; display: block;" />
