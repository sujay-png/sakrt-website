</Layout>

<style>
  /* Common Utilities */
  .text-center { text-align: center; }
  .text-green { color: var(--color-primary-dark); }
  .bg-light { background-color: var(--color-bg-page); }
  .section-padding { padding: 60px 0; }
  .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
  .mb-5 { margin-bottom: 3rem; }
  .mt-4 { margin-top: 2rem; }

  /* Hero Section */
  .location-hero {
    position: relative;
    background-size: cover;
    background-position: center;
    padding: 220px 0 160px;
    color: white;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
  }
  .hero-content {
    position: relative;
    z-index: 1;
  }
  .hero-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 15px;
    font-family: var(--font-serif);
  }
  .hero-subtitle {
    font-size: 1.2rem;
    font-weight: 500;
  }

  /* Typography */
  .green-title {
    color: var(--color-primary-dark);
    font-size: 1.6rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }
  .welcome-title {
    font-size: 2rem;
    font-family: var(--font-serif);
    line-height: 1.4;
    margin-bottom: 1.5rem;
  }
  .welcome-text {
    max-width: 900px;
    margin: 0 auto;
    color: var(--color-text-body);
    line-height: 1.8;
  }

  /* 2 Column Info Grid */
  .info-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  @media (min-width: 768px) {
    .info-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .info-card p {
    color: var(--color-text-body);
    line-height: 1.8;
    margin-bottom: 15px;
  }
  .custom-check-list {
    list-style: none;
    padding: 0;
    margin: 15px 0;
  }
  .custom-check-list li {
    position: relative;
    padding-left: 25px;
    margin-bottom: 10px;
    color: var(--color-text-body);
  }
  .custom-check-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-accent-lime-bright);
    font-weight: bold;
  }

  /* Service Areas */
  .service-areas .sub-heading {
    font-weight: 600;
    color: var(--color-primary-dark);
    margin-bottom: 10px;
  }
  .service-areas .areas-text {
    color: var(--color-text-muted);
    font-weight: 500;
    margin-bottom: 5px;
  }
  .tagline {
    font-style: italic;
    color: var(--color-text-muted);
    margin-top: 20px;
  }

  /* Contact Banner */
  .contact-banner {
    padding: 0 20px;
  }
  .contact-box {
    background-color: var(--color-primary-dark);
    color: white;
    padding: 50px 30px;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(13, 61, 38, 0.15);
  }
  .contact-box h2 {
    font-size: 2rem;
    margin-bottom: 15px;
  }
  .contact-box p {
    font-size: 1.1rem;
    max-width: 800px;
    margin: 0 auto;
    opacity: 0.9;
  }
  .btn-primary {
    display: inline-block;
    background-color: var(--color-accent-lime-bright);
    color: var(--color-primary-dark);
    padding: 12px 30px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 700;
    transition: all 0.3s;
  }
  .btn-primary:hover {
    background-color: white;
    transform: translateY(-2px);
  }

  /* Portfolio Section */
  .portfolio-heading {
    display: inline-block;
    border-bottom: 2px solid var(--color-accent-lime-bright);
    padding-bottom: 5px;
  }
  .portfolio-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
  }
  @media (min-width: 768px) {
    .portfolio-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .portfolio-card {
    background: var(--color-bg-card);
    padding: 30px 20px;
    border-radius: 12px;
    text-align: center;
    border: 1px solid #e2e8e4;
    transition: transform 0.3s;
  }
  .portfolio-card:hover {
    transform: translateY(-5px);
  }
  .portfolio-icon {
    width: 60px;
    height: 60px;
    object-fit: contain;
    margin-bottom: 15px;
  }
  .portfolio-title {
    color: var(--color-primary-dark);
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 15px;
  }
  .portfolio-card p {
    color: var(--color-text-body);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Products Offer Section */
  .lowercase-heading {
    border-bottom: 2px solid var(--color-primary-dark);
    display: inline-block;
    padding-bottom: 5px;
    margin-bottom: 40px;
  }
</style>
