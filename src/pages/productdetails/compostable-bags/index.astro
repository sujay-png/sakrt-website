---
import Layout from '../../../layouts/Layout.astro';
import CategoryGrid from '../../../components/Shared/CategoryGrid.astro';
import ModernFAQ from '../../../components/Shared/ModernFAQ.astro';
import CallToAction from '../../../components/Home/CallToAction.astro';

const bagProducts = [
  { name: "Compostable Bag", slug: "compostable-bag", category: "compostable-bags", image: "/compostable-bags/imgi_4_biodegradable-bags-compostable-products-ecofriendly-bags-1-1.webp" },
  { name: "Compostable Pet Poop Bags", slug: "compostable-pet-poop-bags", category: "compostable-bags", image: "/compostable-bags/imgi_5_compostable-table-wares-Biodegradable-bag-biodegradable-bag-carry-bags-2.webp" },
  { name: "Compostable Custom Made Bag", slug: "compostable-custom-made-bag", category: "compostable-bags", image: "/compostable-bags/imgi_6_biodegradable-bags-compostable-products-eco-product.-3.webp" },
  { name: "Compostable Nursery Bags", slug: "compostable-nursery-bags", category: "compostable-bags", image: "/compostable-bags/imgi_7_Compostable-grow-bags-e1780576071172.webp" },
  { name: "Compostable Medical Waste Bags", slug: "compostable-medical-waste-bags", category: "compostable-bags", image: "/compostable-bags/imgi_8_biodegradable-bags-compostable-products-ecofriendly-bags-1-3.webp" },
  { name: "Compostable Garment Bags", slug: "compostable-garment-bags", category: "compostable-bags", image: "/compostable-bags/imgi_9_biodegradable-bags-compostable-products-ecofriendly-bags-2-1.webp" },
  { name: "Bio Compostable Garbage Bags", slug: "bio-compostable-garbage-bags", category: "compostable-bags", image: "/compostable-bags/imgi_10_biodegradable-bags-compostable-products-ecofriendly-bags-1-2.webp" },
  { name: "Compostable Mailer Bags", slug: "compostable-mailer-bags", category: "compostable-bags", image: "/compostable-bags/imgi_11_courier-bags.webp" },
  { name: "Compostable Grocery Bag", slug: "compostable-grocery-bag", category: "compostable-bags", image: "/compostable-bags/imgi_12_biodegradable-bags-compostable-products-eco-products-3.webp" }
];

const faqs = [
  { question: "What are compostable bags", answer: "Compostable bags are eco-friendly alternatives to traditional plastic bags, made from plant-based materials like corn starch that break down fully into organic compost." },
  { question: "Are compostable bags really better?", answer: "Yes! Unlike traditional plastics that take hundreds of years to break down and leave microplastics, our bags fully compost within 90-180 days and enrich the soil." },
  { question: "What material is 100% biodegradable?", answer: "Materials like PLA (Polylactic Acid) derived from corn starch or sugarcane bagasse are 100% biodegradable under the right industrial or home composting conditions." },
  { question: "How do I know if my bag is compostable?", lookFor: "Look for official certification logos such as CPCB or ISO 17088 printed on the bag, which guarantee that the product has passed strict compostability standards.", answer: "Look for official certification logos such as CPCB or ISO 17088 printed on the bag, which guarantee that the product has passed strict compostability standards." },
  { question: "Is compostable plastic free?", answer: "Yes, true compostable bags are 100% plastic-free. They do not contain any petroleum-based plastics that harm the environment." }
];
---

<Layout title="Compostable Bags | SAKRT">
  <main class="category-page">
    <div class="category-header">
      <h1 class="category-title">Compostable Bags</h1>
    </div>

    <CategoryGrid products={bagProducts} />
    
    <ModernFAQ title="FAQs on compostable Bags" faqs={faqs} />

    <CallToAction />
  </main>
</Layout>

<style>
  .category-page {
    background-color: #f3f4f1;
    min-height: 100vh;
  }

  .category-header {
    background: linear-gradient(180deg, #e6e9e4 0%, #f3f4f1 100%);
    padding: 10rem 1.5rem 4rem;
    text-align: center;
  }

  .category-title {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 2.98rem);
    font-weight: 400;
    color: #0d3d26;
    margin: 0;
  }
</style>