---
import Layout from '../../../layouts/Layout.astro';
import CategoryGrid from '../../../components/Shared/CategoryGrid.astro';
import ModernFAQ from '../../../components/Shared/ModernFAQ.astro';
import CallToAction from '../../../components/Home/CallToAction.astro';

const tablewareProducts = [
  { name: "Compostable Food Plates", slug: "compostable-food-plates", category: "designer-tableware", image: "/tableware/imgi_4_biodegradable-bags-compostable-products-eco-product-1-2.webp" },
  { name: "Compostable Round Cup", slug: "compostable-round-cup", category: "designer-tableware", image: "/tableware/imgi_5_biodegradable-bags-compostable-products-eco-products.webp" },
  { name: "Compostable Bowl", slug: "compostable-bowl", category: "designer-tableware", image: "/tableware/imgi_6_biodegradable-bags-compostable-products-eco-product.webp" },
  { name: "Compostable Square Plate", slug: "compostable-square-plate", category: "designer-tableware", image: "/tableware/imgi_7_biodegradable-bags-compostable-products-eco-product.-1.webp" },
  { name: "Compostable Drinking Straws", slug: "compostable-drinking-straws", category: "designer-tableware", image: "/tableware/imgi_8_tRgDJ.jpg" },
  { name: "Compostable Clam Shell", slug: "compostable-clam-shell", category: "designer-tableware", image: "/tableware/imgi_9_biodegradable-bags-compostable-products-eco-product-2-1.webp" },
  { name: "Compostable Cutleries", slug: "compostable-cutleries", category: "designer-tableware", image: "/tableware/imgi_10_biodegradable-bags-compostable-products-eco-product.-2.webp" },
  { name: "Compostable Packaging", slug: "compostable-packaging", category: "designer-tableware", image: "/tableware/imgi_11_biodegradable-bags-compostable-products-ecofriendly-bags-2.webp" },
  { name: "Compostable Dona Bowl", slug: "compostable-dona-bowl", category: "designer-tableware", image: "/tableware/imgi_12_biodegradable-bags-compostable-products-eco-product-1.webp" },
  { name: "Compostable Compartment Plate", slug: "compostable-compartment-plate", category: "designer-tableware", image: "/tableware/imgi_13_biodegradable-bags-compostable-products-eco-products-1.webp" }
];

const faqs = [
  { question: "What are Biodegradable tableware?", answer: "Biodegradable tableware refers to plates, cups, and utensils made from natural plant-based materials like sugarcane bagasse that can break down naturally in the environment." },
  { question: "What are the difference between biodegradable and compostable plates?", answer: "While all compostable plates are biodegradable, not all biodegradable plates are compostable. Compostable plates break down into nutrient-rich compost in a specific timeframe under specific conditions." },
  { question: "What is eco-friendly tableware?", answer: "Eco-friendly tableware is designed to have a minimal impact on the environment, typically made from renewable resources and designed to be easily composted or recycled." },
  { question: "What are compostable plates made of?", answer: "Our compostable plates are primarily made from sugarcane bagasse, a natural fibrous byproduct of sugarcane processing that would otherwise go to waste." },
  { question: "Why should businesses switch to compostable packaging?", answer: "Switching to compostable packaging significantly reduces plastic waste, lowers carbon footprints, and appeals to increasingly environmentally conscious consumers." }
];
---

<Layout title="Table Ware | SAKRT">
  <main class="category-page">
    <div class="category-header">
      <h1 class="category-title">Table Ware</h1>
    </div>

    <CategoryGrid products={tablewareProducts} />
    
    <ModernFAQ title="FAQs on compostable tableware products" faqs={faqs} />

    <CallToAction />
  </main>
</Layout>

<style>
  .category-page {
    background-color: #f3f4f1;
    min-height: 100vh;
  }

  .category-header {
    background: linear-gradient(180deg, #e6e9e4 0%, #f3f4f1 100%);
    padding: 10rem 1.5rem 4rem;
    text-align: center;
  }

  .category-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    color: #0d3d26;
    margin: 0;
  }
</style>
