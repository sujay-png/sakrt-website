---
import BaseLayout from '../../../layouts/Layout.astro';
import { wpquery } from '../../../lib/wordpress.ts';

export const prerender = true;

export async function getStaticPaths() {
  const data = await wpquery({
    query: `
      query GetBlogs {
        posts(first: 100) {
          nodes {
            id
            title
            slug
            date
            excerpt
            featuredImage {
              node {
                sourceUrl
                altText
              }
            }
            categories {
              nodes {
                name
              }
            }
          }
        }
      }
    `,
  });

  const allPosts = data.posts.nodes;
  
  const allCategories = new Set<string>();
  allPosts.forEach((post: any) => {
    if (post.categories && post.categories.nodes) {
      post.categories.nodes.forEach((cat: any) => {
        allCategories.add(cat.name);
      });
    }
  });

  const slugify = (text: string) => 
    text.toString().toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]+/g, '').replace(/--+/g, '-').replace(/^-+/, '').replace(/-+$/, '');

  return Array.from(allCategories).map(categoryName => {
    const categoryPosts = allPosts.filter((post: any) => {
      const postCategories = post.categories?.nodes.map((c: any) => c.name) || [];
      return postCategories.includes(categoryName);
    });

    return {
      params: { category: slugify(categoryName) },
      props: { 
        categoryName,
        posts: categoryPosts,
        allCategories: Array.from(allCategories)
      }
    };
  });
}

const { categoryName, posts, allCategories } = Astro.props;

const slugify = (text: string) => 
  text.toString().toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]+/g, '').replace(/--+/g, '-').replace(/^-+/, '').replace(/-+$/, '');

const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  const day = date.getDate().toString().padStart(2, '0');
  const month = date.toLocaleString('default', { month: 'short' }).toUpperCase();
  const year = date.getFullYear().toString().slice(-2);
  
  return { day, monthYear: `${month} '${year}` };
};
---

<BaseLayout 
  title={`${categoryName} Blog Articles | SAKRT Journals`}
  description={`Read SAKRT's latest journals and articles on ${categoryName}. Explore how biodegradable products can transform your lifestyle.`}
>
  <main class="blog-container">
    
    <!-- Top Level Header -->
    <header class="blog-main-header">
      <h1 class="main-title">Blog Articles</h1>
      <p class="main-desc">
        Explore how biodegradable product blogs can transform your lifestyle, support zero-waste initiatives, and contribute to a healthier planet. Make the switch today and be a part of the movement towards sustainability.
      </p>
    </header>

    <div class="filters">
      <a href="/blog" class="filter-btn">All</a>
      {allCategories.map((cat: any) => (
        <a href={`/blog/category/${slugify(cat)}`} class={`filter-btn ${cat === categoryName ? 'active' : ''}`}>{cat}</a>
      ))}
    </div>

    <section class="post-list">
      {posts.map((post: any) => {
        const { day, monthYear } = formatDate(post.date);
        const mainCategory = post.categories?.nodes?.[0]?.name || "general";
        const categorySlug = slugify(mainCategory);
        const postUrl = `/blog/category/${categorySlug}/${post.slug}`;
        
        return (
          <article class="post-card" data-categories={post.categories?.nodes.map((c:any) => c.name).join(',') || ''}>
            
            <div class="post-image-wrapper">
              {post.featuredImage?.node ? (
                <a href={postUrl}>
                  <img 
                    src={post.featuredImage.node.sourceUrl} 
                    alt={post.featuredImage.node.altText || post.title} 
                    class="post-thumbnail"
                    loading="lazy"
                  />
                </a>
              ) : (
                <a href={postUrl} class="placeholder-image">
                  <svg viewBox="0 0 24 24" width="32" height="32" stroke="currentColor" stroke-width="1" fill="none">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <polyline points="21 15 16 10 5 21"></polyline>
                  </svg>
                </a>
              )}
            </div>
            
            <div class="post-content">
              <a href={postUrl} class="post-link">
                <h3 class="post-title" set:html={post.title}></h3>
              </a>
              
              <div class="post-excerpt" set:html={post.excerpt.replace(/\[&hellip;\]|\[\.\.\.\]|\.\.\./g, `...`)}></div>
              
              <a href={postUrl} class="read-more-link">Read More</a>
            </div>
            
          </article>
        );
      })}
    </section>

  </main>
</BaseLayout>

<style>
  .blog-container {
    max-width: var(--maxw, 1320px);
    margin: 0 auto;
    padding: clamp(120px, 15vh, 160px) var(--gutter) var(--section-y);
  }

  /* Main Header */
  .blog-main-header {
    margin-bottom: var(--s-10);
    text-align: center;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .main-title {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    font-weight: 400;
    color: var(--ink);
    margin: 0 0 var(--s-4) 0;
  }

  .main-desc {
    font-family: var(--font-sans);
    font-size: var(--fs-lede);
    color: var(--ink-soft);
    margin: 0;
    line-height: 1.6;
  }

  /* Filters */
  .filters {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: var(--s-12);
  }

  .filters a {
    background: var(--brand);
    color: var(--on-dark);
    border: 1px solid transparent;
    padding: 14px 28px;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    transition: all var(--dur-2) var(--ease-out);
  }

  .filters a:hover {
    background: var(--lime);
    color: var(--ink);
  }

  .filters a.active {
    background: #e2e4dc; /* Muted pulp */
    color: var(--ink);
    border-color: var(--hairline-strong);
  }

  /* Grid Layout */
  .post-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s-6);
  }

  /* Card Styling */
  .post-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--hairline);
    transition: transform var(--dur-2) var(--ease-settle),
                box-shadow var(--dur-2) var(--ease-settle),
                border-color var(--dur-2) var(--ease-settle);
  }
  
  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-2);
    border-color: var(--hairline-strong);
  }

  .post-image-wrapper {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--pulp-deep);
    border-bottom: 1px solid var(--hairline);
  }

  .post-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-settle);
  }

  .post-card:hover .post-thumbnail {
    transform: scale(1.05);
  }

  .placeholder-image {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--ink-muted);
  }

  .post-content {
    padding: var(--s-5);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .post-link {
    text-decoration: none;
    margin-bottom: var(--s-3);
  }

  .post-title {
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--ink);
    line-height: 1.4;
    margin: 0;
    transition: color var(--dur-1) var(--ease-out);
  }

  .post-card:hover .post-title {
    color: var(--brand);
  }

  .post-excerpt :global(p) {
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0 0 var(--s-4) 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-line-break: auto;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .read-more-link {
    margin-top: auto;
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--brand);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color var(--dur-1) var(--ease-out);
  }

  .read-more-link:hover {
    color: var(--lime-ink, #4a6b0c);
  }

  /* Responsive Adjustments */
  @media (max-width: 1200px) {
    .post-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  @media (max-width: 900px) {
    .post-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .post-list {
      grid-template-columns: 1fr;
    }
    .filters {
      flex-direction: column;
      align-items: stretch;
    }
    .filters a {
      text-align: center;
    }
  }
</style>
