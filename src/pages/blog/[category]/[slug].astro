---
import BaseLayout from '../../../layouts/Layout.astro';
import { wpquery, getBlogUrl, slugifyCategory } from '../../../lib/wordpress';
import CallToAction from '../../../components/Home/CallToAction.astro';

export const prerender = true;

// Build dynamic article pages at /blog/[category]/[slug]
export async function getStaticPaths() {
  const data = await wpquery({
    query: `
      query GetAllSlugs {
        posts(first: 100) {
          nodes {
            slug
            title
            content
            excerpt
            date
            featuredImage {
              node {
                sourceUrl
                altText
              }
            }
            categories {
              nodes {
                name
              }
            }
          }
        }
      }
    `,
  });

  const posts = data?.posts?.nodes || [];
  const slugify = (text: string) =>
    text.toString().toLowerCase().trim().replace(/\s+/g, '-').replace(/[^\w-]+/g, '').replace(/--+/g, '-').replace(/^-+/, '').replace(/-+$/, '');

  const paths: any[] = [];
  const seen = new Set<string>();

  posts.forEach((post: any) => {
    const catNodes = post.categories?.nodes;
    const catNames = catNodes && catNodes.length > 0 
      ? catNodes.map((c: any) => c.name) 
      : ['general'];

    catNames.forEach((catName: string) => {
      const categorySlug = slugify(catName);
      const key = `${categorySlug}/${post.slug}`;
      if (!seen.has(key)) {
        seen.add(key);
        paths.push({
          params: { category: categorySlug, slug: post.slug },
          props: { post, recentPosts: posts.slice(0, 5) },
        });
      }
    });
  });

  return paths;
}

interface Props {
  post: any;
  recentPosts: any[];
}

const { post, recentPosts = [] } = Astro.props as Props;
const { category, slug } = Astro.params as { category: string; slug: string };

const slugify = (text: string) =>
  text.toString().toLowerCase().trim().replace(/\s+/g, '-').replace(/[^\w-]+/g, '').replace(/--+/g, '-').replace(/^-+/, '').replace(/-+$/, '');

const mainCatName = post?.categories?.nodes?.[0]?.name || 'general';
const mainCategorySlug = slugify(mainCatName);

const date = post ? new Date(post.date) : null;
const formattedDate = date ? date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '';
const cleanExcerpt = post?.excerpt ? post.excerpt.replace(/<[^>]*>?/gm, '').substring(0, 155) + '...' : '';

let processedContent = post?.content || '';
processedContent = processedContent.replace(/<h[1-6][^>]*>Choose SAKRT.*?<\/h[1-6]>[\s\S]*?(?=<div class="wp-block-yoast-faq-block"|<div class="schema-faq"|<div class="schema-faq-section"|<details|$)/i, '');

if (processedContent.includes('schema-faq-section') && !processedContent.includes('wp-block-yoast-faq-block')) {
  const firstFaqIndex = processedContent.indexOf('<div class="schema-faq-section"');
  if (firstFaqIndex !== -1) {
    processedContent = processedContent.slice(0, firstFaqIndex) + '<div class="custom-faq-container">' + processedContent.slice(firstFaqIndex) + '</div>';
  }
}

// Rewrite internal WordPress links to point to Astro frontend routes
processedContent = processedContent.replace(/href="([^"]+)"/gi, (match: string, url: string) => {
  // If it's an external link not containing sakrt.in, leave it alone
  if (url.startsWith('http') && !url.includes('sakrt.in')) return match;
  
  // Ignore anchors, mailto, tel, and media files
  if (url.startsWith('#') || url.startsWith('mailto:') || url.startsWith('tel:')) return match;
  if (url.includes('wp-content') || url.match(/\.(jpg|jpeg|png|webp|pdf|zip)$/i)) return match;
  
  // Parse path
  let path = url;
  if (url.startsWith('http')) {
    try { path = new URL(url).pathname; } catch(e) { return match; }
  } else {
    path = path.split('?')[0].split('#')[0]; // strip query strings/hashes from relative paths
  }
  
  const segments = path.split('/').filter(Boolean);
  if (segments.length === 0) return match;
  const linkSlug = segments[segments.length - 1];
  
  const mainPages = ['about', 'contact', 'shop', 'products', 'faq', 'home'];
  if (mainPages.includes(linkSlug)) return `href="/${linkSlug}"`;
  if (path.includes('category/')) return `href="/blog/${encodeURIComponent(linkSlug)}/"`;
  
  // By default, point to /blog/[slug] which redirects to the category URL
  return `href="/blog/${linkSlug}"`;
});
---

<BaseLayout
  title={`${post.title} | Sakrt`}
  description={cleanExcerpt}
  image={post.featuredImage?.node?.sourceUrl}
  ogType="article"
>
  <main class="single-post-container">
    <div class="blog-grid">
      <div class="blog-content-area">
        <article>
          <header class="post-header">
            <div class="post-meta">
              {post.categories?.nodes?.map((cat: any) => (
                <span class="category-badge">{cat.name}</span>
              ))}
              <span class="date">{formattedDate}</span>
            </div>
            
            <h1 class="post-title">{post.title}</h1>
          </header>

          <!-- Render the WordPress HTML content safely with closing tag -->
          <div class="post-content wp-content" set:html={processedContent}></div>
        </article>
      </div>

      <aside class="blog-sidebar">
        <h3 class="sidebar-title">Read Next</h3>
        <div class="recent-posts-list">
          {recentPosts.filter((p: any) => p.slug !== post.slug).slice(0, 4).map((rp: any) => {
            const rpCat = rp.categories?.nodes?.[0]?.name || "general";
            const rpDate = new Date(rp.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
            
            return (
              <a href={getBlogUrl(rp)} class="recent-post-card">
                {rp.featuredImage?.node?.sourceUrl && (
                  <div class="rp-img-wrapper">
                    <img src={rp.featuredImage.node.sourceUrl} alt={rp.title} />
                  </div>
                )}
                <div class="rp-info">
                  <span class="rp-meta">{rpCat} &bull; {rpDate}</span>
                  <h4 class="rp-title">{rp.title}</h4>
                  <span class="rp-read-more">Read More &rarr;</span>
                </div>
              </a>
            )
          })}
        </div>
      </aside>
    </div>
  </main>
  <CallToAction />
  <div class="back-link">
    <a href={`/blog/${mainCategorySlug}/`}>← Back to {mainCatName}</a>
  </div>
</BaseLayout>

<style>
  .single-post-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 10rem 2rem 4rem; /* Padding for fixed header */
    font-family: 'Helvetica Neue', Arial, sans-serif;
  }

  .back-link {
    text-align: center;
    padding-bottom: 4rem;
  }

  .back-link a {
    color: #1b3d2f;
    text-decoration: none;
    font-weight: bold;
    transition: color 0.2s ease;
  }

  .back-link a:hover {
    color: #a3d200;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 992px) {
    .blog-grid {
      grid-template-columns: 7fr 3fr;
      gap: 4rem;
    }
  }

  /* Sidebar Styles */
  .blog-sidebar {
    position: sticky;
    top: 130px; /* Offset for fixed header */
    align-self: start;
  }
  
  .sidebar-title {
    font-size: 1.5rem;
    color: #111;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid #a3d200;
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .recent-posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .recent-post-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease;
  }

  .recent-post-card:hover {
    transform: translateY(-2px);
  }

  .recent-post-card:hover .rp-title {
    color: #a3d200;
  }

  .rp-img-wrapper {
    width: 100%;
    height: 180px;
    border-radius: 8px;
    overflow: hidden;
  }

  .rp-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  
  .recent-post-card:hover .rp-img-wrapper img {
    transform: scale(1.05);
  }

  .rp-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .rp-meta {
    font-size: 0.75rem;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .rp-title {
    font-size: 1.1rem;
    color: #1b3d2f;
    line-height: 1.4;
    margin: 0;
    transition: color 0.2s ease;
  }

  .rp-read-more {
    font-size: 0.875rem;
    color: #1b3d2f;
    font-weight: bold;
    margin-top: 0.25rem;
  }

  .post-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .post-meta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .category-badge {
    display: inline-block;
    border: 1px solid #e0e0e0;
    border-radius: 20px;
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .date {
    color: #666;
    font-size: 0.875rem;
  }

  .post-title {
    font-size: clamp(1.75rem, 5vw, 2.75rem); /* Responsive font size */
    line-height: 1.2;
    color: #111;
  }

  .back-link {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid #eee;
    text-align: center;
  }

  .back-link a {
    color: #1b3d2f;
    text-decoration: none;
    font-weight: bold;
    transition: color 0.2s ease;
  }

  .back-link a:hover {
    color: #a3d200;
  }
</style>

<!-- Use is:global to allow these styles to penetrate the injected WordPress HTML -->
<style is:global>
  .wp-content {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #333;
  }

  .wp-content a {
    color: #a3d200;
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 500;
  }

  .wp-content a:hover {
    color: #8bb300;
  }

  .wp-content h2, 
  .wp-content h3 {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: #1b3d2f;
  }

  .wp-content p {
    margin-bottom: 1.5rem;
  }

  .wp-content img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 2rem 0;
  }

  /* Add margin to any text that appears after the FAQ blocks */
  .wp-content .schema-faq-section ~ p,
  .wp-content details ~ p {
    margin-top: 2rem;
    color: #555;
  }

  /* Add space below the final accordion item so trailing text doesn't hug the border */
  .wp-content .schema-faq-section:last-of-type,
  .wp-content details:last-of-type {
    margin-bottom: 2rem !important;
  }

  /* ==============================================
     FAQ / ACCORDION STYLES (NATIVE & PLUGIN BLOCKS)
     ============================================== */

  /* Main FAQ container background */
  .wp-content .wp-block-yoast-faq-block,
  .wp-content .schema-faq,
  .wp-content .custom-faq-container {
    background-color: #f7faf3; /* Light mint green */
    padding: 1.5rem 1.25rem; /* Tighter padding for mobile */
    border-radius: 12px;
    margin: 2rem 0;
  }
  
  @media (min-width: 768px) {
    .wp-content .wp-block-yoast-faq-block,
    .wp-content .schema-faq,
    .wp-content .custom-faq-container {
      padding: 2.5rem 2rem;
    }
  }

  /* 1. Target either Yoast divs OR Native HTML details/summary elements */
  .wp-content .schema-faq-section,
  .wp-content details {
    border-bottom: 1px solid #d4e3cb !important;
    padding: 1.25rem 0 !important;
    margin: 0 !important;
    transition: background-color 0.2s ease;
  }

  .wp-content .schema-faq-section:last-child,
  .wp-content details:last-of-type {
    border-bottom: none !important;
  }

  /* 2. Questions / Triggers */
  .wp-content .schema-faq-question,
  .wp-content summary {
    font-size: 1.15rem !important;
    font-weight: 700 !important;
    color: #1b3d2f !important;
    cursor: pointer !important;
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    margin: 0 !important;
    list-style: none !important; /* Hide native browser marker */
    user-select: none;
  }

  /* Hide native summary marker on WebKit browsers */
  .wp-content summary::-webkit-details-marker {
    display: none !important;
  }

  /* Add custom plus icon */
  .wp-content .schema-faq-question::after,
  .wp-content summary::after {
    content: '+' !important;
    font-size: 1.6rem !important;
    font-weight: 300 !important;
    color: #49695b !important;
    line-height: 1 !important;
    margin-left: 1rem !important;
    flex-shrink: 0 !important;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Rotate icon to an 'x' or '-' when open */
  .wp-content .schema-faq-question.is-open::after,
  .wp-content details[open] summary::after {
    transform: rotate(45deg) !important;
    color: #a3d200 !important;
  }

  /* 3. Answers / Panels */
  .wp-content .schema-faq-answer {
    display: none; /* Collapsed by default for div blocks */
    color: #4a5568 !important;
    font-size: 1.05rem !important;
    line-height: 1.7 !important;
    margin-top: 0.75rem !important;
    padding-right: 2rem !important;
  }

  .wp-content .schema-faq-answer.is-open {
    display: block !important;
    animation: faqFadeIn 0.3s ease-out;
  }

  .wp-content details p {
    color: #4a5568 !important;
    font-size: 1.05rem !important;
    line-height: 1.7 !important;
    margin-top: 0.75rem !important;
    margin-bottom: 0 !important;
    padding-right: 2rem !important;
    animation: faqFadeIn 0.3s ease-out;
  }

  @keyframes faqFadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Bullet/Numbered Lists inside WordPress Content */
  .wp-content ul, 
  .wp-content ol {
    margin: 1.5rem 0 2rem 1.5rem !important;
    padding: 0 !important;
  }

  .wp-content ul {
    list-style-type: disc !important;
  }

  .wp-content ol {
    list-style-type: decimal !important;
  }

  .wp-content li {
    margin-bottom: 0.75rem !important;
    line-height: 1.7 !important;
    color: #333 !important;
    padding-left: 0.5rem !important;
  }

  .wp-content li::marker {
    color: #1b3d2f !important;
    font-weight: bold !important;
  }

  /* Tables inside WordPress Content */
  .wp-content table {
    width: 100% !important;
    border-collapse: collapse !important;
    margin: 2.5rem 0 !important;
    font-size: 1rem !important;
    line-height: 1.5 !important;
    text-align: left !important;
    overflow-x: auto !important;
    display: block !important; /* Enables horizontal scroll on tiny screens */
  }

  @media (min-width: 768px) {
    .wp-content table {
      display: table !important; /* Reverts to table layout on larger screens */
    }
  }

  .wp-content table thead tr {
    background-color: #1b3d2f !important;
    color: #ffffff !important;
  }

  .wp-content table th {
    padding: 1rem 1.25rem !important;
    font-weight: 600 !important;
    letter-spacing: 0.03em !important;
    border: 1px solid #1b3d2f !important;
    white-space: nowrap !important;
  }

  .wp-content table tbody tr {
    border-bottom: 1px solid #e2e8f0 !important;
    transition: background-color 0.2s ease !important;
  }

  .wp-content table tbody tr:nth-of-type(even) {
    background-color: #f7faf3 !important; /* Subtle tint matching site brand */
  }

  .wp-content table tbody tr:hover {
    background-color: #edf5e6 !important;
  }

  .wp-content table td {
    padding: 1rem 1.25rem !important;
    border: 1px solid #e2e8f0 !important;
    color: #4a5568 !important;
  }

  .wp-content table td:first-child {
    font-weight: 600 !important;
    color: #1b3d2f !important;
  }
</style>

<!-- Add this script to make third-party div blocks interactive -->
<script>
  function initAccordions() {
    // Find all third-party FAQ questions
    const questions = document.querySelectorAll('.schema-faq-question');
    
    questions.forEach(question => {
      // Remove old listeners to prevent duplication on route changes
      const newQuestion = question.cloneNode(true) as Element;
      if (question.parentNode) {
        question.parentNode.replaceChild(newQuestion, question);
      }
      
      // Add the click toggle
      (newQuestion as Element).addEventListener('click', () => {
        const isCurrentlyOpen = newQuestion.classList.contains('is-open');

        // First, close ALL questions and answers
        document.querySelectorAll('.schema-faq-question.is-open').forEach(q => {
          q.classList.remove('is-open');
        });
        document.querySelectorAll('.schema-faq-answer.is-open').forEach(a => {
          a.classList.remove('is-open');
        });

        // If it wasn't open before we clicked, open it now
        if (!isCurrentlyOpen) {
          newQuestion.classList.add('is-open');
          const answer = newQuestion.nextElementSibling;
          if (answer && answer.classList.contains('schema-faq-answer')) {
            answer.classList.add('is-open');
          }
        }
      });
    });

    // Also add mutually exclusive toggle logic to any native <details> elements if present
    const detailElements = document.querySelectorAll<HTMLDetailsElement>('.wp-content details');
    detailElements.forEach(details => {
      details.addEventListener('toggle', () => {
        if (details.open) {
          detailElements.forEach(other => {
            if (other !== details && other.open) {
              other.open = false;
            }
          });
        }
      });
    });
  }

  // Run on initial load
  initAccordions();
  
  // Run on Astro View Transition navigation
  document.addEventListener('astro:page-load', initAccordions);
</script>
