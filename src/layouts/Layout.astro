---
// src/layouts/Layout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  ogType?: string;
  schema?: any;
}

const { 
  title = "SAKRT | Govt Approved & Certified Compostable Products Manufacturer",
  description = "SAKRT is a leading manufacturer of certified compostable packaging, bags, and tableware in India. Eco-friendly, sustainable alternatives to plastic.",
  image = "/logo/footer-logo.webp",
  canonical,
  ogType = "website",
  schema
} = Astro.props;

const canonicalURL = canonical ? new URL(canonical, Astro.site || Astro.url) : new URL(Astro.url.pathname, Astro.site || Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site || Astro.url).href} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site || Astro.url).href} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL.href} />

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- Global Header rendered at the top of every page -->
    <Header />

    <!-- Page-specific content gets rendered here -->
    <div class="layout-main">
      <slot />
    </div>

    <!-- Global Footer rendered at the bottom of every page -->
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    /* Brand Green Color Palette */
    --color-primary-dark: #0d3d26;       /* Deep Forest Green (Main Brand, Headings, Dark Buttons) */
    --color-forest-medium: #0d3d26;      /* Medium Forest Green (Hover States, Dark Cards) */
    --color-forest-dark: #0d3d26;        /* Extra Dark Forest Green (Dark Section Backgrounds) */
    
    /* Lime Green Accent Palette */
    --color-accent-lime: #8ce02c;        /* Bright Lime Green (Sub-labels, Badges, Highlights) */
    --color-accent-lime-bright: #CFF737; /* Vibrant Lime Green (Active Underlines, Callouts) */
    
    /* Typography Text Colors */
    --color-text-main: #112a21;          /* Dark Greenish Black (Primary Headings) */
    --color-text-body: #2c3e35;          /* Dark Muted Green (Body Copy) */
    --color-text-muted: #4a5d52;         /* Medium Muted Green (Descriptions & Subtitles) */
    --color-text-light: #ffffff;         /* White (Contrast Text) */

    /* Page & Surface Backgrounds */
    --color-bg-page: #f8f9f6;            /* Light Warm Off-White Page Background */
    --color-bg-card: #ffffff;            /* Pure White Card Surface */
    --color-bg-pill: #f2f3f0;            /* Pill Filter Bar Container Background */
    --color-border-subtle: #e2e4de;      /* Subtle Light Border Color */

    /* Typography Font Families */
    --font-serif: 'Cormorant Garamond', 'Playfair Display', 'Georgia', serif;
    --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    --font-mono: 'Space Mono', monospace;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html, body {
    width: 100%;
    min-height: 100vh;
    background-color: var(--color-bg-page);
    color: var(--color-text-body);
    font-family: var(--font-sans);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }
  
  body {
    display: flex;
    flex-direction: column;
  }

  .layout-main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* Lenis Scroll CSS */
  html.lenis, html.lenis body {
    height: auto;
  }

  .lenis.lenis-smooth {
    scroll-behavior: auto !important;
  }

  .lenis.lenis-smooth [data-lenis-prevent] {
    overscroll-behavior: contain;
  }

  .lenis.lenis-stopped {
    overflow: hidden;
  }

  .lenis.lenis-smooth iframe {
    pointer-events: none;
  }
</style>

<script>
  import Lenis from 'lenis';

  let lenis: Lenis | null = null;
  let rafId: number;

  const initLenis = () => {
    if (lenis) {
      lenis.destroy();
      cancelAnimationFrame(rafId);
    }

    lenis = new Lenis({
      duration: 1.2,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      orientation: 'vertical',
      gestureOrientation: 'vertical',
      smoothWheel: true,
      wheelMultiplier: 1,
      touchMultiplier: 2,
    });

    function raf(time: number) {
      if (lenis) {
        lenis.raf(time);
      }
      rafId = requestAnimationFrame(raf);
    }

    rafId = requestAnimationFrame(raf);
  };

  initLenis();

  document.addEventListener('astro:page-load', () => {
    initLenis();
  });
</script>