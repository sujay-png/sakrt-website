---
// src/layouts/Layout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  ogType?: string;
  schema?: any;
  hideHeader?: boolean;
}

const { 
  title = "SAKRT | Govt Approved & Certified Compostable Products Manufacturer",
  description = "SAKRT is a leading manufacturer of certified compostable packaging, bags, and tableware in India. Eco-friendly, sustainable alternatives to plastic.",
  image = "/logo/footer-logo.webp",
  canonical,
  ogType = "website",
  schema,
  hideHeader = false
} = Astro.props;

const canonicalURL = canonical ? new URL(canonical, Astro.site || Astro.url) : new URL(Astro.url.pathname, Astro.site || Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site || Astro.url).href} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site || Astro.url).href} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL.href} />

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- Global Header rendered at the top of every page -->
    {!hideHeader && <Header />}

    <!-- Page-specific content gets rendered here -->
    <div class="layout-main">
      <slot />
    </div>

    <!-- Global Footer rendered at the bottom of every page -->
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    /* --- Ink (dark greens, measured against --pulp) --- */
    --ink: #10281c;              /* 14.0:1  headings, primary text */
    --ink-soft: #3a4a41;         /*  8.4:1  body copy */
    --ink-muted: #5c6b62;        /*  5.0:1  captions, meta (AA at 16px) */
    --brand: #0d3d26;            /* 11.0:1  brand forest green */
    
    /* --- Surfaces: unbleached pulp, not cream, not cold grey --- */
    --pulp: #f2f3ed;             /* page */
    --pulp-deep: #e7e9e0;        /* alternating band */
    --surface: #ffffff;          /* card */
    --hairline: #d8dbd0;         /* 1px borders */
    --hairline-strong: #c3c8b9;
    
    /* --- Lime accent --- */
    --lime: #cff737;             /* fills, marks, rules — never small text */
    --lime-soft: #e8f9a8;        /* tints, hover washes */
    --lime-ink: #4a6b0c;         /* 5.5:1 — the only lime-ish TEXT on light */
    
    /* --- On-dark text --- */
    --on-dark: #f2f3ed;
    --on-dark-muted: #a9b8ac;

    /* --- Type --- */
    --font-display: 'Instrument Serif', 'Cormorant Garamond', Georgia, serif;
    --fs-hero: clamp(2.9rem, 8.4vw, 6.5rem);
    --fs-h1: clamp(2.25rem, 5vw, 3.75rem);
    --fs-h2: clamp(1.9rem, 3.6vw, 2.85rem);
    --fs-h3: clamp(1.3rem, 2.1vw, 1.6rem);
    --fs-h4: 1.0625rem;
    --fs-lede: clamp(1.0313rem, 1.25vw, 1.1563rem);
    --fs-body: 1rem;
    --fs-sm: 0.9375rem;
    --fs-xs: 0.8125rem;
    --fs-label: 0.7rem;          /* mono eyebrows */
    
    /* --- Spacing (4px base) --- */
    --s-1: 4px;  --s-2: 8px;  --s-3: 12px; --s-4: 16px; --s-5: 20px;
    --s-6: 24px; --s-8: 32px; --s-10: 40px; --s-12: 48px; --s-16: 64px;
    --s-20: 80px; --s-24: 96px;
    --section-y: clamp(72px, 9vw, 132px);
    --gutter: clamp(20px, 5vw, 56px);
    --maxw: 1240px;
    --maxw-narrow: 900px;
    
    /* --- Radii: four values, plus one organic mark --- */
    --r-xs: 4px; --r-sm: 8px; --r-md: 12px; --r-lg: 18px; --r-xl: 26px;
    --r-pill: 999px;
    --r-seed: 62% 38% 55% 45% / 52% 58% 42% 48%;

    /* --- Elevation: hairlines do the work, shadows only on lift --- */
    --shadow-1: 0 1px 2px rgba(16, 40, 28, 0.04);
    --shadow-2: 0 18px 40px -22px rgba(16, 40, 28, 0.28);
    --shadow-3: 0 30px 70px -30px rgba(16, 40, 28, 0.34);

    /* --- Motion --- */
    --ease-settle: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-out: cubic-bezier(0.33, 1, 0.68, 1);
    --dur-1: 0.2s; --dur-2: 0.45s; --dur-3: 0.8s;

    /* Brand Green Color Palette */
    --color-primary-dark: #0d3d26;       /* Deep Forest Green (Main Brand, Headings, Dark Buttons) */
    --color-forest-medium: #0d3d26;      /* Medium Forest Green (Hover States, Dark Cards) */
    --color-forest-dark: #0d3d26;        /* Extra Dark Forest Green (Dark Section Backgrounds) */
    
    /* Lime Green Accent Palette */
    --color-accent-lime: #8ce02c;        /* Bright Lime Green (Sub-labels, Badges, Highlights) */
    --color-accent-lime-bright: #CFF737; /* Vibrant Lime Green (Active Underlines, Callouts) */
    
    /* Typography Text Colors */
    --color-text-main: #112a21;          /* Dark Greenish Black (Primary Headings) */
    --color-text-body: #2c3e35;          /* Dark Muted Green (Body Copy) */
    --color-text-muted: #4a5d52;         /* Medium Muted Green (Descriptions & Subtitles) */
    --color-text-light: #ffffff;         /* White (Contrast Text) */

    /* Page & Surface Backgrounds */
    --color-bg-page: #f8f9f6;            /* Light Warm Off-White Page Background */
    --color-bg-card: #ffffff;            /* Pure White Card Surface */
    --color-bg-pill: #f2f3f0;            /* Pill Filter Bar Container Background */
    --color-border-subtle: #e2e4de;      /* Subtle Light Border Color */

    /* Typography Font Families */
    --font-serif: 'Cormorant Garamond', 'Playfair Display', 'Georgia', serif;
    --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    --font-mono: 'Space Mono', monospace;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html, body {
    width: 100%;
    min-height: 100vh;
    background-color: var(--color-bg-page);
    color: var(--color-text-body);
    font-family: var(--font-sans);
    overflow-x: clip;
    -webkit-font-smoothing: antialiased;
  }
  
  body {
    display: flex;
    flex-direction: column;
  }

  .layout-main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* Lenis Scroll CSS */
  html.lenis, html.lenis body {
    height: auto;
  }

  .lenis.lenis-smooth {
    scroll-behavior: auto !important;
  }

  .lenis.lenis-smooth [data-lenis-prevent] {
    overscroll-behavior: contain;
  }

  .lenis.lenis-stopped {
    overflow: hidden;
  }

  .lenis.lenis-smooth iframe {
    pointer-events: none;
  }
</style>

<script>
  import Lenis from 'lenis';

  let lenis: Lenis | null = null;
  let rafId: number;

  const initLenis = () => {
    if (lenis) {
      lenis.destroy();
      cancelAnimationFrame(rafId);
    }

    lenis = new Lenis({
      duration: 1.2,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      orientation: 'vertical',
      gestureOrientation: 'vertical',
      smoothWheel: true,
      wheelMultiplier: 1,
      touchMultiplier: 2,
    });

    function raf(time: number) {
      if (lenis) {
        lenis.raf(time);
      }
      rafId = requestAnimationFrame(raf);
    }

    rafId = requestAnimationFrame(raf);
  };

  initLenis();

  document.addEventListener('astro:page-load', () => {
    initLenis();
  });
</script>