---
// src/layouts/Layout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  ogType?: string;
  schema?: any;
}

const { 
  title = "SAKRT | Govt Approved & Certified Compostable Products Manufacturer",
  description = "SAKRT is a leading manufacturer of certified compostable packaging, bags, and tableware in India. Eco-friendly, sustainable alternatives to plastic.",
  image = "/logo/footer-logo.webp",
  canonical,
  ogType = "website",
  schema
} = Astro.props;

const canonicalURL = canonical ? new URL(canonical, Astro.site || Astro.url) : new URL(Astro.url.pathname, Astro.site || Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site || Astro.url).href} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site || Astro.url).href} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL.href} />

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">

    <script is:inline>
      /* Marks the document as script-enabled so reveal animations only hide
         content when JS can bring it back. No-JS visitors see everything. */
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <!-- Global Header rendered at the top of every page -->
    <Header />

    <!-- Page-specific content gets rendered here -->
    <div class="layout-main">
      <slot />
    </div>

    <!-- Global Footer rendered at the bottom of every page -->
    <Footer />
  </body>
</html>

<style is:global>
  /* ============================================================
     SAKRT DESIGN SYSTEM
     One source of truth for colour, type, spacing, motion.
     Legacy --color-* names are kept as aliases so every existing
     component inherits the corrected values automatically.

     Colour rule that matters: lime is a MARK, never text on a
     light surface. Lime text on pulp measures 1.5:1. Ink on lime
     measures 12.7:1. Fill with lime, write in ink.
     ============================================================ */
  :root {
    /* --- Ink (dark greens, measured against --pulp) --- */
    --ink: #10281c;              /* 14.0:1  headings, primary text */
    --ink-soft: #3a4a41;         /*  8.4:1  body copy */
    --ink-muted: #5c6b62;        /*  5.0:1  captions, meta (AA at 16px) */
    --brand: #0d3d26;            /* 11.0:1  brand forest green */

    /* --- Surfaces: unbleached pulp, not cream, not cold grey --- */
    --pulp: #f2f3ed;             /* page */
    --pulp-deep: #e7e9e0;        /* alternating band */
    --surface: #ffffff;          /* card */
    --hairline: #d8dbd0;         /* 1px borders */
    --hairline-strong: #c3c8b9;

    /* --- Lime accent --- */
    --lime: #cff737;             /* fills, marks, rules — never small text */
    --lime-soft: #e8f9a8;        /* tints, hover washes */
    --lime-ink: #4a6b0c;         /* 5.5:1 — the only lime-ish TEXT on light */

    /* --- On-dark text --- */
    --on-dark: #f2f3ed;
    --on-dark-muted: #a9b8ac;

    /* --- Type --- */
    --font-display: 'Instrument Serif', 'Cormorant Garamond', Georgia, serif;
    --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    --font-mono: 'Space Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

    --fs-hero: clamp(2.9rem, 8.4vw, 6.5rem);
    --fs-h1: clamp(2.25rem, 5vw, 3.75rem);
    --fs-h2: clamp(1.9rem, 3.6vw, 2.85rem);
    --fs-h3: clamp(1.3rem, 2.1vw, 1.6rem);
    --fs-h4: 1.0625rem;
    --fs-lede: clamp(1.0313rem, 1.25vw, 1.1563rem);
    --fs-body: 1rem;
    --fs-sm: 0.9375rem;
    --fs-xs: 0.8125rem;
    --fs-label: 0.7rem;          /* mono eyebrows */

    /* --- Spacing (4px base) --- */
    --s-1: 4px;  --s-2: 8px;  --s-3: 12px; --s-4: 16px; --s-5: 20px;
    --s-6: 24px; --s-8: 32px; --s-10: 40px; --s-12: 48px; --s-16: 64px;
    --s-20: 80px; --s-24: 96px;
    --section-y: clamp(72px, 9vw, 132px);
    --gutter: clamp(20px, 5vw, 56px);
    --maxw: 1240px;
    --maxw-narrow: 900px;

    /* --- Radii: four values, plus one organic mark --- */
    --r-xs: 4px; --r-sm: 8px; --r-md: 12px; --r-lg: 18px; --r-xl: 26px;
    --r-pill: 999px;
    --r-seed: 62% 38% 55% 45% / 52% 58% 42% 48%;

    /* --- Elevation: hairlines do the work, shadows only on lift --- */
    --shadow-1: 0 1px 2px rgba(16, 40, 28, 0.04);
    --shadow-2: 0 18px 40px -22px rgba(16, 40, 28, 0.28);
    --shadow-3: 0 30px 70px -30px rgba(16, 40, 28, 0.34);

    /* --- Motion --- */
    --ease-settle: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-out: cubic-bezier(0.33, 1, 0.68, 1);
    --dur-1: 0.2s; --dur-2: 0.45s; --dur-3: 0.8s;

    /* ---------- Legacy aliases (do not remove) ---------- */
    --color-primary-dark: var(--brand);
    --color-forest-medium: var(--brand);
    --color-forest-dark: var(--ink);
    --color-accent-lime: var(--lime);
    --color-accent-lime-bright: var(--lime);
    --color-text-main: var(--ink);
    --color-text-body: var(--ink-soft);
    --color-text-muted: var(--ink-muted);
    --color-text-light: #ffffff;
    --color-bg-page: var(--pulp);
    --color-bg-card: var(--surface);
    --color-bg-pill: var(--pulp-deep);
    --color-border-subtle: var(--hairline);
    --font-serif: var(--font-display);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  /* No scroll-behavior here — Lenis (src/script/SmoothScroll.js) owns scrolling. */
  html { -webkit-text-size-adjust: 100%; }

  html, body {
    width: 100%;
    min-height: 100vh;
    background-color: var(--pulp);
    color: var(--ink-soft);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    line-height: 1.65;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body { display: flex; flex-direction: column; }
  .layout-main { flex: 1; display: flex; flex-direction: column; }

  /* Instrument Serif ships one weight — stop the browser faking bolds. */
  h1, h2, h3, h4, h5, h6 {
    font-synthesis-weight: none;
    text-wrap: balance;
    color: var(--ink);
  }
  p { text-wrap: pretty; }
  img, picture, video, svg { max-width: 100%; display: block; }
  a { color: inherit; }

  /* Accessibility floor: a focus ring you can actually see. */
  :focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 3px;
    border-radius: var(--r-xs);
  }

  ::selection { background: var(--lime); color: var(--ink); }

  /* ============================================================
     PRIMITIVES  (sk- prefix; Astro's scoped styles always win,
     so these never fight a component's own rules)
     ============================================================ */
  .sk-section { padding-block: var(--section-y); position: relative; }
  .sk-section--band { background: var(--pulp-deep); }
  .sk-section--ink { background: var(--ink); color: var(--on-dark-muted); }
  .sk-section--ink h1, .sk-section--ink h2,
  .sk-section--ink h3, .sk-section--ink h4 { color: var(--on-dark); }

  .sk-wrap {
    width: 100%;
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* Eyebrow: mono, letterspaced, with a short lime rule. The rule is
     the only place lime touches a light background — as a fill, not text. */
  .sk-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .sk-eyebrow::before {
    content: '';
    width: 26px;
    height: 3px;
    background: var(--lime);
    border-radius: var(--r-pill);
    flex: none;
  }
  .sk-section--ink .sk-eyebrow { color: var(--on-dark-muted); }

  .sk-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--fs-h2);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .sk-title--lg { font-size: var(--fs-h1); }

  .sk-lede {
    max-width: 62ch;
    font-size: var(--fs-lede);
    line-height: 1.7;
    color: var(--ink-soft);
  }
  .sk-section--ink .sk-lede { color: var(--on-dark-muted); }

  /* Lime marker stroke behind text. Ink on lime = 12.7:1. */
  .sk-mark {
    background-image: linear-gradient(to top, var(--lime) 0 34%, transparent 34%);
    background-repeat: no-repeat;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding-inline: 0.08em;
  }

  .sk-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-1);
    transition: transform var(--dur-2) var(--ease-settle),
                box-shadow var(--dur-2) var(--ease-settle),
                border-color var(--dur-2) var(--ease-settle);
  }
  @media (hover: hover) {
    .sk-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-2);
      border-color: var(--hairline-strong);
    }
  }

  /* Fixed-ratio image box — the fix for grids of mismatched photos. */
  .sk-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--ar, 4 / 3);
    background: var(--pulp-deep);
    border-radius: var(--r-md);
  }
  .sk-media > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-settle);
  }
  @media (hover: hover) {
    .sk-card:hover .sk-media > img { transform: scale(1.045); }
  }

  .sk-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: 6px 12px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-pill);
    background: var(--pulp);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .sk-rule { height: 1px; background: var(--hairline); border: 0; }

  /* Buttons */
  .sk-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    min-height: 48px;
    padding: 0 26px;
    border: 1px solid transparent;
    border-radius: var(--r-pill);
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: transform var(--dur-1) var(--ease-out),
                background-color var(--dur-1) var(--ease-out),
                color var(--dur-1) var(--ease-out),
                border-color var(--dur-1) var(--ease-out);
  }
  .sk-btn--primary { background: var(--ink); color: var(--on-dark); }
  .sk-btn--ghost { background: transparent; color: var(--ink); border-color: var(--hairline-strong); }
  .sk-btn--lime { background: var(--lime); color: var(--ink); }
  @media (hover: hover) {
    .sk-btn:hover { transform: translateY(-2px); }
    .sk-btn--primary:hover { background: var(--brand); }
    .sk-btn--ghost:hover { border-color: var(--ink); background: rgba(16, 40, 28, 0.04); }
    .sk-btn--lime:hover { background: #c2ec24; }
  }
  .sk-btn__arrow { transition: transform var(--dur-1) var(--ease-out); }
  .sk-btn:hover .sk-btn__arrow { transform: translateX(4px); }

  /* ============================================================
     SCROLL REVEAL & SCRUB — growth, not slide. 
     ============================================================ */
  @media (prefers-reduced-motion: no-preference) {
    .js [data-reveal],
    .js [data-reveal-group] > * {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity var(--dur-3) var(--ease-settle),
                  transform var(--dur-3) var(--ease-settle);
      transition-delay: calc(var(--i, 0) * 90ms);
    }
    .js [data-reveal].is-in,
    .js [data-reveal-group].is-in > * {
      opacity: 1;
      transform: none;
    }

    /* GROW — the signature "expanding" entrance */
    .js [data-reveal="grow"],
    .js [data-reveal-group] > [data-reveal="grow"] {
      opacity: 0;
      transform: scale(0.92);
      transition: opacity var(--dur-3) var(--ease-settle),
                  transform var(--dur-3) var(--ease-settle);
      transition-delay: calc(var(--i, 0) * 80ms);
      transform-origin: center;
    }
    .js [data-reveal="grow"].is-in,
    .js [data-reveal-group].is-in > [data-reveal="grow"] { 
      opacity: 1; 
      transform: none; 
    }

    /* WIPE — an image/panel opens from one edge (unfurling) */
    .js [data-reveal="wipe"],
    .js [data-reveal-group] > [data-reveal="wipe"] {
      opacity: 1;
      transform: none;
      clip-path: inset(0 100% 0 0);
      transition: clip-path var(--dur-3) var(--ease-settle);
      transition-delay: calc(var(--i, 0) * 80ms);
    }
    .js [data-reveal="wipe"].is-in,
    .js [data-reveal-group].is-in > [data-reveal="wipe"] { 
      clip-path: inset(0 0 0 0); 
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>

<script>
  // Site-wide smooth scrolling (Lenis). Self-guards against double-init and
  // respects prefers-reduced-motion internally.
  import "../script/SmoothScroll.js";

  /* Reveal on enter. One observer for the whole page, unobserved after
     firing so nothing animates twice on scroll-back. */
  const reveal = () => {
    const targets = document.querySelectorAll('[data-reveal], [data-reveal-group]');
    if (!targets.length) return;

    if (!('IntersectionObserver' in window)) {
      targets.forEach((el) => el.classList.add('is-in'));
      return;
    }

    document.querySelectorAll('[data-reveal-group]').forEach((group) => {
      Array.from(group.children).forEach((child, i) => {
        (child as HTMLElement).style.setProperty('--i', String(i));
      });
    });

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.08 }
    );

    targets.forEach((el) => io.observe(el));
  };

  reveal();
  document.addEventListener('astro:after-swap', reveal);

  // Scroll progress -> --p (0..1). Vanilla, Lenis-aware, accessibility-safe.
  // Geometry is measured ONCE (and on resize/load); the scroll handler then does
  // pure arithmetic with no per-tick getBoundingClientRect. Reading layout on
  // every Lenis tick forces a synchronous reflow — that was the scroll jank.
  const initScrub = () => {
    const els = Array.from(document.querySelectorAll('[data-scrub]')) as HTMLElement[];
    if (!els.length) return;

    // Reduced motion (or no Lenis): pin every element to its finished state.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      els.forEach((el) => el.style.setProperty('--p', '1'));
      return;
    }

    let vh = window.innerHeight;
    const geom = new Map<HTMLElement, { top: number; h: number }>();

    // The only place layout is read. Run on init, resize, and load.
    const measure = () => {
      vh = window.innerHeight;
      const sy = window.scrollY;
      for (const el of els) {
        const r = el.getBoundingClientRect();
        geom.set(el, { top: r.top + sy, h: r.height });
      }
    };

    let ticking = false;
    const apply = () => {
      ticking = false;
      const sy = window.scrollY;                        // one cheap read per frame
      for (const el of els) {
        const g = geom.get(el);
        if (!g) continue;
        const relTop = g.top - sy;                      // cached equivalent of rect.top
        if (relTop > vh || relTop + g.h < 0) continue;  // off-screen: skip
        const raw = (vh - relTop) / (vh + g.h);         // 0 entering -> 1 leaving
        el.style.setProperty('--p', Math.min(1, Math.max(0, raw)).toFixed(3));
      }
    };
    // Coalesce every scroll event into a single rAF write.
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(apply); } };

    measure();
    apply();
    const lenis = (window as any).lenis;
    if (lenis) lenis.on('scroll', onScroll); // rides Lenis's own rAF
    else window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => { measure(); apply(); });
    window.addEventListener('load', () => { measure(); apply(); });
  };
  initScrub();
  document.addEventListener('astro:after-swap', initScrub);
</script>