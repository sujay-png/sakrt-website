{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/about/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/enquiry/?$",
			"dest": "_render"
		},
		{
			"src": "^/blog/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/blog/?$",
			"dest": "_render"
		},
		{
			"src": "^/compostable-product/biodegradable-water-bottles/?$",
			"dest": "_render"
		},
		{
			"src": "^/compostable-product/carry-bags/?$",
			"dest": "_render"
		},
		{
			"src": "^/compostable-product/compostable-films/?$",
			"dest": "_render"
		},
		{
			"src": "^/compostable-product/compostable-grow-bags/?$",
			"dest": "_render"
		},
		{
			"src": "^/compostable-product/compostable-pouches/?$",
			"dest": "_render"
		},
		{
			"src": "^/compostable-product/food-packaging-boxes/?$",
			"dest": "_render"
		},
		{
			"src": "^/compostable-product/?$",
			"dest": "_render"
		},
		{
			"src": "^/contact-us/?$",
			"dest": "_render"
		},
		{
			"src": "^/media/?$",
			"dest": "_render"
		},
		{
			"src": "^/our-certifications/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}